# ─────────────────────────────────────────────────────────────────────────────
# BioMate — 阿里云 Demo 部署环境变量
# 使用方法:
#   1. cp .env.aliyun.example .env
#   2. 填写带 * 的必填项
#   3. bash scripts/setup_aliyun_demo.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── 授权许可 ──────────────────────────────────────────────────────────────────
BIOMATE_LICENSE_KEY=BMOP-DEMO-DEMO-DEMO-DEMO
BIOMATE_LICENSE_SECRET=

# ── 数据库 *必填 ──────────────────────────────────────────────────────────────
POSTGRES_DB=biomate
POSTGRES_USER=biomate
# 生成命令: openssl rand -hex 16
POSTGRES_PASSWORD=

# ── 密钥 *必填 ────────────────────────────────────────────────────────────────
# 生成命令: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=
GALAXY_API_KEY=

# ── MinIO（替代 S3） *必填 ────────────────────────────────────────────────────
MINIO_ROOT_USER=biomate
# 生成命令: openssl rand -hex 16
MINIO_ROOT_PASSWORD=
S3_BUCKET_NAME=biomate-data

# ── LLM：千问 API *必填 ──────────────────────────────────────────────────────
# 在 https://dashscope.console.aliyun.com/ 获取 API Key
# 模型选择（从便宜到贵）:
#   qwen-turbo      → 最便宜，适合简单演示
#   qwen-plus       → 性价比最佳（推荐 Demo 用）
#   qwen-max        → 效果最好，成本较高
GALAXY_AI_LLM_PROVIDER=openai_compatible
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
GALAXY_AI_LLM_MODEL=qwen-plus

# ── Nextflow 执行器（本地 Docker，无需 AWS）────────────────────────────────────
NEXTFLOW_USE_AWS=false
NEXTFLOW_EXECUTOR=local
NEXTFLOW_WORK_DIR=/app/nf-work
# 用以下命令获取宿主机 docker 组的 GID:
#   stat -c %g /var/run/docker.sock
DOCKER_GID=999

# ── 本地镜像仓库（生信工具容器） ──────────────────────────────────────────────
BIOMATE_LOCAL_REGISTRY=localhost:5050

# ── 网络 ──────────────────────────────────────────────────────────────────────
FORCE_HTTPS=0
ENABLE_HSTS=0
FRONTEND_PORT=5000
# 填写 ECS 公网 IP，例如: http://47.xxx.xxx.xxx:5000
FRONTEND_URL=
APP_URL=

# ── 邮件（Demo 可留空，注册时直接返回验证链接）──────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@biomate.ai
WORKFLOW_NOTIFY=never

# ── 计费（Demo 关闭）─────────────────────────────────────────────────────────
BILLING_LAGO_ENABLED=false
STRIPE_SECRET_KEY=
BILLING_INTERNAL_KEY=aliyun-demo-billing-disabled

# ── 镜像（GHCR，如拉取慢可配置阿里云加速器后重试）─────────────────────────────
BIOMATE_BACKEND_IMAGE=ghcr.io/biomate-ai/biomate-backend:integration-next-phase
BIOMATE_FRONTEND_IMAGE=ghcr.io/biomate-ai/biomate-frontend:integration-next-phase

# ── Bioconductor 容器（Demo 可留空，RNA-seq 等 R 工作流需要）──────────────────
# 留空 = 仅 Python 工作流可用（ADMET、BOIN、药物发现等）
BIOMATE_BIOC_CONTAINER=
