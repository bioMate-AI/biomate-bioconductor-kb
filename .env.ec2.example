# BioMate EC2 运行时环境变量模板(由 deploy/biomate.env.manifest 派生,勿直接改)
# 复制到 /opt/biomate/.env 填值;或配置后由 sync_to_dev.sh BIOMATE_PUSH_ENV=1 推送。
# 主机独有密钥(GALAXY_MASTER_API_KEY 等未列入的)可直接加在此,push 不覆盖。

# ── 核心密钥 (secret) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
JWT_SECRET=
SESSION_SECRET=
BILLING_INTERNAL_KEY=
DATABASE_URL=
GALAXY_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ENCRYPTION_KEY=
CSRF_SECRET=
GALAXY_JWT_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── 核心非敏感配置 (public → GitHub Variables) ──────────────────────────────
GALAXY_URL=
AWS_REGION=
S3_BUCKET_NAME=
NODE_ENV=
APP_URL=
CORS_ORIGINS=
FORCE_HTTPS=
ENABLE_HSTS=

# ── 计费 (Lago + Java billing) ───────────────────────────────────────────────
LAGO_API_KEY=
LAGO_API_URL=
REDIS_URL=
JAVA_BILLING_SERVICE_URL=
JAVA_BILLING_ENABLED=
BILLING_DEV_MODE=

# ── Nextflow / AWS Batch ─────────────────────────────────────────────────────
AWS_NF_ACCESS_KEY_ID=
AWS_NF_SECRET_ACCESS_KEY=
AWS_S3_NEXTFLOW_BUCKET=
AWS_S3_BUCKET=
AWS_DEFAULT_REGION=
AWS_BATCH_QUEUE=
GPU_BATCH_QUEUE=
NEXTFLOW_USE_AWS=
BIOMATE_NF_PROFILE=

# ── 内置 Postgres (docker-compose.ec2.yml 路径用) ───────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── 应用加密 (secret;app 关键,缺失会导致字段/MFA 解密失败)────────────────
FIELD_ENCRYPTION_SECRET=
MFA_ENCRYPTION_SECRET=
LAGO_WEBHOOK_SECRET=

# ── 邮件 / SMTP (EMAIL_PASS 为 secret,其余为 variable)──────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ── 模型 / 行为 / 运维 (public)──────────────────────────────────────────────
BIOMATE_INTENT_MODEL=
BIOMATE_RESPONSE_MODEL=
BIOMATE_CHAT_VIA_CHAIN=
ADMIN_ALERT_EMAIL=

# ── CryoEM / CryoSPARC (CRYOSPARC_PASSWORD 为 secret,其余为 variable)────────
CRYOSPARC_AMI_ID=
CRYOSPARC_HOST=
CRYOSPARC_PORT=
CRYOSPARC_EMAIL=
CRYOSPARC_PASSWORD=
CRYOSPARC_INSTANCE_REGION=
CRYOSPARC_INSTANCE_TYPE=
CRYOSPARC_MOVIES_S3=
CRYOSPARC_PROJECT_DIR=
CRYOSPARC_LICENSE=
CRYOSPARC_DEFAULT_MOVIE_DIR=
CRYOSPARC_SSH_USER=
CRYOSPARC_SSH_KEY=

# ── 本地独有补充 (2026-06-14:原本只在本地、部署机缺) ────────────────────────
GOOGLE_API_KEY=
JWT_EXPIRY=
REDIS_PORT=
DATABASE_PATH=
