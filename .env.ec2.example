# Copy to /opt/biomate/shared/.env.ec2 on EC2 and fill values.
# Required for production startup: JWT_SECRET, SESSION_SECRET, BILLING_INTERNAL_KEY,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, S3_BUCKET_NAME,
# GALAXY_URL, GALAXY_API_KEY, and at least one of OPENAI_API_KEY/ANTHROPIC_API_KEY.

# AI provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Frontend required secrets
JWT_SECRET=
SESSION_SECRET=
BILLING_INTERNAL_KEY=

# Frontend required runtime services
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
S3_BUCKET_NAME=

# Database config
# Leave DATABASE_URL empty to use bundled postgres service defaults below.
# Set DATABASE_URL to override (external RDS/managed Postgres).
DATABASE_URL=
POSTGRES_DB=biomate
POSTGRES_USER=biomate
POSTGRES_PASSWORD=biomate

# Galaxy backend connection used by frontend
GALAXY_URL=http://galaxy-backend:8080
GALAXY_API_KEY=

# Optional services
REDIS_URL=

# Dev-public URL security toggles (recommended for HTTP-terminated EC2 Nginx)
FORCE_HTTPS=0
ENABLE_HSTS=0

# Optional, comma-separated; example:
# CORS_ORIGINS=https://dev-public.biomate.ai,https://biomate.ai
CORS_ORIGINS=
