# ============================================================================
# BioMate P0 Configuration
# ============================================================================

# Claude/Anthropic API Key (REQUIRED for AI features)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=

# ============================================================================
# Database Configuration (REQUIRED for authentication)
# ============================================================================

# PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database
# Example: postgresql://biomate:password@localhost:5432/biomate_production
DATABASE_URL=postgresql://username:password@localhost:5432/biomate_production

# ============================================================================
# Authentication Configuration (REQUIRED)
# ============================================================================

# JWT Secret (Generate with: openssl rand -hex 32)
JWT_SECRET=your-secret-key-change-in-production

# JWT Expiration (e.g., "7d", "24h", "3600s")
JWT_EXPIRY=7d

# ============================================================================
# AWS S3 Configuration (REQUIRED for file storage)
# ============================================================================

# AWS Credentials
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# S3 Bucket Name
S3_BUCKET_NAME=biomate-production

# ============================================================================
# Galaxy Backend Configuration
# ============================================================================

GALAXY_CONFIG_FILE=/app/config/galaxy.yml
GALAXY_API_URL=http://galaxy-backend:8080

# ============================================================================
# Frontend Configuration
# ============================================================================

NODE_ENV=production
PORT=3000

# ============================================================================
# Optional: Stripe Payment Configuration (P2 feature)
# ============================================================================

# STRIPE_SECRET_KEY=sk_test_your_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
