# ────────────────────────────────────────────────────────────────────────────
# BioMate On-Premises — 环境变量模板
# 使用方法: cp .env.onprem.example .env  然后编辑 .env
# 带 * 号的是必填项，其余按需填写
# ────────────────────────────────────────────────────────────────────────────

# ── 授权许可 *必填 ────────────────────────────────────────────────────────────
# 向 BioMate 团队申请，格式: BMOP-XXXX-XXXX-XXXX-XXXX
BIOMATE_LICENSE_KEY=BMOP-XXXX-XXXX-XXXX-XXXX
# BioMate 团队随部署包一并提供，不要自行修改
BIOMATE_LICENSE_SECRET=

# ── 数据库 *必填 ──────────────────────────────────────────────────────────────
POSTGRES_DB=biomate
POSTGRES_USER=biomate
# 请设置一个强密码，至少16位，包含字母+数字+特殊字符
POSTGRES_PASSWORD=

# ── JWT / Session 密钥 *必填 ─────────────────────────────────────────────────
# 生成命令: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# ── LLM 提供商（选择一个填写 API Key）────────────────────────────────────────
#
# 选项 A: Anthropic Claude（效果最好，需要境外网络）
ANTHROPIC_API_KEY=
#
# 选项 B: DeepSeek（国内直连，推荐）
DEEPSEEK_API_KEY=
#
# 选项 C: 智谱 GLM（国内直连）
ZHIPU_API_KEY=
#
# 选项 D: OpenRouter（中转多模型）
OPENROUTER_API_KEY=
#
# 选项 E: OpenAI
OPENAI_API_KEY=
#
# 激活的提供商（填写上面哪个 Key，就设置对应的值）
# 可选值: anthropic / deepseek / zhipu / openrouter / openai / ollama
GALAXY_AI_LLM_PROVIDER=deepseek
#
# 使用的模型（留空则使用各提供商默认模型）
# Anthropic: claude-sonnet-4-6 | DeepSeek: deepseek-chat | 智谱: glm-4-flash
GALAXY_AI_LLM_MODEL=

# ── Ollama 离线模式（完全不联网，需要 GPU）──────────────────────────────────
# 取消 docker-compose.onprem.yml 中 ollama 服务的注释后，设置以下两项:
# GALAXY_AI_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434

# ── 工作流执行引擎 ────────────────────────────────────────────────────────────
# local = 在本机 Docker 中运行（本地部署用这个）
# aws   = 在 AWS Batch 运行（需要下面的 AWS 配置）
NEXTFLOW_EXECUTOR=local

# ── AWS（可选，仅 AWS Batch + S3 存储时需要）─────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=cn-northwest-1
S3_BUCKET_NAME=

# ── 网络 ──────────────────────────────────────────────────────────────────────
# 用了 HTTPS 反向代理后设置为 1
FORCE_HTTPS=0
ENABLE_HSTS=0
# 允许跨域的来源（多个用逗号分隔，留空不做限制）
CORS_ORIGINS=

# ── 计费（本地部署默认关闭，无需配置）──────────────────────────────────────
BILLING_LAGO_ENABLED=false
# 如果需要订阅计费功能，填写 Stripe 密钥
STRIPE_SECRET_KEY=

# ── Galaxy 内部密钥（留空系统自动生成）──────────────────────────────────────
GALAXY_API_KEY=
BILLING_INTERNAL_KEY=onprem-billing-disabled
