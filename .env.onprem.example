# ────────────────────────────────────────────────────────────────────────────
# BioMate On-Premises — 环境变量模板
# 使用方法:
#   1. cp .env.onprem.example .env
#   2. 编辑 .env，填写必填项（标 * 的）
#   3. bash install.sh
# ────────────────────────────────────────────────────────────────────────────

# ── 授权许可 *必填 ────────────────────────────────────────────────────────────
# 演示 Key（功能完整，评估期不限）：默认已填入，无需修改。
# 正式部署请向 BioMate 团队申请正式 Key（格式: BMOP-XXXX-XXXX-YYYY-MM）并替换下方值。
BIOMATE_LICENSE_KEY=BMOP-DEMO-DEMO-DEMO-DEMO
# BioMate 团队随部署包提供，请勿自行修改
BIOMATE_LICENSE_SECRET=

# ── 数据库 *必填 ──────────────────────────────────────────────────────────────
POSTGRES_DB=biomate
POSTGRES_USER=biomate
# 强密码，至少 16 位，包含字母+数字+特殊字符
POSTGRES_PASSWORD=

# ── JWT / Session 密钥 *必填 ─────────────────────────────────────────────────
# 生成命令: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# ── Galaxy 内部 API 密钥 *必填 ────────────────────────────────────────────────
# 前端与 Galaxy AI 后端通信的共享密钥。同时作为 Galaxy bootstrap admin API key。
# install.sh 交互向导会自动生成此密钥。手动安装请执行: openssl rand -hex 32
GALAXY_API_KEY=

# ── 本地对象存储 MinIO *必填 ──────────────────────────────────────────────────
# MinIO 替代 AWS S3，存放工作流输入/输出文件
MINIO_ROOT_USER=biomate
# 强密码，至少 16 位
MINIO_ROOT_PASSWORD=
# Bucket 名称（默认 biomate-data，通常不需要改）
S3_BUCKET_NAME=biomate-data
# MinIO 管理界面访问端口（默认 9001）
# 访问: http://<本机IP>:9001  用户名/密码与上面相同

# ── LLM 提供商配置（选一个填写）────────────────────────────────────────────
#
# ════════════════════════════════════════════════════════════════════════════
# 选项 A: 客户本地大模型（推荐 — 纯内网，零依赖外网）
# 适用于在自己服务器上部署了 vLLM / LMDeploy / Ollama 的场景
# ════════════════════════════════════════════════════════════════════════════
# 本地模型服务地址（OpenAI 兼容接口的 base URL）
# vLLM 默认: http://192.168.x.x:8000/v1
# LMDeploy默认: http://192.168.x.x:23333/v1
# Ollama 默认: http://192.168.x.x:11434/v1
LLM_API_URL=http://192.168.1.100:8000/v1
# 模型名称（vLLM 启动时 --model 参数指定的名字）
# 示例: qwen2.5-32b-instruct / deepseek-r1-32b / llama-3.3-70b
LLM_MODEL=qwen2.5-32b-instruct
# API Key（大多数本地服务不需要，可以填任意字符串）
LLM_API_KEY=none
# 激活选项 A:
GALAXY_AI_LLM_PROVIDER=openai_compatible
GALAXY_AI_LLM_MODEL=

# ════════════════════════════════════════════════════════════════════════════
# 选项 B: DeepSeek API（国内直连，效果好，需要 API Key）
# ════════════════════════════════════════════════════════════════════════════
# DEEPSEEK_API_KEY=sk-xxxx
# GALAXY_AI_LLM_PROVIDER=deepseek
# GALAXY_AI_LLM_MODEL=deepseek-chat

# ════════════════════════════════════════════════════════════════════════════
# 选项 C: 智谱 GLM（国内直连，需要 API Key）
# ════════════════════════════════════════════════════════════════════════════
# ZHIPU_API_KEY=xxxx
# GALAXY_AI_LLM_PROVIDER=zhipu
# GALAXY_AI_LLM_MODEL=glm-4-flash

# ════════════════════════════════════════════════════════════════════════════
# 选项 D: Anthropic Claude（效果最佳，需要境外网络或代理）
# ════════════════════════════════════════════════════════════════════════════
# ANTHROPIC_API_KEY=sk-ant-xxxx
# GALAXY_AI_LLM_PROVIDER=anthropic
# GALAXY_AI_LLM_MODEL=claude-sonnet-4-6

# ════════════════════════════════════════════════════════════════════════════
# 选项 E: OpenAI / OpenRouter（需要 API Key）
# ════════════════════════════════════════════════════════════════════════════
# OPENAI_API_KEY=sk-xxxx
# OPENROUTER_API_KEY=sk-or-xxxx
# GALAXY_AI_LLM_PROVIDER=openai
# GALAXY_AI_LLM_MODEL=gpt-4o

# ════════════════════════════════════════════════════════════════════════════
# 选项 F: Ollama（完全本机运行，需要 GPU / 大内存）
# 先在 docker-compose.onprem.yml 中取消 ollama service 注释
# 然后: docker exec biomate-ollama ollama pull qwen2.5:32b
# ════════════════════════════════════════════════════════════════════════════
# GALAXY_AI_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434

# ── 工作流执行引擎 ────────────────────────────────────────────────────────────
# local = 在本机 Docker 中运行工作流（本地部署默认，无需 AWS）
# aws   = 在 AWS Batch 运行（需要 AWS 凭证和网络，SaaS 用）
NEXTFLOW_USE_AWS=false

# ── Docker 守护进程权限（本地 Nextflow 执行器必须设置） ─────────────────────────
# galaxy-backend 容器以 uid=1000 运行，需要访问宿主机的 Docker socket。
# 用以下命令获取宿主机 docker 组的 GID，填入下方：
#   stat -c %g /var/run/docker.sock
# Ubuntu 22.04 默认 = 121，Debian/RHEL 默认 = 999
DOCKER_GID=999

# ── 工作流工作目录（本地执行引擎必须设置） ────────────────────────────────────
# Nextflow 工作目录使用宿主机路径绑定挂载（bind mount），
# 挂载时宿主机路径与容器内路径必须相同。
# 部署前必须在宿主机上创建该目录：
#   mkdir -p /app/nf-work && chmod 777 /app/nf-work
# （docker-compose.onprem.yml 将其挂载为 /app/nf-work:/app/nf-work）
NEXTFLOW_WORK_DIR=/app/nf-work

# ── 本地 Docker 镜像仓库 ──────────────────────────────────────────────────────
# registry service 监听 localhost:5050（见 docker-compose.onprem.yml）
# 用于存放生信工具镜像（bwa、star、deseq2 等），纯内网环境下替代 ECR
BIOMATE_LOCAL_REGISTRY=localhost:5050

# ── AWS（可选，仅 AWS Batch + S3 存储时需要）─────────────────────────────────
# 本地部署（NEXTFLOW_USE_AWS=false）不需要 AWS 凭证。
# 仅当使用 AWS Batch 运行工作流或 S3 作为对象存储时才需要填写。
# 注意：设置 AWS_DEFAULT_REGION 会触发 AWS SES 邮件服务，需要有效的 IAM 凭证。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# ── 邮件 / SMTP（可选）────────────────────────────────────────────────────────
# 用于发送用户注册验证邮件、密码重置邮件、工作流完成通知。
# 留空则系统不发送邮件（用户注册时会在响应中直接返回验证链接）。
#
# 常见配置示例:
#   网易邮箱 (163/126):  EMAIL_HOST=smtp.163.com EMAIL_PORT=465 EMAIL_SECURE=true
#   腾讯企业邮:           EMAIL_HOST=smtp.exmail.qq.com EMAIL_PORT=465 EMAIL_SECURE=true
#   阿里企业邮:           EMAIL_HOST=smtp.mxhichina.com EMAIL_PORT=465 EMAIL_SECURE=true
#   Gmail:               EMAIL_HOST=smtp.gmail.com EMAIL_PORT=587 EMAIL_SECURE=false
#
EMAIL_HOST=
EMAIL_PORT=587
# EMAIL_SECURE=true 适合 465 端口（SSL）；false 适合 587（STARTTLS）
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
# 发件人地址（留空则使用 EMAIL_USER）
EMAIL_FROM=noreply@yourdomain.com
# 邮件中链接的基础 URL（用于验证邮件中的点击链接）
APP_URL=https://biomate.yourdomain.com

# ── 工作流完成通知 ────────────────────────────────────────────────────────────
# 工作流完成后向运行用户发送邮件通知。依赖上面的 SMTP 配置。
# 可选值: never / always / on_failure
WORKFLOW_NOTIFY=on_failure

# ── 网络配置 ──────────────────────────────────────────────────────────────────
# 如果前面有 Nginx/Traefik/Caddy 做 HTTPS 反向代理，设为 1
FORCE_HTTPS=0
ENABLE_HSTS=0
# 前端访问地址（用于生成下载链接等，留空则自动检测）
FRONTEND_URL=
# 允许跨域的来源（留空不限制）
CORS_ORIGINS=

# ── 端口配置 ──────────────────────────────────────────────────────────────────
# 前端监听端口（默认 5000，如果冲突可改）
FRONTEND_PORT=5000

# ── 计费（本地部署默认关闭）──────────────────────────────────────────────────
BILLING_LAGO_ENABLED=false
STRIPE_SECRET_KEY=
BILLING_INTERNAL_KEY=onprem-billing-disabled

# ── GHCR 认证（如果镜像为私有包才需要填写）─────────────────────────────────
# BioMate 镜像默认以公开方式发布，通常无需此配置。
# 若拉取时报 401 未授权，请向 BioMate 团队索取 GHCR Token，然后填入：
# GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GHCR_USER=biomate-deploy

# ── 镜像版本（高级选项，不建议修改）──────────────────────────────────────────
# 留空则使用 latest。指定具体版本（如 release-v1.2.0）可以锁定版本防止自动升级。
BIOMATE_BACKEND_IMAGE=ghcr.io/biomate-ai/biomate-backend:latest
BIOMATE_FRONTEND_IMAGE=ghcr.io/biomate-ai/biomate-frontend:latest

# ── 工作流数据库（高级选项）──────────────────────────────────────────────────
# 首次启动时系统自动从此 URL 下载工作流目录数据库（~280MB）。
# 在无网络环境中，可以预先下载 galaxy_ai_tools.db 并放到以下路径，
# 然后注释掉 docker-compose.onprem.yml 中的 db-init 服务。
# BIOMATE_DB_URL=https://biomate-onprem-assets.s3.us-west-2.amazonaws.com/onprem/galaxy_ai_tools.db

# ── Nextflow 工作流脚本（高级选项）──────────────────────────────────────────
# 首次启动时系统自动从此 URL 下载 .nf 工作流脚本包（~60MB）。
# 在无网络环境中，可以预先下载 nextflow_nfcore_subworkflows.tar.gz，
# 然后设置此变量指向本地 HTTP 服务或 file:// 路径。
# BIOMATE_NFCORE_URL=https://biomate-onprem-assets.s3.us-west-2.amazonaws.com/onprem/nextflow_nfcore_subworkflows.tar.gz

# ── Bioconductor 容器（高级选项，Bioconductor R 工作流）────────────────────
# Bioconductor R 工作流（RNA-seq、scRNA-seq、甲基化等）默认使用 ECR 私有镜像。
# 内网部署或无 AWS 访问的环境下，需要预先拉取镜像并推入本地仓库，然后设置此变量：
#   1. 拉取: docker pull 399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-transcriptomics:3.20-slim
#   2. 标记: docker tag <sha> localhost:5050/biomate/bioc-transcriptomics:latest
#   3. 推送: docker push localhost:5050/biomate/bioc-transcriptomics:latest
#   4. 设置: BIOMATE_BIOC_CONTAINER=localhost:5050/biomate/bioc-transcriptomics:latest
# 留空则不运行 Bioconductor 工作流（ADMET、药物发现、BOIN 等 Python 工作流不受影响）。
BIOMATE_BIOC_CONTAINER=

# ── biomni-tools 镜像（高级选项）────────────────────────────────────────────
# Python 工作流容器（ADMET、BOIN、药物发现等）使用此镜像。
# install.sh 自动从 GHCR 拉取并标记为 biomate/biomni-tools:latest。
# 离线部署：docker load -i biomni-tools.tar，然后重新运行 install.sh。
# BIOMATE_BIOMNI_TOOLS_IMAGE=ghcr.io/biomate-ai/biomni-tools:latest
