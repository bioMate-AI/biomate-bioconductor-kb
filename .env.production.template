# BioMate Production Environment Template
# Copy this to .env.production and fill in real values
# DO NOT COMMIT .env.production to git!

NODE_ENV=production
PORT=3000

# JWT Configuration
JWT_SECRET=<GENERATE_WITH_SCRIPT>
JWT_EXPIRES_IN=15m

# Session Configuration
SESSION_SECRET=<GENERATE_WITH_SCRIPT>
SESSION_TIMEOUT=900000

# Encryption
ENCRYPTION_KEY=<GENERATE_WITH_SCRIPT>
ENCRYPTION_ALGORITHM=aes-256-gcm

# CSRF Protection
CSRF_SECRET=<GENERATE_WITH_SCRIPT>

# Database (Update after RDS deployment)
DB_HOST=biomate-production.xxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=biomate
DB_USER=biomate_admin
DB_PASSWORD=<GENERATE_WITH_SCRIPT>
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis (Update after ElastiCache deployment)
REDIS_HOST=biomate-production.xxxx.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=<GENERATE_WITH_SCRIPT>
REDIS_TLS=true

# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=399683337364

# S3 Buckets
S3_DATA_BUCKET=biomate-production-data-399683337364
S3_BACKUP_BUCKET=biomate-production-backups-399683337364
S3_EVIDENCE_BUCKET=biomate-compliance-evidence-399683337364

# API Keys
API_KEY=<GENERATE_WITH_SCRIPT>
WEBHOOK_SECRET=<GENERATE_WITH_SCRIPT>
METRICS_API_KEY=<GENERATE_WITH_SCRIPT>

# Backup
BACKUP_ENCRYPTION_KEY=<GENERATE_WITH_SCRIPT>

# Admin
ADMIN_EMAIL=yaoyun.zhang@biomate.ai
ADMIN_INITIAL_PASSWORD=<GENERATE_WITH_SCRIPT>

# Security
BCRYPT_ROUNDS=12
PBKDF2_ITERATIONS=100000

# CORS
CORS_ORIGIN=https://biomate.ai,https://www.biomate.ai

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_RETENTION_DAYS=2557

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=

# Generate secrets with: ./scripts/security/generate-secrets.sh
