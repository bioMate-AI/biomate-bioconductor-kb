# BioMate CUT&RUN Docker Image
# Supports: nf-core/cutandrun
#
# Build: docker build --platform linux/amd64 -t biomate/cutandrun:x86 -f Dockerfile.cutandrun .
# Run:   docker run --platform linux/amd64 -it biomate/cutandrun:x86

FROM --platform=linux/amd64 mambaorg/micromamba:1.5-jammy

LABEL maintainer="BioMate Team"
LABEL description="x86 Docker for CUT&RUN: nf-core/cutandrun"
LABEL version="1.0.0"

USER root

ENV DEBIAN_FRONTEND=noninteractive
ENV MAMBA_ROOT_PREFIX=/opt/conda
ENV PATH="${MAMBA_ROOT_PREFIX}/bin:${PATH}"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget gzip bzip2 unzip pigz \
    build-essential gcc g++ gfortran cmake make \
    zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev libssl-dev \
    libncurses5-dev libncursesw5-dev libtbb-dev \
    libhdf5-dev pkg-config \
    default-jre-headless \
    perl cpanminus \
    git procps \
    && rm -rf /var/lib/apt/lists/*

# Create conda environment
USER $MAMBA_USER
RUN micromamba create -n biotools -c conda-forge -c bioconda -y python=3.11 && \
    micromamba clean --all -y

ARG MAMBA_DOCKERFILE_ACTIVATE=1
ENV ENV_NAME=biotools

# ==============================================================================
# Aligners
# ==============================================================================
RUN micromamba install -n biotools -c conda-forge -c bioconda -y \
    bowtie2 bwa \
    && micromamba clean --all -y

# ==============================================================================
# BAM/SAM Processing
# ==============================================================================
RUN micromamba install -n biotools -c conda-forge -c bioconda -y \
    samtools bedtools picard sambamba \
    && micromamba clean --all -y

# ==============================================================================
# Peak Callers
# ==============================================================================
RUN micromamba install -n biotools -c conda-forge -c bioconda -y \
    macs2 macs3 \
    && micromamba clean --all -y

# ==============================================================================
# DeepTools (for signal tracks and analysis)
# ==============================================================================
RUN micromamba install -n biotools -c conda-forge -c bioconda -y \
    deeptools \
    && micromamba clean --all -y

# ==============================================================================
# SEACR (CUT&RUN specific peak caller)
# ==============================================================================
USER root
RUN git clone --depth 1 https://github.com/FredHutch/SEACR.git /opt/tools/SEACR && \
    chmod +x /opt/tools/SEACR/SEACR_*.sh && \
    ln -sf /opt/tools/SEACR/SEACR_1.3.sh /usr/local/bin/SEACR
USER $MAMBA_USER

# ==============================================================================
# QC Tools
# ==============================================================================
RUN micromamba install -n biotools -c conda-forge -c bioconda -y \
    fastqc fastp multiqc preseq \
    && micromamba clean --all -y

# ==============================================================================
# Trimming Tools
# ==============================================================================
RUN micromamba install -n biotools -c conda-forge -c bioconda -y \
    cutadapt trim-galore \
    && micromamba clean --all -y

# ==============================================================================
# Fragment Analysis
# ==============================================================================
RUN micromamba install -n biotools -c conda-forge -c bioconda -y \
    phantompeakqualtools \
    && micromamba clean --all -y || true

# ==============================================================================
# Python Packages - via conda for better dependency management
# ==============================================================================
RUN micromamba install -n biotools -c conda-forge -c bioconda -y \
    numpy scipy pandas matplotlib seaborn \
    pybedtools pysam \
    && micromamba clean --all -y || true

# ==============================================================================
# Verification Script
# ==============================================================================
USER root

RUN printf '#!/bin/bash\neval "$(micromamba shell hook -s bash)"\nmicromamba activate biotools\nexec "$@"\n' > /usr/local/bin/biotools-shell && chmod +x /usr/local/bin/biotools-shell

RUN cat > /usr/local/bin/verify-tools.sh << 'VERIFY_SCRIPT'
#!/bin/bash
eval "$(micromamba shell hook -s bash)"
micromamba activate biotools
echo "=== BioMate CUT&RUN Docker ==="
echo ""
echo "### ALIGNERS ###"
echo "  bowtie2:    $(bowtie2 --version 2>&1 | head -1 || echo 'not found')"
echo "  bwa:        $(bwa 2>&1 | head -3 | tail -1 || echo 'not found')"
echo ""
echo "### PEAK CALLING ###"
echo "  macs2:      $(macs2 --version 2>&1 || echo 'not found')"
echo "  macs3:      $(macs3 --version 2>&1 || echo 'not found')"
echo "  SEACR:      $(which SEACR >/dev/null 2>&1 && echo 'installed' || echo 'not found')"
echo ""
echo "### SIGNAL ANALYSIS ###"
echo "  deeptools:  $(deeptools --version 2>&1 || echo 'not found')"
echo "  bamCoverage: $(bamCoverage --version 2>&1 || echo 'not found')"
echo ""
echo "### QC TOOLS ###"
echo "  fastqc:     $(fastqc --version 2>&1 || echo 'not found')"
echo "  fastp:      $(fastp --version 2>&1 | head -1 || echo 'not found')"
echo "  multiqc:    $(multiqc --version 2>&1 || echo 'not found')"
echo ""
echo "### BAM PROCESSING ###"
echo "  samtools:   $(samtools --version 2>&1 | head -1 || echo 'not found')"
echo "  bedtools:   $(bedtools --version 2>&1 || echo 'not found')"
echo "  picard:     $(picard MarkDuplicates --version 2>&1 | head -1 || echo 'not found')"
echo ""
echo "=== Supported Workflows ==="
echo "  - nf-core/cutandrun (CUT&RUN/CUT&Tag)"
VERIFY_SCRIPT
RUN chmod +x /usr/local/bin/verify-tools.sh

WORKDIR /data

ENTRYPOINT ["/usr/local/bin/biotools-shell"]
CMD ["/usr/local/bin/verify-tools.sh"]
