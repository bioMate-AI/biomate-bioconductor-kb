  "format-version": "0.1",
  "name": "biomni_genomics_generate_embeddings_with_state",
  "annotation": "Generate State embeddings for single-cell RNA-seq data using the SE-600M model. This function downloads the SE-600M model from Hugging Face, installs required dependencies (git-lfs, uv, arc-state), and generates embeddings for the input AnnData object. The SE-600M model is a state-of-the-art embedding model for single-cell data that can capture complex biological patterns and cell states. Features include real-time streaming output, automatic retry with reduced batch size on failure, GPU detection and warnings, and input validation.",
  "tags": [
    "biomni",
    "genomics",
    "multi-step"
  ],
