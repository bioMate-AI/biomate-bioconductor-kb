# API Credentials Configuration
# COPY THIS FILE TO credentials.yaml AND ADD YOUR TOKENS
# DO NOT COMMIT credentials.yaml TO GIT!

github:
  # Create token at: https://github.com/settings/tokens
  # Required scopes: public_repo
  token: ghp_YOUR_GITHUB_TOKEN_HERE

huggingface:
  # Create token at: https://huggingface.co/settings/tokens
  # Required scopes: read
  token: hf_YOUR_HUGGINGFACE_TOKEN_HERE

anthropic:
  # For LLM-based wrapper generation (optional)
  api_key: sk-ant-YOUR_ANTHROPIC_KEY_HERE

ncbi:
  # NCBI E-utilities (optional, for PubMed searches)
  # Register at: https://www.ncbi.nlm.nih.gov/account/
  api_key: YOUR_NCBI_API_KEY_HERE
  email: your.email@example.com
