# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Git
.git/
.gitignore

# Database (keep structure, not data)
database/*.sqlite
database/*.db
# Local-dev runtime artifacts under database/ that contain absolute dev paths
# (supervisord configs, compiled Mako templates, tmp reports). Galaxy/Gravity
# regenerates these at container startup; they must not be baked into the image.
database/cache/
database/gravity/
database/tmp/

# Dev-machine helper scripts (run on host before container start) — contain
# host-absolute paths and aren't part of the running app.
start_backend.sh
docker/

# Logs
logs/*.log

# Temp files
tmp/
temp/
*.tmp

# OS
.DS_Store
Thumbs.db

# Test files — top-level AND any nested `tests/` directory. The previous
# pattern only matched backend/tests/, leaving nested ones (e.g.
# biomni_workflows/galaxy/tests/) in the image with dev paths intact.
tests/
**/tests/
# Belt-and-suspenders explicit paths for nested tests dirs that ** glob may
# miss depending on BuildKit version.
biomni_workflows/galaxy/tests/
biomni_workflows/**/tests/

# Research / experimental code — not part of the production runtime.
# Contains absolute dev paths (e.g. /home/yzhang/biomate/...) by design;
# would otherwise trip the L4 lint and bloat the image.
experiments/
**/experiments/

# Large workflow libraries not needed in container (indexed separately)
biomni_workflows/nextflow_nfcore/subworkflows/bioconductor/
biomni_workflows/nextflow_nfcore/subworkflows/genomics/
biomni_workflows/nextflow_nfcore/

# Docs and notes
*.md
*.xlsx
*.pdf

# Nextflow logs
.nextflow/
.nextflow.log*

# Nextflow work directories — runtime artifacts that contain absolute paths
# from the launching machine. As of 2026-05-18 also removed from git tracking
# via `git rm -r --cached backend/work/` + `backend/.gitignore` entry.
work/
work/**

# Biomni function analysis docs — reference-only JSON/MD with legitimate
# container-path strings (e.g. /home/appuser/input in DiffDock docstrings)
# that the L4 lint can't tell apart from dev-path leaks. Not needed in image.
BIOMNI_FUNCTIONS_ANALYSIS_*.json
BIOMNI_FUNCTIONS_ANALYSIS_*.md

# Dev-only one-off scripts — not part of the running app
fix_biomni_tools.py
test_dd_modules.py

# Vendored nf-core workflows include upstream GitHub Actions configs with
# /home/ubuntu/ paths (legit CI runner paths). The workflow modules themselves
# are needed at runtime; the .github/ subdirs are not.
nf-core-workflows/*/.github/
nf-core-modules/.github/

# Tests inside experiments/ — production-code modules (e.g. autoloop_bridge.py)
# stay in the image; tests do not.
experiments/*/tests/
experiments/tests/

# Virtual environments
.venv*/
venv*/

# Research repos
../research_repos/
