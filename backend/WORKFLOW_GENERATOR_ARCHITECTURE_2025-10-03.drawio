<mxfile host="app.diagrams.net">
  <diagram name="Workflow Generator Architecture" id="workflow-generator">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Galaxy Workflow Generator Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="470" height="40" as="geometry" />
        </mxCell>

        <!-- User Input -->
        <mxCell id="user-input" value="User Intent&lt;br&gt;&lt;i&gt;&quot;Identify metabolites from human serum LC-MS data&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="290" height="60" as="geometry" />
        </mxCell>

        <!-- Step 1: FTS5 Query Transformation -->
        <mxCell id="step1" value="Step 1: FTS5 Query Transformation&lt;br&gt;&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; User intent&lt;br&gt;&lt;b&gt;LLM:&lt;/b&gt; Claude Sonnet 4.5&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; &quot;metabolite OR lcms OR peak OR serum&quot;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;⏱️ ~2s | 💰 $0.001&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="400" y="180" width="370" height="110" as="geometry" />
        </mxCell>

        <mxCell id="arrow1" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2" edge="1" parent="1" source="user-input" target="step1">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Step 2: Tool Retrieval -->
        <mxCell id="step2" value="Step 2: Tool Retrieval &amp; Validation&lt;br&gt;&lt;br&gt;&lt;b&gt;Source:&lt;/b&gt; ToolSearchIndex (SQLite FTS5)&lt;br&gt;&lt;b&gt;Database:&lt;/b&gt; 2,169 tools indexed&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; 30 validated tools&lt;br&gt;&lt;b&gt;Fields:&lt;/b&gt; tool_id, name, category, &lt;u&gt;keywords&lt;/u&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;⏱️ &lt;100ms | 💰 Free&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="370" height="120" as="geometry" />
        </mxCell>

        <mxCell id="arrow2" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Tool Index Database (side note) -->
        <mxCell id="db-note" value="database/&lt;br&gt;tool_search_index.db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="820" y="350" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="db-arrow" value="" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;strokeColor=#666666" edge="1" parent="1" source="step2" target="db-note">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3: Workflow Generation -->
        <mxCell id="step3" value="Step 3: LLM Workflow Generation ✅ FIXED&lt;br&gt;&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Tool catalog (keywords + category)&lt;br&gt;&lt;b&gt;LLM:&lt;/b&gt; Claude Sonnet 4.5&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; 6-step workflow structure&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; Use keywords instead of descriptions&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;⏱️ ~3s | 💰 $0.002&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="400" y="490" width="370" height="120" as="geometry" />
        </mxCell>

        <mxCell id="arrow3" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Fix Note -->
        <mxCell id="fix-note" value="⚠️ Content Refusal Fix:&lt;br&gt;Changed from descriptions to keywords" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="820" y="510" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fix-arrow" value="" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;strokeColor=#d79b00" edge="1" parent="1" source="step3" target="fix-note">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Step 4: Dataset Assignment -->
        <mxCell id="step4" value="Step 4: Dataset Assignment&lt;br&gt;&lt;br&gt;&lt;b&gt;Component:&lt;/b&gt; WorkflowDatasetSelector&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; User intent + workflow steps&lt;br&gt;&lt;b&gt;LLM:&lt;/b&gt; Claude Sonnet 4.5 (cached)&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Datasets per step with reasoning&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;⏱️ ~5s | 💰 $0.005 (90% cached)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="400" y="650" width="370" height="130" as="geometry" />
        </mxCell>

        <mxCell id="arrow4" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Dataset Source -->
        <mxCell id="dataset-source" value="/tmp/biomni_datasets/&lt;br&gt;105 datasets (28GB)&lt;br&gt;&lt;br&gt;• HMDB&lt;br&gt;• KEGG&lt;br&gt;• UniProt&lt;br&gt;• Data Lake" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="820" y="660" width="150" height="110" as="geometry" />
        </mxCell>

        <mxCell id="dataset-arrow" value="" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;strokeColor=#666666" edge="1" parent="1" source="step4" target="dataset-source">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Step 5: Galaxy .ga JSON Builder -->
        <mxCell id="step5" value="Step 5: Galaxy .ga JSON Builder&lt;br&gt;&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Workflow structure + datasets&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Complete Galaxy .ga workflow&lt;br&gt;&lt;b&gt;Format:&lt;/b&gt; Datasets embedded as tool inputs&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;⏱️ &lt;10ms | 💰 Free&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="400" y="820" width="370" height="110" as="geometry" />
