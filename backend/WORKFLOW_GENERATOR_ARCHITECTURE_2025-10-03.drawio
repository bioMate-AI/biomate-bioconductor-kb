        <!-- Key Components (Left Side) -->
        <mxCell id="components" value="&lt;b&gt;Key Components&lt;/b&gt;&lt;br&gt;&lt;br&gt;✅ WorkflowDatasetSelector&lt;br&gt;✅ GalaxyWorkflowGenerator&lt;br&gt;✅ ToolSearchIndex&lt;br&gt;✅ FTS5 Query Transform&lt;br&gt;✅ .ga JSON Builder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
