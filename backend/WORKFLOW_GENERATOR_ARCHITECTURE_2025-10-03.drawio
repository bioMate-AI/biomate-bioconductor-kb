          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Output -->
        <mxCell id="output" value="Complete Galaxy Workflow&lt;br&gt;&lt;br&gt;workflow.ga&lt;br&gt;(Ready for execution)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="440" y="970" width="290" height="70" as="geometry" />
