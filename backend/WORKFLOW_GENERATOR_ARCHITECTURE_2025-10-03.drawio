        <mxCell id="arrow6" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2" edge="1" parent="1" source="step5" target="output">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
