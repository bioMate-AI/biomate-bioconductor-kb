        <!-- Performance Summary -->
        <mxCell id="performance" value="&lt;b&gt;Total Performance&lt;/b&gt;&lt;br&gt;&lt;br&gt;⏱️ Time: ~10 seconds&lt;br&gt;💰 Cost: ~$0.008&lt;br&gt;✅ Status: All components working" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="100" y="820" width="240" height="110" as="geometry" />
