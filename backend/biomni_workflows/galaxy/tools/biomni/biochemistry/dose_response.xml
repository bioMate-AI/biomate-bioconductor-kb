<?xml version="1.0"?>
<tool id="biomni_biochemistry_dose_response" name="Biomni: Dose Response" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/dose_response_wrapper.py' --output '$output'
    --x '$x'
--ic50 '$ic50'
--hill '$hill'
]]></command>
    <inputs>
        <param name="x" type="text" label="X" help=""  />
        <param name="ic50" type="text" label="Ic50" help=""  />
        <param name="hill" type="text" label="Hill" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Dose Response**



**Domain**: biochemistry
**Function**: dose_response
]]></help>
</tool>
