<?xml version="1.0"?>
<tool id="biomni_biochemistry_michaelis_menten" name="Biomni: Michaelis Menten" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/michaelis_menten_wrapper.py' --output '$output'
    --s '$s'
--vmax '$vmax'
--km '$km'
]]></command>
    <inputs>
        <param name="s" type="text" label="S" help=""  />
        <param name="vmax" type="text" label="Vmax" help=""  />
        <param name="km" type="text" label="Km" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Michaelis Menten**



**Domain**: biochemistry
**Function**: michaelis_menten
]]></help>
</tool>
