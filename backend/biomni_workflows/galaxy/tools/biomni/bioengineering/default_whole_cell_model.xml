<?xml version="1.0"?>
<tool id="biomni_bioengineering_default_whole_cell_model" name="Biomni: Default Whole Cell Model" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/default_whole_cell_model_wrapper.py' --output '$output'
    --t '$t'
--y '$y'
--params '$params'
]]></command>
    <inputs>
        <param name="t" type="text" label="T" help=""  />
        <param name="y" type="text" label="Y" help=""  />
        <param name="params" type="text" label="Params" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Default Whole Cell Model**



**Domain**: bioengineering
**Function**: default_whole_cell_model
]]></help>
</tool>
