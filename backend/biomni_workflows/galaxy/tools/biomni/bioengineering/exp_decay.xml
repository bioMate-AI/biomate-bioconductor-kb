<?xml version="1.0"?>
<tool id="biomni_bioengineering_exp_decay" name="Biomni: Exp Decay" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/exp_decay_wrapper.py' --output '$output'
    --x '$x'
--a '$a'
--tau '$tau'
--c '$c'
]]></command>
    <inputs>
        <param name="x" type="text" label="X" help=""  />
        <param name="a" type="text" label="A" help=""  />
        <param name="tau" type="text" label="Tau" help=""  />
        <param name="c" type="text" label="C" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Exp Decay**



**Domain**: bioengineering
**Function**: exp_decay
]]></help>
</tool>
