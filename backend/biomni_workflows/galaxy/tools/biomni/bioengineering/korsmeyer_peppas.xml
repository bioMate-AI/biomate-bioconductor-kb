<?xml version="1.0"?>
<tool id="biomni_bioengineering_korsmeyer_peppas" name="Biomni: Korsmeyer Peppas" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/korsmeyer_peppas_wrapper.py' --output '$output'
    --t '$t'
--k '$k'
--n '$n'
]]></command>
    <inputs>
        <param name="t" type="text" label="T" help=""  />
        <param name="k" type="text" label="K" help=""  />
        <param name="n" type="text" label="N" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Korsmeyer Peppas**



**Domain**: bioengineering
**Function**: korsmeyer_peppas
]]></help>
</tool>
