<?xml version="1.0"?>
<tool id="biomni_bioengineering_zero_order" name="Biomni: Zero Order" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/zero_order_wrapper.py' --output '$output'
    --t '$t'
--k '$k'
]]></command>
    <inputs>
        <param name="t" type="text" label="T" help=""  />
        <param name="k" type="text" label="K" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Zero Order**



**Domain**: bioengineering
**Function**: zero_order
]]></help>
</tool>
