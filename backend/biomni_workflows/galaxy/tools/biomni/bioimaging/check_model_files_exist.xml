<?xml version="1.0"?>
<tool id="biomni_bioimaging_check_model_files_exist" name="Biomni: Check Model Files Exist" version="1.0.0">
    <description>Check if actual model weight files exist for the specified folds</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/check_model_files_exist_wrapper.py' --output '$output'
    --model_folder '$model_folder'
--folds '$folds'
]]></command>
    <inputs>
        <param name="model_folder" type="text" label="Model Folder" help=""  />
        <param name="folds" type="text" label="Folds" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Check Model Files Exist**

Check if actual model weight files exist for the specified folds

**Domain**: bioimaging
**Function**: check_model_files_exist
]]></help>
</tool>
