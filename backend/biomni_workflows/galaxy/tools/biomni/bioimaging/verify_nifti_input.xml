<?xml version="1.0"?>
<tool id="biomni_bioimaging_verify_nifti_input" name="Biomni: Verify Nifti Input" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/verify_nifti_input_wrapper.py' --output '$output'
    --image_path '$image_path'
]]></command>
    <inputs>
        <param name="image_path" type="text" label="Image Path" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Verify Nifti Input**



**Domain**: bioimaging
**Function**: verify_nifti_input
]]></help>
</tool>
