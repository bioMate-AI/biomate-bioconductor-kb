<?xml version="1.0"?>
<tool id="biomni_cancer_biology_norm_chr" name="Biomni: Norm Chr" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/norm_chr_wrapper.py' --output '$output'
    --x '$x'
]]></command>
    <inputs>
        <param name="x" type="text" label="X" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Norm Chr**



**Domain**: cancer_biology
**Function**: norm_chr
]]></help>
</tool>
