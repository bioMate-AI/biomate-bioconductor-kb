<?xml version="1.0"?>
<tool id="biomni_database_reduce_tokens" name="Biomni: Reduce Tokens" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/reduce_tokens_wrapper.py' --output '$output'
    --res_json '$res_json'
]]></command>
    <inputs>
        <param name="res_json" type="text" label="Res Json" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Reduce Tokens**



**Domain**: database
**Function**: reduce_tokens
]]></help>
</tool>
