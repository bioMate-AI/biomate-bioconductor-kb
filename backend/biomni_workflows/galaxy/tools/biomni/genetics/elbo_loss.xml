<?xml version="1.0"?>
<tool id="biomni_genetics_elbo_loss" name="Biomni: Elbo Loss" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/elbo_loss_wrapper.py' --output '$output'
    --z_scores '$z_scores'
--ld_matrix '$ld_matrix'
--pips '$pips'
#if $n_samples
    --n_samples '$n_samples'
#end if
]]></command>
    <inputs>
        <param name="z_scores" type="text" label="Z Scores" help=""  />
        <param name="ld_matrix" type="text" label="Ld Matrix" help=""  />
        <param name="pips" type="text" label="Pips" help=""  />
        <param name="n_samples" type="text" label="N Samples" help="" value="10" optional="true"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Elbo Loss**



**Domain**: genetics
**Function**: elbo_loss
]]></help>
</tool>
