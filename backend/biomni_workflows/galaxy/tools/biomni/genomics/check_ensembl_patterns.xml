<?xml version="1.0"?>
<tool id="biomni_genomics_check_ensembl_patterns" name="Biomni: Check Ensembl Patterns" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/check_ensembl_patterns_wrapper.py' --output '$output'
    --gene_index '$gene_index'
]]></command>
    <inputs>
        <param name="gene_index" type="text" label="Gene Index" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Check Ensembl Patterns**



**Domain**: genomics
**Function**: check_ensembl_patterns
]]></help>
</tool>
