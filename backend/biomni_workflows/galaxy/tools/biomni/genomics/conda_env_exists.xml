<?xml version="1.0"?>
<tool id="biomni_genomics_conda_env_exists" name="Biomni: Conda Env Exists" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/conda_env_exists_wrapper.py' --output '$output'
    --env_name '$env_name'
]]></command>
    <inputs>
        <param name="env_name" type="text" label="Env Name" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Conda Env Exists**



**Domain**: genomics
**Function**: conda_env_exists
]]></help>
</tool>
