<?xml version="1.0"?>
<tool id="biomni_genomics_create_harmony_embeddings_scRNA" name="Biomni: Create Harmony Embeddings Scrna" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/create_harmony_embeddings_scRNA_wrapper.py' --output '$output'
    --adata_filename '$adata_filename'
--batch_key '$batch_key'
--data_dir '$data_dir'
]]></command>
    <inputs>
        <param name="adata_filename" type="text" label="Adata Filename" help=""  />
        <param name="batch_key" type="text" label="Batch Key" help=""  />
        <param name="data_dir" type="text" label="Data Dir" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Create Harmony Embeddings Scrna**



**Domain**: genomics
**Function**: create_harmony_embeddings_scRNA
]]></help>
</tool>
