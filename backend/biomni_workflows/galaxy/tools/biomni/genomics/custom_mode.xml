<?xml version="1.0"?>
<tool id="biomni_genomics_custom_mode" name="Biomni: Custom Mode" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/custom_mode_wrapper.py' --output '$output'
    --x '$x'
]]></command>
    <inputs>
        <param name="x" type="text" label="X" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Custom Mode**



**Domain**: genomics
**Function**: custom_mode
]]></help>
</tool>
