<?xml version="1.0"?>
<tool id="biomni_genomics_get_matrix" name="Biomni: Get Matrix" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/get_matrix_wrapper.py' --output '$output'
    --chrom '$chrom'
#if $balance_if_possible
    --balance_if_possible '$balance_if_possible'
#end if
]]></command>
    <inputs>
        <param name="chrom" type="text" label="Chrom" help=""  />
        <param name="balance_if_possible" type="text" label="Balance If Possible" help="" value="True" optional="true"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Get Matrix**



**Domain**: genomics
**Function**: get_matrix
]]></help>
</tool>
