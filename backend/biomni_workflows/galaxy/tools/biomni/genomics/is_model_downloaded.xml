<?xml version="1.0"?>
<tool id="biomni_genomics_is_model_downloaded" name="Biomni: Is Model Downloaded" version="1.0.0">
    <description>Check if model is already downloaded by looking for key files</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/is_model_downloaded_wrapper.py' --output '$output'
    --checkpoint_path '$checkpoint_path'
--model_type '$model_type'
]]></command>
    <inputs>
        <param name="checkpoint_path" type="text" label="Checkpoint Path" help=""  />
        <param name="model_type" type="text" label="Model Type" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Is Model Downloaded**

Check if model is already downloaded by looking for key files

**Domain**: genomics
**Function**: is_model_downloaded
]]></help>
</tool>
