<?xml version="1.0"?>
<tool id="biomni_immunology_simulate_cell_population" name="Biomni: Simulate Cell Population" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/simulate_cell_population_wrapper.py' --output '$output'
    --time_points '$time_points'
--g1_duration '$g1_duration'
--s_duration '$s_duration'
--g2m_duration '$g2m_duration'
--death_rate '$death_rate'
]]></command>
    <inputs>
        <param name="time_points" type="text" label="Time Points" help=""  />
        <param name="g1_duration" type="text" label="G1 Duration" help=""  />
        <param name="s_duration" type="text" label="S Duration" help=""  />
        <param name="g2m_duration" type="text" label="G2M Duration" help=""  />
        <param name="death_rate" type="text" label="Death Rate" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Simulate Cell Population**



**Domain**: immunology
**Function**: simulate_cell_population
]]></help>
</tool>
