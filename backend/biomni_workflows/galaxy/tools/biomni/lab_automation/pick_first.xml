<?xml version="1.0"?>
<tool id="biomni_lab_automation_pick_first" name="Biomni: Pick First" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/pick_first_wrapper.py' --output '$output'
    --keywords '$keywords'
]]></command>
    <inputs>
        <param name="keywords" type="text" label="Keywords" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Pick First**



**Domain**: lab_automation
**Function**: pick_first
]]></help>
</tool>
