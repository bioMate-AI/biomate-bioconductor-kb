<?xml version="1.0"?>
<tool id="biomni_microbiology_bacterial_dynamics" name="Biomni: Bacterial Dynamics" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/bacterial_dynamics_wrapper.py' --output '$output'
    --t '$t'
--N '$N'
]]></command>
    <inputs>
        <param name="t" type="text" label="T" help=""  />
        <param name="N" type="text" label="N" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Bacterial Dynamics**



**Domain**: microbiology
**Function**: bacterial_dynamics
]]></help>
</tool>
