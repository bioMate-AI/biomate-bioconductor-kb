<?xml version="1.0"?>
<tool id="biomni_microbiology_glv_equations" name="Biomni: Glv Equations" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/glv_equations_wrapper.py' --output '$output'
    --abundances '$abundances'
--t '$t'
--growth_rates '$growth_rates'
--interaction_matrix '$interaction_matrix'
]]></command>
    <inputs>
        <param name="abundances" type="text" label="Abundances" help=""  />
        <param name="t" type="text" label="T" help=""  />
        <param name="growth_rates" type="text" label="Growth Rates" help=""  />
        <param name="interaction_matrix" type="text" label="Interaction Matrix" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Glv Equations**



**Domain**: microbiology
**Function**: glv_equations
]]></help>
</tool>
