<?xml version="1.0"?>
<tool id="biomni_molecular_biology_find_orfs_in_frame" name="Biomni: Find Orfs In Frame" version="1.0.0">
    <description>Helper function to find ORFs in a specific frame.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/find_orfs_in_frame_wrapper.py' --output '$output'
    --seq_str '$seq_str'
--frame '$frame'
--strand '$strand'
]]></command>
    <inputs>
        <param name="seq_str" type="text" label="Seq Str" help=""  />
        <param name="frame" type="text" label="Frame" help=""  />
        <param name="strand" type="text" label="Strand" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Find Orfs In Frame**

Helper function to find ORFs in a specific frame.

**Domain**: molecular_biology
**Function**: find_orfs_in_frame
]]></help>
</tool>
