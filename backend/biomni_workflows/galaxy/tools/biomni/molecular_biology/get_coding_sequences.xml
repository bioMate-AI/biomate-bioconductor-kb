<?xml version="1.0"?>
<tool id="biomni_molecular_biology_get_coding_sequences" name="Biomni: Get Coding Sequences" version="1.0.0">
    <description>Extract coding sequences from RefSeq record.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/get_coding_sequences_wrapper.py' --output '$output'
    --refseq_id '$refseq_id'
]]></command>
    <inputs>
        <param name="refseq_id" type="text" label="Refseq Id" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Get Coding Sequences**

Extract coding sequences from RefSeq record.

**Domain**: molecular_biology
**Function**: get_coding_sequences
]]></help>
</tool>
