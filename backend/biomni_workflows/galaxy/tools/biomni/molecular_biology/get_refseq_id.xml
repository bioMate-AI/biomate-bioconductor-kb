<?xml version="1.0"?>
<tool id="biomni_molecular_biology_get_refseq_id" name="Biomni: Get Refseq Id" version="1.0.0">
    <description>Get RefSeq ID from gene record.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/get_refseq_id_wrapper.py' --output '$output'
    --gene_id '$gene_id'
]]></command>
    <inputs>
        <param name="gene_id" type="text" label="Gene Id" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Get Refseq Id**

Get RefSeq ID from gene record.

**Domain**: molecular_biology
**Function**: get_refseq_id
]]></help>
</tool>
