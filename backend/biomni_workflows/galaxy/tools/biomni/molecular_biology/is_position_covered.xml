<?xml version="1.0"?>
<tool id="biomni_molecular_biology_is_position_covered" name="Biomni: Is Position Covered" version="1.0.0">
    <description>Check if a position is covered by any region.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/is_position_covered_wrapper.py' --output '$output'
    --pos '$pos'
--covered_regions '$covered_regions'
]]></command>
    <inputs>
        <param name="pos" type="text" label="Pos" help=""  />
        <param name="covered_regions" type="text" label="Covered Regions" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Is Position Covered**

Check if a position is covered by any region.

**Domain**: molecular_biology
**Function**: is_position_covered
]]></help>
</tool>
