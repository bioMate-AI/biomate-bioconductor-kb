<?xml version="1.0"?>
<tool id="biomni_molecular_biology_is_region_fully_covered" name="Biomni: Is Region Fully Covered" version="1.0.0">
    <description>Check if the target region is fully covered.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/is_region_fully_covered_wrapper.py' --output '$output'
    --covered_regions '$covered_regions'
--start '$start'
--end '$end'
]]></command>
    <inputs>
        <param name="covered_regions" type="text" label="Covered Regions" help=""  />
        <param name="start" type="text" label="Start" help=""  />
        <param name="end" type="text" label="End" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Is Region Fully Covered**

Check if the target region is fully covered.

**Domain**: molecular_biology
**Function**: is_region_fully_covered
]]></help>
</tool>
