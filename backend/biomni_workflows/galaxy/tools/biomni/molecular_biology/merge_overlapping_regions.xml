<?xml version="1.0"?>
<tool id="biomni_molecular_biology_merge_overlapping_regions" name="Biomni: Merge Overlapping Regions" version="1.0.0">
    <description>Merge overlapping regions in the list.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/merge_overlapping_regions_wrapper.py' --output '$output'
    --regions '$regions'
]]></command>
    <inputs>
        <param name="regions" type="text" label="Regions" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Merge Overlapping Regions**

Merge overlapping regions in the list.

**Domain**: molecular_biology
**Function**: merge_overlapping_regions
]]></help>
</tool>
