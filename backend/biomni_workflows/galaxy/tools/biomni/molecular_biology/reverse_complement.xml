<?xml version="1.0"?>
<tool id="biomni_molecular_biology_reverse_complement" name="Biomni: Reverse Complement" version="1.0.0">
    <description>Get the reverse complement of a DNA sequence.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/reverse_complement_wrapper.py' --output '$output'
    --seq '$seq'
]]></command>
    <inputs>
        <param name="seq" type="text" label="Seq" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Reverse Complement**

Get the reverse complement of a DNA sequence.

**Domain**: molecular_biology
**Function**: reverse_complement
]]></help>
</tool>
