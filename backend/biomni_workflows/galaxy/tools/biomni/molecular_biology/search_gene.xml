<?xml version="1.0"?>
<tool id="biomni_molecular_biology_search_gene" name="Biomni: Search Gene" version="1.0.0">
    <description>Search for gene ID in NCBI database.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/search_gene_wrapper.py' --output '$output'
    
]]></command>
    <inputs>

    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Search Gene**

Search for gene ID in NCBI database.

**Domain**: molecular_biology
**Function**: search_gene
]]></help>
</tool>
