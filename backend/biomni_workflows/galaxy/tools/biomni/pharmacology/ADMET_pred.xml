<?xml version="1.0"?>
<tool id="biomni_pharmacology_ADMET_pred" name="Biomni: Admet Pred" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/ADMET_pred_wrapper.py' --output '$output'
    --drug '$drug'
--task '$task'
--unit '$unit'
]]></command>
    <inputs>
        <param name="drug" type="text" label="Drug" help=""  />
        <param name="task" type="text" label="Task" help=""  />
        <param name="unit" type="text" label="Unit" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Admet Pred**



**Domain**: pharmacology
**Function**: ADMET_pred
]]></help>
</tool>
