<?xml version="1.0"?>
<tool id="biomni_pharmacology_bi_exp_model" name="Biomni: Bi Exp Model" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/bi_exp_model_wrapper.py' --output '$output'
    --t '$t'
--A '$A'
--alpha '$alpha'
--B '$B'
--beta '$beta'
]]></command>
    <inputs>
        <param name="t" type="text" label="T" help=""  />
        <param name="A" type="text" label="A" help=""  />
        <param name="alpha" type="text" label="Alpha" help=""  />
        <param name="B" type="text" label="B" help=""  />
        <param name="beta" type="text" label="Beta" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Bi Exp Model**



**Domain**: pharmacology
**Function**: bi_exp_model
]]></help>
</tool>
