<?xml version="1.0"?>
<tool id="biomni_pharmacology_docking_autodock_vina" name="Biomni: Docking Autodock Vina" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/docking_autodock_vina_wrapper.py' --output '$output'
    --smiles_list '$smiles_list'
--receptor_pdb_file '$receptor_pdb_file'
--box_center '$box_center'
--box_size '$box_size'
#if $ncpu
    --ncpu '$ncpu'
#end if
]]></command>
    <inputs>
        <param name="smiles_list" type="text" label="Smiles List" help=""  />
        <param name="receptor_pdb_file" type="text" label="Receptor Pdb File" help=""  />
        <param name="box_center" type="text" label="Box Center" help=""  />
        <param name="box_size" type="text" label="Box Size" help=""  />
        <param name="ncpu" type="text" label="Ncpu" help="" value="1" optional="true"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Docking Autodock Vina**



**Domain**: pharmacology
**Function**: docking_autodock_vina
]]></help>
</tool>
