<?xml version="1.0"?>
<tool id="biomni_pharmacology_predict_admet_properties" name="Biomni: Predict Admet Properties" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/predict_admet_properties_wrapper.py' --output '$output'
    --smiles_list '$smiles_list'
#if $ADMET_model_type
    --ADMET_model_type '$ADMET_model_type'
#end if
]]></command>
    <inputs>
        <param name="smiles_list" type="text" label="Smiles List" help=""  />
        <param name="ADMET_model_type" type="text" label="Admet Model Type" help="" value="MPNN" optional="true"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Predict Admet Properties**



**Domain**: pharmacology
**Function**: predict_admet_properties
]]></help>
</tool>
