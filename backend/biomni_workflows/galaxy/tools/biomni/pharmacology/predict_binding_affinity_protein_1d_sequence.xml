<?xml version="1.0"?>
<tool id="biomni_pharmacology_predict_binding_affinity_protein_1d_sequence" name="Biomni: Predict Binding Affinity Protein 1D Sequence" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/predict_binding_affinity_protein_1d_sequence_wrapper.py' --output '$output'
    --smiles_list '$smiles_list'
--amino_acid_sequence '$amino_acid_sequence'
#if $affinity_model_type
    --affinity_model_type '$affinity_model_type'
#end if
]]></command>
    <inputs>
        <param name="smiles_list" type="text" label="Smiles List" help=""  />
        <param name="amino_acid_sequence" type="text" label="Amino Acid Sequence" help=""  />
        <param name="affinity_model_type" type="text" label="Affinity Model Type" help="" value="MPNN-CNN" optional="true"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Predict Binding Affinity Protein 1D Sequence**



**Domain**: pharmacology
**Function**: predict_binding_affinity_protein_1d_sequence
]]></help>
</tool>
