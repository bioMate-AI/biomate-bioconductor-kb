<?xml version="1.0"?>
<tool id="biomni_pharmacology_query_adverse_events" name="Biomni: Query Adverse Events" version="1.0.0">
    <description>Query adverse events with robust error handling and validation.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/query_adverse_events_wrapper.py' --output '$output'
    --drug_name '$drug_name'
#if $limit
    --limit '$limit'
#end if
]]></command>
    <inputs>
        <param name="drug_name" type="text" label="Drug Name" help=""  />
        <param name="limit" type="integer" label="Limit" help="" value="100" optional="true"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Query Adverse Events**

Query adverse events with robust error handling and validation.

**Domain**: pharmacology
**Function**: query_adverse_events
]]></help>
</tool>
