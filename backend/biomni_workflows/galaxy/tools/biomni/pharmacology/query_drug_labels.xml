<?xml version="1.0"?>
<tool id="biomni_pharmacology_query_drug_labels" name="Biomni: Query Drug Labels" version="1.0.0">
    <description>Query FDA drug label information.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/query_drug_labels_wrapper.py' --output '$output'
    --drug_name '$drug_name'
#if $sections
    --sections '$sections'
#end if
]]></command>
    <inputs>
        <param name="drug_name" type="text" label="Drug Name" help=""  />
        <param name="sections" type="text" label="Sections" help=""  optional="true"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Query Drug Labels**

Query FDA drug label information.

**Domain**: pharmacology
**Function**: query_drug_labels
]]></help>
</tool>
