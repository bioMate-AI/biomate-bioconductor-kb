<?xml version="1.0"?>
<tool id="biomni_pharmacology_query_drug_recalls" name="Biomni: Query Drug Recalls" version="1.0.0">
    <description>Query FDA drug recall and enforcement information.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/query_drug_recalls_wrapper.py' --output '$output'
    --drug_name '$drug_name'
#if $classification
    --classification '$classification'
#end if
]]></command>
    <inputs>
        <param name="drug_name" type="text" label="Drug Name" help=""  />
        <param name="classification" type="text" label="Classification" help=""  optional="true"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Query Drug Recalls**

Query FDA drug recall and enforcement information.

**Domain**: pharmacology
**Function**: query_drug_recalls
]]></help>
</tool>
