<?xml version="1.0"?>
<tool id="biomni_pharmacology_run_autosite" name="Biomni: Run Autosite" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/run_autosite_wrapper.py' --output '$output'
    --pdb_file '$pdb_file'
--output_dir '$output_dir'
#if $spacing
    --spacing '$spacing'
#end if
]]></command>
    <inputs>
        <param name="pdb_file" type="text" label="Pdb File" help=""  />
        <param name="output_dir" type="text" label="Output Dir" help=""  />
        <param name="spacing" type="text" label="Spacing" help="" value="1.0" optional="true"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Run Autosite**



**Domain**: pharmacology
**Function**: run_autosite
]]></help>
</tool>
