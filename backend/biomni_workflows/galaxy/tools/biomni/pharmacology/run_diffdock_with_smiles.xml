<?xml version="1.0"?>
<tool id="biomni_pharmacology_run_diffdock_with_smiles" name="Biomni: Run Diffdock With Smiles" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/run_diffdock_with_smiles_wrapper.py' --output '$output'
    --pdb_path '$pdb_path'
--smiles_string '$smiles_string'
--local_output_dir '$local_output_dir'
#if $gpu_device
    --gpu_device '$gpu_device'
#end if
#if $use_gpu
    --use_gpu '$use_gpu'
#end if
]]></command>
    <inputs>
        <param name="pdb_path" type="text" label="Pdb Path" help=""  />
        <param name="smiles_string" type="text" label="Smiles String" help=""  />
        <param name="local_output_dir" type="text" label="Local Output Dir" help=""  />
        <param name="gpu_device" type="text" label="Gpu Device" help="" value="0" optional="true"/>
        <param name="use_gpu" type="text" label="Use Gpu" help="" value="True" optional="true"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Run Diffdock With Smiles**



**Domain**: pharmacology
**Function**: run_diffdock_with_smiles
]]></help>
</tool>
