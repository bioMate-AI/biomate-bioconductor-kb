<?xml version="1.0"?>
<tool id="biomni_physiology_cosinor_model" name="Biomni: Cosinor Model" version="1.0.0">
    <description>Cosine function with baseline (mesor), amplitude, and phase shift.</description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/cosinor_model_wrapper.py' --output '$output'
    --t '$t'
--mesor '$mesor'
--amplitude '$amplitude'
--acrophase '$acrophase'
]]></command>
    <inputs>
        <param name="t" type="text" label="T" help=""  />
        <param name="mesor" type="text" label="Mesor" help=""  />
        <param name="amplitude" type="text" label="Amplitude" help=""  />
        <param name="acrophase" type="text" label="Acrophase" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Cosinor Model**

Cosine function with baseline (mesor), amplitude, and phase shift.

**Domain**: physiology
**Function**: cosinor_model
]]></help>
</tool>
