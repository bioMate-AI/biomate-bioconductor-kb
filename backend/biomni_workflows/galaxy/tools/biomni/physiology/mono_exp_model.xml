<?xml version="1.0"?>
<tool id="biomni_physiology_mono_exp_model" name="Biomni: Mono Exp Model" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/mono_exp_model_wrapper.py' --output '$output'
    --b '$b'
--S0 '$S0'
--ADC '$ADC'
]]></command>
    <inputs>
        <param name="b" type="text" label="B" help=""  />
        <param name="S0" type="text" label="S0" help=""  />
        <param name="ADC" type="text" label="Adc" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Mono Exp Model**



**Domain**: physiology
**Function**: mono_exp_model
]]></help>
</tool>
