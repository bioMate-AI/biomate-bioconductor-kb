<?xml version="1.0"?>
<tool id="biomni_physiology_quantify_amyloid_beta_plaques" name="Biomni: Quantify Amyloid Beta Plaques" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/quantify_amyloid_beta_plaques_wrapper.py' --output '$output'
    --image_path '$image_path'
#if $output_dir
    --output_dir '$output_dir'
#end if
#if $threshold_method
    --threshold_method '$threshold_method'
#end if
#if $min_plaque_size
    --min_plaque_size '$min_plaque_size'
#end if
#if $manual_threshold
    --manual_threshold '$manual_threshold'
#end if
]]></command>
    <inputs>
        <param name="image_path" type="text" label="Image Path" help=""  />
        <param name="output_dir" type="text" label="Output Dir" help="" value="./results" optional="true"/>
        <param name="threshold_method" type="text" label="Threshold Method" help="" value="otsu" optional="true"/>
        <param name="min_plaque_size" type="text" label="Min Plaque Size" help="" value="50" optional="true"/>
        <param name="manual_threshold" type="text" label="Manual Threshold" help="" value="127" optional="true"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Quantify Amyloid Beta Plaques**



**Domain**: physiology
**Function**: quantify_amyloid_beta_plaques
]]></help>
</tool>
