<?xml version="1.0"?>
<tool id="biomni_synthetic_biology_gene_circuit_odes" name="Biomni: Gene Circuit Odes" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/gene_circuit_odes_wrapper.py' --output '$output'
    --t '$t'
--state '$state'
]]></command>
    <inputs>
        <param name="t" type="text" label="T" help=""  />
        <param name="state" type="text" label="State" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Gene Circuit Odes**



**Domain**: synthetic_biology
**Function**: gene_circuit_odes
]]></help>
</tool>
