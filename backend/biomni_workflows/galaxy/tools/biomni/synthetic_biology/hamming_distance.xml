<?xml version="1.0"?>
<tool id="biomni_synthetic_biology_hamming_distance" name="Biomni: Hamming Distance" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/hamming_distance_wrapper.py' --output '$output'
    --s1 '$s1'
--s2 '$s2'
]]></command>
    <inputs>
        <param name="s1" type="text" label="S1" help=""  />
        <param name="s2" type="text" label="S2" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Hamming Distance**



**Domain**: synthetic_biology
**Function**: hamming_distance
]]></help>
</tool>
