<?xml version="1.0"?>
<tool id="biomni_systems_biology_dimerization_odes" name="Biomni: Dimerization Odes" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/dimerization_odes_wrapper.py' --output '$output'
    --t '$t'
--y '$y'
]]></command>
    <inputs>
        <param name="t" type="text" label="T" help=""  />
        <param name="y" type="text" label="Y" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Dimerization Odes**



**Domain**: systems_biology
**Function**: dimerization_odes
]]></help>
</tool>
