<?xml version="1.0"?>
<tool id="biomni_systems_biology_hill_function" name="Biomni: Hill Function" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/hill_function_wrapper.py' --output '$output'
    --x '$x'
--n '$n'
--ec50 '$ec50'
]]></command>
    <inputs>
        <param name="x" type="text" label="X" help=""  />
        <param name="n" type="text" label="N" help=""  />
        <param name="ec50" type="text" label="Ec50" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Hill Function**



**Domain**: systems_biology
**Function**: hill_function
]]></help>
</tool>
