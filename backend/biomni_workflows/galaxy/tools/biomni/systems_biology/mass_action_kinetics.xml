<?xml version="1.0"?>
<tool id="biomni_systems_biology_mass_action_kinetics" name="Biomni: Mass Action Kinetics" version="1.0.0">
    <description></description>
    <requirements>
        <container type="docker">biomate/biomni-tools:latest</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/mass_action_kinetics_wrapper.py' --output '$output'
    --reaction '$reaction'
--concentrations '$concentrations'
--metabolite_ids '$metabolite_ids'
]]></command>
    <inputs>
        <param name="reaction" type="text" label="Reaction" help=""  />
        <param name="concentrations" type="text" label="Concentrations" help=""  />
        <param name="metabolite_ids" type="text" label="Metabolite Ids" help=""  />
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <help><![CDATA[
**Biomni: Mass Action Kinetics**



**Domain**: systems_biology
**Function**: mass_action_kinetics
]]></help>
</tool>
