{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "biomni_genomics_interspecies_gene_conversion",
  "annotation": "Convert ENSEMBL gene IDs between different species using BioMart homology mapping. This function converts a list of ENSEMBL gene IDs from one species to their homologous counterparts in another species using the Ensembl BioMart database. The conversion is based on one-to-one ortholog mappings between species.",
