/*
 * Biomni Nextflow Configuration
 * Generated configuration for running Biomni tools
 */

// Docker configuration
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

// Process resource defaults
process {
    withLabel: 'process_low' {
        cpus = 1
        memory = '2.GB'
        time = '1.h'
    }
    withLabel: 'process_medium' {
        cpus = 2
        memory = '4.GB'
        time = '4.h'
    }
    withLabel: 'process_high' {
        cpus = 4
        memory = '8.GB'
        time = '8.h'
    }

    // Default container
    container = 'biomate/biomni-tools:latest'

    // Error handling
    errorStrategy = 'retry'
    maxRetries = 2
}

// Profiles for different execution environments
profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled = true
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }

    aws_batch {
        process.executor = 'awsbatch'
        process.queue = 'biomni-queue'
        aws.region = 'us-west-2'
        workDir = 's3://biomni-work/nextflow'
    }
}

// Output directory
params.outdir = './results'

// Manifest
manifest {
    name = 'biomni-workflows'
    author = 'BioMate Team'
    description = 'Biomni bioinformatics workflows for Nextflow'
    version = '1.0.0'
    nextflowVersion = '>=21.10.0'
}
