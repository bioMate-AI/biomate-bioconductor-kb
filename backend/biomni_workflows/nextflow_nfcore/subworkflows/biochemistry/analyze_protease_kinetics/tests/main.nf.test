nextflow_process {

    name "Test Process ANALYZE_PROTEASE_KINETICS"
    script "../main.nf"
    process "ANALYZE_PROTEASE_KINETICS"

    test("Should run analyze_protease_kinetics successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
