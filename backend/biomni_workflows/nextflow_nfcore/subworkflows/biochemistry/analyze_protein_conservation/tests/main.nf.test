nextflow_process {

    name "Test Process ANALYZE_PROTEIN_CONSERVATION"
    script "../main.nf"
    process "ANALYZE_PROTEIN_CONSERVATION"

    test("Should run analyze_protein_conservation successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
