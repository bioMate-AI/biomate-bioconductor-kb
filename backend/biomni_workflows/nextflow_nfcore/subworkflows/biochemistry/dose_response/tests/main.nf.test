nextflow_process {

    name "Test Process DOSE_RESPONSE"
    script "../main.nf"
    process "DOSE_RESPONSE"

    test("Should run dose_response successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
