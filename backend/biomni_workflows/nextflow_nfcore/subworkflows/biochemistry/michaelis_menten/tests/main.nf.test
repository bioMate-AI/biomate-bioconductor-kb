nextflow_process {

    name "Test Process MICHAELIS_MENTEN"
    script "../main.nf"
    process "MICHAELIS_MENTEN"

    test("Should run michaelis_menten successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
