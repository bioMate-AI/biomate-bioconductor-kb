#!/usr/bin/env nextflow
// ============================================================
// Bioconductor module: CAMERA
// Annotation of peaklists generated by xcms, rule based annotation of isotopes and adducts, isotope va
//
// Source : https://bioconductor.org/packages/3.20/bioc/vignettes/CAMERA/inst/doc/CAMERA.R
// Upstream  : none
// Downstream: flagme, IPO, LOBSTAHS, MAIT, metaMS
//
// Install: BiocManager::install("CAMERA")
// ============================================================

nextflow.enable.dsl = 2

process BIOC_CAMERA {
    tag "${meta.id}"
    label 'process_medium'

    conda "bioconductor-camera"
    container "${workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
        'https://depot.galaxyproject.org/singularity/bioconductor-camera:1.62.0--r44_0' :
        'quay.io/biocontainers/bioconductor-camera:1.62.0--r44_0'}"

    input:
    tuple val(meta), path(count_data)

    output:
    tuple val(meta), path("${meta.id}_camera_results.csv"),  emit: results
    tuple val(meta), path("${meta.id}_camera_output.rds"),   emit: rds
    tuple val(meta), path("${meta.id}_camera_plots.pdf"),    emit: plots, optional: true
    path "versions.yml",                                            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def args   = task.ext.args   ?: ''
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    library(CAMERA)
    library(jsonlite)

    # --- Eicpspec1 [] ---
    # Key functions: xcmsSet, xsAnnotate, groupFWHM, findAdducts, plotEICs
    library(CAMERA)
    file <- system.file('mzML/MM14.mzML', package = "CAMERA")
    xs   <- xcmsSet(file, method="centWave",ppm=30, peakwidth=c(5,10))
    an   <- xsAnnotate(xs)
    an   <- groupFWHM(an)
    # --- Pspec1 [] ---
    # Key functions: plotPsSpectrum
    plotPsSpectrum(an, pspec=2, maxlabel=5)

    # --- Save outputs ---
    if (exists("results_df") && is.data.frame(results_df)) {
        write.csv(results_df, "${prefix}_camera_results.csv", row.names = TRUE)
    } else {
        write.csv(data.frame(status = "completed"), "${prefix}_camera_results.csv")
    }
    if (exists("result_obj")) {
        saveRDS(result_obj, "${prefix}_camera_output.rds")
    }

    # --- versions.yml ---
    writeLines(
        c("BIOC_CAMERA:", paste0("    camera: ", packageVersion("CAMERA"))),
        "versions.yml"
    )
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_camera_results.csv
    touch ${prefix}_camera_output.rds
    echo "BIOC_CAMERA:" > versions.yml
    echo "    camera: 0.0.0" >> versions.yml
    """
}


workflow BIOC_CAMERA_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), path(count_data) ]

    main:
    BIOC_CAMERA(ch_input)

    emit:
    results  = BIOC_CAMERA.out.results   // channel: [ val(meta), path(csv) ]
    rds      = BIOC_CAMERA.out.rds       // channel: [ val(meta), path(rds) ]
    plots    = BIOC_CAMERA.out.plots     // channel: [ val(meta), path(pdf) ] (optional)
    versions = BIOC_CAMERA.out.versions  // channel: path(versions.yml)
}
