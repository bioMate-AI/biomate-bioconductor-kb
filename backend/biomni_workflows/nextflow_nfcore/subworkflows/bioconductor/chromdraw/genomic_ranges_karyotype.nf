#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: chromdraw — genomic_ranges_karyotype
// Visualize karyotypes and cytogenetic marks directly from R using GenomicRanges and a color data frame.
// Input: genomic_ranges_object, color_dataframe
// Container: quay.io/biocontainers/bioconductor-chromdraw:2.40.0--r45ha27e39d_0
// R packages: GenomicRanges, chromDraw
// Bioconductor: 3.21 | R: 4.5
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

nextflow.enable.dsl = 2

process BIOC_CHROMDRAW_GENOMIC_RANGES_KARYOTYPE {
    tag "${meta.id}"
    label 'process_medium'

    container "quay.io/biocontainers/bioconductor-chromdraw:2.40.0--r45ha27e39d_0"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("GenomicRanges", "chromDraw")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }

    # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
    for (.bm_d in list.files(".", full.names = TRUE)) {
      if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
        for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
          if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
        }
      }
    }
    
    # Load required libraries
    library(GenomicRanges)
    library(chromDraw)
    
    # Define input file paths in the working directory
    gr_input_path <- "genomic_ranges_object.rds"
    color_input_path <- "color_dataframe.csv"
    
    # Validate existence of required input files
    if (!file.exists(gr_input_path)) {
      stop(paste("Error: Required input file missing:", gr_input_path))
    }
    if (!file.exists(color_input_path)) {
      stop(paste("Error: Required input file missing:", color_input_path))
    }
    
    # Load the GenomicRanges object and color data frame from user inputs
    genomic_ranges_object <- readRDS(gr_input_path)
    color_dataframe <- read.csv(color_input_path, stringsAsFactors = FALSE)
    
    # Ensure the color data frame columns are correctly typed
    color_dataframe\$name <- as.character(color_dataframe\$name)
    color_dataframe\$r <- as.integer(color_dataframe\$r)
    color_dataframe\$g <- as.integer(color_dataframe\$g)
    color_dataframe\$b <- as.integer(color_dataframe\$b)
    
    # Track files in the working directory before running the visualization
    files_before <- list.files(all.files = TRUE)
    
    # Run the visualization using chromDrawGR
    # This call faithfully reproduces the documented function and argument structure
    chromDrawGR(list(genomic_ranges_object), color_dataframe)
    
    # Identify any output files generated by chromDrawGR (typically EPS or SVG files)
    files_after <- list.files(all.files = TRUE)
    generated_files <- setdiff(files_after, files_before)
    
    # Save a pipeline execution summary containing metadata and generated output file names
    pipeline_summary <- list(
      status = "success",
      input_ranges_count = length(genomic_ranges_object),
      input_colors_count = nrow(color_dataframe),
      output_files = generated_files
    )
    saveRDS(pipeline_summary, "pipeline_summary.rds")

    writeLines(c(
        '"BIOC_CHROMDRAW_GENOMIC_RANGES_KARYOTYPE":',
        paste0('        chromdraw: ', as.character(packageVersion("chromdraw")))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_genomic_ranges_karyotype.csv versions.yml
    """
}

workflow BIOC_CHROMDRAW_GENOMIC_RANGES_KARYOTYPE_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ genomic_ranges_object, color_dataframe ] ]

    main:
    BIOC_CHROMDRAW_GENOMIC_RANGES_KARYOTYPE(ch_input)

    emit:
    tables   = BIOC_CHROMDRAW_GENOMIC_RANGES_KARYOTYPE.out.tables
    plots    = BIOC_CHROMDRAW_GENOMIC_RANGES_KARYOTYPE.out.plots
    objects  = BIOC_CHROMDRAW_GENOMIC_RANGES_KARYOTYPE.out.objects
    versions = BIOC_CHROMDRAW_GENOMIC_RANGES_KARYOTYPE.out.versions
}
