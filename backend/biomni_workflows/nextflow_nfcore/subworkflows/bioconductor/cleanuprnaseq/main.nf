#!/usr/bin/env nextflow
// ============================================================
// Bioconductor module: CleanUpRNAseq
// RNA-seq data generated by some library preparation methods, such as rRNA-depletion-based method and 
//
// Source : https://bioconductor.org/packages/3.20/bioc/vignettes/CleanUpRNAseq/inst/doc/CleanUpRNAseq.R
// Upstream  : ensembldb, ggplotify, patchwork
// Downstream: none
//
// Install: BiocManager::install("CleanUpRNAseq")
// ============================================================

nextflow.enable.dsl = 2

process BIOC_CLEANUPRNASEQ {
    tag "${meta.id}"
    label 'process_medium'

    conda "bioconductor-cleanuprnaseq"
    container "${workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
        'https://depot.galaxyproject.org/singularity/bioconductor-cleanuprnaseq:1.0.0--r44_0' :
        'quay.io/biocontainers/bioconductor-cleanuprnaseq:1.0.0--r44_0'}"

    input:
    tuple val(meta), path(count_data)

    output:
    tuple val(meta), path("${meta.id}_cleanuprnaseq_results.csv"),  emit: results
    tuple val(meta), path("${meta.id}_cleanuprnaseq_output.rds"),   emit: rds
    tuple val(meta), path("${meta.id}_cleanuprnaseq_plots.pdf"),    emit: plots, optional: true
    path "versions.yml",                                            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def args   = task.ext.args   ?: ''
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    library(CleanUpRNAseq)
    library(jsonlite)

    # --- EnsDbFromGtf analysis [] ---
    # Key functions: tempdir, ensDbFromGtf, get_saf, create_summarizedcounts, salmon_tximport, plot_assignment_stat, plot_sample_corr, plot_expr_distr
    tmp_dir <- tempdir()
    in_dir <- system.file("extdata", package = "CleanUpRNAseq")
    gtf.gz <- dir(in_dir, ".gtf.gz$", full.name = TRUE)

    # --- Save outputs ---
    if (exists("results_df") && is.data.frame(results_df)) {
        write.csv(results_df, "${prefix}_cleanuprnaseq_results.csv", row.names = TRUE)
    } else {
        write.csv(data.frame(status = "completed"), "${prefix}_cleanuprnaseq_results.csv")
    }
    if (exists("result_obj")) {
        saveRDS(result_obj, "${prefix}_cleanuprnaseq_output.rds")
    }

    # --- versions.yml ---
    writeLines(
        c("BIOC_CLEANUPRNASEQ:", paste0("    cleanuprnaseq: ", packageVersion("CleanUpRNAseq"))),
        "versions.yml"
    )
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_cleanuprnaseq_results.csv
    touch ${prefix}_cleanuprnaseq_output.rds
    echo "BIOC_CLEANUPRNASEQ:" > versions.yml
    echo "    cleanuprnaseq: 0.0.0" >> versions.yml
    """
}


workflow BIOC_CLEANUPRNASEQ_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), path(count_data) ]

    main:
    BIOC_CLEANUPRNASEQ(ch_input)

    emit:
    results  = BIOC_CLEANUPRNASEQ.out.results   // channel: [ val(meta), path(csv) ]
    rds      = BIOC_CLEANUPRNASEQ.out.rds       // channel: [ val(meta), path(rds) ]
    plots    = BIOC_CLEANUPRNASEQ.out.plots     // channel: [ val(meta), path(pdf) ] (optional)
    versions = BIOC_CLEANUPRNASEQ.out.versions  // channel: path(versions.yml)
}
