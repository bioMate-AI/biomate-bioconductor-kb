#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: comapr — single_sperm_co_analysis
// Build individualized genetic maps and analyze crossovers from single-sperm haplotype state files generated by sscocaller.
// Input: sample_barcodes.txt, sample_chr_vi.mtx, sample_chr_snpAnnot.txt, sample_chr_viSegInfo.txt
// Container: quay.io/biocontainers/bioconductor-comapr:1.10.0--r44hdfd78af_0
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

nextflow.enable.dsl = 2

process BIOC_COMAPR_SINGLE_SPERM_CO_ANALYSIS {
    tag "${meta.id}"
    label 'process_medium'

    container "quay.io/biocontainers/bioconductor-comapr:1.10.0--r44hdfd78af_0"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("GenomicRanges", "SummarizedExperiment", "comapr")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      if (!requireNamespace("BiocManager", quietly=TRUE)) install.packages("BiocManager", repos="https://cloud.r-project.org")
      bin <- tryCatch(sprintf("https://bioconductor.org/packages/%s/container-binaries/bioconductor_docker", BiocManager::version()), error=function(e) NULL)
      suppressMessages(tryCatch(BiocManager::install(.bm_miss, update=FALSE, ask=FALSE, site_repository=bin), error=function(e) BiocManager::install(.bm_miss, update=FALSE, ask=FALSE)))
    }
    
    # Load required libraries
    suppressPackageStartupMessages({
      library(comapr)
      library(SummarizedExperiment)
      library(GenomicRanges)
    })
    
    # Define paths and map user input files to the expected structure
    demo_path <- "."
    
    # Copy user input files to match the expected names for s1 and s2, chr1 and chr2
    file.copy("sample_barcodes.txt", "s1_barcodes.txt", overwrite = TRUE)
    file.copy("sample_barcodes.txt", "s2_barcodes.txt", overwrite = TRUE)
    
    for (chr in c("chr1", "chr2")) {
      file.copy("sample_chr_vi.mtx", paste0("s1_", chr, "_vi.mtx"), overwrite = TRUE)
      file.copy("sample_chr_vi.mtx", paste0("s2_", chr, "_vi.mtx"), overwrite = TRUE)
    
      file.copy("sample_chr_snpAnnot.txt", paste0("s1_", chr, "_snpAnnot.txt"), overwrite = TRUE)
      file.copy("sample_chr_snpAnnot.txt", paste0("s2_", chr, "_snpAnnot.txt"), overwrite = TRUE)
    
      file.copy("sample_chr_viSegInfo.txt", paste0("s1_", chr, "_viSegInfo.txt"), overwrite = TRUE)
      file.copy("sample_chr_viSegInfo.txt", paste0("s2_", chr, "_viSegInfo.txt"), overwrite = TRUE)
    }
    
    # 1. Perform quality control on cells and chromosomes using perCellChrQC
    pcQC <- perCellChrQC(sampleName="s1",chroms=c("chr1"),
                         path=paste0(demo_path,"/"),
                         barcodeFile=NULL)
    
    # Save QC results
    write.csv(as.data.frame(pcQC), "per_cell_chr_qc.csv", row.names = FALSE)
    
    # 2. Read and parse haplotype states while filtering low-confidence crossovers using readHapState
    s1_rse_state <- readHapState("s1",chroms=c("chr1","chr2"),
                                 path=demo_path,barcodeFile=NULL,
                                 minSNP = 0,
                                 minlogllRatio = 50,
                                 bpDist = 100,
                                 maxRawCO=10,
                                 minCellSNP = 1)
    
    s2_rse_state <- readHapState("s2",chroms=c("chr1","chr2"),
                                 path=demo_path,
                                 barcodeFile=NULL,
                                 minSNP = 0,
                                 minlogllRatio = 50,
                                 bpDist = 100,
                                 maxRawCO=10,
                                 minCellSNP = 1)
    
    colData(s1_rse_state)\$sampleGroup <- "s1"
    
    colData(s2_rse_state)\$sampleGroup <- "s2"
    
    # 3. Combine haplotype states from multiple samples using combineHapState
    twoSample <- combineHapState(s1_rse_state,
                                 s2_rse_state)
    
    saveRDS(twoSample, "combined_hap_state.rds")
    
    # 4. Count crossovers for SNP intervals using countCOs
    cocounts <- countCOs(twoSample)
    saveRDS(cocounts, "crossover_counts.rds")
    
    # 5. Calculate overall or group-specific genetic distances using calGeneticDist
    dist_gr_overall <- calGeneticDist(co_count = cocounts, mapping_fun = "k")
    saveRDS(dist_gr_overall, "genetic_distances_overall.rds")
    
    dist_gr <- calGeneticDist(co_count = cocounts,
                              group_by  = "sampleGroup",
                              mapping_fun = "k")
    saveRDS(dist_gr, "genetic_distances_by_group.rds")
    
    p_gr <- granges(dist_gr)
    mcols(p_gr) <- rowData(dist_gr)\$kosambi
    
    # 6. Plot whole-genome or chromosome-specific genetic distances using plotWholeGenome and plotGeneticDist
    pdf("whole_genome_genetic_distances.pdf", width = 10, height = 6)
    plotWholeGenome(p_gr)
    dev.off()
    
    pdf("chr1_cumulative_genetic_distances.pdf", width = 8, height = 6)
    plotGeneticDist(p_gr,chr = "chr1",cumulative = TRUE)
    dev.off()
    
    # 7. Test for statistical differences between groups using bootstrapDist or permuteDist
    set.seed(100)
    bootsDiff <- bootstrapDist(co_gr = cocounts,B=10,
                               group_by = "sampleGroup")
    saveRDS(bootsDiff, "bootstrap_distances.rds")
    
    set.seed(100)
    perms <- permuteDist(cocounts,B=1000,group_by = "sampleGroup")
    saveRDS(perms, "permutation_distances.rds")
    
    # Clean up temporary copied files to keep the directory clean
    try({
      file.remove("s1_barcodes.txt")
      file.remove("s2_barcodes.txt")
      for (chr in c("chr1", "chr2")) {
        file.remove(paste0("s1_", chr, "_vi.mtx"))
        file.remove(paste0("s2_", chr, "_vi.mtx"))
        file.remove(paste0("s1_", chr, "_snpAnnot.txt"))
        file.remove(paste0("s2_", chr, "_snpAnnot.txt"))
        file.remove(paste0("s1_", chr, "_viSegInfo.txt"))
        file.remove(paste0("s2_", chr, "_viSegInfo.txt"))
      }
    }, silent = TRUE)

    cat <<-END_VERSIONS > versions.yml
    "BIOC_COMAPR_SINGLE_SPERM_CO_ANALYSIS":
        comapr: \$(Rscript -e 'cat(as.character(packageVersion("comapr")))')
    END_VERSIONS
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_single_sperm_co_analysis.csv versions.yml
    """
}

workflow BIOC_COMAPR_SINGLE_SPERM_CO_ANALYSIS_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ sample_barcodes.txt, sample_chr_vi.mtx, sample_chr_snpAnnot.txt, sample_chr_viSegInfo.txt ] ]

    main:
    BIOC_COMAPR_SINGLE_SPERM_CO_ANALYSIS(ch_input)

    emit:
    tables   = BIOC_COMAPR_SINGLE_SPERM_CO_ANALYSIS.out.tables
    plots    = BIOC_COMAPR_SINGLE_SPERM_CO_ANALYSIS.out.plots
    objects  = BIOC_COMAPR_SINGLE_SPERM_CO_ANALYSIS.out.objects
    versions = BIOC_COMAPR_SINGLE_SPERM_CO_ANALYSIS.out.versions
}
