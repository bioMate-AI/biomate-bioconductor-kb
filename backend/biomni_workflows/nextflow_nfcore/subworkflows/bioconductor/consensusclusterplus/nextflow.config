/*
 * BioMate — ConsensusClusterPlus Nextflow Configuration
 * Consensus clustering for molecular subtype discovery
 */

params {
    outdir          = './results/consensusclusterplus'
    expr_matrix_rds = null
    max_k           = 8
    n_reps          = 500
}

process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 16.GB
        time   = 4.h
    }
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

profiles {
    standard {
        process.executor = 'local'
    }

    // test profile — stub mode; no R required
    test {
        params.max_k  = 4
        params.n_reps = 10
        stubRun = true
        process {
            withLabel: 'process_medium' { cpus = 1; memory = 2.GB }
        }
    }

    docker {
        docker.enabled      = true
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
}

manifest {
    name            = 'biomate-consensusclusterplus'
    author          = 'BioMate AI'
    description     = 'ConsensusClusterPlus molecular subtype discovery'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.10.0'
    version         = '1.0.0'
}
