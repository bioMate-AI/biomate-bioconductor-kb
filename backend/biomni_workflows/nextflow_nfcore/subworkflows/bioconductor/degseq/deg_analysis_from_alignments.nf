#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: degseq — deg_analysis_from_alignments
// Identify differentially expressed genes directly from mapped read files (e.g., BED format) using a gene annotation file and the Likelihood Ratio Test (LRT).
// Input: kidneyChr21.bed.txt, liverChr21.bed.txt, refFlatChr21.txt
// Container: quay.io/biocontainers/bioconductor-degseq:1.64.0--r45ha27e39d_0
// R packages: DEGseq
// Bioconductor: 3.21 | R: 4.5
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

nextflow.enable.dsl = 2

process BIOC_DEGSEQ_DEG_ANALYSIS_FROM_ALIGNMENTS {
    tag "${meta.id}"
    label 'process_medium'

    container "quay.io/biocontainers/bioconductor-degseq:1.64.0--r45ha27e39d_0"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("DEGseq")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }

    # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
    for (.bm_d in list.files(".", full.names = TRUE)) {
      if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
        for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
          if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
        }
      }
    }
    
    # Load the required Bioconductor library
    library(DEGseq)
    
    # 1. Define paths to mapped read files and the refFlat annotation file
    # (Reading directly from the working directory as specified)
    kidneyR1L1 <- "kidneyChr21.bed.txt"
    liverR1L2  <- "liverChr21.bed.txt"
    refFlat    <- "refFlatChr21.txt"
    
    # Construct the batch vectors
    mapResultBatch1 <- c(kidneyR1L1)
    mapResultBatch2 <- c(liverR1L2)
    
    # Define the output directory for the DEGseq analysis
    outputDir <- "DEGseq_output"
    if (!dir.exists(outputDir)) {
      dir.create(outputDir, recursive = TRUE)
    }
    
    # 2. Run DEGseq to count reads mapped to each gene and perform differential expression analysis using the LRT method
    DEGseq(mapResultBatch1, mapResultBatch2, fileFormat="bed", refFlat=refFlat,
           outputDir=outputDir, method="LRT")
    
    # 3. Process and write named output files for the meaningful results
    # DEGseq writes output files (including a tab-delimited text file and HTML reports) to the outputDir.
    # We locate the generated expression and differential analysis text file, then export it as CSV and RDS.
    output_files <- list.files(outputDir, full.names = TRUE)
    for (file_path in output_files) {
      if (grepl("\\\\.txt\$", file_path)) {
        # Read the tab-delimited results file generated by DEGseq
        results_data <- read.delim(file_path, header = TRUE, stringsAsFactors = FALSE)
        
        # Define clean output names
        base_name <- tools::file_path_sans_ext(basename(file_path))
        csv_output <- paste0(base_name, "_results.csv")
        rds_output <- paste0(base_name, "_results.rds")
        
        # Save as CSV and RDS in the working directory
        write.csv(results_data, file = csv_output, row.names = FALSE)
        saveRDS(results_data, file = rds_output)
      }
    }

    cat <<-END_VERSIONS > versions.yml
    "BIOC_DEGSEQ_DEG_ANALYSIS_FROM_ALIGNMENTS":
        degseq: \$(Rscript -e 'cat(as.character(packageVersion("degseq")))')
    END_VERSIONS
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_deg_analysis_from_alignments.csv versions.yml
    """
}

workflow BIOC_DEGSEQ_DEG_ANALYSIS_FROM_ALIGNMENTS_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ kidneyChr21.bed.txt, liverChr21.bed.txt, refFlatChr21.txt ] ]

    main:
    BIOC_DEGSEQ_DEG_ANALYSIS_FROM_ALIGNMENTS(ch_input)

    emit:
    tables   = BIOC_DEGSEQ_DEG_ANALYSIS_FROM_ALIGNMENTS.out.tables
    plots    = BIOC_DEGSEQ_DEG_ANALYSIS_FROM_ALIGNMENTS.out.plots
    objects  = BIOC_DEGSEQ_DEG_ANALYSIS_FROM_ALIGNMENTS.out.objects
    versions = BIOC_DEGSEQ_DEG_ANALYSIS_FROM_ALIGNMENTS.out.versions
}
