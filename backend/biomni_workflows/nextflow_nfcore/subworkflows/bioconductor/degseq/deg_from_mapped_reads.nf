#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: DEGseq — deg_from_mapped_reads
// Identify differentially expressed genes starting from mapped read files (BED format) and a gene annotation file.
// Input: sample1.bed, sample2.bed, refFlat.txt
// Container: quay.io/biocontainers/bioconductor-degseq:1.64.0--r45ha27e39d_0
// Requires: DEGseq
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Visualization & Output] Define input file paths and output directory
//  * 2. [Core Analysis] Run DEGseq to count reads mapped to each gene and identify DEGs using the Likelihood Ratio Test (LRT)

nextflow.enable.dsl = 2

process BIOC_DEGSEQ_DEG_FROM_MAPPED_READS {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-transcriptomics:3.20"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_f in list.files(".", recursive = TRUE, full.names = TRUE)) {
          .bm_bn <- basename(.bm_f)
          if (!file.exists(.bm_bn)) try(file.copy(.bm_f, .bm_bn), silent = TRUE)
        }
    
    # Load required library
    library(DEGseq)
    
    # 1. Define input file paths and output directory
    kidneyR1L1 <- "sample1.bed"
    liverR1L2  <- "sample2.bed"
    refFlat    <- "refFlat.txt"
    outputDir  <- "DEGseq_output"
    
    # Verify input files exist before running
    if (!file.exists(kidneyR1L1)) {
      stop(paste("Required input file missing:", kidneyR1L1))
    }
    if (!file.exists(liverR1L2)) {
      stop(paste("Required input file missing:", liverR1L2))
    }
    if (!file.exists(refFlat)) {
      stop(paste("Required input file missing:", refFlat))
    }
    
    # Ensure output directory exists
    if (!dir.exists(outputDir)) {
      dir.create(outputDir, recursive = TRUE)
    }
    
    # 2. Run DEGseq to count reads mapped to each gene and identify DEGs using the Likelihood Ratio Test (LRT)
    mapResultBatch1 <- c(kidneyR1L1)
    mapResultBatch2 <- c(liverR1L2)
    
    DEGseq(mapResultBatch1, mapResultBatch2, fileFormat="bed", refFlat=refFlat,
           outputDir=outputDir, method="LRT")
    
    # 3. Write named output files for the meaningful results
    # DEGseq writes its results directly to the output directory.
    # We locate the generated output text file, read it, and save it as a structured CSV and RDS.
    tryCatch({
      output_files <- list.files(outputDir, full.names = TRUE)
      txt_files <- output_files[grep("\\\\.txt\$", output_files)]
      
      if (length(txt_files) > 0) {
        # Read the primary output text file generated by DEGseq
        results_df <- read.delim(txt_files[1], header = TRUE, sep = "\t")
        
        # Save as CSV and RDS in the working directory
        write.csv(results_df, file = "deg_results.csv", row.names = FALSE)
        saveRDS(results_df, file = "deg_results.rds")
      } else {
        warning("DEGseq completed, but no output text file was found in the output directory.")
      }
    }, error = function(e) {
      warning(paste("Post-processing of output files failed:", e\$message))
    })

    writeLines(c(
        '"BIOC_DEGSEQ_DEG_FROM_MAPPED_READS":',
        paste0('    DEGseq: ', as.character(packageVersion('DEGseq')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_deg_from_mapped_reads.csv versions.yml
    """
}

workflow BIOC_DEGSEQ_DEG_FROM_MAPPED_READS_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ sample1.bed, sample2.bed, refFlat.txt ] ]

    main:
    BIOC_DEGSEQ_DEG_FROM_MAPPED_READS(ch_input)

    emit:
    tables   = BIOC_DEGSEQ_DEG_FROM_MAPPED_READS.out.tables
    plots    = BIOC_DEGSEQ_DEG_FROM_MAPPED_READS.out.plots
    objects  = BIOC_DEGSEQ_DEG_FROM_MAPPED_READS.out.objects
    versions = BIOC_DEGSEQ_DEG_FROM_MAPPED_READS.out.versions
}
