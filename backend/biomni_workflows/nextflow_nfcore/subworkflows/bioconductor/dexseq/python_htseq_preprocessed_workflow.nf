#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: DEXSeq — python_htseq_preprocessed_workflow
// Perform differential exon usage analysis using pre-calculated count files and a flattened GFF file generated by DEXSeq's Python scripts.
// Input: treated1fb.txt, treated2fb.txt, treated3fb.txt, untreated1fb.txt, untreated2fb.txt, untreated3fb.txt, untreated4fb.txt, Dmel.BDGP5.25.62.DEXSeq.chr.gff
// Container: quay.io/biocontainers/bioconductor-dexseq:1.56.0--r45hdfd78af_0
// R packages: DEXSeq
// Bioconductor: 3.20 | R: 4.4
// Requires: DEXSeq
// Visualizations: MA plot
// QC: diagnostic MA/PCA QC
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Core Analysis] Locate count files and flattened GFF file
//  * 2. [Input & Preparation] Construct sample table
//  * 3. [Input & Preparation] Build DEXSeqDataSet using DEXSeqDataSetFromHTSeq
//  * 4. [Core Analysis] Run standard analysis workflow in one command using DEXSeq
//  * 5. [Core Analysis] Calculate gene-level FDR using perGeneQValue

nextflow.enable.dsl = 2

process BIOC_DEXSEQ_PYTHON_HTSEQ_PREPROCESSED_WORKFLOW {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-transcriptomics:3.20"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("DEXSeq")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_d in list.files(".", full.names = TRUE)) {
          if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
            for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
              if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
            }
          }
        }
        
        # Load required libraries
        library(DEXSeq)
        
        # Define input files in the current working directory as specified by the user
        countFiles <- c(
          "treated1fb.txt", 
          "treated2fb.txt", 
          "treated3fb.txt", 
          "untreated1fb.txt", 
          "untreated2fb.txt", 
          "untreated3fb.txt", 
          "untreated4fb.txt"
        )
        flattenedFile <- "Dmel.BDGP5.25.62.DEXSeq.chr.gff"
        
        # Verify that all required input files exist in the working directory
        for (f in c(countFiles, flattenedFile)) {
          if (!file.exists(f)) {
            stop(paste("Required input file missing from working directory:", f))
          }
        }
        
        # Construct the sample table exactly as documented
        sampleTable = data.frame(
           row.names = c( "treated1", "treated2", "treated3", 
              "untreated1", "untreated2", "untreated3", "untreated4" ),
           condition = c("knockdown", "knockdown", "knockdown",  
              "control", "control", "control", "control" ),
           libType = c( "single-end", "paired-end", "paired-end", 
              "single-end", "single-end", "paired-end", "paired-end" ) )
        
        # Build DEXSeqDataSet using DEXSeqDataSetFromHTSeq
        dxd = DEXSeqDataSetFromHTSeq(
           countFiles,
           sampleData=sampleTable,
           design= ~ sample + exon + condition:exon,
           flattenedfile=flattenedFile )
        
        # Run standard analysis workflow in one command using DEXSeq
        dxr = DEXSeq(dxd)
        
        # Calculate gene-level FDR using perGeneQValue
        gene_q = perGeneQValue(dxr)
        numbOfGenes = sum( gene_q < 0.1, na.rm = TRUE )
        
        # Write meaningful results to output files
        # 1. Save the main DEXSeqResults table as a CSV file
        dxr_df <- as.data.frame(dxr)
        for (col in names(dxr_df)) {
          if (is.list(dxr_df[[col]])) {
            dxr_df[[col]] <- sapply(dxr_df[[col]], paste, collapse = ",")
          } else if (is.matrix(dxr_df[[col]])) {
            dxr_df[[col]] <- apply(dxr_df[[col]], 1, paste, collapse = ",")
          }
        }
        write.csv(dxr_df, file = "dexseq_results.csv", row.names = TRUE)
        
        # 2. Save the gene-level Q-values as a CSV file
        write.csv(data.frame(geneID = names(gene_q), q_value = gene_q), file = "gene_level_qvalues.csv", row.names = FALSE)
        
        # 3. Save the R objects as RDS files for downstream analysis
        saveRDS(dxd, file = "dexseq_dxd.rds")
        saveRDS(dxr, file = "dexseq_dxr.rds")
        
        # 4. Generate diagnostic and results plots in a PDF file
        pdf("dexseq_plots.pdf", width = 10, height = 7)
        
        # Plot MA
        tryCatch({
          plotMA(dxr, cex=0.8)
        }, error = function(e) {
          message("Could not generate MA plot: ", e\$message)
        })
        
        # Plot DEXSeq for the most significant gene (or the first gene if none are significant)
        tryCatch({
          sig_genes <- names(gene_q)[gene_q < 0.1 & !is.na(gene_q)]
          if (length(sig_genes) > 0) {
            plot_gene <- sig_genes[1]
          } else {
            plot_gene <- unique(dxr\$groupID)[1]
          }
          
          if (!is.na(plot_gene)) {
            plotDEXSeq(dxr, plot_gene, legend=TRUE, cex.axis=1.2, cex=1.3, lwd=2)
            plotDEXSeq(dxr, plot_gene, displayTranscripts=TRUE, legend=TRUE, cex.axis=1.2, cex=1.3, lwd=2)
            plotDEXSeq(dxr, plot_gene, expression=FALSE, norCounts=TRUE, legend=TRUE, cex.axis=1.2, cex=1.3, lwd=2)
            plotDEXSeq(dxr, plot_gene, expression=FALSE, splicing=TRUE, legend=TRUE, cex.axis=1.2, cex=1.3, lwd=2)
          }
        }, error = function(e) {
          message("Could not generate gene-level plots: ", e\$message)
        })
        
        dev.off()
        
        # Print summary message
        message("DEXSeq pipeline completed successfully.")
        message("Number of genes with significant DEU (FDR < 0.1): ", numbOfGenes)

    writeLines(c(
        '"BIOC_DEXSEQ_PYTHON_HTSEQ_PREPROCESSED_WORKFLOW":',
        paste0('    DEXSeq: ', as.character(packageVersion('DEXSeq')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_python_htseq_preprocessed_workflow.csv versions.yml
    """
}

workflow BIOC_DEXSEQ_PYTHON_HTSEQ_PREPROCESSED_WORKFLOW_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ treated1fb.txt, treated2fb.txt, treated3fb.txt, untreated1fb.txt, untreated2fb.txt, untreated3fb.txt, untreated4fb.txt, Dmel.BDGP5.25.62.DEXSeq.chr.gff ] ]

    main:
    BIOC_DEXSEQ_PYTHON_HTSEQ_PREPROCESSED_WORKFLOW(ch_input)

    emit:
    tables   = BIOC_DEXSEQ_PYTHON_HTSEQ_PREPROCESSED_WORKFLOW.out.tables
    plots    = BIOC_DEXSEQ_PYTHON_HTSEQ_PREPROCESSED_WORKFLOW.out.plots
    objects  = BIOC_DEXSEQ_PYTHON_HTSEQ_PREPROCESSED_WORKFLOW.out.objects
    versions = BIOC_DEXSEQ_PYTHON_HTSEQ_PREPROCESSED_WORKFLOW.out.versions
}
