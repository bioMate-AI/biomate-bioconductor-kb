params {
    outdir           = './results/faers'
    publish_dir_mode = 'copy'

    // Pharmacovigilance query (user-overridable; defaults reproduce the 2004-Q1 insulin demo)
    faers_year     = 2004      // FAERS reporting year
    faers_quarter  = 'q1'      // FAERS reporting quarter: q1 | q2 | q3 | q4
    drug_substance = 'insulin' // Drug / active-substance to detect safety signals for
}

profiles {

    standard {
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled      = true
        singularity.enabled = false
        process.executor    = 'local'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    aws {
        docker.enabled = true
        process {
            executor = 'awsbatch'
            queue    = 'biomate-nextflow-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
    }
}
