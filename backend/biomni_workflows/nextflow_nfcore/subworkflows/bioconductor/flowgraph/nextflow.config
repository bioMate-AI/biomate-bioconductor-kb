params {
    outdir           = './results/flowgraph'
    publish_dir_mode = 'copy'
}

profiles {

    standard {
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled      = true
        singularity.enabled = false
        process.executor    = 'local'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    aws {
        docker.enabled = true
        process {
            executor = 'awsbatch'
            queue    = 'biomate-nextflow-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/usr/local/bin/aws'
        }
    }
}
