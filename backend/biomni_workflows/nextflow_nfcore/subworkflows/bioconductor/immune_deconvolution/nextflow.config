/*
 * BioMate — Immune Deconvolution Nextflow Configuration
 * Sprint 2: bulk RNA-seq → immune cell fraction estimation
 *
 * Processes:  BIOC_DECONRNASEQ | IMMUNEDECONV_SUMMARY
 * Entry WF:   IMMUNE_DECONVOLUTION
 */

// ── Default parameters ──────────────────────────────────────
params {
    outdir            = './results/immune_deconvolution'
    publish_dir_mode  = 'copy'

    // Mock mode (set false to supply real count/signature matrices)
    mock_mode         = true

    // Real inputs
    counts_matrix     = null
    signature_matrix  = null
    clinical_metadata = null

    // Deconvolution settings
    method            = 'DeconRNASeq'
    scale_counts      = true
    checksig          = false

    // Container
    container         = 'quay.io/biocontainers/bioconductor-deconrnaseq:1.46.0--r44_0'
}

// ── Process defaults ─────────────────────────────────────────
process {
    container = params.container

    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 8.GB
        time   = 4.h
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = 16.GB
        time   = 8.h
    }

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

// ── Profiles ─────────────────────────────────────────────────
profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled     = false
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }

    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
    }

    test {
        params.mock_mode = true
        stubRun = true
        process {
            withLabel: 'process_low'    { cpus = 1; memory = 2.GB }
            withLabel: 'process_medium' { cpus = 1; memory = 2.GB }
            withLabel: 'process_high'   { cpus = 2; memory = 4.GB }
        }
    }

    aws {
        process.executor        = 'awsbatch'
        aws.region              = 'us-east-1'
        aws.batch.cliPath       = '/opt/aws-cli/bin/aws'
    }

    slurm {
        process.executor        = 'slurm'
        process.queue           = 'normal'
    }
}

// ── Execution reports ─────────────────────────────────────────
timeline {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

// ── Manifest ──────────────────────────────────────────────────
manifest {
    name            = 'biomate-immune-deconvolution'
    author          = 'BioMate AI'
    description     = 'Immune deconvolution of bulk RNA-seq using DeconRNASeq (Sprint 2)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.10.0'
    version         = '1.0.0'
}
