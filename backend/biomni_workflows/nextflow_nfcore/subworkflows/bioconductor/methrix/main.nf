#!/usr/bin/env nextflow
// ============================================================
// Bioconductor module: methrix
// Bedgraph files generated by Bisulfite pipelines often come in various flavors. Critical downstream s
//
// Source : https://bioconductor.org/packages/3.20/bioc/vignettes/methrix/inst/doc/methrix.R
// Upstream  : GenomicScores, bsseq
// Downstream: none
//
// Install: BiocManager::install("methrix")
// ============================================================

nextflow.enable.dsl = 2

process BIOC_METHRIX {
    tag "${meta.id}"
    label 'process_medium'

    conda "bioconductor-methrix"
    container "${workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
        'https://depot.galaxyproject.org/singularity/bioconductor-methrix:1.20.0--r44_0' :
        'quay.io/biocontainers/bioconductor-methrix:1.20.0--r44_0'}"

    input:
    tuple val(meta), path(count_data)

    output:
    tuple val(meta), path("${meta.id}_methrix_results.csv"),  emit: results
    tuple val(meta), path("${meta.id}_methrix_output.rds"),   emit: rds
    tuple val(meta), path("${meta.id}_methrix_plots.pdf"),    emit: plots, optional: true
    path "versions.yml",                                            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def args   = task.ext.args   ?: ''
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    library(methrix)
    library(GRanges)
    library(jsonlite)

    # --- Quality Control and Filtering [] ---
    # Key functions: remove_uncovered, remove_snps, coverage_filter
    meth_filtered <- methrix::remove_uncovered(m = meth)
    meth_snps_filtered <- methrix::remove_snps(m = meth_filtered)
    meth_cov_filtered <- methrix::coverage_filter(
        m = meth_snps_filtered,
        cov_thr = 3,
        min_samples = 2
    )


    # --- Subsetting and Matrix Extraction [] ---
    # Key functions: subset_methrix, get_matrix
    meth_sub <- methrix::subset_methrix(
        m = methrix_data,
        contigs = "chr21"
    )
    meth_mat <- methrix::get_matrix(
        m = meth_sub,
        type = "M",
        add_loci = TRUE,
        in_granges = TRUE
    )


    # --- Statistical Summary and Visualization [] ---
    # Key functions: get_stats, plot_stats, plot_violin, plot_coverage
    meth_stats <- methrix::get_stats(m = methrix_data)
    methrix::plot_stats(plot_dat = meth_stats, what = "C", stat = "mean")
    methrix::plot_violin(m = methrix_data)
    methrix::plot_coverage(m = methrix_data, type = "dens")


    # --- Dimensionality Reduction and Conversion [] ---
    # Key functions: methrix_pca, plot_pca, methrix2bsseq
    mpca <- methrix::methrix_pca(m = methrix_data, do_plot = FALSE)
    methrix::plot_pca(
        pca_res = mpca,
        m = methrix_data,
        col_anno = "Condition"
    )
    bs_seq <- methrix::methrix2bsseq(m = methrix_data)

    # --- Save outputs ---
    if (exists("results_df") && is.data.frame(results_df)) {
        write.csv(results_df, "${prefix}_methrix_results.csv", row.names = TRUE)
    } else {
        write.csv(data.frame(status = "completed"), "${prefix}_methrix_results.csv")
    }
    if (exists("result_obj")) {
        saveRDS(result_obj, "${prefix}_methrix_output.rds")
    }

    # --- versions.yml ---
    writeLines(
        c("BIOC_METHRIX:", paste0("    methrix: ", packageVersion("methrix"))),
        "versions.yml"
    )
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_methrix_results.csv
    touch ${prefix}_methrix_output.rds
    echo "BIOC_METHRIX:" > versions.yml
    echo "    methrix: 0.0.0" >> versions.yml
    """
}


workflow BIOC_METHRIX_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), path(count_data) ]

    main:
    BIOC_METHRIX(ch_input)

    emit:
    results  = BIOC_METHRIX.out.results   // channel: [ val(meta), path(csv) ]
    rds      = BIOC_METHRIX.out.rds       // channel: [ val(meta), path(rds) ]
    plots    = BIOC_METHRIX.out.plots     // channel: [ val(meta), path(pdf) ] (optional)
    versions = BIOC_METHRIX.out.versions  // channel: path(versions.yml)
}
