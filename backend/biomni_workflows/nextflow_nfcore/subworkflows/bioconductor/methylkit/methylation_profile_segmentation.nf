#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: methylKit — methylation_profile_segmentation
// Segment methylation or differential methylation profiles into regions of similar methylation levels.
// Input: mbw
// Container: quay.io/biocontainers/bioconductor-methylkit:1.36.0--r45ha27e39d_0
// R packages: methylKit
// Bioconductor: 3.20 | R: 4.4
// Requires: methylKit
// Visualizations: plot (ggplot/base)
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Core Analysis] Segment the methylation profiles
//  * 2. [Visualization & Output] Export the segmented regions to a BED file

nextflow.enable.dsl = 2

process BIOC_METHYLKIT_METHYLATION_PROFILE_SEGMENTATION {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-genomics:3.20-slim"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("methylKit")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_d in list.files(".", full.names = TRUE)) {
          if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
            for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
              if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
            }
          }
        }
        
        # Load required libraries
        library(methylKit)
        
        # 1. Read the user input file from the working directory
        # The input 'mbw' is expected to be an RDS file containing a methylBase, methylDiff, or GRanges object.
        input_file <- "mbw"
        if (!file.exists(input_file)) {
          if (file.exists("mbw.rds")) {
            input_file <- "mbw.rds"
          } else {
            stop("Error: Input file 'mbw' or 'mbw.rds' not found in the working directory.")
          }
        }
        
        message("Reading input methylation data from: ", input_file)
        mbw <- readRDS(input_file)
        
        # 2. Segment the methylation profiles
        # We open a PDF device to capture the diagnostic plot generated by methSeg
        pdf_filename <- "diagnostic_plot.pdf"
        message("Performing methylation profile segmentation and saving diagnostic plot to: ", pdf_filename)
        pdf(pdf_filename)
        
        res = methSeg(mbw, diagnostic.plot = TRUE, maxInt = 100, minSeg = 10)
        
        dev.off()
        
        # 3. Export the segmented regions to a BED file
        output_bed <- "segmented_regions.bed"
        message("Exporting segmented regions to BED file: ", output_bed)
        methSeg2bed(res, filename = output_bed)
        
        # 4. Save the segmentation result object as an RDS file for downstream analysis
        output_rds <- "segmentation_result.rds"
        message("Saving segmentation result object to: ", output_rds)
        saveRDS(res, file = output_rds)
        
        message("Pipeline completed successfully.")

    writeLines(c(
        '"BIOC_METHYLKIT_METHYLATION_PROFILE_SEGMENTATION":',
        paste0('    methylKit: ', as.character(packageVersion('methylKit')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_methylation_profile_segmentation.csv versions.yml
    """
}

workflow BIOC_METHYLKIT_METHYLATION_PROFILE_SEGMENTATION_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ mbw ] ]

    main:
    BIOC_METHYLKIT_METHYLATION_PROFILE_SEGMENTATION(ch_input)

    emit:
    tables   = BIOC_METHYLKIT_METHYLATION_PROFILE_SEGMENTATION.out.tables
    plots    = BIOC_METHYLKIT_METHYLATION_PROFILE_SEGMENTATION.out.plots
    objects  = BIOC_METHYLKIT_METHYLATION_PROFILE_SEGMENTATION.out.objects
    versions = BIOC_METHYLKIT_METHYLATION_PROFILE_SEGMENTATION.out.versions
}
