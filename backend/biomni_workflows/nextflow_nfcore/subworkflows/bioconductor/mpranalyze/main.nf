#!/usr/bin/env nextflow
// ============================================================
// Bioconductor module: MPRAnalyze
// MPRAnalyze provides statistical framework for the analysis of data generated by Massively Parallel R
//
// Source : https://bioconductor.org/packages/3.20/bioc/vignettes/MPRAnalyze/inst/doc/vignette.R
// Upstream  : none
// Downstream: none
//
// Install: BiocManager::install("MPRAnalyze")
// ============================================================

nextflow.enable.dsl = 2

process BIOC_MPRANALYZE {
    tag "${meta.id}"
    label 'process_medium'

    conda "bioconductor-mpranalyze"
    container "${workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
        'https://depot.galaxyproject.org/singularity/bioconductor-mpranalyze:1.24.0--r44_0' :
        'quay.io/biocontainers/bioconductor-mpranalyze:1.24.0--r44_0'}"

    input:
    tuple val(meta), path(count_data)

    output:
    tuple val(meta), path("${meta.id}_mpranalyze_results.csv"),  emit: results
    tuple val(meta), path("${meta.id}_mpranalyze_output.rds"),   emit: rds
    tuple val(meta), path("${meta.id}_mpranalyze_plots.pdf"),    emit: plots, optional: true
    path "versions.yml",                                            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def args   = task.ext.args   ?: ''
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    library(MPRAnalyze)
    library(MpraObject)
    library(jsonlite)

    # --- Depth Factor Estimation [] ---
    # Key functions: estimateDepthFactors
    obj <- estimateDepthFactors(
        obj = obj,
        lib.factor = c("batch", "condition"),
        which.lib = "both",
        depth.estimator = "uq"
    )


    # --- Quantification Analysis [] ---
    # Key functions: analyzeQuantification, getAlpha
    obj <- analyzeQuantification(
        obj = obj,
        dnaDesign = ~ batch + condition,
        rnaDesign = ~ condition
    )
    alpha <- getAlpha(
        obj = obj,
        by.factor = "condition"
    )


    # --- Empirical Testing [] ---
    # Key functions: testEmpirical
    res.epi <- testEmpirical(
        obj = obj,
        statistic = alpha$MT
    )
    res.chr <- testEmpirical(
        obj = obj,
        statistic = alpha$WT
    )


    # --- Comparative Analysis [] ---
    # Key functions: analyzeComparative, testLrt
    obj <- analyzeComparative(
        obj = obj,
        dnaDesign = ~ barcode + batch + condition,
        rnaDesign = ~ condition,
        reducedDesign = ~ 1
    )
    res <- testLrt(obj = obj)

    # --- Save outputs ---
    if (exists("results_df") && is.data.frame(results_df)) {
        write.csv(results_df, "${prefix}_mpranalyze_results.csv", row.names = TRUE)
    } else {
        write.csv(data.frame(status = "completed"), "${prefix}_mpranalyze_results.csv")
    }
    if (exists("result_obj")) {
        saveRDS(result_obj, "${prefix}_mpranalyze_output.rds")
    }

    # --- versions.yml ---
    writeLines(
        c("BIOC_MPRANALYZE:", paste0("    mpranalyze: ", packageVersion("MPRAnalyze"))),
        "versions.yml"
    )
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_mpranalyze_results.csv
    touch ${prefix}_mpranalyze_output.rds
    echo "BIOC_MPRANALYZE:" > versions.yml
    echo "    mpranalyze: 0.0.0" >> versions.yml
    """
}


workflow BIOC_MPRANALYZE_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), path(count_data) ]

    main:
    BIOC_MPRANALYZE(ch_input)

    emit:
    results  = BIOC_MPRANALYZE.out.results   // channel: [ val(meta), path(csv) ]
    rds      = BIOC_MPRANALYZE.out.rds       // channel: [ val(meta), path(rds) ]
    plots    = BIOC_MPRANALYZE.out.plots     // channel: [ val(meta), path(pdf) ] (optional)
    versions = BIOC_MPRANALYZE.out.versions  // channel: path(versions.yml)
}
