#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: plgem — step_by_step_mode
// Run the PLGEM pipeline step-by-step to gain advanced control over model fitting, signal-to-noise ratio calculation, resampling, p-value computation, and DEG sel
// Input: ExpressionSet object
// Container: quay.io/biocontainers/bioconductor-plgem:1.82.0--r45hdfd78af_0
// R packages: Biobase, plgem
// Bioconductor: 3.20 | R: 4.4
// Requires: Biobase, plgem
// Visualizations: plot (ggplot/base)
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Core Analysis] Fit the PLGEM model using plgem.fit
//  * 2. [Core Analysis] Compute observed signal-to-noise ratios using plgem.obsStn
//  * 3. [Core Analysis] Compute resampled signal-to-noise ratios under the null hypothesis using plgem.resampledStn
//  * 4. [Core Analysis] Calculate empirical p-values using plgem.pValue
//  * 5. [Core Analysis] Select differentially expressed genes or proteins using plgem.deg

nextflow.enable.dsl = 2

process BIOC_PLGEM_STEP_BY_STEP_MODE {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-transcriptomics:3.20"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("Biobase", "plgem")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_d in list.files(".", full.names = TRUE)) {
          if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
            for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
              if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
            }
          }
        }
    
    # Load required libraries
    library(plgem)
    library(Biobase)
    
    # ------------------------------------------------------------------------------
    # 1. Read User Input
    # ------------------------------------------------------------------------------
    # The pipeline expects an ExpressionSet object saved as an RDS file in the
    # working directory. The ExpressionSet must contain a covariate at index 1
    # with at least one condition having multiple replicates (used for model fitting) and a baseline.
    input_file <- "ExpressionSet.rds"
    
    if (!file.exists(input_file)) {
      stop(paste("Error: Input file", input_file, "not found in the working directory."))
    }
    
    LPSeset <- readRDS(input_file)
    
    if (!is(LPSeset, "ExpressionSet")) {
      stop("Error: The input file does not contain a valid ExpressionSet object.")
    }
    
    # ------------------------------------------------------------------------------
    # 2. Fit the PLGEM model
    # ------------------------------------------------------------------------------
    # We open a PDF device to capture the diagnostic plots generated by plgem.fit
    pdf("plgem_fit_diagnostics.pdf", width = 8, height = 8)
    
    # Determine the most replicated condition to use for fitting
    conditions <- pData(LPSeset)[[1]]
    fit_cond <- names(sort(table(conditions), decreasing = TRUE))[1]
    
    LPSfit <- plgem.fit(data=LPSeset, covariate=1, fitCondition=fit_cond, p=10, q=0.5,
      plot.file=FALSE, fittingEval=TRUE, verbose=TRUE)
    
    dev.off()
    
    # Save the fitted model object
    saveRDS(LPSfit, "plgem_fit.rds")
    
    # ------------------------------------------------------------------------------
    # 3. Compute observed signal-to-noise ratios
    # ------------------------------------------------------------------------------
    LPSobsStn <- plgem.obsStn(data=LPSeset, covariate=1, baselineCondition=1,
      plgemFit=LPSfit, verbose=TRUE)
    
    # Save the observed STN values
    saveRDS(LPSobsStn, "plgem_observed_stn.rds")
    write.csv(as.data.frame(LPSobsStn), "plgem_observed_stn.csv", row.names=TRUE)
    
    # ------------------------------------------------------------------------------
    # 4. Compute resampled signal-to-noise ratios under the null hypothesis
    # ------------------------------------------------------------------------------
    set.seed(123)
    LPSresampledStn <- plgem.resampledStn(data=LPSeset, plgemFit=LPSfit,
      iterations="automatic", verbose=TRUE)
    
    # Save the resampled STN values
    saveRDS(LPSresampledStn, "plgem_resampled_stn.rds")
    
    # ------------------------------------------------------------------------------
    # 5. Calculate empirical p-values
    # ------------------------------------------------------------------------------
    LPSpValues <- plgem.pValue(observedStn=LPSobsStn,
      plgemResampledStn=LPSresampledStn, verbose=TRUE)
    
    # Save the p-values
    saveRDS(LPSpValues, "plgem_pvalues.rds")
    write.csv(as.data.frame(LPSpValues), "plgem_pvalues.csv", row.names=TRUE)
    
    # ------------------------------------------------------------------------------
    # 6. Select differentially expressed genes or proteins (DEG)
    # ------------------------------------------------------------------------------
    LPSdegList <- plgem.deg(observedStn=LPSobsStn, plgemPval=LPSpValues,
      delta=0.001, verbose=TRUE)
    
    # Save the final DEG list object
    saveRDS(LPSdegList, "plgem_deg_list.rds")
    
    # Write summary of results using the package's built-in utility
    tryCatch({
      plgem.write.summary(LPSdegList, prefix="plgem_results", verbose=TRUE)
    }, error = function(e) {
      warning("plgem.write.summary failed, writing significant genes manually. Error: ", e\$message)
    })
    
    # Also manually extract and write the significant genes to ensure robust output
    if (!is.null(LPSdegList\$significant)) {
      for (delta_val in names(LPSdegList\$significant)) {
        for (comparison in names(LPSdegList\$significant[[delta_val]])) {
          sig_genes <- LPSdegList\$significant[[delta_val]][[comparison]]
          output_name <- paste0("significant_genes_delta_", delta_val, "_", comparison, ".csv")
          write.csv(data.frame(GeneID = names(sig_genes), STN = sig_genes), 
                    file = output_name, row.names = FALSE)
        }
      }
    }

    writeLines(c(
        '"BIOC_PLGEM_STEP_BY_STEP_MODE":',
        paste0('    plgem: ', as.character(packageVersion('plgem')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_step_by_step_mode.csv versions.yml
    """
}

workflow BIOC_PLGEM_STEP_BY_STEP_MODE_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ ExpressionSet object ] ]

    main:
    BIOC_PLGEM_STEP_BY_STEP_MODE(ch_input)

    emit:
    tables   = BIOC_PLGEM_STEP_BY_STEP_MODE.out.tables
    plots    = BIOC_PLGEM_STEP_BY_STEP_MODE.out.plots
    objects  = BIOC_PLGEM_STEP_BY_STEP_MODE.out.objects
    versions = BIOC_PLGEM_STEP_BY_STEP_MODE.out.versions
}
