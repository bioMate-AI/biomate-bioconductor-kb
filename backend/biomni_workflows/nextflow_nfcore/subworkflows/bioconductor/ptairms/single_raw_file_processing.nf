#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: ptairMS — single_raw_file_processing
// Read and inspect a single raw PTR-TOF-MS HDF5 file.
// Input: file.h5
// Container: quay.io/biocontainers/bioconductor-ptairms:1.18.0--r45ha27e39d_0
// Requires: ptairMS
// Visualizations: plot (ggplot/base)
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Input & Preparation] Read the raw file using readRaw
//  * 2. [Core Analysis] Perform calibration, time limit detection, or peak detection on the single raw object

nextflow.enable.dsl = 2

process BIOC_PTAIRMS_SINGLE_RAW_FILE_PROCESSING {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-transcriptomics:3.20"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("ptairMS")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      if (!requireNamespace("BiocManager", quietly=TRUE)) install.packages("BiocManager", repos="https://cloud.r-project.org")
      bin <- tryCatch(sprintf("https://bioconductor.org/packages/%s/container-binaries/bioconductor_docker", BiocManager::version()), error=function(e) NULL)
      suppressMessages(tryCatch(BiocManager::install(.bm_miss, update=FALSE, ask=FALSE, site_repository=bin), error=function(e) BiocManager::install(.bm_miss, update=FALSE, ask=FALSE)))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_f in list.files(".", recursive = TRUE, full.names = TRUE)) {
          .bm_bn <- basename(.bm_f)
          if (!file.exists(.bm_bn)) try(file.copy(.bm_f, .bm_bn), silent = TRUE)
        }
    
    # Load required libraries
    library(ptairMS)
    
    # Define input file
    samplePath <- "file.h5"
    
    # Check if file exists
    if (!file.exists(samplePath)) {
      stop("Input file 'file.h5' not found in the working directory.")
    }
    
    # 1. Read the raw file using readRaw (exactly as documented)
    sampleRaw <- readRaw(samplePath, calib = FALSE)
    
    # Print raw object details to console
    print(sampleRaw)
    
    # 2. Perform calibration on the single raw object
    # Using standard reference masses present in typical PTR-TOF-MS data
    calibratedRaw <- calibration(sampleRaw, mzCalibRef = c(21.022, 60.0525))
    
    # 3. Determine time limits (expiration/headspace limits)
    # Wrap in a PDF device to capture the diagnostic plot generated by timeLimits
    pdf("time_limits_plot.pdf")
    expirationLimit <- timeLimits(sampleRaw, fracMaxTIC = 0.5, plotDel = TRUE, mzBreathTracer = NULL)
    dev.off()
    
    # 4. Write named output files for the meaningful results
    saveRDS(sampleRaw, "sampleRaw.rds")
    saveRDS(calibratedRaw, "calibratedRaw.rds")
    saveRDS(expirationLimit, "expiration_limits.rds")
    
    # Export expiration limits as a CSV table
    if (!is.null(expirationLimit)) {
      limits_df <- as.data.frame(t(unlist(expirationLimit)))
      write.csv(limits_df, "expiration_limits.csv", row.names = FALSE)
    }

    writeLines(c(
        '"BIOC_PTAIRMS_SINGLE_RAW_FILE_PROCESSING":',
        paste0('    ptairMS: ', as.character(packageVersion('ptairMS')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_single_raw_file_processing.csv versions.yml
    """
}

workflow BIOC_PTAIRMS_SINGLE_RAW_FILE_PROCESSING_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ file.h5 ] ]

    main:
    BIOC_PTAIRMS_SINGLE_RAW_FILE_PROCESSING(ch_input)

    emit:
    tables   = BIOC_PTAIRMS_SINGLE_RAW_FILE_PROCESSING.out.tables
    plots    = BIOC_PTAIRMS_SINGLE_RAW_FILE_PROCESSING.out.plots
    objects  = BIOC_PTAIRMS_SINGLE_RAW_FILE_PROCESSING.out.objects
    versions = BIOC_PTAIRMS_SINGLE_RAW_FILE_PROCESSING.out.versions
}
