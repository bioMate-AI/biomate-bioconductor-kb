#!/usr/bin/env nextflow
// ============================================================
// Bioconductor module: R453Plus1Toolbox
// The R453Plus1 Toolbox comprises useful functions for the analysis of data generated by Roche's 454 s
//
// Source : https://bioconductor.org/packages/3.20/bioc/vignettes/R453Plus1Toolbox/inst/doc/vignette.R
// Upstream  : Rsamtools, ShortRead, rtracklayer
// Downstream: none
//
// Install: BiocManager::install("R453Plus1Toolbox")
// ============================================================

nextflow.enable.dsl = 2

process BIOC_R453PLUS1TOOLBOX {
    tag "${meta.id}"
    label 'process_medium'

    conda "bioconductor-r453plus1toolbox"
    container "${workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
        'https://depot.galaxyproject.org/singularity/bioconductor-r453plus1toolbox:1.56.0--r44_0' :
        'quay.io/biocontainers/bioconductor-r453plus1toolbox:1.56.0--r44_0'}"

    input:
    tuple val(meta), path(count_data)

    output:
    tuple val(meta), path("${meta.id}_r453plus1toolbox_results.csv"),  emit: results
    tuple val(meta), path("${meta.id}_r453plus1toolbox_output.rds"),   emit: rds
    tuple val(meta), path("${meta.id}_r453plus1toolbox_plots.pdf"),    emit: plots, optional: true
    path "versions.yml",                                            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def args   = task.ext.args   ?: ''
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    library(AVASet)
    library(MapperSet)
    library(ScanBamParam)
    library(jsonlite)

    # --- Data import and loading [] ---
    # Key functions: data, ScanBamParam, scanBamWhat, scanBam
    library("Rsamtools")
    bamFile = system.file("extdata", "SVDetection", "bam", "N01.bam",
     package="R453Plus1Toolbox")
    parameters = ScanBamParam(what=scanBamWhat())
    bam = scanBam(bamFile, param=parameters)
    # --- Quality control and filtering [] ---
    # Key functions: ucsc, split, ranges, seqnames
    library("rtracklayer")
    bedFile = system.file("extdata", "SVDetection", "chip",
     "CaptureArray_hg19.bed", package="R453Plus1Toolbox")
    chip = import.ucsc(bedFile, subformat="bed")
    chip = split(ranges(chip[[1]]), seqnames(chip[[1]]))
    # --- AVASet analysis [] ---
    # Key functions: AVASet, assayData, fData, assayDataAmp, referenceSequences, sread, subset, setVariantFilter
    ## projectDir = system.file("extdata", "AVASet_doAmplicon", package="R453Plus1Toolbox")
    ## avaSetExample = AVASet(dirname=projectDir, file_sample="sample.csv",
    ##  file_amp="amp.csv", file_reference="reference.csv", file_variant="variant.csv",
    ##  file_variantHits="variantHits.csv")

    # --- Save outputs ---
    if (exists("results_df") && is.data.frame(results_df)) {
        write.csv(results_df, "${prefix}_r453plus1toolbox_results.csv", row.names = TRUE)
    } else {
        write.csv(data.frame(status = "completed"), "${prefix}_r453plus1toolbox_results.csv")
    }
    if (exists("result_obj")) {
        saveRDS(result_obj, "${prefix}_r453plus1toolbox_output.rds")
    }

    # --- versions.yml ---
    writeLines(
        c("BIOC_R453PLUS1TOOLBOX:", paste0("    r453plus1toolbox: ", packageVersion("R453Plus1Toolbox"))),
        "versions.yml"
    )
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_r453plus1toolbox_results.csv
    touch ${prefix}_r453plus1toolbox_output.rds
    echo "BIOC_R453PLUS1TOOLBOX:" > versions.yml
    echo "    r453plus1toolbox: 0.0.0" >> versions.yml
    """
}


workflow BIOC_R453PLUS1TOOLBOX_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), path(count_data) ]

    main:
    BIOC_R453PLUS1TOOLBOX(ch_input)

    emit:
    results  = BIOC_R453PLUS1TOOLBOX.out.results   // channel: [ val(meta), path(csv) ]
    rds      = BIOC_R453PLUS1TOOLBOX.out.rds       // channel: [ val(meta), path(rds) ]
    plots    = BIOC_R453PLUS1TOOLBOX.out.plots     // channel: [ val(meta), path(pdf) ] (optional)
    versions = BIOC_R453PLUS1TOOLBOX.out.versions  // channel: path(versions.yml)
}
