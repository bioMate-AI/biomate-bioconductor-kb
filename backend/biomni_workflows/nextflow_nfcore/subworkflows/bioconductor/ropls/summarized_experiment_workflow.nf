#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: ropls — summarized_experiment_workflow
// Perform PLS-DA or OPLS-DA directly on a SummarizedExperiment object and extract results.
// Input: SummarizedExperiment object
// Container: quay.io/biocontainers/bioconductor-ropls:1.42.0--r45hdfd78af_0
// R packages: SummarizedExperiment, ropls
// Bioconductor: 3.20 | R: 4.4
// Requires: SummarizedExperiment, ropls
// Visualizations: plot (ggplot/base)
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Visualization & Output] Run PLS-DA using opls on the SummarizedExperiment
//  * 2. [Core Analysis] Extract the updated object with scores and loadings
//  * 3. [Visualization & Output] Extract and plot the model scores

nextflow.enable.dsl = 2

process BIOC_ROPLS_SUMMARIZED_EXPERIMENT_WORKFLOW {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-general:3.20"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("SummarizedExperiment", "ropls")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_d in list.files(".", full.names = TRUE)) {
          if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
            for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
              if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
            }
          }
        }
        
        # Load required libraries
        library(ropls)
        
        library(SummarizedExperiment)
        # 1. Read the user input SummarizedExperiment object
        # The pipeline expects 'summarized_experiment.rds' in the working directory.
        # This object must contain assay data and colData metadata.
        input_file <- "summarized_experiment.rds"
        if (!file.exists(input_file)) {
          stop(paste("Input file", input_file, "not found in the working directory."))
        }
        
        sac.se <- readRDS(input_file)
        
        # Determine response variable from command line arguments, or default to the first colData column
        args <- commandArgs(trailingOnly = TRUE)
        if (length(args) > 0) {
          response_var <- args[1]
        } else {
          response_var <- colnames(SummarizedExperiment::colData(sac.se))[1]
        }
        
        # 2. Run PLS-DA using opls on the SummarizedExperiment
        sac.se <- opls(sac.se, response_var)
        
        # 3. Extract and display updated colData and rowData
        col_data_head <- head(SummarizedExperiment::colData(sac.se))
        row_data_head <- head(SummarizedExperiment::rowData(sac.se))
        
        print("Updated colData head:")
        print(col_data_head)
        print("Updated rowData head:")
        print(row_data_head)
        
        # 4. Extract the updated object with scores and loadings
        sac_opls.ls <- getOpls(sac.se)
        
        # Dynamically get the model name generated by ropls
        model_name <- names(sac_opls.ls)[1]
        
        # 5. Extract and plot the model scores
        # Save the static x-score plot to a PDF file
        pdf("opls_xscore_plot.pdf", width = 7, height = 7)
        plot(sac_opls.ls[[model_name]], typeVc = "x-score")
        dev.off()
        
        # Call plot_score as documented (returns a plotly object)
        p_score <- plot_score(sac.se, model.c = model_name, plotly.l = TRUE, info.vc = "all")
        
        # Save the plotly object as an RDS file for interactive viewing later
        saveRDS(p_score, "plot_score_interactive.rds")
        
        # Save meaningful results to files
        write.csv(as.data.frame(SummarizedExperiment::colData(sac.se)), "colData_updated.csv", row.names = TRUE)
        write.csv(as.data.frame(SummarizedExperiment::rowData(sac.se)), "rowData_updated.csv", row.names = TRUE)
        saveRDS(sac.se, "summarized_experiment_updated.rds")
        saveRDS(sac_opls.ls, "opls_models_list.rds")
        
        message("Pipeline completed successfully. Outputs written to working directory.")

    writeLines(c(
        '"BIOC_ROPLS_SUMMARIZED_EXPERIMENT_WORKFLOW":',
        paste0('    ropls: ', as.character(packageVersion('ropls')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_summarized_experiment_workflow.csv versions.yml
    """
}

workflow BIOC_ROPLS_SUMMARIZED_EXPERIMENT_WORKFLOW_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ SummarizedExperiment object ] ]

    main:
    BIOC_ROPLS_SUMMARIZED_EXPERIMENT_WORKFLOW(ch_input)

    emit:
    tables   = BIOC_ROPLS_SUMMARIZED_EXPERIMENT_WORKFLOW.out.tables
    plots    = BIOC_ROPLS_SUMMARIZED_EXPERIMENT_WORKFLOW.out.plots
    objects  = BIOC_ROPLS_SUMMARIZED_EXPERIMENT_WORKFLOW.out.objects
    versions = BIOC_ROPLS_SUMMARIZED_EXPERIMENT_WORKFLOW.out.versions
}
