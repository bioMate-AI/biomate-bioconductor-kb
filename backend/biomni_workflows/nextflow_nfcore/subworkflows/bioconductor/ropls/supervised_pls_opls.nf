#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: ropls — supervised_pls_opls
// Perform supervised classification or regression with cross-validation, permutation testing, and performance evaluation on a test set.
// Input: dataMatrix.tsv, sampleMetadata.tsv
// Container: quay.io/biocontainers/bioconductor-ropls:1.42.0--r45hdfd78af_0
// Requires: ropls
// Visualizations: plot (ggplot/base)
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Core Analysis] Run PLS-DA or OPLS-DA using opls
//  * 2. [Core Analysis] Train model on a subset of samples
//  * 3. [Core Analysis] Evaluate predictions on training and test subsets
//  * 4. [Core Analysis] Extract VIP values for feature selection

nextflow.enable.dsl = 2

process BIOC_ROPLS_SUPERVISED_PLS_OPLS {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-general:3.20"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_f in list.files(".", recursive = TRUE, full.names = TRUE)) {
          .bm_bn <- basename(.bm_f)
          if (!file.exists(.bm_bn)) try(file.copy(.bm_f, .bm_bn), silent = TRUE)
        }
        
    # Load required library
    library(ropls)
    
    # 1. Read the user input files from the working directory
    if (!file.exists("dataMatrix.tsv") || !file.exists("sampleMetadata.tsv")) {
      stop("Required input files 'dataMatrix.tsv' and/or 'sampleMetadata.tsv' are missing in the working directory.")
    }
    
    dataMatrix <- as.matrix(read.table("dataMatrix.tsv", header = TRUE, sep = "\t", row.names = 1, check.names = FALSE))
    sampleMetadata <- read.table("sampleMetadata.tsv", header = TRUE, sep = "\t", row.names = 1, check.names = FALSE)
    
    # Align samples between data matrix and metadata
    common_samples <- intersect(rownames(dataMatrix), rownames(sampleMetadata))
    if (length(common_samples) == 0) {
      stop("No common samples found between dataMatrix and sampleMetadata.")
    }
    dataMatrix <- dataMatrix[common_samples, , drop = FALSE]
    sampleMetadata <- sampleMetadata[common_samples, , drop = FALSE]
    
    # Extract response variable (using the first column of metadata)
    if (ncol(sampleMetadata) == 0) {
      stop("sampleMetadata.tsv must contain at least one column to be used as the response variable.")
    }
    
    response_factor <- as.factor(sampleMetadata[, 1])
    
    # Open PDF device to capture diagnostic plots generated by opls()
    pdf("opls_diagnostic_plots.pdf", width = 8, height = 8)
    
    # 2. Run PLS-DA
    plsda_model <- opls(dataMatrix, response_factor)
    
    # 3. Run OPLS-DA
    oplsda_model <- opls(dataMatrix, response_factor, predI = 1, orthoI = NA)
    
    # 4. Train model on a subset of samples ("odd" indices)
    oplsda_model <- opls(dataMatrix, response_factor, predI = 1, orthoI = NA, subset = "odd")
    
    # 5. Evaluate predictions on training and test subsets
    trainVi <- getSubsetVi(oplsda_model)
    confusion_train.tb <- table(response_factor[trainVi], fitted(oplsda_model))
    confusion_test.tb <- table(response_factor[-trainVi], predict(oplsda_model, dataMatrix[-trainVi, ]))
    
    # Close PDF device
    dev.off()
    
    # 6. Extract VIP values for feature selection
    vipVn <- getVipVn(opls(dataMatrix, response_factor, predI = 1, orthoI = NA, fig.pdfC = "none"))
    
    # 7. Save meaningful results to files
    # Save confusion matrices
    write.csv(as.data.frame(confusion_train.tb), "confusion_matrix_train.csv", row.names = TRUE)
    write.csv(as.data.frame(confusion_test.tb), "confusion_matrix_test.csv", row.names = TRUE)
    
    # Save VIP values
    vip_df <- data.frame(Feature = names(vipVn), VIP = vipVn)
    write.csv(vip_df, "vip_values.csv", row.names = FALSE)
    
    # Save models as RDS objects
    saveRDS(plsda_model, "plsda_model.rds")
    saveRDS(oplsda_model, "oplsda_model.rds")
    
    message("Pipeline completed successfully. Outputs written to working directory.")

    writeLines(c(
        '"BIOC_ROPLS_SUPERVISED_PLS_OPLS":',
        paste0('    ropls: ', as.character(packageVersion('ropls')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_supervised_pls_opls.csv versions.yml
    """
}

workflow BIOC_ROPLS_SUPERVISED_PLS_OPLS_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ dataMatrix.tsv, sampleMetadata.tsv ] ]

    main:
    BIOC_ROPLS_SUPERVISED_PLS_OPLS(ch_input)

    emit:
    tables   = BIOC_ROPLS_SUPERVISED_PLS_OPLS.out.tables
    plots    = BIOC_ROPLS_SUPERVISED_PLS_OPLS.out.plots
    objects  = BIOC_ROPLS_SUPERVISED_PLS_OPLS.out.objects
    versions = BIOC_ROPLS_SUPERVISED_PLS_OPLS.out.versions
}
