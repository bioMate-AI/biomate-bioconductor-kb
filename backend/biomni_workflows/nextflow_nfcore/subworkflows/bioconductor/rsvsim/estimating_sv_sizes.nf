#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: rsvsim — estimating_sv_sizes
// Estimate and generate realistic SV size distributions by fitting a beta distribution to real data or using default database parameters.
// Input: real_sv_sizes.txt
// Container: quay.io/biocontainers/bioconductor-rsvsim:1.50.0--r45hdfd78af_0
// R packages: MASS, RSVSim
// Bioconductor: 3.21 | R: 4.5
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

nextflow.enable.dsl = 2

process BIOC_RSVSIM_ESTIMATING_SV_SIZES {
    tag "${meta.id}"
    label 'process_medium'

    container "quay.io/biocontainers/bioconductor-rsvsim:1.50.0--r45hdfd78af_0"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("MASS", "RSVSim")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }

    # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
    for (.bm_d in list.files(".", full.names = TRUE)) {
      if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
        for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
          if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
        }
      }
    }
    
    # Load required libraries
    library(RSVSim)
    library(MASS)
    
    # Define input file path
    input_file <- "real_sv_sizes.txt"
    
    # If the optional input file does not exist, create it with default realistic SV sizes
    if (!file.exists(input_file)) {
      default_sizes <- c(10, 20, 30, 40, 60, 80, 100, 150, 200, 250, 300, 400, 500, 750, 1000)
      writeLines(as.character(default_sizes), input_file)
    }
    
    # Read the SV sizes from the user input file
    svSizes <- as.numeric(readLines(input_file))
    svSizes <- svSizes[!is.na(svSizes)]
    
    # Open a PDF device to capture the histograms generated by estimateSVSizes(..., hist=TRUE)
    pdf("sv_size_histograms.pdf", width=12, height=6)
    par(mfrow=c(1, 2))
    
    # Run the documented workflow steps exactly as specified
    simSizes = estimateSVSizes(n=1000, svSizes=svSizes, minSize=10, maxSize=1000, hist=TRUE) 
    delSizes = estimateSVSizes(n=10000, minSize=500, maxSize=10000, 
    default="deletions", hist=TRUE)
    
    # Close the plotting device
    dev.off()
    
    # Save the meaningful results to output files
    write.csv(data.frame(simulated_sizes = simSizes), "simulated_sizes.csv", row.names=FALSE)
    write.csv(data.frame(deletion_sizes = delSizes), "simulated_deletion_sizes.csv", row.names=FALSE)
    
    saveRDS(simSizes, "simSizes.rds")
    saveRDS(delSizes, "delSizes.rds")

    writeLines(c(
        '"BIOC_RSVSIM_ESTIMATING_SV_SIZES":',
        paste0('    RSVSim: ', as.character(packageVersion('RSVSim')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_estimating_sv_sizes.csv versions.yml
    """
}

workflow BIOC_RSVSIM_ESTIMATING_SV_SIZES_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ real_sv_sizes.txt ] ]

    main:
    BIOC_RSVSIM_ESTIMATING_SV_SIZES(ch_input)

    emit:
    tables   = BIOC_RSVSIM_ESTIMATING_SV_SIZES.out.tables
    plots    = BIOC_RSVSIM_ESTIMATING_SV_SIZES.out.plots
    objects  = BIOC_RSVSIM_ESTIMATING_SV_SIZES.out.objects
    versions = BIOC_RSVSIM_ESTIMATING_SV_SIZES.out.versions
}
