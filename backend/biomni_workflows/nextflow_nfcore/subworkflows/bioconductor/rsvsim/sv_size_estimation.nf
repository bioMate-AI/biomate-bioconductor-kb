#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: RSVSim — sv_size_estimation
// Estimate realistic SV size distributions by fitting a beta distribution to real datasets or using default database distributions.
// Input: real_sv_sizes.txt
// Container: quay.io/biocontainers/bioconductor-rsvsim:1.50.0--r45hdfd78af_0
// Requires: RSVSim
// Visualizations: plot (ggplot/base)
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Core Analysis] Estimate SV sizes using estimateSVSizes by fitting a beta distribution to user-supplied sizes or using default distributions from 

nextflow.enable.dsl = 2

process BIOC_RSVSIM_SV_SIZE_ESTIMATION {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-genomics:3.20"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("RSVSim")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      if (!requireNamespace("BiocManager", quietly=TRUE)) install.packages("BiocManager", repos="https://cloud.r-project.org")
      bin <- tryCatch(sprintf("https://bioconductor.org/packages/%s/container-binaries/bioconductor_docker", BiocManager::version()), error=function(e) NULL)
      suppressMessages(tryCatch(BiocManager::install(.bm_miss, update=FALSE, ask=FALSE, site_repository=bin), error=function(e) BiocManager::install(.bm_miss, update=FALSE, ask=FALSE)))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_f in list.files(".", recursive = TRUE, full.names = TRUE)) {
          .bm_bn <- basename(.bm_f)
          if (!file.exists(.bm_bn)) try(file.copy(.bm_f, .bm_bn), silent = TRUE)
        }
        
        # Load required libraries
        library(RSVSim)
        
        # Define input file path
        input_file <- "real_sv_sizes.txt"
        
        # Read user input if available, otherwise fall back to the documented default vector
        if (file.exists(input_file)) {
          svSizes <- scan(input_file, what = numeric(), quiet = TRUE)
        } else {
          svSizes = c(10,20,30,40,60,80,100,150,200,250,300,400,500,750,1000)
        }
        
        # Open PDF device to capture the histograms generated by estimateSVSizes(..., hist=TRUE)
        pdf("sv_size_distributions.pdf", width = 10, height = 5)
        par(mfrow = c(1, 2))
        
        # 1. Estimate SV sizes by fitting a beta distribution to the user-supplied or default sizes
        simSizes = estimateSVSizes(n=1000, svSizes=svSizes, hist=TRUE)
        
        # 2. Estimate SV sizes using default database distributions (deletions)
        delSizes = estimateSVSizes(n=10000, minSize=500, maxSize=10000, default="deletions", hist=TRUE)
        
        # Close the PDF device
        dev.off()
        
        # Save the estimated sizes to CSV files
        write.csv(data.frame(Size = simSizes), "simulated_sizes_beta_fit.csv", row.names = FALSE)
        write.csv(data.frame(Size = delSizes), "simulated_deletion_sizes_dgv.csv", row.names = FALSE)
        
        # Save the results as RDS objects for downstream R workflows
        saveRDS(simSizes, "simSizes.rds")
        saveRDS(delSizes, "delSizes.rds")
        
        cat("Workflow completed successfully. Outputs written to:\n")
        cat("- sv_size_distributions.pdf (Plots)\n")
        cat("- simulated_sizes_beta_fit.csv (CSV)\n")
        cat("- simulated_deletion_sizes_dgv.csv (CSV)\n")
        cat("- simSizes.rds (RDS)\n")
        cat("- delSizes.rds (RDS)\n")

    writeLines(c(
        '"BIOC_RSVSIM_SV_SIZE_ESTIMATION":',
        paste0('    RSVSim: ', as.character(packageVersion('RSVSim')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_sv_size_estimation.csv versions.yml
    """
}

workflow BIOC_RSVSIM_SV_SIZE_ESTIMATION_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ real_sv_sizes.txt ] ]

    main:
    BIOC_RSVSIM_SV_SIZE_ESTIMATION(ch_input)

    emit:
    tables   = BIOC_RSVSIM_SV_SIZE_ESTIMATION.out.tables
    plots    = BIOC_RSVSIM_SV_SIZE_ESTIMATION.out.plots
    objects  = BIOC_RSVSIM_SV_SIZE_ESTIMATION.out.objects
    versions = BIOC_RSVSIM_SV_SIZE_ESTIMATION.out.versions
}
