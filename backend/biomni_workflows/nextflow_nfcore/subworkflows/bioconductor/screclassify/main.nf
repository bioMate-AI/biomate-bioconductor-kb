#!/usr/bin/env nextflow
// ============================================================
// Bioconductor module: scReClassify
// A post hoc cell type classification tool to fine-tune cell type annotations generated by any cell ty
//
// Source : https://bioconductor.org/packages/3.20/bioc/https://bioconductor.org/packages/3.20/bioc/vignettes/scReClassify/inst/doc/scReClassify.html
// Upstream  : DT, SingleCellExperiment, SummarizedExperiment, devtools, dplyr
// Downstream: none
//
// Install: BiocManager::install("scReClassify")
// ============================================================

nextflow.enable.dsl = 2

process BIOC_SCRECLASSIFY {
    tag "${meta.id}"
    label 'process_medium'

    conda "bioconductor-screclassify"
    container "${workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
        'https://depot.galaxyproject.org/singularity/bioconductor-screclassify:1.12.0--r44_0' :
        'quay.io/biocontainers/bioconductor-screclassify:1.12.0--r44_0'}"

    input:
    tuple val(meta), path(count_data)

    output:
    tuple val(meta), path("${meta.id}_screclassify_results.csv"),  emit: results
    tuple val(meta), path("${meta.id}_screclassify_output.rds"),   emit: rds
    tuple val(meta), path("${meta.id}_screclassify_plots.pdf"),    emit: plots, optional: true
    path "versions.yml",                                            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def args   = task.ext.args   ?: ''
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    library(scReClassify)
    library(jsonlite)

    # --- Dimension Reduction ---
    # Key functions: matPCs, reducedDim
    reducedDim(dat, "matPCs") <- matPCs(
        dat,
        assay = "logNorm",
        percent = 0.7
    )
    pcs_matrix <- reducedDim(dat, "matPCs")

    # --- Noise Simulation ---
    # Key functions: noisyCls, reducedDim
    pcs_transposed <- t(reducedDim(dat, "matPCs"))
    cls.noisy02 <- noisyCls(
        pcs_transposed,
        rho = 0.2,
        lab = cellTypes
    )
    cls.noisy05 <- noisyCls(
        pcs_transposed,
        rho = 0.5,
        lab = cellTypes
    )

    # --- Cell Type Reclassification ---
    # Key functions: multiAdaSampling
    cellTypes.reclassify <- multiAdaSampling(
        dat,
        cellTypes = cellTypes,
        assay = "logNorm",
        classifier = "svm",
        percent = 0.8,
        L = 10
    )

    # --- Reclassification Evaluation ---
    # Key functions: multiAdaSampling
    idx <- which(cellTypes.reclassify$final != cellTypes)
    reclass_results <- data.frame(
        original = cellTypes[idx],
        reclassify = cellTypes.reclassify$final[idx]
    )


    # --- Save outputs ---
    if (exists("results_df") && is.data.frame(results_df)) {
        write.csv(results_df, "${prefix}_screclassify_results.csv", row.names = TRUE)
    } else {
        write.csv(data.frame(status = "completed"), "${prefix}_screclassify_results.csv")
    }
    if (exists("result_obj")) {
        saveRDS(result_obj, "${prefix}_screclassify_output.rds")
    }

    # --- versions.yml ---
    writeLines(
        c("BIOC_SCRECLASSIFY:", paste0("    screclassify: ", packageVersion("scReClassify"))),
        "versions.yml"
    )
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_screclassify_results.csv
    touch ${prefix}_screclassify_output.rds
    echo "BIOC_SCRECLASSIFY:" > versions.yml
    echo "    screclassify: 0.0.0" >> versions.yml
    """
}


workflow BIOC_SCRECLASSIFY_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), path(count_data) ]

    main:
    BIOC_SCRECLASSIFY(ch_input)

    emit:
    results  = BIOC_SCRECLASSIFY.out.results   // channel: [ val(meta), path(csv) ]
    rds      = BIOC_SCRECLASSIFY.out.rds       // channel: [ val(meta), path(rds) ]
    plots    = BIOC_SCRECLASSIFY.out.plots     // channel: [ val(meta), path(pdf) ] (optional)
    versions = BIOC_SCRECLASSIFY.out.versions  // channel: path(versions.yml)
}
