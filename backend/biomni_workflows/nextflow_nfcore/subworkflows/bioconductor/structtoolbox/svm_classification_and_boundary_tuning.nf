#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: structToolbox — svm_classification_and_boundary_tuning
// Train Support Vector Machine (SVM) classifiers on low-dimensional scores, tune cost and kernel parameters, and visualize decision boundaries in 2D space.
// Input: DE
// Container: quay.io/biocontainers/bioconductor-structtoolbox:1.22.0--r45hdfd78af_0
// R packages: (see script)
// Bioconductor: 3.20 | R: 4.4
// Requires: cowplot, ggplot2, structToolbox
// Visualizations: plot (ggplot/base)
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Core Analysis] Filter samples and apply PLS-DA to reduce data to two components
//  * 2. [Input & Preparation] Create a new 2D DatasetExperiment from PLS scores
//  * 3. [Visualization & Output] Train a basic linear SVM model and plot the decision boundary
//  * 4. [Core Analysis] Train SVM models with varying cost parameters
//  * 5. [Core Analysis] Train SVM models with different kernel functions (linear, polynomial, radial, sigmoid) and gamma parameters

nextflow.enable.dsl = 2

process BIOC_STRUCTTOOLBOX_SVM_CLASSIFICATION_AND_BOUNDARY_TUNING {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-metabolomics:3.20"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("structToolbox", "ggplot2", "cowplot")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_d in list.files(".", full.names = TRUE)) {
          if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
            for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
              if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
            }
          }
        }
        
        # Load required libraries
        library(structToolbox)
        library(ggplot2)
        library(cowplot)
        
        # Read the input DatasetExperiment object from the working directory
        if (file.exists("DE.rds")) {
          DE <- readRDS("DE.rds")
        } else if (file.exists("DE")) {
          DE <- readRDS("DE")
        } else {
          stop("Error: Input file 'DE.rds' or 'DE' not found in the working directory.")
        }
        
        # Determine factor name and levels dynamically to avoid hardcoding
        fac_name <- if ("Class" %in% colnames(DE\$sample_meta)) "Class" else colnames(DE\$sample_meta)[1]
        fac_levels <- as.character(unique(DE\$sample_meta[[fac_name]]))
        fac_levels <- fac_levels[!is.na(fac_levels)]
        
        # 1. Filter samples and apply PLS-DA to reduce data to two components
        MS = filter_smeta(mode = 'include', levels = fac_levels, factor_name = fac_name) +
             PLSDA(factor_name = fac_name, number_components = 2)
        MS = model_apply(MS,DE)
        C = pls_scores_plot(factor_name = fac_name)
        p_pls = chart_plot(C,MS[2])
        
        # Save PLS scores plot
        pdf("pls_scores_plot.pdf")
        print(p_pls)
        dev.off()
        
        # 2. Create a new 2D DatasetExperiment from PLS scores
        DE2 = DatasetExperiment(
          data = MS[2]\$scores\$data, 
          sample_meta = predicted(MS[1])\$sample_meta,
          variable_meta = data.frame('LV'=c(1,2),row.names = colnames(MS[2]\$scores\$data)),
          name = 'Illustrativate SVM dataset',
          description = 'Generated by applying PLS to the processed Gastric cancer (NMR) dataset'
        )
        
        # Ensure 'Species' column exists in DE2 sample metadata to support the exact documented code calls
        if (!"Species" %in% colnames(DE2\$sample_meta) && fac_name %in% colnames(DE2\$sample_meta)) {
          DE2\$sample_meta\$Species = DE2\$sample_meta[[fac_name]]
        }
        
        # Save the generated 2D DatasetExperiment object
        saveRDS(DE2, "DE2_pls_scores.rds")
        
        # 3. Train a basic linear SVM model and plot the decision boundary
        M = SVM(
          factor_name = fac_name,
          kernel = 'linear'
        )
        M = model_apply(M,DE2)
        C = svm_plot_2d(factor_name = fac_name)
        p_svm_basic = chart_plot(C,M, DE2)
        
        pdf("svm_basic_boundary.pdf")
        print(p_svm_basic)
        dev.off()
        
        # 4. Train SVM models with varying cost parameters
        M\$cost=0.01
        M=model_apply(M,DE2)
        C=svm_plot_2d(factor_name='Species')
        g1=chart_plot(C,M,DE2)
        
        M\$cost=0.05
        M=model_apply(M,DE2)
        C=svm_plot_2d(factor_name='Species')
        g2=chart_plot(C,M,DE2)
        
        M\$cost=100
        M=model_apply(M,DE2)
        C=svm_plot_2d(factor_name='Species')
        g3=chart_plot(C,M,DE2)
        
        # Save cost tuning plots
        pdf("svm_cost_tuning.pdf", width = 12, height = 4)
        print(cowplot::plot_grid(g1, g2, g3, ncol = 3, labels = c("Cost = 0.01", "Cost = 0.05", "Cost = 100")))
        dev.off()
        
        # 5. Train SVM models with different kernel functions and gamma parameters
        M\$cost=1
        M\$kernel='linear'
        M=model_apply(M,DE2)
        C=svm_plot_2d(factor_name='Species')
        g1=chart_plot(C,M,DE2)
        
        M\$kernel='polynomial'
        M\$gamma=1
        M\$coef0=0
        M=model_apply(M,DE2)
        C=svm_plot_2d(factor_name='Species')
        g2=chart_plot(C,M,DE2)
        
        M\$kernel='radial'
        M\$gamma=1
        M=model_apply(M,DE2)
        C=svm_plot_2d(factor_name='Species')
        g3=chart_plot(C,M,DE2)
        
        M\$kernel='sigmoid'
        M\$gamma=1
        M\$coef0=0
        M=model_apply(M,DE2)
        C=svm_plot_2d(factor_name='Species')
        g4=chart_plot(C,M,DE2)
        
        # Save kernel tuning plots
        pdf("svm_kernel_tuning.pdf", width = 10, height = 10)
        print(cowplot::plot_grid(g1, g2, g3, g4, ncol = 2, labels = c("Linear", "Polynomial", "Radial", "Sigmoid")))
        dev.off()
        
        # Save final trained SVM model object
        saveRDS(M, "final_svm_model.rds")

    writeLines(c(
        '"BIOC_STRUCTTOOLBOX_SVM_CLASSIFICATION_AND_BOUNDARY_TUNING":',
        paste0('    structToolbox: ', as.character(packageVersion('structToolbox')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_svm_classification_and_boundary_tuning.csv versions.yml
    """
}

workflow BIOC_STRUCTTOOLBOX_SVM_CLASSIFICATION_AND_BOUNDARY_TUNING_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ DE ] ]

    main:
    BIOC_STRUCTTOOLBOX_SVM_CLASSIFICATION_AND_BOUNDARY_TUNING(ch_input)

    emit:
    tables   = BIOC_STRUCTTOOLBOX_SVM_CLASSIFICATION_AND_BOUNDARY_TUNING.out.tables
    plots    = BIOC_STRUCTTOOLBOX_SVM_CLASSIFICATION_AND_BOUNDARY_TUNING.out.plots
    objects  = BIOC_STRUCTTOOLBOX_SVM_CLASSIFICATION_AND_BOUNDARY_TUNING.out.objects
    versions = BIOC_STRUCTTOOLBOX_SVM_CLASSIFICATION_AND_BOUNDARY_TUNING.out.versions
}
