/*
 * BioMate — survival Nextflow Configuration
 * Kaplan-Meier + Cox PH survival analysis (CRAN survival package)
 */

params {
    outdir       = './results/survival'
    clinical_csv = null
    time_col     = 'time'
    event_col    = 'event'
    group_col    = 'treatment'
    covariates   = 'age'
}

process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 8.GB
        time   = 4.h
    }
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

profiles {
    standard {
        process.executor = 'local'
    }

    // test profile — stub mode; no R required
    test {
        stubRun = true
        process {
            withLabel: 'process_low'    { cpus = 1; memory = 2.GB }
            withLabel: 'process_medium' { cpus = 1; memory = 2.GB }
        }
    }

    docker {
        docker.enabled      = true
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    aws {
        docker.enabled = true
        process {
            executor = 'awsbatch'
            queue    = 'biomate-nextflow-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/usr/local/bin/aws'
        }
    }
}

manifest {
    name            = 'biomate-survival'
    author          = 'BioMate AI'
    description     = 'Kaplan-Meier + Cox PH survival analysis (CRAN survival)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.10.0'
    version         = '1.0.0'
}
