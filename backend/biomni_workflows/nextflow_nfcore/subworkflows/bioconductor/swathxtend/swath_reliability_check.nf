#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: SwathXtend — swath_reliability_check
// Perform reliability checks and assess quantification consistency between SWATH results extracted using a seed library versus an extended library.
// Input: Lib2.txt, Lib2_3.txt, Swath_result_seed.xlsx, Swath_result_ext.xlsx
// Container: quay.io/biocontainers/bioconductor-swathxtend:2.32.0--r45hdfd78af_0
// R packages: SwathXtend
// Bioconductor: 3.20 | R: 4.4
// Requires: SwathXtend
// Visualizations: plot (ggplot/base)
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Core Analysis] Compare peptide and protein coverage between the seed and extended libraries
//  * 2. [Core Analysis] Run comprehensive reliability check on SWATH results
//  * 3. [Input & Preparation] Read FDR and peptide worksheets from SWATH results
//  * 4. [Core Analysis] Calculate FDR passing rates and evaluate quantification consistency (e.g., Coefficient of Variation)

nextflow.enable.dsl = 2

process BIOC_SWATHXTEND_SWATH_RELIABILITY_CHECK {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-general:3.20-slim"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("SwathXtend")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_d in list.files(".", full.names = TRUE)) {
          if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
            for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
              if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
            }
          }
        }
    
    # Load required library
    library(SwathXtend)
    
    # Define input files from the working directory
    libfiles <- c("Lib2.txt", "Lib2_3.txt")
    fswaths <- c("Swath_result_seed.xlsx", "Swath_result_ext.xlsx")
    
    # Verify that all required input files exist
    for (f in c(libfiles, fswaths)) {
      if (!file.exists(f)) {
        stop(paste("Required input file missing in working directory:", f))
      }
    }
    
    # -------------------------------------------------------------------------
    # Stage 1: Compare peptide and protein coverage between seed and extended libraries
    # -------------------------------------------------------------------------
    message("Comparing peptide and protein coverage between libraries...")
    res_lib <- reliabilityCheckLibrary(libfiles[1], libfiles[2])
    
    # Save library comparison results
    write.csv(res_lib, "reliability_check_library_results.csv", row.names = FALSE)
    
    
    # -------------------------------------------------------------------------
    # Stage 2: Run comprehensive reliability check on SWATH results
    # -------------------------------------------------------------------------
    message("Running comprehensive reliability check on SWATH results...")
    
    # Capture the plots generated by reliabilityCheckSwath in a PDF
    pdf("reliability_check_swath_plots.pdf", width = 8, height = 8)
    res_swath <- reliabilityCheckSwath(fswaths[1], fswaths[2], max.fdrpass = 8, max.peptide = 2)
    dev.off()
    
    # Save the returned reliability check results
    saveRDS(res_swath, "reliability_check_swath_results.rds")
    
    
    # -------------------------------------------------------------------------
    # Stage 3: Read FDR and peptide worksheets from SWATH results
    # -------------------------------------------------------------------------
    message("Reading FDR worksheets...")
    fdr.seed <- readWorkbook(fswaths[1], sheet = 'FDR')
    fdr.ext <- readWorkbook(fswaths[2], sheet = 'FDR')
    
    
    # -------------------------------------------------------------------------
    # Stage 4: Calculate FDR passing rates and evaluate quantification consistency
    # -------------------------------------------------------------------------
    message("Calculating FDR passing rates...")
    fdr.seed <- fdr.crit(fdr.seed)
    fdr.ext <- fdr.crit(fdr.ext)
    
    # Print head of processed FDR for extended library as in documented code
    print(head(fdr.ext[, c(1:2, ncol(fdr.ext))]))
    
    # Save processed FDR tables
    write.csv(fdr.seed, "fdr_seed_processed.csv", row.names = FALSE)
    write.csv(fdr.ext, "fdr_ext_processed.csv", row.names = FALSE)
    
    message("Reading peptide worksheets...")
    swa.seed <- readWorkbook(fswaths[1], 2)
    swa.ext <- readWorkbook(fswaths[2], 2)
    
    # Filter for passing FDR
    fdr.seed <- fdr.seed[fdr.seed\$nfdr.pass > 0, ]
    fdr.ext <- fdr.ext[fdr.ext\$nfdr.pass > 0, ]
    
    message("Evaluating quantification consistency (Coefficient of Variation)...")
    res_accuracy <- quantification.accuracy(
      swa.seed[fdr.seed\$nfdr.pass >= 1, ], 
      swa.ext[fdr.ext\$nfdr.pass >= 1, ], 
      method = "cv"
    )[[1]]
    
    # Save quantification accuracy results
    saveRDS(res_accuracy, "quantification_accuracy_cv.rds")
    write.csv(data.frame(CV = res_accuracy), "quantification_accuracy_cv.csv", row.names = FALSE)
    
    message("Pipeline completed successfully. Outputs written to working directory.")

    writeLines(c(
        '"BIOC_SWATHXTEND_SWATH_RELIABILITY_CHECK":',
        paste0('    SwathXtend: ', as.character(packageVersion('SwathXtend')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_swath_reliability_check.csv versions.yml
    """
}

workflow BIOC_SWATHXTEND_SWATH_RELIABILITY_CHECK_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ Lib2.txt, Lib2_3.txt, Swath_result_seed.xlsx, Swath_result_ext.xlsx ] ]

    main:
    BIOC_SWATHXTEND_SWATH_RELIABILITY_CHECK(ch_input)

    emit:
    tables   = BIOC_SWATHXTEND_SWATH_RELIABILITY_CHECK.out.tables
    plots    = BIOC_SWATHXTEND_SWATH_RELIABILITY_CHECK.out.plots
    objects  = BIOC_SWATHXTEND_SWATH_RELIABILITY_CHECK.out.objects
    versions = BIOC_SWATHXTEND_SWATH_RELIABILITY_CHECK.out.versions
}
