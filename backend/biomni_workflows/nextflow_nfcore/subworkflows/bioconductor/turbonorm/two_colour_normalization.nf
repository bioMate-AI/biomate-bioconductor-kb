#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: TurboNorm — two_colour_normalization
// Normalize two-colour microarray data using P-splines.
// Input: swirl.RData
// Container: quay.io/biocontainers/bioconductor-turbonorm:1.58.0--r45h01b2380_0
// R packages: (see script)
// Bioconductor: 3.20 | R: 4.4
// Requires: TurboNorm, marray
// Visualizations: plot (ggplot/base)
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Input & Preparation] Load the marray or limma library and the two-colour data
//  * 2. [Visualization & Output] Normalize the data using pspline() while optionally plotting the fit for a specific array

nextflow.enable.dsl = 2

process BIOC_TURBONORM_TWO_COLOUR_NORMALIZATION {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-epigenomics:3.20-slim"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("TurboNorm", "marray")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_d in list.files(".", full.names = TRUE)) {
          if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
            for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
              if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
            }
          }
        }
    
    # Load required libraries
    library(TurboNorm)
    library(marray)
    
    # 1. Load the two-colour data from the user-provided swirl.RData
    # This file is expected to contain the 'swirl' object (MarrayRaw or RGList)
    load("swirl.RData")
    
    # Ensure 'swirl' object is loaded
    if (!exists("swirl")) {
      stop("The loaded 'swirl.RData' did not contain an object named 'swirl'.")
    }
    
    # 2. Normalize the data using pspline() while plotting the fit for array 2
    # We wrap this in a pdf device to capture the plot generated by showArrays=2
    pdf("pspline_fit_array2.pdf", width=7, height=7)
    x <- pspline(swirl, showArrays=2, pch=20, col="grey")
    dev.off()
    
    # 3. Save the normalized object as an RDS file
    saveRDS(x, "normalized_data.rds")
    
    # 4. Export M and A values to a CSV file for downstream analysis
    if (inherits(x, "MarrayNorm")) {
      m_vals <- marray::maM(x)
      a_vals <- marray::maA(x)
      
      # Construct a data frame with M and A values for all arrays
      df <- data.frame(Probe = seq_len(nrow(m_vals)))
      for (i in seq_len(ncol(m_vals))) {
        df[[paste0("M_Array", i)]] <- m_vals[, i]
        df[[paste0("A_Array", i)]] <- a_vals[, i]
      }
      write.csv(df, "normalized_values.csv", row.names=FALSE)
    } else if (inherits(x, "MAList")) {
      m_vals <- x\$M
      a_vals <- x\$A
      df <- data.frame(Probe = seq_len(nrow(m_vals)))
      for (i in seq_len(ncol(m_vals))) {
        df[[paste0("M_Array", i)]] <- m_vals[, i]
        df[[paste0("A_Array", i)]] <- a_vals[, i]
      }
      write.csv(df, "normalized_values.csv", row.names=FALSE)
    }

    writeLines(c(
        '"BIOC_TURBONORM_TWO_COLOUR_NORMALIZATION":',
        paste0('    TurboNorm: ', as.character(packageVersion('TurboNorm')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_two_colour_normalization.csv versions.yml
    """
}

workflow BIOC_TURBONORM_TWO_COLOUR_NORMALIZATION_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ swirl.RData ] ]

    main:
    BIOC_TURBONORM_TWO_COLOUR_NORMALIZATION(ch_input)

    emit:
    tables   = BIOC_TURBONORM_TWO_COLOUR_NORMALIZATION.out.tables
    plots    = BIOC_TURBONORM_TWO_COLOUR_NORMALIZATION.out.plots
    objects  = BIOC_TURBONORM_TWO_COLOUR_NORMALIZATION.out.objects
    versions = BIOC_TURBONORM_TWO_COLOUR_NORMALIZATION.out.versions
}
