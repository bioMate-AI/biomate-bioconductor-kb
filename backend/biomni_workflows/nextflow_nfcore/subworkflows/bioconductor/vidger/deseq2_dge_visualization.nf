#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: vidger — deseq2_dge_visualization
// Visualize and interpret differential gene expression results generated by DESeq2.
// Input: df.deseq
// Container: quay.io/biocontainers/bioconductor-vidger:1.30.0--r45hdfd78af_0
// R packages: (see script)
// Bioconductor: 3.20 | R: 4.4
// Requires: DESeq2, vidger
// Visualizations: box plot, scatter plot, volcano plot
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Visualization & Output] Generate box plots to check FPKM/normalized count distribution across treatments using vsBoxPlot() with d.factor specified
//  * 2. [Visualization & Output] Create scatter plots and scatter matrices to compare expression values between treatments using vsScatterPlot() and vsScatterMatri
//  * 3. [Visualization & Output] Visualize the number of DEGs at a given adjusted p-value using vsDEGMatrix()
//  * 4. [Visualization & Output] Generate MA plots and MA matrices to visualize variance and log fold changes using vsMAPlot() and vsMAMatrix()
//  * 5. [Visualization & Output] Create volcano plots and volcano matrices to compare significance against log fold changes using vsVolcano() and vsVolcanoMatrix()
//  * 6. [Core Analysis] Compare two treatments against a control using vsFourWay()

nextflow.enable.dsl = 2

process BIOC_VIDGER_DESEQ2_DGE_VISUALIZATION {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-transcriptomics:3.20-slim"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("vidger", "DESeq2", "SummarizedExperiment")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_d in list.files(".", full.names = TRUE)) {
          if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
            for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
              if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
            }
          }
        }
            
    # Load required libraries
    library(vidger)
    library(SummarizedExperiment)
    library(DESeq2)
    
    # Read user input from the working directory
    if (file.exists("df.deseq")) {
      df.deseq <- readRDS("df.deseq")
    } else if (file.exists("df.deseq.rds")) {
      df.deseq <- readRDS("df.deseq.rds")
    } else {
      stop("Error: Input file 'df.deseq' or 'df.deseq.rds' not found in the working directory.")
    }
    
    # Extract design factor dynamically
    d_factor <- all.vars(design(df.deseq))[length(all.vars(design(df.deseq)))]
    
    # Extract treatment names dynamically
    treatments <- unique(as.character(colData(df.deseq)[[d_factor]]))
    if (length(treatments) < 2) {
      stop("Error: At least two treatments are required in the design factor.")
    }
    trt1 <- treatments[1]
    trt2 <- treatments[2]
    trt3 <- if (length(treatments) >= 3) treatments[3] else treatments[1]
    
    # 1. Generate box plots to check FPKM/normalized count distribution across treatments
    pdf("vsBoxPlot.pdf", width = 8, height = 6)
    print(vsBoxPlot(
        data = df.deseq, d.factor = d_factor, type = 'deseq', 
        title = TRUE, legend = TRUE, grid = TRUE
    ))
    dev.off()
    
    # 2. Create scatter plots and scatter matrices to compare expression values between treatments
    pdf("vsScatterPlot.pdf", width = 8, height = 6)
    print(vsScatterPlot(
        x = trt1, y = trt2, 
        data = df.deseq, type = 'deseq', d.factor = d_factor, 
        title = TRUE, grid = TRUE
    ))
    dev.off()
    
    pdf("vsScatterMatrix.pdf", width = 10, height = 10)
    print(vsScatterMatrix(
        data = df.deseq, d.factor = d_factor, type = 'deseq',
        comp = NULL, title = TRUE, grid = TRUE, man.title = NULL
    ))
    dev.off()
    
    # 3. Visualize the number of DEGs at a given adjusted p-value
    pdf("vsDEGMatrix.pdf", width = 8, height = 6)
    print(vsDEGMatrix(
        data = df.deseq, padj = 0.05, d.factor = d_factor, 
        type = 'deseq', title = TRUE, legend = TRUE, grid = TRUE
    ))
    dev.off()
    
    # 4. Generate MA plots and MA matrices to visualize variance and log fold changes
    pdf("vsMAPlot.pdf", width = 8, height = 6)
    print(vsMAPlot(
        x = trt1, y = trt2, 
        data = df.deseq, d.factor = d_factor, type = 'deseq', 
        padj = 0.05, y.lim = NULL, lfc = NULL, title = TRUE, 
        legend = TRUE, grid = TRUE
    ))
    dev.off()
    
    pdf("vsMAMatrix.pdf", width = 10, height = 10)
    print(vsMAMatrix(
        data = df.deseq, d.factor = d_factor, type = 'deseq', 
        padj = 0.05, y.lim = NULL, lfc = 1, title = TRUE, 
        grid = TRUE, counts = TRUE, data.return = FALSE
    ))
    dev.off()
    
    # 5. Create volcano plots and volcano matrices to compare significance against log fold changes
    pdf("vsVolcano.pdf", width = 8, height = 6)
    print(vsVolcano(
        x = trt1, y = trt2, 
        data = df.deseq, d.factor = d_factor, type = 'deseq', 
        padj = 0.05, x.lim = NULL, lfc = NULL, title = TRUE, 
        legend = TRUE, grid = TRUE, data.return = FALSE
    ))
    dev.off()
    
    pdf("vsVolcanoMatrix.pdf", width = 10, height = 10)
    print(vsVolcanoMatrix(
        data = df.deseq, d.factor = d_factor, type = 'deseq', 
        padj = 0.05, x.lim = NULL, lfc = NULL, title = TRUE, 
        legend = TRUE, grid = TRUE, counts = TRUE
    ))
    dev.off()
    
    # 6. Compare two treatments against a control using vsFourWay()
    pdf("vsFourWay.pdf", width = 8, height = 6)
    print(vsFourWay(
        x = trt1, y = trt3, 
        control = trt2, data = df.deseq, 
        d.factor = d_factor, type = 'deseq', padj = 0.05, x.lim = NULL, 
        y.lim = NULL, lfc = NULL, legend = TRUE, title = TRUE, grid = TRUE
    ))
    dev.off()
    
    # 7. Extract and save processed data from a visualization for downstream analysis
    tmp_scatter <- vsScatterPlot(
        x = trt1, y = trt2, 
        data = df.deseq, type = 'deseq', d.factor = d_factor, 
        title = TRUE, grid = TRUE, data.return = TRUE
    )
    write.csv(tmp_scatter\$data, "scatter_plot_data.csv", row.names = FALSE)

    writeLines(c(
        '"BIOC_VIDGER_DESEQ2_DGE_VISUALIZATION":',
        paste0('    vidger: ', as.character(packageVersion('vidger')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_deseq2_dge_visualization.csv versions.yml
    """
}

workflow BIOC_VIDGER_DESEQ2_DGE_VISUALIZATION_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ df.deseq ] ]

    main:
    BIOC_VIDGER_DESEQ2_DGE_VISUALIZATION(ch_input)

    emit:
    tables   = BIOC_VIDGER_DESEQ2_DGE_VISUALIZATION.out.tables
    plots    = BIOC_VIDGER_DESEQ2_DGE_VISUALIZATION.out.plots
    objects  = BIOC_VIDGER_DESEQ2_DGE_VISUALIZATION.out.objects
    versions = BIOC_VIDGER_DESEQ2_DGE_VISUALIZATION.out.versions
}
