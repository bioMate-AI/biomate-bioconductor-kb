#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: vidger — edger_dge_visualization
// Visualize and interpret differential gene expression results generated by edgeR.
// Input: df.edger
// Container: quay.io/biocontainers/bioconductor-vidger:1.30.0--r45hdfd78af_0
// R packages: (see script)
// Bioconductor: 3.20 | R: 4.4
// Requires: edgeR, ggplot2, vidger
// Visualizations: box plot, scatter plot, volcano plot
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Visualization & Output] Generate box plots to check CPM distribution across treatments using vsBoxPlot()
//  * 2. [Visualization & Output] Create scatter plots and scatter matrices to compare CPM values between treatments using vsScatterPlot() and vsScatterMatrix()
//  * 3. [Visualization & Output] Visualize the number of DEGs at a given adjusted p-value using vsDEGMatrix()
//  * 4. [Visualization & Output] Generate MA plots and MA matrices to visualize variance and log fold changes using vsMAPlot() and vsMAMatrix()
//  * 5. [Visualization & Output] Create volcano plots and volcano matrices to compare significance against log fold changes using vsVolcano() and vsVolcanoMatrix()
//  * 6. [Core Analysis] Compare two treatments against a control using vsFourWay()

nextflow.enable.dsl = 2

process BIOC_VIDGER_EDGER_DGE_VISUALIZATION {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-transcriptomics:3.20"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("vidger", "edgeR", "ggplot2")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_d in list.files(".", full.names = TRUE)) {
          if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
            for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
              if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
            }
          }
        }
            
        # Load required libraries
        library(vidger)
        library(edgeR)
        library(ggplot2)
        
        # Load input data
        if (file.exists("df.edger")) {
          df.edger <- tryCatch({
            readRDS("df.edger")
          }, error = function(e) {
            env <- new.env()
            load("df.edger", envir = env)
            if (length(ls(env)) > 0) {
              env[[ls(env)[1]]]
            } else {
              stop("Could not load df.edger from RData format.")
            }
          })
        } else if (file.exists("df.edger.rds")) {
          df.edger <- readRDS("df.edger.rds")
        } else if (file.exists("df.edger.RData")) {
          env <- new.env()
          load("df.edger.RData", envir = env)
          df.edger <- env[[ls(env)[1]]]
        } else {
          stop("Required input file 'df.edger' (or df.edger.rds/df.edger.RData) not found in the working directory.")
        }
        
        # Dynamically extract treatment groups from the data
        if ("samples" %in% names(df.edger) && "group" %in% names(df.edger\$samples)) {
          groups <- as.character(unique(df.edger\$samples\$group))
        } else {
          # Fallback for other object types or data frames
          groups <- colnames(df.edger)
          # Remove common non-group columns
          groups <- setdiff(groups, c("logFC", "logCPM", "PValue", "FDR", "LR", "F", "genes"))
        }
        
        if (length(groups) < 2) {
          stop("At least two treatment groups are required in the data for pairwise comparisons.")
        }
        
        group1 <- groups[1]
        group2 <- groups[2]
        
        # 1. Generate box plots to check CPM distribution across treatments using vsBoxPlot()
        pdf("vsBoxPlot.pdf", width = 8, height = 6)
        print(vsBoxPlot(
            data = df.edger, d.factor = NULL, type = 'edger', 
            title = TRUE, legend = TRUE, grid = TRUE
        ))
        dev.off()
        
        # 2. Create scatter plots and scatter matrices to compare CPM values between treatments using vsScatterPlot() and vsScatterMatrix()
        pdf("vsScatterPlot.pdf", width = 8, height = 6)
        print(vsScatterPlot(
            x = group1, y = group2, data = df.edger, type = 'edger',
            d.factor = NULL, title = TRUE, grid = TRUE
        ))
        dev.off()
        
        pdf("vsScatterMatrix.pdf", width = 10, height = 10)
        print(vsScatterMatrix(
            data = df.edger, d.factor = NULL, type = 'edger', comp = NULL,
            title = TRUE, grid = TRUE, man.title = NULL
        ))
        dev.off()
        
        # 3. Visualize the number of DEGs at a given adjusted p-value using vsDEGMatrix()
        pdf("vsDEGMatrix.pdf", width = 8, height = 6)
        print(vsDEGMatrix(
            data = df.edger, padj = 0.05, d.factor = NULL, type = 'edger', 
            title = TRUE, legend = TRUE, grid = TRUE
        ))
        dev.off()
        
        # 4. Generate MA plots and MA matrices to visualize variance and log fold changes using vsMAPlot() and vsMAMatrix()
        pdf("vsMAPlot.pdf", width = 8, height = 6)
        print(vsMAPlot(
            x = group1, y = group2, data = df.edger, d.factor = NULL, 
            type = 'edger', padj = 0.05, y.lim = NULL, lfc = NULL, 
            title = TRUE, legend = TRUE, grid = TRUE
        ))
        dev.off()
        
        pdf("vsMAMatrix.pdf", width = 10, height = 10)
        print(vsMAMatrix(
            data = df.edger, d.factor = NULL, type = 'edger', 
            padj = 0.05, y.lim = NULL, lfc = 1, title = TRUE, 
            grid = TRUE, counts = TRUE, data.return = FALSE
        ))
        dev.off()
        
        # 5. Create volcano plots and volcano matrices to compare significance against log fold changes using vsVolcano() and vsVolcanoMatrix()
        pdf("vsVolcano.pdf", width = 8, height = 6)
        print(vsVolcano(
            x = group1, y = group2, data = df.edger, d.factor = NULL, 
            type = 'edger', padj = 0.05, x.lim = NULL, lfc = NULL, 
            title = TRUE, legend = TRUE, grid = TRUE, data.return = FALSE
        ))
        dev.off()
        
        pdf("vsVolcanoMatrix.pdf", width = 10, height = 10)
        print(vsVolcanoMatrix(
            data = df.edger, d.factor = NULL, type = 'edger', padj = 0.05, 
            x.lim = NULL, lfc = NULL, title = TRUE, legend = TRUE, 
            grid = TRUE, counts = TRUE
        ))
        dev.off()
        
        # 6. Compare two treatments against a control using vsFourWay()
        if (length(groups) >= 3) {
            group3 <- groups[3]
            pdf("vsFourWay.pdf", width = 8, height = 6)
            print(vsFourWay(
                x = group1, y = group2, control = group3, data = df.edger,
                d.factor = NULL, type = 'edger', padj = 0.05, x.lim = NULL,
                y.lim = NULL, lfc = NULL, legend = TRUE, title = TRUE, grid = TRUE
            ))
            dev.off()
        } else {
            message("Skipping vsFourWay plot: requires at least 3 treatment groups.")
        }
        
        # Extra: Extract and save data from vsScatterPlot to a CSV file
        scatter_data_list <- vsScatterPlot(
            x = group1, y = group2, data = df.edger, type = 'edger',
            d.factor = NULL, title = TRUE, grid = TRUE, data.return = TRUE
        )
        write.csv(scatter_data_list\$data, "scatter_plot_data.csv", row.names = FALSE)
        
        # Extra: Extract and save data from vsVolcano to a CSV file
        volcano_data_list <- vsVolcano(
            x = group1, y = group2, data = df.edger, d.factor = NULL, 
            type = 'edger', padj = 0.05, x.lim = NULL, lfc = NULL, 
            title = TRUE, legend = TRUE, grid = TRUE, data.return = TRUE
        )
        write.csv(volcano_data_list\$data, "volcano_plot_data.csv", row.names = FALSE)
        
        message("Pipeline completed successfully. Outputs saved to PDF and CSV files.")

    writeLines(c(
        '"BIOC_VIDGER_EDGER_DGE_VISUALIZATION":',
        paste0('    vidger: ', as.character(packageVersion('vidger')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_edger_dge_visualization.csv versions.yml
    """
}

workflow BIOC_VIDGER_EDGER_DGE_VISUALIZATION_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ df.edger ] ]

    main:
    BIOC_VIDGER_EDGER_DGE_VISUALIZATION(ch_input)

    emit:
    tables   = BIOC_VIDGER_EDGER_DGE_VISUALIZATION.out.tables
    plots    = BIOC_VIDGER_EDGER_DGE_VISUALIZATION.out.plots
    objects  = BIOC_VIDGER_EDGER_DGE_VISUALIZATION.out.objects
    versions = BIOC_VIDGER_EDGER_DGE_VISUALIZATION.out.versions
}
