#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: vidger — cuffdiff_dge_visualization
// Visualize and interpret differential gene expression results generated by Cuffdiff.
// Input: df.cuff
// Container: quay.io/biocontainers/bioconductor-vidger:1.30.0--r45hdfd78af_0
// R packages: (see script)
// Bioconductor: 3.20 | R: 4.4
// Requires: vidger
// Visualizations: box plot, scatter plot, volcano plot
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

// Steps:
//  * 1. [Visualization & Output] Generate box plots to check FPKM distribution across treatments using vsBoxPlot()
//  * 2. [Visualization & Output] Create scatter plots and scatter matrices to compare FPKM values between treatments using vsScatterPlot() and vsScatterMatrix()
//  * 3. [Visualization & Output] Visualize the number of DEGs at a given adjusted p-value using vsDEGMatrix()
//  * 4. [Visualization & Output] Generate MA plots and MA matrices to visualize variance and log fold changes using vsMAPlot() and vsMAMatrix()
//  * 5. [Visualization & Output] Create volcano plots and volcano matrices to compare significance against log fold changes using vsVolcano() and vsVolcanoMatrix()
//  * 6. [Core Analysis] Compare two treatments against a control using vsFourWay()

nextflow.enable.dsl = 2

process BIOC_VIDGER_CUFFDIFF_DGE_VISUALIZATION {
    tag "${meta.id}"
    label 'process_medium'

    container "399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/bioc-domain-transcriptomics:3.20"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("vidger")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      .rv <- getRversion()
      .biocv <- if (.rv >= "4.5") "3.21" else if (.rv >= "4.4") "3.20" else if (.rv >= "4.3") "3.18" else "3.16"
      .repos <- c(sprintf("https://bioconductor.org/packages/%s/bioc", .biocv), sprintf("https://bioconductor.org/packages/%s/data/annotation", .biocv), sprintf("https://bioconductor.org/packages/%s/data/experiment", .biocv), "https://cloud.r-project.org")
      suppressWarnings(try(install.packages(.bm_miss, repos=.repos, quiet=TRUE), silent=TRUE))
    }
        # [biomate] flatten staged inputs (stageAs '?/*' -> numbered subdirs)
        for (.bm_d in list.files(".", full.names = TRUE)) {
          if (dir.exists(.bm_d) && grepl("/[0-9]+\$", .bm_d)) {
            for (.bm_e in list.files(.bm_d, full.names = TRUE)) {
              if (!file.exists(basename(.bm_e))) try(file.copy(.bm_e, ".", recursive = TRUE), silent = TRUE)
            }
          }
        }
            
            # Load required libraries
            library(vidger)
            
            # Read the user input file 'df.cuff' from the working directory.
            # Cuffdiff outputs are typically tabular text files.
            if (file.exists("df.cuff")) {
                df.cuff <- read.table("df.cuff", header = TRUE, sep = "\t", stringsAsFactors = FALSE)
            } else {
                stop("Error: Required input file 'df.cuff' not found in the working directory.")
            }
            
            # Extract treatment names dynamically from the Cuffdiff data frame
            treatments <- unique(c(as.character(df.cuff\$sample_1), as.character(df.cuff\$sample_2)))
            if (length(treatments) < 2) {
                stop("Error: At least two treatments are required in the dataset.")
            }
            trt1 <- treatments[1]
            trt2 <- treatments[2]
            
            # 1. Generate box plots to check FPKM distribution across treatments
            pdf("vsBoxPlot_cuffdiff.pdf", width = 8, height = 6)
            p_box <- vsBoxPlot(
                data = df.cuff, d.factor = NULL, type = 'cuffdiff', title = TRUE, 
                legend = TRUE, grid = TRUE
            )
            print(p_box)
            dev.off()
            
            # 2. Create scatter plots and scatter matrices to compare FPKM values between treatments
            pdf("vsScatterPlot_cuffdiff.pdf", width = 8, height = 6)
            p_scatter <- vsScatterPlot(
                x = trt1, y = trt2, data = df.cuff, type = 'cuffdiff',
                d.factor = NULL, title = TRUE, grid = TRUE
            )
            print(p_scatter)
            dev.off()
            
            pdf("vsScatterMatrix_cuffdiff.pdf", width = 10, height = 10)
            p_scatter_matrix <- vsScatterMatrix(
                data = df.cuff, d.factor = NULL, type = 'cuffdiff', 
                comp = NULL, title = TRUE, grid = TRUE, man.title = NULL
            )
            print(p_scatter_matrix)
            dev.off()
            
            # 3. Visualize the number of DEGs at a given adjusted p-value
            pdf("vsDEGMatrix_cuffdiff.pdf", width = 8, height = 6)
            p_deg_matrix <- vsDEGMatrix(
                data = df.cuff, padj = 0.05, d.factor = NULL, type = 'cuffdiff', 
                title = TRUE, legend = TRUE, grid = TRUE
            )
            print(p_deg_matrix)
            dev.off()
            
            # 4. Generate MA plots and MA matrices to visualize variance and log fold changes
            pdf("vsMAPlot_cuffdiff.pdf", width = 8, height = 6)
            p_ma <- vsMAPlot(
                x = trt2, y = trt1, data = df.cuff, d.factor = NULL, 
                type = 'cuffdiff', padj = 0.05, y.lim = NULL, lfc = NULL, 
                title = TRUE, legend = TRUE, grid = TRUE
            )
            print(p_ma)
            dev.off()
            
            pdf("vsMAMatrix_cuffdiff.pdf", width = 10, height = 10)
            p_ma_matrix <- vsMAMatrix(
                data = df.cuff, d.factor = NULL, type = 'cuffdiff', 
                padj = 0.05, y.lim = NULL, lfc = 1, title = TRUE, 
                grid = TRUE, counts = TRUE, data.return = FALSE
            )
            print(p_ma_matrix)
            dev.off()
            
            # 5. Create volcano plots and volcano matrices to compare significance against log fold changes
            pdf("vsVolcano_cuffdiff.pdf", width = 8, height = 6)
            p_volcano <- vsVolcano(
                x = trt2, y = trt1, data = df.cuff, d.factor = NULL, 
                type = 'cuffdiff', padj = 0.05, x.lim = NULL, lfc = NULL, 
                title = TRUE, legend = TRUE, grid = TRUE, data.return = FALSE
            )
            print(p_volcano)
            dev.off()
            
            pdf("vsVolcanoMatrix_cuffdiff.pdf", width = 10, height = 10)
            p_volcano_matrix <- vsVolcanoMatrix(
                data = df.cuff, d.factor = NULL, type = 'cuffdiff', 
                padj = 0.05, x.lim = NULL, lfc = NULL, title = TRUE, 
                legend = TRUE, grid = TRUE, counts = TRUE
            )
            print(p_volcano_matrix)
            dev.off()
            
            # 6. Compare two treatments against a control using vsFourWay()
            if (length(treatments) >= 3) {
                trt3 <- treatments[3]
                pdf("vsFourWay_cuffdiff.pdf", width = 8, height = 6)
                p_fourway <- vsFourWay(
                    x = trt2, y = trt1, control = trt3, data = df.cuff,
                    d.factor = NULL, type = 'cuffdiff', padj = 0.05, x.lim = NULL,
                    y.lim = NULL, lfc = NULL, legend = TRUE, title = TRUE, grid = TRUE
                )
                print(p_fourway)
                dev.off()
            } else {
                message("Skipping vsFourWay(): At least three treatments are required in the dataset.")
            }

    writeLines(c(
        '"BIOC_VIDGER_CUFFDIFF_DGE_VISUALIZATION":',
        paste0('    vidger: ', as.character(packageVersion('vidger')))
    ), "versions.yml")
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_cuffdiff_dge_visualization.csv versions.yml
    """
}

workflow BIOC_VIDGER_CUFFDIFF_DGE_VISUALIZATION_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ df.cuff ] ]

    main:
    BIOC_VIDGER_CUFFDIFF_DGE_VISUALIZATION(ch_input)

    emit:
    tables   = BIOC_VIDGER_CUFFDIFF_DGE_VISUALIZATION.out.tables
    plots    = BIOC_VIDGER_CUFFDIFF_DGE_VISUALIZATION.out.plots
    objects  = BIOC_VIDGER_CUFFDIFF_DGE_VISUALIZATION.out.objects
    versions = BIOC_VIDGER_CUFFDIFF_DGE_VISUALIZATION.out.versions
}
