#!/usr/bin/env nextflow
// ============================================================
// Bioconductor workflow: vtpnet — alt_allele_injection
// Generate an ALT-allele injected FASTA genome image for a specific chromosome to enable variant-aware motif matching.
// Input: chromosome_id.txt, snps_database.pkg, reference_genome.pkg
// Container: quay.io/biocontainers/bioconductor-vtpnet:0.50.0--r45hdfd78af_0
// Document-derived (two-stage interpret->build) real input-consuming pipeline.
// ============================================================

nextflow.enable.dsl = 2

process BIOC_VTPNET_ALT_ALLELE_INJECTION {
    tag "${meta.id}"
    label 'process_medium'

    container "quay.io/biocontainers/bioconductor-vtpnet:0.50.0--r45hdfd78af_0"

    input:
    tuple val(meta), path(input_files, stageAs: '?/*')

    output:
    tuple val(meta), path("*.csv"), emit: tables, optional: true
    tuple val(meta), path("*.pdf"), emit: plots,  optional: true
    tuple val(meta), path("*.rds"), emit: objects, optional: true
    path "versions.yml",            emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    #!/usr/bin/env Rscript
    # [biomate-deps] resolve declared dependencies so the workflow runs in any environment
    .bm_deps <- c("BSgenome", "Biostrings", "ShortRead", "hgpack", "slpack", "vtpnet")
    .bm_miss <- .bm_deps[!vapply(.bm_deps, function(.p) requireNamespace(.p, quietly=TRUE), logical(1))]
    if (length(.bm_miss)) {
      if (!requireNamespace("BiocManager", quietly=TRUE)) install.packages("BiocManager", repos="https://cloud.r-project.org")
      bin <- tryCatch(sprintf("https://bioconductor.org/packages/%s/container-binaries/bioconductor_docker", BiocManager::version()), error=function(e) NULL)
      suppressMessages(tryCatch(BiocManager::install(.bm_miss, update=FALSE, ask=FALSE, site_repository=bin), error=function(e) BiocManager::install(.bm_miss, update=FALSE, ask=FALSE)))
    }
    
    # Load required libraries
    library(vtpnet)
    library(BSgenome)
    library(Biostrings)
    library(ShortRead)
    
    # Read user inputs from the working directory
    if (!file.exists("chromosome_id.txt")) {
      stop("Error: 'chromosome_id.txt' not found in the working directory.")
    }
    if (!file.exists("snps_database.pkg")) {
      stop("Error: 'snps_database.pkg' not found in the working directory.")
    }
    if (!file.exists("reference_genome.pkg")) {
      stop("Error: 'reference_genome.pkg' not found in the working directory.")
    }
    
    chtag <- trimws(readLines("chromosome_id.txt", warn = FALSE)[1])
    slpack <- trimws(readLines("snps_database.pkg", warn = FALSE)[1])
    hgpack <- trimws(readLines("reference_genome.pkg", warn = FALSE)[1])
    
    # Define the documented altize function exactly as specified
    altize = function(chtag = "21",
      slpack="SNPlocs.Hsapiens.dbSNP.20120608",
      hgpack ="BSgenome.Hsapiens.UCSC.hg19",
      faElFun = function(x) sub("%%TAG%%", x, "alt%%TAG%%chr"),
      faTargFun = function(x) 
         sub("%%TAG%%", x, "alt%%TAG%%_hg19.fa")) {
        require(slpack, character.only=TRUE)
        require(hgpack, character.only=TRUE)
        require("ShortRead", character.only=TRUE)
        chk = grep("ch|chr", chtag)
        if (length(chk)>0) {
          warning("clearing prefix ch or chr from chtag")
          chtag = gsub("ch|chr", "", chtag)
          }
        snpgettag = paste0("ch", chtag)
        ggettag = paste0("chr", chtag)
        cursnps = getSNPlocs(snpgettag, as.GRanges=TRUE)
        curgenome = unmasked(Hsapiens[[ggettag]])
        ref_allele = 
         strsplit(as.character(curgenome[start(cursnps)]),
            NULL, fixed=TRUE)[[1L]]
        all_alleles = IUPAC_CODE_MAP[cursnps\$alleles_as_ambig]
        alt_alleles = mapply( function(ref,all)
          sub(ref, "", all, fixed=TRUE),
            ref_allele, all_alleles, USE.NAMES=FALSE)
        cursnps\$ref_allele = ref_allele
        cursnps\$alt_alleles = alt_alleles
        cursnps\$one_alt = substr(cursnps\$alt_alleles, 1, 1)
        altg = list(replaceLetterAt(curgenome, start(cursnps),
          cursnps\$one_alt))
        names(altg) = faElFun(chtag)
        writeFasta(DNAStringSet(altg), file=faTargFun(chtag))
    }
    
    # Run the workflow
    message("Running altize with the following parameters:")
    message("Chromosome tag: ", chtag)
    message("SNPs database package: ", slpack)
    message("Reference genome package: ", hgpack)
    
    # Execute the ALT-allele injection
    altize(chtag = chtag, slpack = slpack, hgpack = hgpack)
    
    # Determine the output file name generated by the function
    expected_output_file <- sub("%%TAG%%", gsub("ch|chr", "", chtag), "alt%%TAG%%_hg19.fa")
    
    # Write a summary CSV file of the execution
    summary_df <- data.frame(
      parameter = c("chromosome_id", "snps_database", "reference_genome", "output_fasta"),
      value = c(chtag, slpack, hgpack, expected_output_file),
      stringsAsFactors = FALSE
    )
    write.csv(summary_df, file = "alt_allele_injection_summary.csv", row.names = FALSE)
    
    message("Workflow completed successfully. Output written to: ", expected_output_file)

    cat <<-END_VERSIONS > versions.yml
    "BIOC_VTPNET_ALT_ALLELE_INJECTION":
        vtpnet: \$(Rscript -e 'cat(as.character(packageVersion("vtpnet")))')
    END_VERSIONS
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch ${prefix}_alt_allele_injection.csv versions.yml
    """
}

workflow BIOC_VTPNET_ALT_ALLELE_INJECTION_WORKFLOW {
    take:
    ch_input  // channel: [ val(meta), [ chromosome_id.txt, snps_database.pkg, reference_genome.pkg ] ]

    main:
    BIOC_VTPNET_ALT_ALLELE_INJECTION(ch_input)

    emit:
    tables   = BIOC_VTPNET_ALT_ALLELE_INJECTION.out.tables
    plots    = BIOC_VTPNET_ALT_ALLELE_INJECTION.out.plots
    objects  = BIOC_VTPNET_ALT_ALLELE_INJECTION.out.objects
    versions = BIOC_VTPNET_ALT_ALLELE_INJECTION.out.versions
}
