nextflow_process {
    name "Test Process ANALYZE_IN_VITRO_DRUG_RELEASE_KINETICS"
    script "../main.nf"
    process "ANALYZE_IN_VITRO_DRUG_RELEASE_KINETICS"

    test("Should run analyze_in_vitro_drug_release_kinetics with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
