nextflow_process {
    name "Test Process ANALYZE_MYOFIBER_MORPHOLOGY"
    script "../main.nf"
    process "ANALYZE_MYOFIBER_MORPHOLOGY"

    test("Should run analyze_myofiber_morphology with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
