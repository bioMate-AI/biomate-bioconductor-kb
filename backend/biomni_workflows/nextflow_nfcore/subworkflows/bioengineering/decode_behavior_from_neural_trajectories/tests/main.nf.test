nextflow_process {
    name "Test Process DECODE_BEHAVIOR_FROM_NEURAL_TRAJECTORIES"
    script "../main.nf"
    process "DECODE_BEHAVIOR_FROM_NEURAL_TRAJECTORIES"

    test("Should run decode_behavior_from_neural_trajectories with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
