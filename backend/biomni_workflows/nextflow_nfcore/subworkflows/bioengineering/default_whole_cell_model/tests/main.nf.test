nextflow_process {
    name "Test Process DEFAULT_WHOLE_CELL_MODEL"
    script "../main.nf"
    process "DEFAULT_WHOLE_CELL_MODEL"

    test("Should run default_whole_cell_model with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
