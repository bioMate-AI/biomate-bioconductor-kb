nextflow_process {

    name "Test Process FIRST_ORDER"
    script "../main.nf"
    process "FIRST_ORDER"

    test("Should run first_order successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
