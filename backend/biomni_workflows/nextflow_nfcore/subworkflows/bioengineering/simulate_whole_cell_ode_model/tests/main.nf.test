nextflow_process {
    name "Test Process SIMULATE_WHOLE_CELL_ODE_MODEL"
    script "../main.nf"
    process "SIMULATE_WHOLE_CELL_ODE_MODEL"

    test("Should run simulate_whole_cell_ode_model with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
