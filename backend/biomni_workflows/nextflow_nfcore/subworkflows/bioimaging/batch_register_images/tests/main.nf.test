nextflow_process {
    name "Test Process BATCH_REGISTER_IMAGES"
    script "../main.nf"
    process "BATCH_REGISTER_IMAGES"

    test("Should run batch_register_images with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
