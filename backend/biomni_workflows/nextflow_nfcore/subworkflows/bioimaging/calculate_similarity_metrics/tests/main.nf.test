nextflow_process {
    name "Test Process CALCULATE_SIMILARITY_METRICS"
    script "../main.nf"
    process "CALCULATE_SIMILARITY_METRICS"

    test("Should run calculate_similarity_metrics with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
