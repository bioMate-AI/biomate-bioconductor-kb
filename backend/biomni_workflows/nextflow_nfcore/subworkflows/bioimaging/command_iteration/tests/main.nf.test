nextflow_process {

    name "Test Process COMMAND_ITERATION"
    script "../main.nf"
    process "COMMAND_ITERATION"

    test("Should run command_iteration successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
