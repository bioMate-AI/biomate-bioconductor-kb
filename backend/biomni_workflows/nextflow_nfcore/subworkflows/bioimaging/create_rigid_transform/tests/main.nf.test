nextflow_process {

    name "Test Process CREATE_RIGID_TRANSFORM"
    script "../main.nf"
    process "CREATE_RIGID_TRANSFORM"

    test("Should run create_rigid_transform successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
