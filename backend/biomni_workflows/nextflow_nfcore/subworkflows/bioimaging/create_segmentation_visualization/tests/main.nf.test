nextflow_process {
    name "Test Process CREATE_SEGMENTATION_VISUALIZATION"
    script "../main.nf"
    process "CREATE_SEGMENTATION_VISUALIZATION"

    test("Should run create_segmentation_visualization with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
