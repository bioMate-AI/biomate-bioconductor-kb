nextflow_process {

    name "Test Process LOAD_IMAGE"
    script "../main.nf"
    process "LOAD_IMAGE"

    test("Should run load_image successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
