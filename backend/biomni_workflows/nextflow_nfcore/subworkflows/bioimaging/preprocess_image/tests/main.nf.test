nextflow_process {
    name "Test Process PREPROCESS_IMAGE"
    script "../main.nf"
    process "PREPROCESS_IMAGE"

    test("Should run preprocess_image with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
