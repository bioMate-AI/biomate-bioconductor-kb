nextflow_process {
    name "Test Process QUICK_RIGID_REGISTRATION"
    script "../main.nf"
    process "QUICK_RIGID_REGISTRATION"

    test("Should run quick_rigid_registration with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
