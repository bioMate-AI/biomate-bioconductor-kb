nextflow_process {
    name "Test Process SPLIT_MODALITIES"
    script "../main.nf"
    process "SPLIT_MODALITIES"

    test("Should run split_modalities with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
