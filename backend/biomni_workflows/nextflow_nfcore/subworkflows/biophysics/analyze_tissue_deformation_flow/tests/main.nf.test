nextflow_process {

    name "Test Process ANALYZE_TISSUE_DEFORMATION_FLOW"
    script "../main.nf"
    process "ANALYZE_TISSUE_DEFORMATION_FLOW"

    test("Should run analyze_tissue_deformation_flow successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
