nextflow_process {

    name "Test Process ANALYZE_DDR_NETWORK_IN_CANCER"
    script "../main.nf"
    process "ANALYZE_DDR_NETWORK_IN_CANCER"

    test("Should run analyze_ddr_network_in_cancer successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
