nextflow_process {

    name "Test Process NORM_CHR"
    script "../main.nf"
    process "NORM_CHR"

    test("Should run norm_chr successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
