nextflow_process {

    name "Test Process ANALYZE_MITOCHONDRIAL_MORPHOLOGY_AND_POTENTIAL"
    script "../main.nf"
    process "ANALYZE_MITOCHONDRIAL_MORPHOLOGY_AND_POTENTIAL"

    test("Should run analyze_mitochondrial_morphology_and_potential successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
