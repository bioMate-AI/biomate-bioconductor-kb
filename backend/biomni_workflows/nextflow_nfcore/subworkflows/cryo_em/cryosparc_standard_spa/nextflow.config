/*
 * CryoSPARC Standard SPA — Nextflow configuration
 * AWS Batch + parallelism settings
 */

params {
    // Defaults for parallelism params (can be overridden on the command line)
    micrograph_batch_size = 200
    particle_batch_size   = 10000
    num_gpu_workers       = 4
    num_gpu               = 4
    max_parallel_jobs     = 20
}

process {
    executor  = 'awsbatch'
    queue     = 'galaxy-cloud-queue'
    // All containers just submit/poll CryoSPARC — no local GPU compute
    container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/cryosparc-nf:latest'

    // All processes use LOW resources (they only talk to CryoSPARC API)
    withName: 'INIT_CRYOSPARC_PROJECT|SPLIT_INTO_BATCHES|SPLIT_PARTICLE_BATCHES' {
        cpus   = 2
        memory = '4 GB'
        queue  = 'galaxy-cloud-queue'
    }

    withName: 'PATCH_MOTION_CORRECTION_BATCH' {
        cpus   = 2
        memory = '4 GB'
        queue  = 'galaxy-cloud-queue'
    }

    withName: 'PATCH_CTF_ESTIMATION_BATCH' {
        cpus   = 2
        memory = '4 GB'
        queue  = 'galaxy-cloud-queue'
    }

    withName: 'BLOB_PICKER_BATCH|EXTRACT_PARTICLES_R1_BATCH' {
        cpus   = 2
        memory = '4 GB'
        queue  = 'galaxy-cloud-queue'
    }

    withName: 'CLASSIFY_2D_R1_BATCH|CLASSIFY_2D_R2_BATCH' {
        cpus   = 2
        memory = '4 GB'
        queue  = 'galaxy-cloud-queue'
    }

    withName: 'AB_INITIO_BATCH|HOMO_REFINEMENT_BATCH' {
        cpus   = 2
        memory = '4 GB'
        queue  = 'galaxy-cloud-queue'
    }

    withName: 'NON_UNIFORM_REFINEMENT|LOCAL_CTF_REFINEMENT' {
        cpus   = 2
        memory = '4 GB'
        queue  = 'galaxy-cloud-queue'
    }

    withName: 'MERGE_MICROGRAPHS|MERGE_PARTICLES|MERGE_CLASSES|MERGE_VOLUMES' {
        cpus   = 2
        memory = '4 GB'
        queue  = 'galaxy-cloud-queue'
    }

    withName: 'MICROGRAPH_DENOISER|JUNK_2D_DETECTOR|INSPECT_PICKS|INSPECT_PICKS_R2' {
        cpus   = 2
        memory = '4 GB'
        queue  = 'galaxy-cloud-queue'
    }

    withName: 'SELECT_2D_R1|SELECT_2D_R2|TEMPLATE_PICKER|EXTRACT_PARTICLES_R2' {
        cpus   = 2
        memory = '4 GB'
        queue  = 'galaxy-cloud-queue'
    }

    withName: 'VOLUME_TOOLS|VALIDATION_FSC|LOCAL_RESOLUTION|SHARPEN' {
        cpus   = 2
        memory = '4 GB'
        queue  = 'galaxy-cloud-queue'
    }
}

executor {
    // Cap parallel jobs to avoid overwhelming the CryoSPARC API
    queueSize       = params.max_parallel_jobs ?: 20
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
    jobName         = { "biomate-cryosparc-${task.process.tokenize(':').last()}-${task.index}" }
}

// AWS Batch-specific settings
aws {
    region = 'us-west-2'
    batch {
        cliPath        = '/usr/local/bin/aws'
        maxParallelTransfers = 4
    }
}

// Docker / container settings (applied on AWS Batch)
docker {
    enabled    = true
    runOptions = '--shm-size=4g'
}

// Tracing and reporting
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.txt"
    fields    = 'task_id,name,status,exit,realtime,cpus,memory,rss,vmem,rchar,wchar'
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
