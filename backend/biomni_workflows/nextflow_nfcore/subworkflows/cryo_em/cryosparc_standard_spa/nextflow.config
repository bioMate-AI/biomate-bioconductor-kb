/*
 * CryoSPARC Standard SPA — Nextflow configuration
 * AWS Batch + parallelism settings
 */

params {
    // Defaults for parallelism params (can be overridden on the command line)
    micrograph_batch_size = 200
    particle_batch_size   = 10000
    num_gpu_workers       = 1
    max_parallel_jobs     = 20
}

process {
    executor = 'awsbatch'
    queue    = 'biomate-nextflow-queue'

    // Per-process resource overrides
    withName: 'SPLIT_INTO_BATCHES|SPLIT_PARTICLE_BATCHES' {
        cpus   = 1
        memory = '2 GB'
    }

    withName: 'PATCH_MOTION_CORRECTION_BATCH' {
        cpus   = 4
        memory = '16 GB'
        // GPU processes use the GPU queue when available
        queue  = 'biomate-nextflow-queue'
    }

    withName: 'PATCH_CTF_ESTIMATION_BATCH' {
        cpus   = 2
        memory = '8 GB'
    }

    withName: 'BLOB_PICKER_BATCH|EXTRACT_PARTICLES_R1_BATCH' {
        cpus   = 2
        memory = '8 GB'
    }

    withName: 'CLASSIFY_2D_R1_BATCH|CLASSIFY_2D_R2_BATCH' {
        cpus   = 4
        memory = '32 GB'
    }

    withName: 'AB_INITIO_BATCH|HOMO_REFINEMENT_BATCH' {
        cpus   = 8
        memory = '64 GB'
    }

    withName: 'NON_UNIFORM_REFINEMENT' {
        cpus   = 8
        memory = '64 GB'
    }
}

executor {
    // Cap parallel jobs to avoid overwhelming the CryoSPARC API
    queueSize       = params.max_parallel_jobs ?: 20
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
    jobName         = { "biomate-cryosparc-${task.process.tokenize(':').last()}-${task.index}" }
}

// AWS Batch-specific settings
aws {
    region = 'us-west-2'
    batch {
        cliPath        = '/usr/local/bin/aws'
        maxParallelTransfers = 4
    }
}

// Docker / container settings (applied on AWS Batch)
docker {
    enabled    = true
    runOptions = '--shm-size=4g'
}

// Tracing and reporting
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.txt"
    fields    = 'task_id,name,status,exit,realtime,cpus,memory,rss,vmem,rchar,wchar'
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
