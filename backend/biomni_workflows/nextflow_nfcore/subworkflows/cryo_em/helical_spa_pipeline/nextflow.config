/*
 * Helical SPA Pipeline — Nextflow Configuration
 *
 * Profiles: test, docker, singularity, local_gpu, slurm
 */

// ============================================================================
// Global defaults
// ============================================================================

params {
    // Input / output
    movies_path   = null
    outdir        = './results/helical_spa'

    // Acquisition
    pixel_size    = 1.05    // Å/px
    voltage       = 300     // kV
    cs            = 2.7     // spherical aberration (mm)
    total_dose    = 50.0    // e-/Å²

    // Helical parameters
    filament_diameter_angstroms   = 150
    helical_rise_angstroms        = 4.75
    helical_twist_deg             = -166.15

    // Processing mode
    mock_mode     = true
    use_cryosparc = false

    // Resource limits (overridden per profile)
    max_memory    = '128.GB'
    max_cpus      = 16
    max_time      = '24.h'
}

// ============================================================================
// Process labels
// ============================================================================

process {
    withLabel: 'process_single' {
        cpus   = 1
        memory = '6.GB'
        time   = '4.h'
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = '12.GB'
        time   = '4.h'
    }
    withLabel: 'process_medium' {
        cpus   = 6
        memory = '36.GB'
        time   = '8.h'
    }
    withLabel: 'process_high' {
        cpus   = 12
        memory = '72.GB'
        time   = '16.h'
    }
    withLabel: 'process_gpu' {
        cpus        = 8
        memory      = '60.GB'
        time        = '16.h'
        accelerator = 1
    }
}

// ============================================================================
// Profiles
// ============================================================================

profiles {

    test {
        params {
            mock_mode  = true
            outdir     = './results/helical_spa_test'
            max_memory = '8.GB'
            max_cpus   = 4
            max_time   = '1.h'
        }
        process {
            resourceLimits = [
                cpus  : 4,
                memory: '8.GB',
                time  : '1.h'
            ]
        }
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '--gpus all'
        singularity.enabled    = false

        process {
            withLabel: 'process_gpu' {
                containerOptions = '--gpus all'
            }
            // Default container covers Python + CryoSPARC mock dependencies
            container = 'quay.io/biocontainers/python:3.11'
        }
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false

        process {
            withLabel: 'process_gpu' {
                containerOptions = '--nv'
            }
            container = 'docker://quay.io/biocontainers/python:3.11'
        }
    }

    local_gpu {
        process {
            executor = 'local'
            withLabel: 'process_gpu' {
                cpus        = 8
                memory      = '60.GB'
                accelerator = 1
            }
        }
        docker.enabled    = true
        docker.runOptions = '--gpus all'
    }

    slurm {
        process {
            executor = 'slurm'

            withLabel: 'process_single' {
                cpus   = 1
                memory = '6.GB'
                time   = '4.h'
                clusterOptions = '--partition=cpu'
            }
            withLabel: 'process_medium' {
                cpus   = 8
                memory = '48.GB'
                time   = '8.h'
                clusterOptions = '--partition=cpu'
            }
            withLabel: 'process_gpu' {
                cpus   = 8
                memory = '60.GB'
                time   = '16.h'
                clusterOptions = '--partition=gpu --gres=gpu:1'
            }
        }
    }
}

// ============================================================================
// Manifest
// ============================================================================

manifest {
    name        = 'helical_spa_pipeline'
    author      = 'BioMate'
    description = 'Complete CryoSPARC helical single-particle analysis pipeline'
    version     = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
