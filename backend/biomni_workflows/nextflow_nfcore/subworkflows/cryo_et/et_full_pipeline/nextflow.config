/*
 * Nextflow configuration for the Cryo-ET Full Pipeline
 */

profiles {

    test {
        params.tiltseries_path = 'test_data/'
        params.outdir = 'results/test_et'
        params.pixel_size = 1.35
        params.voltage = 300
        params.total_dose = 120.0
        params.alignment_method = 'aretomo2'
        params.reconstruction_method = 'wbp'
        params.num_particles = 500
        params.num_sta_rounds = 2
    }

    docker {
        docker.enabled = true
        docker.runOptions = '--gpus all'
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }

    stub {
        stubRun = true
    }

    local_gpu {
        process {
            withLabel: 'process_gpu' {
                clusterOptions = '--gres=gpu:1'
                memory = '32 GB'
                cpus = 8
            }
        }
    }

    slurm {
        process.executor = 'slurm'
        process {
            withLabel: 'process_gpu' {
                clusterOptions = '--gres=gpu:1 --partition=gpu'
                memory = '64 GB'
                cpus = 16
                time = '24h'
            }
            withoutLabel: 'process_gpu' {
                memory = '16 GB'
                cpus = 4
                time = '4h'
            }
        }
    }


    aws {
        docker.enabled = true
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-nextflow-queue'
            container   = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/aretomo2:latest'
            withLabel: 'process_gpu' {
                queue       = 'biomate-nextflow-gpu-queue'
                accelerator = 1
            }
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/usr/local/bin/aws'
        }
    }
}

// Default resource limits
process {
    withLabel: 'process_gpu' {
        // GPU processes: tilt alignment and subtomogram averaging
        // Container label only — actual container set per-deployment
        memory = '32 GB'
        cpus = 8
    }
}
