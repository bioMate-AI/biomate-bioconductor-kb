/*
 * BioMate Nextflow Configuration
 * cryo_et/tomogram_reconstruction
 *
 * Weighted back-projection tomogram reconstruction
 */

params {
    outdir           = './results/tomogram_reconstruction'
    publish_dir_mode = 'copy'

    // CryoSPARC connection (used when use_cryosparc = true)
    cryosparc_host          = 'localhost'
    cryosparc_port          = 39000
    cryosparc_email         = ''
    cryosparc_password      = ''
    cryosparc_project_uid   = ''
    cryosparc_workspace_uid = ''
    use_cryosparc           = false
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'process_gpu' {
        cpus        = 8
        memory      = '64.GB'
        time        = '12h'
        accelerator = 1
    }
    withLabel: 'process_high' {
        cpus   = 12
        memory = '64.GB'
        time   = '12h'
    }
    withLabel: 'process_medium' {
        cpus   = 6
        memory = '32.GB'
        time   = '8h'
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = '12.GB'
        time   = '4h'
    }
}

profiles {

    standard {
        docker.enabled      = false
        singularity.enabled = false
        process.executor    = 'local'
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '--gpus all -u $(id -u):$(id -g)'
        singularity.enabled = false
        process.executor    = 'local'
        process.container   = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/aretomo2:latest'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        process.container      = 'docker://399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/aretomo2:latest'
    }

    aws {
        docker.enabled = true
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-nextflow-queue'
            container   = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/aretomo2:latest'
            withLabel: 'process_gpu' {
                queue       = 'biomate-nextflow-gpu-queue'
                accelerator = 1
            }
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/usr/local/bin/aws'
        }
    }
}

manifest {
    name            = 'biomate/tomogram_reconstruction'
    author          = 'BioMate AI'
    description     = 'Weighted back-projection tomogram reconstruction'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
