nextflow_process {

    name "Test Process GET_GENES_NEAR_CCRE"
    script "../main.nf"
    process "GET_GENES_NEAR_CCRE"

    test("Should run get_genes_near_ccre successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
