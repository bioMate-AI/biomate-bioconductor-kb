nextflow_process {
    name "Test Process REDUCE_TOKENS"
    script "../main.nf"
    process "REDUCE_TOKENS"

    test("Should run reduce_tokens with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
