/*
 * BioMate Nextflow Configuration
 * drug_discovery/aizynthfinder_retrosynthesis
 *
 * AiZynthFinder retrosynthesis pipeline
 *
 * Profiles:
 *   standard    — mock mode, local executor (default; no AiZynthFinder models needed)
 *   docker      — Docker container, live mode (biomate/biomni-drug-discovery-nf:latest)
 *   gpu         — GPU-enabled local execution
 */

params {
    outdir                  = './results/aizynthfinder_retrosynthesis'
    publish_dir_mode        = 'copy'
    mock_mode               = true
    smiles_file             = null
    aizynthfinder_config    = '/opt/aizynthfinder/config.yml'
    max_routes              = 5
    max_depth               = 6
    score_threshold         = 0.6
    max_steps_pass          = 4
    max_steps_warn          = 6
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

profiles {

    standard {
        params.mock_mode    = true
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        params.mock_mode    = true
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        params.mock_mode    = false
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false
        process.executor    = 'local'
    }

    gpu {
        params.mock_mode    = false
        docker.enabled      = true
        docker.runOptions   = '--gpus all -u $(id -u):$(id -g)'
        singularity.enabled = false
        process.executor    = 'local'
    }

    singularity {
        params.mock_mode        = false
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite  = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite  = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite  = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/aizynthfinder_retrosynthesis'
    author          = 'BioMate AI'
    description     = 'AiZynthFinder retrosynthesis route planning pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
