/*
 * alphafold_db_search — Nextflow configuration
 */

params {
    query_pdb     = ''
    query_fasta   = ''
    search_mode   = 'both'          // 'structural' | 'sequence' | 'both'
    max_hits      = 50
    evalue        = 0.001
    min_seq_id    = 0.0
    coverage      = 0.8
    mock_mode     = false
    s3_db_base    = 's3://biomate-structure-db/alphafold/human'
    outdir        = 'results'
}

process {
    withName: 'FOLDSEEK_STRUCTURAL_SEARCH' {
        cpus   = 8
        memory = '32 GB'
        time   = '2 h'
    }
    withName: 'MMSEQS2_SEQUENCE_SEARCH' {
        cpus   = 8
        memory = '32 GB'
        time   = '1 h'
    }
    withName: 'MERGE_SEARCH_RESULTS' {
        cpus   = 2
        memory = '4 GB'
        time   = '30 min'
    }
}

profiles {
    docker {
        docker.enabled = true
        process {
            withName: 'FOLDSEEK_STRUCTURAL_SEARCH' {
                container = 'steineggerlab/foldseek:latest'
            }
            withName: 'MMSEQS2_SEQUENCE_SEARCH' {
                container = 'soedinglab/mmseqs2:latest'
            }
            withName: 'MERGE_SEARCH_RESULTS' {
                container = 'python:3.11-slim'
            }
        }
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            withName: 'FOLDSEEK_STRUCTURAL_SEARCH' {
                container = 'docker://steineggerlab/foldseek:latest'
            }
            withName: 'MMSEQS2_SEQUENCE_SEARCH' {
                container = 'docker://soedinglab/mmseqs2:latest'
            }
            withName: 'MERGE_SEARCH_RESULTS' {
                container = 'docker://python:3.11-slim'
            }
        }
    }

    aws {
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-nextflow-queue'
            container   = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate-nextflow-base:latest'
        }
        aws {
            region    = 'us-west-2'
            batch.cliPath = '/usr/local/bin/aws'
        }
    }

    mock {
        params.mock_mode = true
        process {
            cpus   = 1
            memory = '2 GB'
            time   = '5 min'
        }
    }
}
