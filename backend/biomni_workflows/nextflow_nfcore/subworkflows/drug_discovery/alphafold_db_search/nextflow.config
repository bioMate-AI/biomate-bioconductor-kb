/*
 * alphafold_db_search — Nextflow configuration
 *
 * API-based workflow: no local database download, no heavy binaries.
 * Runs on the standard queue with minimal resources.
 */

params {
    query_pdb   = ''
    query_fasta = ''
    max_hits    = 50
    evalue      = 0.001
    databases   = 'afdb50,afdb-swissprot,pdb100'
    outdir      = 'results'
}

process {
    withName: 'ALPHAFOLD_API_SEARCH' {
        cpus   = 1
        memory = '2 GB'
        time   = '30 min'   // Foldseek + HMMER API polls take <10 min typically
    }
}

profiles {
    docker {
        docker.enabled = true
        process {
            withName: 'ALPHAFOLD_API_SEARCH' {
                container = 'python:3.11-slim'
            }
        }
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            withName: 'ALPHAFOLD_API_SEARCH' {
                container = 'docker://python:3.11-slim'
            }
        }
    }
    aws {
        process {
            executor  = 'awsbatch'
            queue     = 'galaxy-cloud-queue'
            container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate-nextflow-base:latest'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
    }
}
