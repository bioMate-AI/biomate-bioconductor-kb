/*
 * BioMate Nextflow Configuration
 * drug_discovery/amber_peptide_mmgbsa
 *
 * Protein-PEPTIDE MD + MM-GBSA. Build is EXTERNAL (CHARMM-GUI): this workflow consumes a pre-built,
 * solvated complex topology (AMBER prmtop/inpcrd) and automates MD + MM-GBSA (peptide-range split).
 * Reuses the amber_pmemd_md min/equil/production/analysis processes.
 *
 * STATUS: v1 downstream — reviewed, NOT yet smoke-tested end-to-end (needs a CHARMM-GUI bundle).
 */

params {
    outdir           = './results/amber_peptide_mmgbsa'
    publish_dir_mode = 'copy'
    complex_prmtop   = null
    complex_inpcrd   = null
    pep_start        = null
    pep_end          = null
    force_field      = 'ff19SB'
    water_model      = 'tip3p'
    n_steps          = 5000000
    dt               = 0.002
    temperature      = 300
    pressure         = 1.0
    mmgbsa_startframe = 500
    mmgbsa_interval  = 5
    n_cpus           = 8
    gpu              = true
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'ENERGY_MINIMIZATION' { cpus = 16; memory = '32.GB'; time = '2h'  }
    withName: 'EQUILIBRATION'       { cpus = 16; memory = '32.GB'; time = '4h'  }
    withName: 'PRODUCTION_MD'       { cpus = 8;  memory = '32.GB'; time = '48h' }
    withName: 'TRAJECTORY_ANALYSIS' { cpus = 8;  memory = '16.GB'; time = '2h'  }
    withName: 'MM_GBSA'             { cpus = 8;  memory = '32.GB'; time = '6h'  }
}

profiles {
    standard   { params.gpu = false; process.executor = 'local'; docker.enabled = false; singularity.enabled = false }
    test       { params.n_steps = 1000; params.gpu = false; process.executor = 'local'; docker.enabled = false; singularity.enabled = false }
    docker     { docker.enabled = true; docker.runOptions = '-u $(id -u):$(id -g) -v /tmp:/tmp'; singularity.enabled = false; process.executor = 'local' }
    gpu        { docker.enabled = true; docker.runOptions = '--gpus all -u $(id -u):$(id -g)'; singularity.enabled = false; process.executor = 'local'
                 process { withName: 'PRODUCTION_MD' { maxForks = 1 } } }
    singularity{ singularity.enabled = true; singularity.autoMounts = true; docker.enabled = false }

    aws {
        params.use_aws = true; docker.enabled = true
        process { executor = 'awsbatch'; queue = 'biomate-nextflow-queue' }
        aws { region = 'us-west-2'; batch.cliPath = '/opt/aws-cli/bin/aws' }
    }

    gpu_batch {
        // GPU steps (EQUILIBRATION, PRODUCTION_MD via pmemd.cuda) -> GPU queue; CPU steps -> hpc queue.
        params.use_aws = true; docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'; singularity.enabled = false
        process {
            executor  = 'awsbatch'
            queue     = 'biomate-hpc-queue'
            container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/ambertools-gromacs-nf:latest'
            withName: 'EQUILIBRATION' { queue = 'galaxy-cloud-queue-gpu'; accelerator = 1; docker.runOptions = '--gpus all -u $(id -u):$(id -g)' }
            withName: 'PRODUCTION_MD' { queue = 'galaxy-cloud-queue-gpu'; accelerator = 1; maxForks = 1; docker.runOptions = '--gpus all -u $(id -u):$(id -g)' }
            withName: 'MM_GBSA'       { queue = 'biomate-hpc-queue' }
        }
        aws { region = 'us-west-2'; batch.cliPath = '/opt/aws-cli/bin/aws' }
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt"; overwrite = true; fields = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss' }

manifest {
    name            = 'biomate/amber_peptide_mmgbsa'
    author          = 'BioMate AI'
    description     = 'Protein-peptide MD + MM-GBSA (consumes CHARMM-GUI-built complex; peptide-range split)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}
