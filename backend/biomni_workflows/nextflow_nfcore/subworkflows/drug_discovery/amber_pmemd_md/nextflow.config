/*
 * BioMate Nextflow Configuration
 * drug_discovery/amber_pmemd_md
 *
 * AMBER pmemd molecular dynamics pipeline
 *
 * Profiles:
 *   standard    — local executor (default)
 *   docker      — Docker containers, live mode (ambermd/ambertools + ECR amber24-cuda)
 *   gpu         — GPU-accelerated pmemd.cuda (requires NVIDIA GPU + ECR image)
 */

params {
    outdir              = './results/amber_pmemd_md'
    publish_dir_mode    = 'copy'
    receptor            = null
    ligand              = null
    force_field         = 'ff19SB'
    water_model         = 'opc'
    n_steps             = 5000000
    dt                  = 0.002
    temperature         = 300
    pressure            = 1.0
    n_cpus              = 8
    gpu                 = true
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'ENERGY_MINIMIZATION' {
        cpus   = 16
        memory = '32.GB'
        time   = '2h'
    }
    withName: 'NVT_EQUILIBRATION' {
        cpus   = 16
        memory = '32.GB'
        time   = '4h'
    }
    withName: 'NPT_EQUILIBRATION' {
        cpus   = 16
        memory = '32.GB'
        time   = '4h'
    }
    withName: 'AMBER_PRODUCTION_MD' {
        cpus   = 8
        memory = '32.GB'
        time   = '48h'
    }
}

profiles {

    standard {
        params.gpu          = false
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        params.n_steps      = 1000
        params.gpu          = false
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false
        process.executor    = 'local'
    }

    gpu {
        docker.enabled      = true
        docker.runOptions   = '--gpus all -u $(id -u):$(id -g)'
        singularity.enabled = false
        process.executor    = 'local'

        process {
            withName: 'AMBER_PRODUCTION_MD' {
                maxForks = 1
            }
        }
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }

    aws {
        params.use_aws = true
        docker.enabled = true
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-nextflow-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/usr/local/bin/aws'
        }
    }

    gpu_batch {
        // Mixed-queue profile: CPU prep steps → biomate-hpc-queue (c5.4xlarge / r5.4xlarge, heavy CPU)
        // GPU MD step → galaxy-cloud-queue-gpu
        params.use_aws = true
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false

        process {
            executor  = 'awsbatch'
            queue     = 'biomate-hpc-queue'
            container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/ambertools-gromacs-nf:latest'

            withName: 'AMBER_PRODUCTION_MD' {
                queue       = 'galaxy-cloud-queue-gpu'
                accelerator = 1
                maxForks    = 1
                docker.runOptions = '--gpus all -u $(id -u):$(id -g)'
            }
            withName: 'MM_GBSA' {
                queue = 'biomate-hpc-queue'
            }
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/usr/local/bin/aws'
        }
    }
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite  = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite  = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite  = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/amber_pmemd_md'
    author          = 'BioMate AI'
    description     = 'AMBER pmemd protein-ligand molecular dynamics pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
