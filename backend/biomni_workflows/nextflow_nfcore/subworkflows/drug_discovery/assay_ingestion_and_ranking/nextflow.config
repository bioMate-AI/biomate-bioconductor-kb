/*
 * BioMate Nextflow Configuration
 * drug_discovery/assay_ingestion_and_ranking
 *
 * Multi-assay compound ingestion, safety/potency scoring, and composite ranking.
 */

params {
    outdir             = './results/assay_ingestion_and_ranking'
    publish_dir_mode   = 'copy'
    assay_csv          = null
    potency_assay      = 'IC50_BCR_ABL1'
    safety_assay       = 'hERG_IC50'
    potency_weight     = 0.6
    safety_weight      = 0.4
    herg_safe_threshold = 1.0
    top_n              = 10
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'PARSE_ASSAY_DATA' {
        cpus   = 2
        memory = '4.GB'
        time   = '30min'
    }
    withName: 'COMPUTE_COMPOSITE_SCORE' {
        cpus   = 2
        memory = '4.GB'
        time   = '30min'
    }
    withName: 'RANK_AND_REPORT' {
        cpus   = 2
        memory = '4.GB'
        time   = '30min'
    }
}

profiles {

    standard {
        docker.enabled      = false
        singularity.enabled = false
        process.executor    = 'local'
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        process.executor    = 'local'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    aws {
        docker.enabled = true
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-nextflow-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
    }
}

timeline {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields   = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/assay_ingestion_and_ranking'
    author          = 'BioMate AI'
    description     = 'Multi-assay compound ingestion, composite safety-potency scoring, and CRO-ready ranked output'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
