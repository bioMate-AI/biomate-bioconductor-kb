/*
 * BioMate Nextflow Configuration
 * drug_discovery/cro_submission_export
 *
 * Format top-N compounds for CRO submission (WuXi AppTec standard format).
 */

params {
    outdir              = './results/cro_submission_export'
    publish_dir_mode    = 'copy'
    compound_csv        = null
    cro_target          = 'WuXiAppTec'
    top_n               = 5
    herg_safe_threshold  = 1.0
    assay_name          = 'BCR-ABL1 Kinase Inhibition'
    project_code        = 'BIOMATE-BCR-ABL1-2026'
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'VALIDATE_COMPOUNDS' {
        cpus   = 2
        memory = '4.GB'
        time   = '30min'
    }
    withName: 'FORMAT_CRO_SUBMISSION' {
        cpus   = 2
        memory = '4.GB'
        time   = '30min'
    }
    withName: 'EXPORT_CSV' {
        cpus   = 2
        memory = '4.GB'
        time   = '30min'
    }
}

profiles {

    standard {
        docker.enabled      = false
        singularity.enabled = false
        process.executor    = 'local'
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        process.executor    = 'local'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    aws {
        docker.enabled = true
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-nextflow-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
    }
}

timeline {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields   = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/cro_submission_export'
    author          = 'BioMate AI'
    description     = 'Format top-N ranked compounds for CRO submission (WuXi AppTec standard SDF+CSV package)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
