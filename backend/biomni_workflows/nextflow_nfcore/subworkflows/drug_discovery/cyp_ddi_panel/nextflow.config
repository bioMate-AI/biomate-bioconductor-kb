/*
 * BioMate Nextflow Configuration
 * drug_discovery/cyp_ddi_panel
 *
 * CYP450 DDI Panel + Hepatic Clearance Prediction
 *
 * Profiles:
 *   standard    — local executor (default)
 *   docker      — Docker containers
 *   aws         — AWS Batch (CPU, fast)
 */

params {
    outdir                      = './results/cyp_ddi_panel'
    publish_dir_mode            = 'copy'
    smiles                      = null
    compound_name               = 'drug_candidate'
    cyp_isoforms                = 'CYP1A2,CYP2C9,CYP2C19,CYP2D6,CYP3A4'
    inhibitor_cutoff_1um        = true
    inhibitor_cutoff_10um       = true
    hepatocyte_scalingFactor    = 99.0
    liver_weight_g              = 1500
    fu_mic                      = 1.0
    fu_plasma                   = null
    blood_to_plasma_ratio       = 1.0
    f_a                         = 1.0
    max_clinical_dose_mg        = null
    dose_route                  = 'oral'
    n_cpus                      = 4
    gpu                         = false
    use_aws                     = false
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'SMILES_VALIDATION' {
        cpus   = 2
        memory = '4.GB'
        time   = '30m'
    }
    withName: 'CYP_INHIBITION' {
        cpus   = 4
        memory = '8.GB'
        time   = '2h'
    }
    withName: 'HEPATIC_CLEARANCE' {
        cpus   = 4
        memory = '8.GB'
        time   = '1h'
    }
    withName: 'DDI_RISK_ASSESSMENT' {
        cpus   = 2
        memory = '4.GB'
        time   = '30m'
    }
    withName: 'DDI_REPORT' {
        cpus   = 2
        memory = '4.GB'
        time   = '30m'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor  = 'local'
    }

    aws {
        params.use_aws  = true
        process {
            executor = 'awsbatch'
            queue    = 'biomate-nextflow-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
        workDir = 's3://biomate-nextflow-work/cyp_ddi_panel/'
    }
}
