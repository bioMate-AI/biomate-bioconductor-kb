  all_genes     = all_genes[:200]
  
  # ---------------------------------------------------------------------------
  # Assign DE statistics
  # ~20 % of genes are significantly DE (padj < 0.05, |log2FC| > 1).
  # Kinase genes get stronger signal (80 % sig probability).
  # ---------------------------------------------------------------------------
