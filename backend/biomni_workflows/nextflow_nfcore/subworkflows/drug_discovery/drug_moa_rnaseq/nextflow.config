/*
 * BioMate Nextflow Configuration
 * drug_discovery/drug_moa_rnaseq
 *
 * Drug mechanism-of-action characterisation via RNA-seq (DESeq2 + fgsea + CMap)
 *
 * Profiles:
 *   standard    — mock mode, local executor (default; no DESeq2/fgsea needed)
 *   docker      — Docker container, live mode (bioconductor/bioconductor_docker)
 */

params {
    outdir              = './results/drug_moa_rnaseq'
    publish_dir_mode    = 'copy'
    mock_mode           = true
    drug_name           = 'Imatinib'
    target_gene         = 'BCR-ABL1'
    n_replicates        = 3
    gmt_file            = null   // falls back to gseapy built-in hallmarks if not provided
    treated_counts      = null
    control_counts      = null
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'DESEQ2_DIFFERENTIAL_EXPRESSION' {
        cpus   = 4
        memory = '16.GB'
        time   = '2h'
    }
    withName: 'GSEA_PATHWAY_ENRICHMENT' {
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
    }
}

profiles {

    standard {
        params.mock_mode    = true
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        params.mock_mode    = true
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        params.mock_mode    = false
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp -e HOME=/tmp -e MPLCONFIGDIR=/tmp/matplotlib'
        singularity.enabled = false
        process.executor    = 'local'
    }

    singularity {
        params.mock_mode        = false
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite  = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite  = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite  = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/drug_moa_rnaseq'
    author          = 'BioMate AI'
    description     = 'Drug MoA characterisation: differential expression, GSEA, CMap matching'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
