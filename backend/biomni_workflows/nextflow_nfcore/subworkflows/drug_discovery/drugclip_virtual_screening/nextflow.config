/*
 * DrugCLIP Virtual Screening — Nextflow config
 * GPU accelerated but can fall back to CPU for small compound sets
 */

params {
    outdir           = './results'
    publish_dir_mode = 'copy'
}

process {
    container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/ai-tools/drugclip:latest'

    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 30.min
    }
    withLabel: 'process_gpu' {
        cpus        = 8
        memory      = 16.GB
        time        = 4.h
        accelerator = 1
    }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
}

profiles {
    standard {
        process.executor = 'local'
        docker.enabled   = true
    }

    gpu_batch {
        process.executor  = 'awsbatch'
        aws.region        = 'us-west-2'
        aws.batch.cliPath = '/opt/aws-cli/bin/aws'

        process {
            withLabel: 'process_gpu' {
                queue            = 'galaxy-cloud-queue-gpu'
                containerOptions = '--runtime=nvidia'
            }
            withLabel: 'process_low' {
                queue = 'biomate-nextflow-queue'
            }
        }
    }

    cpu_batch {
        process.executor  = 'awsbatch'
        aws.region        = 'us-west-2'
        aws.batch.cliPath = '/opt/aws-cli/bin/aws'

        process {
            withLabel: 'process_gpu' {
                queue = 'biomate-nextflow-queue'
                cpus  = 16
            }
            withLabel: 'process_low' {
                queue = 'biomate-nextflow-queue'
            }
        }
    }
}

manifest {
    name            = 'drugclip_virtual_screening'
    description     = 'Ultra-fast virtual screening with DrugCLIP (Science 2026)'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
