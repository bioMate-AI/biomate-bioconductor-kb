/*
 * BioMate Nextflow Configuration
 * drug_discovery/gromacs_protein_md
 *
 * GROMACS protein-ligand molecular dynamics pipeline
 *
 * Profiles:
 *   standard    — local executor (default; no GROMACS needed)
 *   docker      — Docker containers, live mode
 *   gpu         — GPU-accelerated MD (recommended for production runs)
 */

params {
    outdir              = './results/gromacs_protein_md'
    publish_dir_mode    = 'copy'
    receptor            = null
    ligand              = null
    force_field         = 'amber99sb-ildn'
    water_model         = 'tip3p'
    gaff_version        = 'gaff2'
    box_padding         = 12
    ion_concentration   = 0.15
    temperature         = 300
    pressure            = 1.0
    n_steps             = 5000000
    dt                  = 0.002
    nstxout_compressed  = 5000
    mmgbsa_startframe   = 500
    mmgbsa_endframe     = -1
    mmgbsa_interval     = 5
    n_cpus              = 8
    gpu                 = true
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'LIGAND_PREP' {
        cpus   = 4
        memory = '8.GB'
        time   = '2h'
    }
    withName: 'SYSTEM_SETUP' {
        cpus   = 4
        memory = '16.GB'
        time   = '2h'
    }
    withName: 'ENERGY_MINIMIZATION' {
        cpus   = 4
        memory = '8.GB'
        time   = '2h'
    }
    withName: 'NVT_EQUILIBRATION' {
        cpus   = 8
        memory = '16.GB'
        time   = '4h'
    }
    withName: 'NPT_EQUILIBRATION' {
        cpus   = 8
        memory = '16.GB'
        time   = '4h'
    }
    withName: 'PRODUCTION_MD' {
        cpus   = 8
        memory = '32.GB'
        time   = '48h'
    }
    withName: 'TRAJECTORY_ANALYSIS' {
        cpus   = 4
        memory = '8.GB'
        time   = '2h'
    }
    withName: 'MM_GBSA' {
        cpus   = 8
        memory = '32.GB'
        time   = '12h'
    }
}

profiles {

    standard {
        params.gpu          = false
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        params.n_steps      = 1000
        params.gpu          = false
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false
        process.executor    = 'local'
    }

    gpu {
        docker.enabled      = true
        docker.runOptions   = '--gpus all -u $(id -u):$(id -g)'
        singularity.enabled = false
        process.executor    = 'local'

        process {
            withName: 'GROMACS_PRODUCTION_MD' {
                maxForks = 1
            }
        }
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }

    aws {
        env.NEXTFLOW_USE_AWS = 'true'
        docker.enabled = true
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-nextflow-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/usr/local/bin/aws'
        }
    }

    gpu_batch {
        // Mixed-queue profile: CPU steps → biomate-nextflow-queue (internet access, Docker Hub OK)
        // GPU MD step      → galaxy-cloud-queue-gpu (g4dn instances, NVIDIA T4)
        // All processes use the ECR AmberTools+GROMACS image to avoid Docker Hub auth issues.
        // env.NEXTFLOW_USE_AWS=true ensures System.getenv() in main.nf returns 'true' at
        // script-parse time so all container variables resolve to the ECR image.
        env.NEXTFLOW_USE_AWS = 'true'
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false

        process {
            executor  = 'awsbatch'
            queue     = 'biomate-nextflow-queue'
            container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/ambertools-gromacs-nf:latest'

            withName: 'PRODUCTION_MD' {
                queue       = 'galaxy-cloud-queue-gpu'
                accelerator = 1
                maxForks    = 1
                // GPU Docker options only for the MD step
                docker.runOptions = '--gpus all -u $(id -u):$(id -g)'
            }
            withName: 'MM_GBSA' {
                // MM-GBSA is CPU-heavy, keep on CPU queue
                queue = 'biomate-nextflow-queue'
            }
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/usr/local/bin/aws'
        }
    }
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite  = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite  = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite  = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/gromacs_protein_md'
    author          = 'BioMate AI'
    description     = 'GROMACS protein-ligand molecular dynamics and MM-GBSA binding free energy pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
