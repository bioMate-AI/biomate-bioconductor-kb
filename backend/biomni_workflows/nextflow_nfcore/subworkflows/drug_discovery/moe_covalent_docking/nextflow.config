/*
 * BioMate Nextflow Configuration
 * drug_discovery/moe_covalent_docking
 *
 * MOE covalent docking pipeline
 *
 * NOTE: MOE requires a commercial license and the ECR image:
 *   399683337364.dkr.ecr.us-west-2.amazonaws.com/moe2024:latest
 * Ensure ECR authentication and MOE_LICENSE_FILE env var are set before
 * using the docker profile.
 *
 * Profiles:
 *   standard    — local executor (default; no MOE license needed)
 *   docker      — Docker container, live mode (requires ECR auth + MOE license)
 */

params {
    outdir              = './results/moe_covalent_docking'
    publish_dir_mode    = 'copy'
    receptor            = null
    ligands             = null
    covalent_residue    = 'CYS145'
    n_poses             = 10
    moe_license_file    = System.getenv('MOE_LICENSE_FILE') ?: '/opt/moe/license.dat'
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 1
}

profiles {

    standard {
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled      = true
        // MOE license must be mounted; set MOE_LICENSE_DIR env var to license dir
        docker.runOptions   = "-u \$(id -u):\$(id -g) -v /tmp:/tmp ${System.getenv('MOE_LICENSE_DIR') ? '-v ' + System.getenv('MOE_LICENSE_DIR') + ':/opt/moe/license:ro' : ''}"
        singularity.enabled = false
        process.executor    = 'local'
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }

    aws {
        docker.enabled = true
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-nextflow-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
    }
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite  = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite  = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite  = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/moe_covalent_docking'
    author          = 'BioMate AI'
    description     = 'MOE covalent docking pipeline (requires commercial license)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
