/*
 * BioMate Nextflow Configuration
 * drug_discovery/mpo_denovo_optimization
 *
 * Closed multi-objective (GP-Pareto / EHVI) de-novo optimisation round.
 * Mirrors reinvent4_lead_design's profile layout so the Galaxy Nextflow
 * executor launches it the same way (-profile aws -c <override> --<param> ...).
 */

params {
    outdir            = './results/mpo_denovo_optimization'
    publish_dir_mode  = 'copy'

    seed_smiles       = 'c1ccc2c(c1)ccc(=O)o2'
    generator         = 'brics'
    n_generate        = 200
    train_smiles      = 'CCO,CCN,CCC,c1ccccc1,c1ccncc1,CC(=O)O,CC(=O)N,CCOC,CCCO,CCCN'
    objectives        = 'qed:maximize,sa:minimize'
    n_propose         = 10
    n_initial         = 8
    diversity_weight  = 0.2
    campaign_id       = 'mpo_denovo_campaign'
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'MPO_ROUND' {
        cpus   = 4
        memory = '16.GB'
        time   = '2h'
    }
    withName: 'STAGE_TRAIN_SMILES' {
        cpus   = 1
        memory = '2.GB'
        time   = '15m'
    }
}

profiles {

    standard {
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        params.n_generate   = 40
        params.n_propose    = 5
        process.executor    = 'local'
        docker.enabled      = true
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false
        process.executor    = 'local'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    aws {
        docker.enabled = true
        process {
            executor  = 'awsbatch'
            queue     = 'biomate-hpc-queue'
            container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/drug-discovery-nf:x86'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields   = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/mpo_denovo_optimization'
    author          = 'BioMate AI'
    description     = 'Closed multi-objective GP-Pareto/EHVI de-novo optimisation round (generate->predict->score->propose->rank)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
