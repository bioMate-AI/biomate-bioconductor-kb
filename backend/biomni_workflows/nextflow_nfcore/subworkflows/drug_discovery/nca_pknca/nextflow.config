/*
 * BioMate Nextflow Configuration
 * drug_discovery/nca_pknca
 *
 * Non-Compartmental Analysis (NCA) pipeline using the PKNCA R package.
 * Steps: input validation → PKNCA analysis → HTML report.
 *
 * Profiles:
 *   standard    — mock mode, local executor (default; no R installation needed)
 *   test        — minimal resources, mock mode, fast CI
 *   docker      — Docker containers (rocker/tidyverse), live mode
 *   singularity — Singularity containers, live mode (HPC)
 *   slurm       — SLURM HPC cluster (CPU-only; NCA is not GPU-intensive)
 */

// ============================================================================
// Default parameters
// ============================================================================

params {
    // --- Output ---
    outdir              = './results/nca_pknca'
    publish_dir_mode    = 'copy'

    // --- Mode ---
    mock_mode           = true          // synthetic outputs; no real tools needed

    // --- PK study settings ---
    input_csv           = null          // path to concentration-time CSV (live mode)
    dose                = 100           // dose amount
    route               = 'oral'        // 'oral' | 'iv'
    time_unit           = 'h'           // time axis label
    conc_unit           = 'ng/mL'       // concentration axis label
}

// ============================================================================
// Process resource defaults
// ============================================================================

process {
    // Retry on OOM / SIGKILL / segfault
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    // --- Input validation: lightweight Python/R CSV check ---
    withName: 'NCA_INPUT_VALIDATION' {
        cpus   = 1
        memory = '2.GB'
        time   = '15m'
    }

    // --- NCA analysis: R/PKNCA; single-threaded but may load large CSVs ---
    withName: 'NCA_PKNCA_ANALYSIS' {
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
    }

    // --- HTML report: knitr/ggplot2 rendering ---
    withName: 'NCA_REPORT_HTML' {
        cpus   = 2
        memory = '8.GB'
        time   = '30m'
    }
}

// ============================================================================
// Profiles
// ============================================================================

profiles {

    // ------------------------------------------------------------------
    // standard: mock mode, local executor, no containers required
    // Python 3 must be available on PATH for mock scripts.
    // ------------------------------------------------------------------
    standard {
        params.mock_mode    = true

        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    // ------------------------------------------------------------------
    // test: ultra-minimal resources for CI (GitHub Actions, etc.)
    // ------------------------------------------------------------------
    test {
        params.mock_mode    = true
        params.dose         = 100
        params.route        = 'oral'

        process {
            withName: 'NCA_INPUT_VALIDATION' {
                cpus   = 1
                memory = '1.GB'
                time   = '5m'
            }
            withName: 'NCA_PKNCA_ANALYSIS' {
                cpus   = 1
                memory = '2.GB'
                time   = '10m'
            }
            withName: 'NCA_REPORT_HTML' {
                cpus   = 1
                memory = '2.GB'
                time   = '10m'
            }
        }

        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    // ------------------------------------------------------------------
    // docker: live mode with Docker containers (rocker suite)
    // ------------------------------------------------------------------
    docker {
        params.mock_mode    = false

        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false

        process {
            withName: 'NCA_INPUT_VALIDATION' {
                // Lightweight R base sufficient for readr + jsonlite
                container = 'docker.io/rocker/r-ver:4.3.1'
            }
            withName: 'NCA_PKNCA_ANALYSIS' {
                // rocker/r-ver + PKNCA + readr + dplyr (installed at image build time)
                container = 'docker.io/rocker/r-ver:4.3.1'
            }
            withName: 'NCA_REPORT_HTML' {
                // rocker/tidyverse includes rmarkdown + ggplot2 + knitr
                container = 'docker.io/rocker/tidyverse:4.3.1'
            }
        }
    }

    // ------------------------------------------------------------------
    // singularity: live mode with Singularity/Apptainer (HPC-friendly)
    // ------------------------------------------------------------------
    singularity {
        params.mock_mode    = false

        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false

        process {
            withName: 'NCA_INPUT_VALIDATION' {
                container = 'docker://rocker/r-ver:4.3.1'
            }
            withName: 'NCA_PKNCA_ANALYSIS' {
                container = 'docker://rocker/r-ver:4.3.1'
            }
            withName: 'NCA_REPORT_HTML' {
                container = 'docker://rocker/tidyverse:4.3.1'
            }
        }
    }

    // ------------------------------------------------------------------
    // slurm: SLURM HPC cluster (CPU-only; NCA is not GPU-intensive)
    // ------------------------------------------------------------------
    slurm {
        params.mock_mode    = false

        process.executor    = 'slurm'

        process {
            withName: 'NCA_INPUT_VALIDATION' {
                queue  = 'cpu'
                cpus   = 1
                memory = '2.GB'
                time   = '15m'
            }
            withName: 'NCA_PKNCA_ANALYSIS' {
                queue  = 'cpu'
                cpus   = 2
                memory = '8.GB'
                time   = '1h'
            }
            withName: 'NCA_REPORT_HTML' {
                queue  = 'cpu'
                cpus   = 2
                memory = '8.GB'
                time   = '30m'
            }
        }

        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
}

// ============================================================================
// Execution reports
// ============================================================================

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite  = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite  = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite  = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss,vmem,peak_vmem,rchar,wchar'
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/dag.svg"
    overwrite  = true
}

// ============================================================================
// Manifest
// ============================================================================

manifest {
    name            = 'biomate/nca_pknca'
    author          = 'BioMate AI'
    description     = 'Non-Compartmental Analysis (NCA) pharmacokinetics pipeline using the PKNCA R package'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
    doi             = ''
}
