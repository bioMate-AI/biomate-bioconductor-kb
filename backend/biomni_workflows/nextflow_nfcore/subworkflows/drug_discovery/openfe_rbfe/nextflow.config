/*
 * BioMate Nextflow Configuration
 * drug_discovery/openfe_rbfe
 *
 * Relative Binding Free Energy (RBFE) using OpenFE + OpenMM
 *
 * Profiles:
 *   standard    — local executor (default)
 *   docker      — Docker containers, live mode
 *   gpu_batch   — AWS Batch + GPU (production RBFE)
 */

params {
    outdir                  = './results/openfe_rbfe'
    publish_dir_mode        = 'copy'
    receptor                = null
    ligand_a                = null
    ligand_b                = null
    protein_ff              = 'ff14sb'
    ligand_ff               = 'openff-2.2.0'
    n_lambda_windows        = 11
    n_replicas              = 3
    simulation_time_ns      = 5.0
    equilibration_ns        = 1.0
    timestep_fs             = 4
    temperature             = 298.15
    pressure                = 1.0
    ionic_strength          = 0.15
    box_padding             = 12
    mbar_bootstrap_iter     = 1000
    overlap_threshold       = 0.03
    n_cpus                  = 4
    gpu                     = true
    use_aws                 = false
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'LIGAND_PREP' {
        cpus   = 8
        memory = '16.GB'
        time   = '1h'
    }
    withName: 'PROTEIN_PREP' {
        cpus   = 8
        memory = '16.GB'
        time   = '1h'
    }
    withName: 'RBFE_SETUP' {
        cpus   = 16
        memory = '32.GB'
        time   = '2h'
    }
    withName: 'PRODUCTION_RBFE' {
        cpus   = 8
        memory = '64.GB'
        time   = '96h'
        accelerator = 1
    }
    withName: 'ANALYSIS' {
        cpus   = 16
        memory = '32.GB'
        time   = '4h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor = 'local'
    }

    gpu_batch {
        params.use_aws  = true
        params.gpu      = true
        process {
            executor = 'awsbatch'
            queue    = 'biomate-hpc-queue'

            withName: 'LIGAND_PREP|PROTEIN_PREP|RBFE_SETUP|ANALYSIS' {
                queue  = 'biomate-hpc-queue'
            }
            withName: 'PRODUCTION_RBFE' {
                queue       = 'galaxy-cloud-queue-gpu'
                accelerator = 1
                memory      = '64.GB'
                cpus        = 16
                time        = '96h'
            }
        }
        aws {
            region      = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
        workDir = 's3://biomate-nextflow-work/openfe_rbfe/'
    }
}
