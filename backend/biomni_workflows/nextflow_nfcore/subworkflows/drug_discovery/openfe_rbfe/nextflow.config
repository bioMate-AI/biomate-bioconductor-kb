/*
 * BioMate Nextflow Configuration
 * drug_discovery/openfe_rbfe
 *
 * Real relative binding free energy (RBFE / FEP) via OpenFE + OpenMM.
 * Mirrors the docking / mpo profile layout so the Galaxy Nextflow executor
 * launches it the same way (-profile <p> -c <override> --<param> ...).
 *
 * Profiles:
 *   standard    — local executor (CPU; setup/smoke only — no real ΔΔG)
 *   docker      — local Docker (CPU; setup/smoke only)
 *   gpu_batch   — AWS Batch + GPU for --mode production (real MBAR ΔΔG)
 */

params {
    outdir            = './results/openfe_rbfe'
    publish_dir_mode  = 'copy'

    receptor          = null
    ligand_a          = null
    ligand_b          = null

    mode              = 'setup'      // setup | smoke | production
    validate          = ''           // e.g. 'tyk2:ejm_31->ejm_42'

    temperature       = 298.15
    equilibration_ns  = 1.0
    production_ns     = 5.0
    lambda_windows    = 11
    protocol_repeats  = 3
    max3d             = 1.0

    use_aws           = false
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'PREP' {
        cpus   = 4
        memory = '16.GB'
        time   = '1h'
    }
    withName: 'RBFE_SETUP' {
        cpus   = 8
        memory = '32.GB'
        time   = '2h'
    }
    withName: 'OPENFE_ANALYSIS' {
        cpus   = 16
        memory = '64.GB'
        time   = '96h'
    }
}

profiles {

    standard {
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        process.executor    = 'local'
    }

    gpu_batch {
        // Real production RBFE. --mode production must be set for a ΔΔG.
        params.use_aws = true
        docker.enabled = true
        process {
            executor  = 'awsbatch'
            queue     = 'biomate-hpc-queue'
            container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/openfe-rbfe:1.0'

            withName: 'PREP|RBFE_SETUP' {
                queue = 'biomate-hpc-queue'
            }
            // Production RBFE needs a GPU — route to the GPU queue.
            withName: 'OPENFE_ANALYSIS' {
                queue       = 'galaxy-cloud-queue-gpu'
                accelerator = 1
                cpus        = 16
                memory      = '64.GB'
                time        = '96h'
            }
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
        workDir = 's3://biomate-nextflow-work/openfe_rbfe/'
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/openfe_rbfe'
    author          = 'BioMate AI'
    description     = 'Real small-molecule RBFE (relative binding free energy / FEP) via OpenFE + OpenMM; LOMAP mapping, RelativeHybridTopologyProtocol, MBAR ΔΔG ± SEM'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
