/*
 * p0_docking_validation -- Nextflow configuration
 * P0-C internal validation: AutoDock Vina RMSD vs PDB 7RFS (nirmatrelvir)
 */

params {
    outdir                  = './results'
    pdb_id                  = '7RFS'
    ligand_smiles           = 'CC1(C2CC2NC(=O)C(F)(F)F)C(=O)N1CC(CC3CC(=O)N(C)C3=O)NC(=O)c4cncc(C#N)c4'
    // Box centred on nirmatrelvir in 7RFS crystal structure
    box_center              = '[-10.2, 17.5, 50.1]'
    box_size                = '[22.0, 22.0, 22.0]'
    exhaustiveness          = '16'
    n_poses                 = '20'
    rmsd_threshold          = '2.0'
}

process {
    withName: 'P0_DOCKING_VALIDATION' {
        cpus   = 4
        memory = '8 GB'
        time   = '2 h'
    }
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
}

profiles {
    docker {
        docker.enabled    = true
        singularity.enabled = false
    }
    aws {
        process.executor = 'awsbatch'
        aws.region       = 'us-west-2'
        aws.batch.cliPath = '/usr/local/bin/aws'
    }
}

manifest {
    name        = 'p0_docking_validation'
    description = 'Phase 0 docking validation: Vina RMSD vs 7RFS crystal'
    mainScript  = 'main.nf'
    version     = '1.0.0'
}
