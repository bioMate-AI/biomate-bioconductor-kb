/*
 * p0_mrna_validation -- Nextflow configuration
 * P0-B internal validation: mRNA codon optimisation + ViennaRNA fold
 * Gold standard: Hsieh et al. Science 2020 (HexaPro spike, MN908947.3)
 */

params {
    outdir          = './results'
    genbank_id      = 'MN908947.3'
    orf_start       = '21563'   // 1-based, spike ORF start in Wuhan-Hu-1
    orf_end         = '25384'   // 1-based, spike ORF end (no stop codon)
    cai_threshold   = '0.90'
    mfe_threshold   = '-150.0'
}

process {
    withName: 'P0_MRNA_VALIDATION' {
        cpus   = 4
        memory = '8 GB'
        time   = '1 h'
    }
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
}

profiles {
    docker {
        docker.enabled    = true
        singularity.enabled = false
    }
    aws {
        process.executor = 'awsbatch'
        aws.region       = 'us-west-2'
        aws.batch.cliPath = '/usr/local/bin/aws'
    }
}

manifest {
    name        = 'p0_mrna_validation'
    description = 'Phase 0 mRNA validation: HexaPro spike CAI + ViennaRNA fold'
    mainScript  = 'main.nf'
    version     = '1.0.0'
}
