/*
 * p0_pharmacophore_validation -- Nextflow configuration
 * P0-D: GLP-1R pharmacophore enrichment AUC-ROC vs PDB 7KI0
 */

params {
    outdir          = './results'
    pdb_id          = '7KI0'
    auc_threshold   = '0.75'
}

process {
    withName: 'P0_PHARMACOPHORE_VALIDATION' {
        cpus   = 2
        memory = '4 GB'
        time   = '30 min'
    }
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
}

profiles {
    docker {
        docker.enabled    = true
        singularity.enabled = false
    }
    aws {
        process.executor = 'awsbatch'
        aws.region       = 'us-west-2'
        aws.batch.cliPath = '/usr/local/bin/aws'
    }
}

manifest {
    name        = 'p0_pharmacophore_validation'
    description = 'Phase 0 pharmacophore enrichment validation: GLP-1R AUC-ROC >= 0.75'
    mainScript  = 'main.nf'
    version     = '1.0.0'
}
