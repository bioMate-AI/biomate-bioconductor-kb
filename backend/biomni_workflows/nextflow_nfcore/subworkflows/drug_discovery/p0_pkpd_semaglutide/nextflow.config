/*
 * p0_pkpd_semaglutide -- Nextflow configuration
 * P0-E: 2-compartment SC PK + GLP-1R Emax body weight PD model
 * Gold standard: Overgaard 2019 (PK) + SUSTAIN-1 trial (PD)
 */

params {
    outdir           = './results'
    publish_dir_mode = 'copy'

    // PK parameters (Overgaard et al. 2019, Table 1)
    pk_cl_ml_h       = 41.0
    pk_v1_l          = 8.18
    pk_q_ml_h        = 89.5
    pk_v2_l          = 4.50
    pk_ka_h          = 0.0116
    pk_f_bio         = 0.89
    dose_mg          = 1.0
    n_weeks          = 30
    mw_semaglutide   = 4113.58

    // PD parameters
    pd_emax_kg_wk    = -0.22
    pd_ec50_nm       = 5.0
    pd_baseline_wt_kg = 92.0

    // Pass/fail thresholds
    cmax_ref_nm      = 15.0
    cmax_tol         = 0.30
    wt_loss_min_kg   = -6.0
    wt_loss_max_kg   = -3.0
}

process {
    withName: 'P0_PKPD_SEMAGLUTIDE' {
        cpus   = 2
        memory = '4 GB'
        time   = '30 min'
    }
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
}

profiles {
    docker {
        docker.enabled      = true
        singularity.enabled = false
    }
    aws {
        process.executor    = 'awsbatch'
        aws.region          = 'us-west-2'
        aws.batch.cliPath   = '/usr/local/bin/aws'
    }
}

manifest {
    name        = 'p0_pkpd_semaglutide'
    description = 'Phase 0 PKPD validation: semaglutide 2-compartment PK + GLP-1R Emax body weight model vs SUSTAIN-1'
    mainScript  = 'main.nf'
    version     = '1.0.0'
}
