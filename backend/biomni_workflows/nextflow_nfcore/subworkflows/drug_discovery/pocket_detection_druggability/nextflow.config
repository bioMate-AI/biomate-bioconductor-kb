/*
 * BioMate Nextflow Configuration
 * drug_discovery/pocket_detection_druggability
 *
 * fpocket-based binding pocket detection and druggability scoring pipeline
 *
 * Profiles:
 *   standard    — mock mode, local executor (default; no fpocket needed)
 *   docker      — Docker container, live mode (fpocket/fpocket)
 */

params {
    outdir              = './results/pocket_detection_druggability'
    publish_dir_mode    = 'copy'
    mock_mode           = true
    pdb_input           = null
    min_druggability    = 0.5
    warn_druggability   = 0.3
    min_volume          = 300.0
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

profiles {

    standard {
        params.mock_mode    = true
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        params.mock_mode    = true
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        params.mock_mode    = false
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false
        process.executor    = 'local'
    }

    singularity {
        params.mock_mode        = false
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite  = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite  = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite  = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/pocket_detection_druggability'
    author          = 'BioMate AI'
    description     = 'fpocket binding pocket detection and druggability scoring pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
