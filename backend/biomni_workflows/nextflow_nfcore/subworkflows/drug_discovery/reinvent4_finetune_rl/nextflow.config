/*
 * BioMate Nextflow Configuration
 * drug_discovery/reinvent4_finetune_rl
 *
 * REINVENT4 training: generator fine-tuning (transfer_learning) + reinforcement
 * learning (staged_learning). Runs the reinvent4-nf image (reinvent CLI + priors).
 *
 * Profiles:
 *   standard    — local executor (CLI is x86-only; process fails honestly on ARM)
 *   test        — tiny epochs/steps for a fast smoke on x86
 *   docker      — Docker containers, live mode
 *   gpu         — GPU-enabled (recommended for RL / large fine-tuning)
 *   aws         — AWS Batch (the intended production path; x86 ECR image)
 */

params {
    outdir            = './results/reinvent4_finetune_rl'
    publish_dir_mode  = 'copy'
    stage             = 'both'
    train_smiles      = null
    output_prefix     = 'reinvent4'
    epochs            = 10
    tl_batch_size     = 128
    tl_learning_rate  = 0.0001
    reward            = 'default'
    rl_steps          = 300
    rl_batch_size     = 128
    sigma             = 128.0
    rl_learning_rate  = 0.0001
    diversity_filter  = true
    prior_path        = null
    gpu               = false
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'REINVENT4_TRAIN' {
        cpus   = 8
        memory = '32.GB'
        time   = '12h'
    }
}

profiles {

    standard {
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        params.epochs       = 2
        params.rl_steps     = 5
        params.rl_batch_size = 16
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false
        process.executor    = 'local'
    }

    gpu {
        docker.enabled      = true
        docker.runOptions   = '--gpus all -u $(id -u):$(id -g)'
        singularity.enabled = false
        process.executor    = 'local'
        params.gpu          = true

        process {
            withName: 'REINVENT4_TRAIN' {
                maxForks = 1
            }
        }
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }

    aws {
        docker.enabled = true
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-hpc-queue'
            container   = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/reinvent4-nf:x86'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
    }
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/reinvent4_finetune_rl'
    author          = 'BioMate AI'
    description     = 'REINVENT4 generator fine-tuning (transfer learning) + multi-objective reinforcement learning'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
