/*
 * BioMate Nextflow Configuration
 * drug_discovery/reinvent4_lead_design
 *
 * REINVENT4 generative lead design pipeline
 *
 * Profiles:
 *   standard    — local executor (default; no REINVENT4 needed)
 *   docker      — Docker containers, live mode
 *   gpu         — GPU-enabled (recommended for REINVENT4 sampling)
 */

params {
    outdir              = './results/reinvent4_lead_design'
    publish_dir_mode    = 'copy'
    smiles              = null
    n_compounds         = 100
    n_epochs            = 50
    scoring_components  = 'qed,sa_score,docking_score'
    receptor_pdb        = null
    docking_center_x    = 0.0
    docking_center_y    = 0.0
    docking_center_z    = 0.0
    docking_box_size    = 20.0
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'REINVENT_DESIGN' {
        cpus   = 8
        memory = '32.GB'
        time   = '4h'
    }
}

profiles {

    standard {
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        params.n_epochs     = 5
        params.n_compounds  = 10
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false
        process.executor    = 'local'
    }

    gpu {
        docker.enabled      = true
        docker.runOptions   = '--gpus all -u $(id -u):$(id -g)'
        singularity.enabled = false
        process.executor    = 'local'

        process {
            withName: 'REINVENT_DESIGN' {
                maxForks = 1
            }
        }
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }

    aws {
        docker.enabled = true
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-hpc-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
    }
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite  = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite  = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite  = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/reinvent4_lead_design'
    author          = 'BioMate AI'
    description     = 'REINVENT4 generative lead design and analogue optimisation pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
