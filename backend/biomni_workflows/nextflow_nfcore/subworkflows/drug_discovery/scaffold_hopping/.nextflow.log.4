  import json
  import csv
  import subprocess
  import sys
  import os
  import tempfile
  from datetime import datetime
  
  meta_id      = "test_actives"
  input_csv    = "test_actives_validated.csv"
  ref_smiles   = "CC(=O)Nc1ccc(O)cc1"
  
  # ---- 1. Convert validated CSV → SMILES file expected by mmpdb ----
  smiles_file = f"{meta_id}_for_mmpdb.smi"
  with open(input_csv, newline="") as csvf, open(smiles_file, "w") as smif:
      reader = csv.DictReader(csvf)
      for row in reader:
          if row.get("valid", "").lower() == "true":
              smif.write(f"{row['canonical_smiles']} {row['compound_id']}
  ")
  
  # ---- 2. Fragment with mmpdb ----
  frag_file = f"{meta_id}_mmpdb.fragments"
  result = subprocess.run(
      ["mmpdb", "fragment", smiles_file, "-o", frag_file],
      capture_output=True, text=True
  )
  if result.returncode != 0:
      print(f"mmpdb fragment failed: {result.stderr}", file=sys.stderr)
      sys.exit(1)
  
  # ---- 3. Index ----
  db_file = f"{meta_id}_mmpdb.db"
  result = subprocess.run(
      ["mmpdb", "index", frag_file, "-o", db_file],
      capture_output=True, text=True
  )
  if result.returncode != 0:
      print(f"mmpdb index failed: {result.stderr}", file=sys.stderr)
      sys.exit(1)
  
  # ---- 4. Transform from reference (find all pairs that include reference) ----
  transform_out = f"{meta_id}_transforms.csv"
  result = subprocess.run(
      ["mmpdb", "transform", "--smiles", ref_smiles, db_file,
       "--output", transform_out],
      capture_output=True, text=True
  )
  if result.returncode != 0:
      print(f"mmpdb transform warning: {result.stderr}", file=sys.stderr)
  
  # ---- 5. Parse transform output → MMP pairs CSV ----
  rows = []
  try:
      with open(transform_out, newline="") as csvf:
          reader = csv.DictReader(csvf, delimiter="	")
          for i, row in enumerate(reader):
              rows.append({
                  "pair_id":           f"MMP_{i+1:03d}",
                  "query_smiles":      ref_smiles,
                  "match_smiles":      row.get("start_smiles", ""),
                  "transformation":    row.get("rule", ""),
                  "logP_query":        0.0,
                  "logP_match":        0.0,
                  "logP_delta":        float(row.get("delta_logP", 0) or 0),
                  "mw_query_da":       0.0,
                  "mw_match_da":       0.0,
                  "mw_delta_da":       float(row.get("delta_MW", 0) or 0),
                  "qed_query":         0.0,
                  "qed_match":         0.0,
                  "qed_delta":         0.0,
                  "is_reference_pair": "True",
              })
  except FileNotFoundError:
      pass
  
  with open(f"{meta_id}_mmp_pairs.csv", "w", newline="") as csvf:
      if rows:
          writer = csv.DictWriter(csvf, fieldnames=list(rows[0].keys()))
          writer.writeheader()
          writer.writerows(rows)
      else:
          csvf.write("pair_id,query_smiles,match_smiles,transformation\n")
  
  summary = {
      "meta_id":          meta_id,
      "reference_smiles": ref_smiles,
      "total_pairs":      len(rows),
      "tool":             "mmpdb 3.1",
      "timestamp":        datetime.utcnow().isoformat() + "Z",
      "mock_mode":        False,
  }
  with open(f"{meta_id}_mmp_summary.json", "w") as jf:
      json.dump(summary, jf, indent=2)
  
  print(f"MMP live complete: {len(rows)} pairs")
  PYEOF
      fi
  
      cat <<-END_VERSIONS > versions.yml
      "SCAFFOLD_HOPPING:MMP_ANALYSIS":
