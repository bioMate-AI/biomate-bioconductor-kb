/*
 * BioMate Nextflow Configuration
 * drug_discovery/scaffold_hopping
 *
 * RECAP Fragmentation + Matched Molecular Pair (MMP) scaffold hopping pipeline
 * Steps: SCAFFOLD_INPUT_VALIDATION → RECAP_FRAGMENTATION → MMP_ANALYSIS
 *        → SCAFFOLD_HOPPING_CANDIDATES
 *
 * Profiles:
 *   standard    — local executor (default; no GPU required)
 *   test        — minimal resources, fast CI
 *   docker      — Docker containers (RDKit + mmpdb), live mode
 *   singularity — Singularity containers, live mode (HPC)
 *   stub        — Nextflow stub-run mode (touch-only outputs, fastest CI check)
 */

// ============================================================================
// Default parameters
// ============================================================================

params {
    // --- Output ---
    outdir              = './results/scaffold_hopping'
    publish_dir_mode    = 'copy'

    // --- Mode ---

    // --- Input (live mode) ---
    input_smiles        = null          // path to SMILES file (one "SMILES id" per line)
    reference_smiles    = 'CC(=O)Nc1ccc(O)cc1'  // acetaminophen reference

    // --- Filtering / ranking ---
    max_candidates      = 20            // cap on reported scaffold hop candidates
    lipinski_filter     = true          // apply Ro5 filter before ranking
}

// ============================================================================
// Process resource defaults (labels used in main.nf)
// ============================================================================

process {
    // Error handling — retry on OOM / SIGKILL
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    // --- Step 1: input validation — lightweight ----
    withName: 'SCAFFOLD_INPUT_VALIDATION' {
        cpus   = 1
        memory = '4.GB'
        time   = '30m'
    }

    // --- Step 2: RECAP fragmentation — CPU-bound but modest ----
    withName: 'RECAP_FRAGMENTATION' {
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
    }

    // --- Step 3: MMP analysis — potentially long for large libraries ----
    withName: 'MMP_ANALYSIS' {
        cpus   = 4
        memory = '16.GB'
        time   = '4h'
    }

    // --- Step 4: candidate ranking — CPU, modest memory ----
    withName: 'SCAFFOLD_HOPPING_CANDIDATES' {
        cpus   = 2
        memory = '8.GB'
        time   = '1h'
    }
}

// ============================================================================
// Profiles
// ============================================================================

profiles {

    // ------------------------------------------------------------------
    // standard: local executor, no containers
    // ------------------------------------------------------------------
    standard {

        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    // ------------------------------------------------------------------
    // test: ultra-minimal resources for CI (GitHub Actions, etc.)
    // ------------------------------------------------------------------
    test {
        params.max_candidates  = 5

        process {
            withName: 'SCAFFOLD_INPUT_VALIDATION' {
                cpus   = 1
                memory = '2.GB'
                time   = '10m'
            }
            withName: 'RECAP_FRAGMENTATION' {
                cpus   = 1
                memory = '2.GB'
                time   = '10m'
            }
            withName: 'MMP_ANALYSIS' {
                cpus   = 1
                memory = '2.GB'
                time   = '10m'
            }
            withName: 'SCAFFOLD_HOPPING_CANDIDATES' {
                cpus   = 1
                memory = '2.GB'
                time   = '10m'
            }
        }

        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    // ------------------------------------------------------------------
    // docker: live mode with Docker containers (RDKit + mmpdb)
    // ------------------------------------------------------------------
    docker {

        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false

        process {
            withName: 'SCAFFOLD_INPUT_VALIDATION' {
                container = 'biomate/biomni-drug-discovery-nf:latest'
            }
            withName: 'RECAP_FRAGMENTATION' {
                container = 'biomate/biomni-drug-discovery-nf:latest'
            }
            withName: 'MMP_ANALYSIS' {
                // mmpdb is included in the rdkit-python3-debian image
                container = 'biomate/biomni-drug-discovery-nf:latest'
            }
            withName: 'SCAFFOLD_HOPPING_CANDIDATES' {
                container = 'biomate/biomni-drug-discovery-nf:latest'
            }
        }
    }

    // ------------------------------------------------------------------
    // singularity: live mode with Singularity/Apptainer (HPC-friendly)
    // ------------------------------------------------------------------
    singularity {

        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false

        process {
            withName: 'SCAFFOLD_INPUT_VALIDATION' {
                container = 'docker://informaticsmatters/rdkit-python3-debian:latest'
            }
            withName: 'RECAP_FRAGMENTATION' {
                container = 'docker://informaticsmatters/rdkit-python3-debian:latest'
            }
            withName: 'MMP_ANALYSIS' {
                container = 'docker://informaticsmatters/rdkit-python3-debian:latest'
            }
            withName: 'SCAFFOLD_HOPPING_CANDIDATES' {
                container = 'docker://informaticsmatters/rdkit-python3-debian:latest'
            }
        }
    }

    // ------------------------------------------------------------------
    // stub: Nextflow stub-run (touch-only outputs, no Python executed)
    //       Fastest possible CI sanity check for DSL2 syntax + graph
    // ------------------------------------------------------------------
    stub {

        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    // ------------------------------------------------------------------
    // slurm: SLURM HPC cluster
    // ------------------------------------------------------------------
    slurm {

        process.executor = 'slurm'

        process {
            withName: 'SCAFFOLD_INPUT_VALIDATION' {
                queue  = 'short'
                cpus   = 1
                memory = '4.GB'
                time   = '30m'
            }
            withName: 'RECAP_FRAGMENTATION' {
                queue  = 'short'
                cpus   = 2
                memory = '8.GB'
                time   = '1h'
            }
            withName: 'MMP_ANALYSIS' {
                queue  = 'cpu'
                cpus   = 4
                memory = '16.GB'
                time   = '4h'
            }
            withName: 'SCAFFOLD_HOPPING_CANDIDATES' {
                queue  = 'short'
                cpus   = 2
                memory = '8.GB'
                time   = '1h'
            }
        }

        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    aws {
        docker.enabled = true
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-nextflow-queue'
            container   = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/biomni-drug-discovery-nf:x86'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
    }
}

// ============================================================================
// Execution reports
// ============================================================================

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite  = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite  = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite  = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss,vmem,peak_vmem,rchar,wchar'
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/dag.svg"
    overwrite  = true
}

// ============================================================================
// Manifest
// ============================================================================

manifest {
    name            = 'biomate/scaffold_hopping'
    author          = 'BioMate AI'
    description     = 'RECAP fragmentation + MMP analysis scaffold hopping pipeline for drug discovery'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
    doi             = ''
}
