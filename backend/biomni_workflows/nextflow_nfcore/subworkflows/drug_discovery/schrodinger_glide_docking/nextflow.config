/*
 * BioMate Nextflow Configuration
 * drug_discovery/schrodinger_glide_docking
 *
 * Schrödinger Glide docking pipeline
 *
 * NOTE: Glide requires a Schrödinger license and the ECR image:
 *   399683337364.dkr.ecr.us-west-2.amazonaws.com/schrodinger2024:latest
 * Ensure ECR authentication and SCHRODINGER_LICENSE_FILE env var are set
 * before using the docker profile.
 *
 * Profiles:
 *   standard    — local executor (default; no Schrödinger license needed)
 *   docker      — Docker container, live mode (requires ECR auth + Schrödinger license)
 */

params {
    outdir                  = './results/schrodinger_glide_docking'
    publish_dir_mode        = 'copy'
    receptor                = null
    ligands                 = null
    glide_precision         = 'SP'      // SP | XP | HTVS
    n_poses                 = 5
    schrodinger_license     = System.getenv('SCHRODINGER_LICENSE') ?: '/opt/schrodinger/license.dat'
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 1
}

profiles {

    standard {
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    test {
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false
        process.executor    = 'local'
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }

    aws {
        docker.enabled = true
        process {
            executor    = 'awsbatch'
            queue       = 'biomate-nextflow-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/usr/local/bin/aws'
        }
    }
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite  = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite  = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite  = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/schrodinger_glide_docking'
    author          = 'BioMate AI'
    description     = 'Schrödinger Glide docking pipeline (requires commercial license)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
