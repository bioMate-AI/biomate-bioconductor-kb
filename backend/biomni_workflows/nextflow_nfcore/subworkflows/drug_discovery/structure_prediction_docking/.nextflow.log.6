      x_ca    = 2.3 * math.cos(angle)
      y_ca    = 2.3 * math.sin(angle)
      z_ca    = i * 1.5
      res3    = aa_three.get(aa, 'ALA')
      bfac    = round(random.uniform(10.0, 30.0), 2)
  
