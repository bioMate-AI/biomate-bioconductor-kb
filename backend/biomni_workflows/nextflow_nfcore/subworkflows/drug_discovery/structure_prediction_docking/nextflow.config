/*
 * BioMate Nextflow Configuration
 * drug_discovery/structure_prediction_docking
 *
 * AlphaFold3 → DiffDock (blind) + AutoDock Vina (PAE-guided) pipeline
 *
 * Profiles:
 *   standard    — mock mode, local executor (default; no GPU required)
 *   test        — minimal resources, mock mode, fast CI
 *   docker      — Docker containers, live mode
 *   singularity — Singularity containers, live mode (HPC)
 *   gpu         — local GPU executor (single GPU)
 *   aws         — AWS Batch (GPU queue)
 *   slurm       — SLURM HPC cluster (GPU partition)
 */

// ============================================================================
// Default parameters
// ============================================================================

params {
    // --- Output ---
    outdir              = './results/structure_prediction_docking'
    publish_dir_mode    = 'copy'

    // --- Mode ---
    mock_mode           = true          // synthetic outputs; no real tools needed
    af3_mode            = 'mock'        // 'mock' | 'server' | 'local'

    // --- AlphaFold3 ---
    af3_api_token       = null          // Bearer token (server mode)
    af3_model_dir       = '/opt/alphafold3/models'
    af3_num_recycles    = 10

    // --- DiffDock ---
    diffdock_poses          = 10
    diffdock_inference_steps = 20

    // --- AutoDock Vina ---
    vina_exhaustiveness = 32
    vina_num_modes      = 9

    // --- Live mode inputs (ignored in mock mode) ---
    fasta_input         = null          // path to FASTA (live mode)
    ligand_sdf          = null          // path to SDF   (live mode)
}

// ============================================================================
// Process resource defaults (labels used in main.nf)
// ============================================================================

process {
    // Error handling — retry on OOM / SIGKILL
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    // --- AlphaFold3: compute-intensive; GPU required for live mode ---
    withName: 'ALPHAFOLD3_STRUCTURE_PREDICTION' {
        cpus   = 8
        memory = '64.GB'
        time   = '48h'
    }

    // --- DiffDock: diffusion model; GPU strongly recommended ---
    withName: 'DIFFDOCK_BLIND_DOCKING' {
        cpus   = 4
        memory = '32.GB'
        time   = '4h'
    }

    // --- AutoDock Vina: CPU-parallelised; modest memory ---
    withName: 'AUTODOCK_VINA_DOCKING' {
        cpus   = 8
        memory = '16.GB'
        time   = '2h'
    }
}

// ============================================================================
// Profiles
// ============================================================================

profiles {

    // ------------------------------------------------------------------
    // standard: mock mode, local executor, no GPU, no containers
    // ------------------------------------------------------------------
    standard {
        params.mock_mode = true
        params.af3_mode  = 'mock'

        process.executor = 'local'

        // Use the lightweight BioMate toolbox image if Docker is available,
        // otherwise run bare-metal (mock mode needs only Python 3).
        docker.enabled   = false
        singularity.enabled = false
    }

    // ------------------------------------------------------------------
    // test: ultra-minimal resources for CI (GitHub Actions, etc.)
    // ------------------------------------------------------------------
    test {
        params.mock_mode            = true
        params.af3_mode             = 'mock'
        params.diffdock_poses       = 3
        params.diffdock_inference_steps = 5
        params.vina_exhaustiveness  = 4
        params.vina_num_modes       = 3

        process {
            withName: 'ALPHAFOLD3_STRUCTURE_PREDICTION' {
                cpus   = 1
                memory = '4.GB'
                time   = '30m'
            }
            withName: 'DIFFDOCK_BLIND_DOCKING' {
                cpus   = 1
                memory = '4.GB'
                time   = '15m'
            }
            withName: 'AUTODOCK_VINA_DOCKING' {
                cpus   = 1
                memory = '4.GB'
                time   = '15m'
            }
        }

        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    // ------------------------------------------------------------------
    // docker: live mode with Docker containers
    // ------------------------------------------------------------------
    docker {
        params.mock_mode = false

        docker.enabled      = true
        docker.runOptions   = '--gpus all -u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false

        process {
            withName: 'ALPHAFOLD3_STRUCTURE_PREDICTION' {
                container = 'docker.io/catgumag/alphafold3:latest'
            }
            withName: 'DIFFDOCK_BLIND_DOCKING' {
                container = 'docker.io/simonelenz/diffdock:latest'
            }
            withName: 'AUTODOCK_VINA_DOCKING' {
                container = 'docker.io/cford38/autodockvina:latest'
            }
        }
    }

    // ------------------------------------------------------------------
    // singularity: live mode with Singularity/Apptainer (HPC-friendly)
    // ------------------------------------------------------------------
    singularity {
        params.mock_mode = false

        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false

        process {
            withName: 'ALPHAFOLD3_STRUCTURE_PREDICTION' {
                container = 'docker://catgumag/alphafold3:latest'
            }
            withName: 'DIFFDOCK_BLIND_DOCKING' {
                container = 'docker://simonelenz/diffdock:latest'
            }
            withName: 'AUTODOCK_VINA_DOCKING' {
                container = 'docker://cford38/autodockvina:latest'
            }
        }
    }

    // ------------------------------------------------------------------
    // gpu: single-GPU local execution (developer workstation / DGX)
    // ------------------------------------------------------------------
    gpu {
        params.mock_mode = false

        process.executor    = 'local'
        docker.enabled      = true
        docker.runOptions   = '--gpus all -u $(id -u):$(id -g)'
        singularity.enabled = false

        process {
            // AF3 — one job at a time (fills GPU memory)
            withName: 'ALPHAFOLD3_STRUCTURE_PREDICTION' {
                container    = 'docker.io/catgumag/alphafold3:latest'
                maxForks     = 1
                clusterOptions = '--gres=gpu:1'
                cpus         = 8
                memory       = '64.GB'
                time         = '48h'
            }

            // DiffDock — can share GPU after AF3 finishes
            withName: 'DIFFDOCK_BLIND_DOCKING' {
                container    = 'docker.io/simonelenz/diffdock:latest'
                maxForks     = 1
                clusterOptions = '--gres=gpu:1'
                cpus         = 4
                memory       = '32.GB'
                time         = '4h'
            }

            // Vina — CPU only; can run concurrently with DiffDock GPU jobs
            withName: 'AUTODOCK_VINA_DOCKING' {
                container    = 'docker.io/cford38/autodockvina:latest'
                cpus         = 8
                memory       = '16.GB'
                time         = '2h'
            }
        }
    }

    // ------------------------------------------------------------------
    // aws: AWS Batch on a GPU-enabled compute environment
    // ------------------------------------------------------------------
    aws {
        params.mock_mode = false

        process.executor = 'awsbatch'
        aws.region       = 'us-east-1'

        process {
            withName: 'ALPHAFOLD3_STRUCTURE_PREDICTION' {
                queue     = 'biomate-gpu-queue'
                container = 'docker.io/catgumag/alphafold3:latest'
                cpus      = 8
                memory    = '64.GB'
                time      = '48h'
            }
            withName: 'DIFFDOCK_BLIND_DOCKING' {
                queue     = 'biomate-gpu-queue'
                container = 'docker.io/simonelenz/diffdock:latest'
                cpus      = 4
                memory    = '32.GB'
                time      = '4h'
            }
            withName: 'AUTODOCK_VINA_DOCKING' {
                queue     = 'biomate-cpu-queue'
                container = 'docker.io/cford38/autodockvina:latest'
                cpus      = 8
                memory    = '16.GB'
                time      = '2h'
            }
        }
    }

    // ------------------------------------------------------------------
    // slurm: SLURM HPC cluster with GPU partition
    // ------------------------------------------------------------------
    slurm {
        params.mock_mode = false

        process.executor = 'slurm'

        process {
            withName: 'ALPHAFOLD3_STRUCTURE_PREDICTION' {
                queue          = 'gpu'
                clusterOptions = '--gres=gpu:1 --constraint=a100'
                cpus           = 8
                memory         = '64.GB'
                time           = '48h'
            }
            withName: 'DIFFDOCK_BLIND_DOCKING' {
                queue          = 'gpu'
                clusterOptions = '--gres=gpu:1'
                cpus           = 4
                memory         = '32.GB'
                time           = '4h'
            }
            withName: 'AUTODOCK_VINA_DOCKING' {
                queue          = 'cpu'
                cpus           = 8
                memory         = '16.GB'
                time           = '2h'
            }
        }

        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
}

// ============================================================================
// Execution reports
// ============================================================================

timeline {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields   = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss,vmem,peak_vmem,rchar,wchar'
}

dag {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

// ============================================================================
// Manifest
// ============================================================================

manifest {
    name            = 'biomate/structure_prediction_docking'
    author          = 'BioMate AI'
    description     = 'AlphaFold3 structure prediction + DiffDock + AutoDock Vina docking pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
    doi             = ''
}
