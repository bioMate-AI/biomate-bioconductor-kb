/*
 * SynCraft Synthesizability Optimization — Nextflow config (CPU, LLM-backed)
 */

params {
    outdir           = './results'
    publish_dir_mode = 'copy'
}

process {
    container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/ai-tools/syncraft:latest'

    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 30.min
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 8.GB
        time   = 2.h
    }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

profiles {
    standard {
        process.executor = 'local'
        docker.enabled   = true
    }

    cpu_batch {
        process.executor  = 'awsbatch'
        aws.region        = 'us-west-2'
        aws.batch.cliPath = '/opt/aws-cli/bin/aws'

        process {
            withLabel: 'process_medium' {
                queue = 'biomate-nextflow-queue'
            }
            withLabel: 'process_low' {
                queue = 'biomate-nextflow-queue'
            }
        }
    }
}

manifest {
    name            = 'syncraft_synthesizability'
    description     = 'LLM-guided synthesizability optimization with SynCraft (Gemini-2.5-Pro)'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
