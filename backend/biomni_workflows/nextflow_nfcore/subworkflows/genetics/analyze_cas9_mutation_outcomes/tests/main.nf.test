nextflow_process {
    name "Test Process ANALYZE_CAS9_MUTATION_OUTCOMES"
    script "../main.nf"
    process "ANALYZE_CAS9_MUTATION_OUTCOMES"

    test("Should run analyze_cas9_mutation_outcomes with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
