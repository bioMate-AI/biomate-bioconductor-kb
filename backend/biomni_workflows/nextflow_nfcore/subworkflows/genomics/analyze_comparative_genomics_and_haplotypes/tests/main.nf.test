nextflow_process {
    name "Test Process ANALYZE_COMPARATIVE_GENOMICS_AND_HAPLOTYPES"
    script "../main.nf"
    process "ANALYZE_COMPARATIVE_GENOMICS_AND_HAPLOTYPES"

    test("Should run analyze_comparative_genomics_and_haplotypes with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
