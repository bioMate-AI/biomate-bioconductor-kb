nextflow_process {
    name "Test Process CREATE_HARMONY_EMBEDDINGS_SCRNA"
    script "../main.nf"
    process "CREATE_HARMONY_EMBEDDINGS_SCRNA"

    test("Should run create_harmony_embeddings_scRNA with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
