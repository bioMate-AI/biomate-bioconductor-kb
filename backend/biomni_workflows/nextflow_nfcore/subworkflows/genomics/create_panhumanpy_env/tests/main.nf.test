nextflow_process {

    name "Test Process CREATE_PANHUMANPY_ENV"
    script "../main.nf"
    process "CREATE_PANHUMANPY_ENV"

    test("Should run create_panhumanpy_env successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
