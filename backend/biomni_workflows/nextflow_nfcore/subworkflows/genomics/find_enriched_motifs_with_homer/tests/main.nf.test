nextflow_process {
    name "Test Process FIND_ENRICHED_MOTIFS_WITH_HOMER"
    script "../main.nf"
    process "FIND_ENRICHED_MOTIFS_WITH_HOMER"

    test("Should run find_enriched_motifs_with_homer with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
