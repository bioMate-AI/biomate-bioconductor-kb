nextflow_process {
    name "Test Process GENERATE_EMBEDDINGS_WITH_STATE"
    script "../main.nf"
    process "GENERATE_EMBEDDINGS_WITH_STATE"

    test("Should run generate_embeddings_with_state with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
