/*
 * geo_data_connector — Nextflow configuration
 * nf-core style configuration for the GEO / TCGA data connector workflow.
 */

// ─── Default parameters ──────────────────────────────────────────────────────

params {
    outdir                = './results'
    publish_dir_mode      = 'copy'

    // GEO accession to fetch (GSE or GSM prefix). Required unless a local
    // series matrix is supplied; never default to a fabricated accession.
    accession             = null

    // Optional path to a pre-downloaded series matrix file
    local_series_matrix   = null

    // Required only when a GSE resolves to multiple platforms.  The workflow
    // fails with the available IDs instead of silently choosing the first.
    platform_id           = null

    // Container image used by all three processes
    container             = 'quay.io/biocontainers/bioconductor-geoquery:2.74.0--r44hdfd78af_0'
}

// ─── Process defaults ────────────────────────────────────────────────────────

process {
    container = params.container

    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 8.GB
        time   = 4.h
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = 16.GB
        time   = 8.h
    }

    // Retry on common OOM / signal exit codes
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

// ─── Execution profiles ──────────────────────────────────────────────────────

profiles {

    standard {
        process.executor = 'local'
    }

    // test profile — always runs in stub mode (no R required)
    test {
        // A test fixture may use a fake accession only because stubRun means
        // no remote GEO record is ever requested.  Production defaults stay
        // null above.
        params.accession  = 'GSE_TEST_STUB'

        stubRun = true

        process {
            withLabel: 'process_low' {
                cpus   = 1
                memory = 2.GB
                time   = 30.m
            }
            withLabel: 'process_medium' {
                cpus   = 1
                memory = 2.GB
                time   = 30.m
            }
            withLabel: 'process_high' {
                cpus   = 2
                memory = 4.GB
                time   = 1.h
            }
        }
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    conda {
        conda.enabled       = true
        docker.enabled      = false
        singularity.enabled = false
    }

    // AWS Batch profile
    aws {
        process.executor    = 'awsbatch'
        aws.region          = 'us-west-2'
        aws.batch.cliPath   = '/opt/aws-cli/bin/aws'
        docker.enabled      = true

        // No hard-coded `queue` names here: they were 'biomate-medium-queue' /
        // 'biomate-high-queue', which do NOT exist (the real queues are
        // biomate-nextflow-queue + biomate-hpc-queue, us-west-2) — a stale config
        // unique to this workflow that failed GEO_FETCH with "JobQueue not found"
        // (2026-11-02). Queue routing is injected by the executor (-c override:
        // default biomate-nextflow-queue, process_high → biomate-hpc-queue), exactly
        // like every other subworkflow. Keep only cpus/memory here.
        process {
            withLabel: 'process_low' {
                cpus   = 2
                memory = 4.GB
            }
            withLabel: 'process_medium' {
                cpus   = 4
                memory = 8.GB
            }
            withLabel: 'process_high' {
                cpus   = 8
                memory = 16.GB
            }
        }
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
    }
}

// ─── Execution reports ───────────────────────────────────────────────────────

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}

// ─── Manifest ────────────────────────────────────────────────────────────────

manifest {
    name            = 'geo_data_connector'
    author          = 'BioMate AI'
    description     = 'GEO/TCGA data connector: fetch count matrix and clinical metadata from GEO accessions for downstream DE workflows'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.10.0'
    version         = '1.0.0'
}
