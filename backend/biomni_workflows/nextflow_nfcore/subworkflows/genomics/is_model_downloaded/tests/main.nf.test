nextflow_process {

    name "Test Process IS_MODEL_DOWNLOADED"
    script "../main.nf"
    process "IS_MODEL_DOWNLOADED"

    test("Should run is_model_downloaded successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
