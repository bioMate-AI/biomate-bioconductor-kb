params { outdir = './results' }
profiles {
    standard { process.executor = 'local'; docker.enabled = true }
    docker    { docker.enabled = true; process.executor = 'local' }
    aws {
        docker.enabled = true
        process { executor = 'awsbatch'; queue = 'biomate-nextflow-queue' }
        aws { region = 'us-west-2'; batch.cliPath = '/opt/aws-cli/bin/aws' }
    }
}
