nextflow_process {
    name "Test Process MAP_TO_IMA_INTERPRET_SCRNA"
    script "../main.nf"
    process "MAP_TO_IMA_INTERPRET_SCRNA"

    test("Should run map_to_ima_interpret_scRNA with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
