/*
 * BioMate — Trajectory Inference Nextflow Configuration
 * Sprint 3: single-cell pseudotime + RNA velocity
 *
 * Processes:  MONOCLE3_TRAJECTORY | SCVELO_DYNAMICS
 * Entry WF:   TRAJECTORY_INFERENCE (both run in parallel)
 */

// ── Default parameters ──────────────────────────────────────
params {
    outdir          = './results/trajectory_inference'
    publish_dir_mode = 'copy'

    // Mock mode (set false to supply a real AnnData h5ad file)

    // Real input
    adata_h5ad      = null   // AnnData .h5ad with spliced/unspliced + UMAP

    // Monocle3 settings
    root_cell       = null          // barcode of trajectory root cell
    monocle_cluster = 'leiden'

    // scVelo settings
    velocity_mode   = 'dynamical'   // stochastic | deterministic | dynamical

    // Container overrides (rarely needed)
    monocle3_container = 'quay.io/biocontainers/bioconductor-monocle3:1.3.4--r44_0'
    scvelo_container   = 'biomate/biomni-tools:latest'
}

// ── Process defaults ─────────────────────────────────────────
process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 16.GB   // Monocle3 UMAP + graph learning
        time   = 4.h
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = 32.GB   // scVelo dynamical mode can be memory-intensive
        time   = 8.h
    }

    withName: 'MONOCLE3_TRAJECTORY' {
        container = params.monocle3_container
    }
    withName: 'SCVELO_DYNAMICS' {
        container = params.scvelo_container
    }

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

// ── Profiles ─────────────────────────────────────────────────
profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled     = false
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }

    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
    }

    test {
        params.velocity_mode = 'stochastic'   // faster for CI
        stubRun = true
        process {
            withLabel: 'process_low'    { cpus = 1; memory = 2.GB }
            withLabel: 'process_medium' { cpus = 1; memory = 4.GB }
            withLabel: 'process_high'   { cpus = 2; memory = 8.GB }
        }
    }

    aws {
        process.executor        = 'awsbatch'
        aws.region              = 'us-east-1'
        aws.batch.cliPath       = '/opt/aws-cli/bin/aws'
    }

    slurm {
        process.executor        = 'slurm'
        process.queue           = 'normal'
    }

    gpu {
        // Enable GPU acceleration for scVelo dynamical mode
        process.executor        = 'local'
        process {
            withName: 'SCVELO_DYNAMICS' {
                containerOptions = '--gpus all'
                memory           = 32.GB
            }
        }
    }
}

// ── Execution reports ─────────────────────────────────────────
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

// ── Manifest ──────────────────────────────────────────────────
manifest {
    name            = 'biomate-trajectory-inference'
    author          = 'BioMate AI'
    description     = 'Pseudotime (Monocle3) + RNA velocity (scVelo) in parallel (Sprint 3)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.10.0'
    version         = '1.0.0'
}
