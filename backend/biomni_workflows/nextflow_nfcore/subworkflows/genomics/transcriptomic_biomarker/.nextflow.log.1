  rmd_content <- paste0('---
  title: "BioMate Transcriptomic Biomarker Report"
  output: html_document
  ---
  
  ## Summary
  
  - Contrast: ', mod_sum[["contrast"]], '
  - Significant DE genes: ', mod_sum[["n_significant"]], '
