/*
 * BioMate Nextflow Configuration
 * genomics/transcriptomic_biomarker
 *
 * LIMMA differential expression + GSVA gene signature scoring pipeline
 *
 * Profiles:
 *   standard    — local executor (default; no special tools needed)
 *   test        — minimal resources, fast CI
 *   docker      — Docker containers, live mode (Bioconductor image)
 *   singularity — Singularity containers, live mode (HPC-friendly)
 *   stub        — Nextflow stub-run mode for rapid pipeline graph validation
 */

// ============================================================================
// Default parameters
// ============================================================================

params {
    // --- Output ---
    outdir              = './results/transcriptomic_biomarker'
    publish_dir_mode    = 'copy'

    // --- Mode ---

    // --- Input files (required in live mode) ---
    expression_matrix   = null          // path to genes×samples CSV/TSV
    metadata            = null          // path to sample metadata CSV

    // --- Analysis settings ---
    group_column        = 'group'       // metadata column for group contrast
    reference_group     = 'control'     // baseline group label
    fdr_threshold       = 0.05          // FDR cutoff (adj.P.Val)
    logfc_threshold     = 1.0           // |log2FC| cutoff

    // --- LIMMA settings ---
    voom_plot           = true          // emit mean-variance trend PNG
    covariates          = null          // comma-separated covariate column names

    // --- GSVA settings ---
    gsva_method         = 'gsva'        // 'gsva' or 'ssgsea'
    min_gene_set_size   = 10
    max_gene_set_size   = 500
}

// ============================================================================
// Process resource defaults (labels used in main.nf)
// ============================================================================

process {
    // Error handling — retry on OOM / SIGKILL
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    // --- Input QC: lightweight validation ---
    withName: 'BIOMARKER_INPUT_QC' {
        cpus   = 2
        memory = '8.GB'
        time   = '30m'
    }

    // --- LIMMA DE: moderate compute (voom + eBayes) ---
    withName: 'LIMMA_DIFFERENTIAL_EXPRESSION' {
        cpus   = 4
        memory = '16.GB'
        time   = '1h'
    }

    // --- GSVA: moderately memory-intensive (gene set matrix operations) ---
    withName: 'BIOMARKER_SIGNATURE_SCORING' {
        cpus   = 4
        memory = '32.GB'
        time   = '2h'
    }

    // --- Report rendering: R Markdown / ggplot2 ---
    withName: 'BIOMARKER_REPORT' {
        cpus   = 2
        memory = '8.GB'
        time   = '30m'
    }
}

// ============================================================================
// Profiles
// ============================================================================

profiles {

    // ------------------------------------------------------------------
    // standard: local executor, no containers
    // ------------------------------------------------------------------
    standard {

        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    // ------------------------------------------------------------------
    // test: ultra-minimal resources for CI (GitHub Actions, etc.)
    // ------------------------------------------------------------------
    test {
        params.fdr_threshold    = 0.10
        params.logfc_threshold  = 0.5

        process {
            withName: 'BIOMARKER_INPUT_QC' {
                cpus   = 1
                memory = '2.GB'
                time   = '10m'
            }
            withName: 'LIMMA_DIFFERENTIAL_EXPRESSION' {
                cpus   = 1
                memory = '4.GB'
                time   = '15m'
            }
            withName: 'BIOMARKER_SIGNATURE_SCORING' {
                cpus   = 1
                memory = '4.GB'
                time   = '15m'
            }
            withName: 'BIOMARKER_REPORT' {
                cpus   = 1
                memory = '2.GB'
                time   = '10m'
            }
        }

        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    // ------------------------------------------------------------------
    // docker: live mode with Docker containers (Bioconductor image)
    // ------------------------------------------------------------------
    docker {

        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -v /tmp:/tmp'
        singularity.enabled = false

        process {
            withName: 'BIOMARKER_INPUT_QC' {
                container = 'docker.io/bioconductor/bioconductor_docker:RELEASE_3_18'
            }
            withName: 'LIMMA_DIFFERENTIAL_EXPRESSION' {
                container = 'docker.io/bioconductor/bioconductor_docker:RELEASE_3_18'
            }
            withName: 'BIOMARKER_SIGNATURE_SCORING' {
                container = 'docker.io/bioconductor/bioconductor_docker:RELEASE_3_18'
            }
            withName: 'BIOMARKER_REPORT' {
                container = 'docker.io/bioconductor/bioconductor_docker:RELEASE_3_18'
            }
        }
    }

    // ------------------------------------------------------------------
    // singularity: live mode with Singularity/Apptainer (HPC-friendly)
    // ------------------------------------------------------------------
    singularity {

        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false

        process {
            withName: 'BIOMARKER_INPUT_QC' {
                container = 'docker://bioconductor/bioconductor_docker:RELEASE_3_18'
            }
            withName: 'LIMMA_DIFFERENTIAL_EXPRESSION' {
                container = 'docker://bioconductor/bioconductor_docker:RELEASE_3_18'
            }
            withName: 'BIOMARKER_SIGNATURE_SCORING' {
                container = 'docker://bioconductor/bioconductor_docker:RELEASE_3_18'
            }
            withName: 'BIOMARKER_REPORT' {
                container = 'docker://bioconductor/bioconductor_docker:RELEASE_3_18'
            }
        }
    }

    // ------------------------------------------------------------------
    // stub: Nextflow stub-run profile — validates DAG without running
    //       any actual scripts (use: nextflow run main.nf -profile stub)
    // ------------------------------------------------------------------
    stub {

        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    // ------------------------------------------------------------------
    // slurm: SLURM HPC cluster (CPU-only; no GPU needed for R/GSVA)
    // ------------------------------------------------------------------
    slurm {

        process.executor = 'slurm'

        process {
            withName: 'BIOMARKER_INPUT_QC' {
                queue          = 'cpu'
                cpus           = 2
                memory         = '8.GB'
                time           = '30m'
            }
            withName: 'LIMMA_DIFFERENTIAL_EXPRESSION' {
                queue          = 'cpu'
                cpus           = 4
                memory         = '16.GB'
                time           = '1h'
            }
            withName: 'BIOMARKER_SIGNATURE_SCORING' {
                queue          = 'cpu'
                cpus           = 4
                memory         = '32.GB'
                time           = '2h'
            }
            withName: 'BIOMARKER_REPORT' {
                queue          = 'cpu'
                cpus           = 2
                memory         = '8.GB'
                time           = '30m'
            }
        }

        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    aws {
        docker.enabled = true
        process {
            executor = 'awsbatch'
            queue    = 'biomate-nextflow-queue'
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/usr/local/bin/aws'
        }
    }
}

// ============================================================================
// Execution reports
// ============================================================================

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss,vmem,peak_vmem,rchar,wchar'
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

// ============================================================================
// Manifest
// ============================================================================

manifest {
    name            = 'biomate/transcriptomic_biomarker'
    author          = 'BioMate AI'
    description     = 'LIMMA-voom differential expression + GSVA/ssGSEA pathway signature scoring for transcriptomic biomarker discovery'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
    doi             = ''
}
