nextflow_process {
    name "Test Process UNSUPERVISED_CELLTYPE_TRANSFER_BETWEEN_SCRNA_DATASETS"
    script "../main.nf"
    process "UNSUPERVISED_CELLTYPE_TRANSFER_BETWEEN_SCRNA_DATASETS"

    test("Should run unsupervised_celltype_transfer_between_scRNA_datasets with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
