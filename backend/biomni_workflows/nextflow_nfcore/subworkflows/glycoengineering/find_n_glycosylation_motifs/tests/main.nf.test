nextflow_process {

    name "Test Process FIND_N_GLYCOSYLATION_MOTIFS"
    script "../main.nf"
    process "FIND_N_GLYCOSYLATION_MOTIFS"

    test("Should run find_n_glycosylation_motifs successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
