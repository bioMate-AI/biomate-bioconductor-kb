nextflow_process {

    name "Test Process PREDICT_O_GLYCOSYLATION_HOTSPOTS"
    script "../main.nf"
    process "PREDICT_O_GLYCOSYLATION_HOTSPOTS"

    test("Should run predict_o_glycosylation_hotspots successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
