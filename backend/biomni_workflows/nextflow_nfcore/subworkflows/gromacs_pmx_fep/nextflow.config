/*
 * BioMate Nextflow Configuration — drug_discovery/gromacs_pmx_fep
 *
 * Generic relative FEP (ΔΔG) for residue-mutation / peptide / cyclic / metal edges,
 * via GROMACS + pmx. Mirrors the openfe_rbfe profile layout so the Galaxy Nextflow
 * executor launches it identically (-profile <p> -c <override> --<param> ...).
 *
 * Profiles:
 *   standard   — local executor (CPU; define_edge/prepare/setup only — no real ΔΔG)
 *   docker     — local Docker (CPU; setup/smoke)
 *   gpu_batch  — AWS Batch; GPU steps (EQUILIBRATE, FEP_PRODUCTION) on the SPOT GPU
 *                queue for --mode production (spot-only; jobs are RUNNABLE until capacity)
 */

params {
    outdir            = './results/gromacs_pmx_fep'
    publish_dir_mode  = 'copy'

    receptor          = null            // null → main.nf falls back to assets/1BXL.pdb
    edge_kind         = 'peptide_pair'  // control edge default (schema-aligned)
    edge_spec         = 'GQVGRQLAIIGDDINR|AQVGRQLAIIGDDINR'   // BAK BH3 WT | G1A
    modality          = 'peptide'
    metal_model       = 'none'
    legs              = 'complex,solvent'

    dt_fs             = 2.0
    equil_ns          = 0.7
    restraints        = 'backbone'

    lambda_windows    = 12
    production_ns     = 5.0
    protocol_repeats  = 3
    temperature       = 298.15

    control_edge_expected = null

    mode              = 'setup'      // setup | smoke | production
    gates_cleared     = ''
    use_aws           = false
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'DEFINE_EDGE'   { cpus = 2;  memory = '4.GB';  time = '20m' }
    withName: 'PREPARE'       { cpus = 8;  memory = '32.GB'; time = '4h'  }
    withName: 'EQUILIBRATE'   { cpus = 16; memory = '64.GB'; time = '24h' }
    withName: 'FEP_PRODUCTION'{ cpus = 16; memory = '64.GB'; time = '96h' }
    withName: 'ANALYZE'       { cpus = 4;  memory = '16.GB'; time = '2h'  }
}

profiles {

    standard {
        process.executor    = 'local'
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor  = 'local'
    }

    gpu_batch {
        // Production FEP. --mode production must be set for a ΔΔG. GPU steps on the
        // SPOT GPU queue (spot-only discipline; RUNNABLE until capacity, never on-demand).
        params.use_aws = true
        docker.enabled = true
        process {
            executor  = 'awsbatch'
            queue     = 'biomate-hpc-queue'
            container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/gromacs-cuda:2024-cu12'

            withName: 'DEFINE_EDGE|PREPARE|ANALYZE' {
                queue = 'biomate-hpc-queue'   // CPU steps
            }
            withName: 'EQUILIBRATE|FEP_PRODUCTION' {
                queue       = 'biomate-gpu-spot-queue'   // SPOT GPU (spend gates)
                accelerator = 1
                cpus        = 16
                memory      = '64.GB'
            }
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
        workDir = 's3://biomate-nextflow-work/gromacs_pmx_fep/'
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss'
}

manifest {
    name            = 'biomate/gromacs_pmx_fep'
    author          = 'BioMate AI'
    description     = 'Generic relative FEP (ΔΔG) for residue-mutation/peptide/cyclic/metal edges via GROMACS+pmx; stepwise, gate-enforced, honesty contract'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
