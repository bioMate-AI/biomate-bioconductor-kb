nextflow_process {

    name "Test Process ANALYZE_CFSE_CELL_PROLIFERATION"
    script "../main.nf"
    process "ANALYZE_CFSE_CELL_PROLIFERATION"

    test("Should run analyze_cfse_cell_proliferation successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
