nextflow_process {
    name "Test Process ESTIMATE_CELL_CYCLE_PHASE_DURATIONS"
    script "../main.nf"
    process "ESTIMATE_CELL_CYCLE_PHASE_DURATIONS"

    test("Should run estimate_cell_cycle_phase_durations with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
