nextflow_process {
    name "Test Process OBJECTIVE_FUNCTION"
    script "../main.nf"
    process "OBJECTIVE_FUNCTION"

    test("Should run objective_function with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
