nextflow_process {

    name "Test Process SIMULATE_CELL_POPULATION"
    script "../main.nf"
    process "SIMULATE_CELL_POPULATION"

    test("Should run simulate_cell_population successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
