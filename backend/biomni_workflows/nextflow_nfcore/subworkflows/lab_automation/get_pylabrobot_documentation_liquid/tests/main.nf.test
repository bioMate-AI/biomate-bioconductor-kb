nextflow_process {
    name "Test Process GET_PYLABROBOT_DOCUMENTATION_LIQUID"
    script "../main.nf"
    process "GET_PYLABROBOT_DOCUMENTATION_LIQUID"

    test("Should run get_pylabrobot_documentation_liquid with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
