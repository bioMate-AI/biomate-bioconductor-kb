#!/usr/bin/env nextflow
nextflow.enable.dsl=2

// Minimal test workflow that outputs an HTML report.
// Used exclusively by the WC-6 E2E test to verify the HTML iframe viewer.
// Runs on AWS Batch via the biomate-nextflow-base ECR image.

params.outdir = 'results'
params.report_title = 'BioMate Test Report'

process GENERATE_HTML_REPORT {
    container '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate-nextflow-base:latest'
    publishDir params.outdir, mode: 'copy'

    output:
    path 'multiqc_report.html'

    script:
    """
    cat > multiqc_report.html << 'HTMLEOF'
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>${params.report_title}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; background: #f8f9fa; }
    h1 { color: #2c3e50; }
    .summary { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }
    .stat { display: inline-block; margin: 10px 20px; text-align: center; }
    .stat .value { font-size: 2em; font-weight: bold; color: #27ae60; }
    .stat .label { font-size: 0.85em; color: #666; }
  </style>
</head>
<body>
  <h1>${params.report_title}</h1>
  <div class="summary">
    <h2>Analysis Summary</h2>
    <div class="stat"><div class="value">1</div><div class="label">Samples</div></div>
    <div class="stat"><div class="value">100%</div><div class="label">QC Pass Rate</div></div>
    <div class="stat"><div class="value">42M</div><div class="label">Reads Processed</div></div>
    <p style="color:#666;margin-top:20px;">Generated by BioMate HTML Output Test workflow (E2E test fixture).</p>
  </div>
</body>
</html>
HTMLEOF
    """
}

workflow {
    GENERATE_HTML_REPORT()
}
