nextflow_process {

    name "Test Process PICK_FIRST"
    script "../main.nf"
    process "PICK_FIRST"

    test("Should run pick_first successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
