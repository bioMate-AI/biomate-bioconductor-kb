nextflow_process {

    name "Test Process RUN_ASYNC"
    script "../main.nf"
    process "RUN_ASYNC"

    test("Should run run_async successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
