nextflow_process {

    name "Test Process TARGET"
    script "../main.nf"
    process "TARGET"

    test("Should run target successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
