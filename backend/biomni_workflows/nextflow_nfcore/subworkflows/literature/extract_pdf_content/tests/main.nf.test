nextflow_process {
    name "Test Process EXTRACT_PDF_CONTENT"
    script "../main.nf"
    process "EXTRACT_PDF_CONTENT"

    test("Should run extract_pdf_content with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
