nextflow_process {

    name "Test Process MODEL_BACTERIAL_GROWTH_DYNAMICS"
    script "../main.nf"
    process "MODEL_BACTERIAL_GROWTH_DYNAMICS"

    test("Should run model_bacterial_growth_dynamics successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
