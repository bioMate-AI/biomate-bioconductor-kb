nextflow_process {
    name "Test Process OPTIMIZE_ANAEROBIC_DIGESTION_PROCESS"
    script "../main.nf"
    process "OPTIMIZE_ANAEROBIC_DIGESTION_PROCESS"

    test("Should run optimize_anaerobic_digestion_process with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
