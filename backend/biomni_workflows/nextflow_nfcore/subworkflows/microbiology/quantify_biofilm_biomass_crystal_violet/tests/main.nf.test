nextflow_process {
    name "Test Process QUANTIFY_BIOFILM_BIOMASS_CRYSTAL_VIOLET"
    script "../main.nf"
    process "QUANTIFY_BIOFILM_BIOMASS_CRYSTAL_VIOLET"

    test("Should run quantify_biofilm_biomass_crystal_violet with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
