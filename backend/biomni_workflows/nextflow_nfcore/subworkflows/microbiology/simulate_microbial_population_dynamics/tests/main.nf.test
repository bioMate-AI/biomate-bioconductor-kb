nextflow_process {
    name "Test Process SIMULATE_MICROBIAL_POPULATION_DYNAMICS"
    script "../main.nf"
    process "SIMULATE_MICROBIAL_POPULATION_DYNAMICS"

    test("Should run simulate_microbial_population_dynamics with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
