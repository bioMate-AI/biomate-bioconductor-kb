nextflow_process {
    name "Test Process DESIGN_KNOCKOUT_SGRNA"
    script "../main.nf"
    process "DESIGN_KNOCKOUT_SGRNA"

    test("Should run design_knockout_sgrna with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
