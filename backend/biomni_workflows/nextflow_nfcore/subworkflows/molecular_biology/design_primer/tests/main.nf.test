nextflow_process {

    name "Test Process DESIGN_PRIMER"
    script "../main.nf"
    process "DESIGN_PRIMER"

    test("Should run design_primer successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
