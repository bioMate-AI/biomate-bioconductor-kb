nextflow_process {

    name "Test Process DIGEST_SEQUENCE"
    script "../main.nf"
    process "DIGEST_SEQUENCE"

    test("Should run digest_sequence successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
