nextflow_process {

    name "Test Process FIND_RESTRICTION_SITES"
    script "../main.nf"
    process "FIND_RESTRICTION_SITES"

    test("Should run find_restriction_sites successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
