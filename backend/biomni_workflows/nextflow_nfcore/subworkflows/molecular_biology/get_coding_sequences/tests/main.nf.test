nextflow_process {

    name "Test Process GET_CODING_SEQUENCES"
    script "../main.nf"
    process "GET_CODING_SEQUENCES"

    test("Should run get_coding_sequences successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
