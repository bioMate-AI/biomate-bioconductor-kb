nextflow_process {

    name "Test Process GET_GENE_CODING_SEQUENCE"
    script "../main.nf"
    process "GET_GENE_CODING_SEQUENCE"

    test("Should run get_gene_coding_sequence successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
