nextflow_process {
    name "Test Process GET_GOLDEN_GATE_ASSEMBLY_PROTOCOL"
    script "../main.nf"
    process "GET_GOLDEN_GATE_ASSEMBLY_PROTOCOL"

    test("Should run get_golden_gate_assembly_protocol with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
