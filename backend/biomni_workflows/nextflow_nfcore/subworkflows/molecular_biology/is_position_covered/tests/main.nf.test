nextflow_process {
    name "Test Process IS_POSITION_COVERED"
    script "../main.nf"
    process "IS_POSITION_COVERED"

    test("Should run is_position_covered with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
