nextflow_process {

    name "Test Process REVERSE_COMPLEMENT"
    script "../main.nf"
    process "REVERSE_COMPLEMENT"

    test("Should run reverse_complement successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
