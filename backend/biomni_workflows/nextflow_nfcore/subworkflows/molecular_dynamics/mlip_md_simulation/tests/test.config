/*
 * Local dry-run profile for molecular_dynamics/mlip_md_simulation.
 *
 * Disables Docker/containers so the --mock branch runs with the host's own
 * python3 (no GPU, no OpenMM, no openmm-ml). This proves the DAG wires up and
 * produces a well-formed summary JSON without any Batch/GPU infrastructure.
 */

docker.enabled     = false
singularity.enabled = false
podman.enabled     = false

process {
    // Strip container requirements for every process in this run.
    withName: '.*' {
        container = null
    }
    // process_high normally maps to a GPU queue on Batch; locally we just run it.
    executor = 'local'
}

params {
    mock          = true
    n_steps       = 100
    temperature_k = 300
    mlip          = 'aimnet2'
}
