nextflow_process {

    name "Test Process ANALYZE_ATP_LUMINESCENCE_ASSAY"
    script "../main.nf"
    process "ANALYZE_ATP_LUMINESCENCE_ASSAY"

    test("Should run analyze_atp_luminescence_assay successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
