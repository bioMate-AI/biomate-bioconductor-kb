nextflow_process {

    name "Test Process ANALYZE_THROMBUS_HISTOLOGY"
    script "../main.nf"
    process "ANALYZE_THROMBUS_HISTOLOGY"

    test("Should run analyze_thrombus_histology successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
