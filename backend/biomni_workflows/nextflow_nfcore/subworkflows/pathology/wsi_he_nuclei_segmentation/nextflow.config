/*
 * pathology/wsi_he_nuclei_segmentation — nf-core style config
 *
 * NOTE: the process-level `container` directive in main.nf is authoritative on
 * AWS Batch (it OVERRIDES this default and the DB docker_image). The default
 * below is only for standalone local/docker runs.
 */

params {
    outdir = './results'
    publish_dir_mode = 'copy'

    // Pinned, registry-verified, license-clean (BSD-3-Clause) cellpose biocontainer.
    container = 'quay.io/biocontainers/cellpose:3.1.0'
}

process {
    container = params.container

    withLabel: 'process_low' {
        cpus = 2
        memory = 4.GB
        time = 1.h
    }
    withLabel: 'process_medium' {
        cpus = 4
        memory = 8.GB
        time = 4.h
    }
    withLabel: 'process_high' {
        cpus = 8
        memory = 16.GB
        time = 8.h
    }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 2
}

profiles {
    standard {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g) -v /tmp:/tmp -e MPLCONFIGDIR=/tmp/matplotlib'
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
    }
    aws {
        process.executor = 'awsbatch'
        aws.region = 'us-west-2'
        aws.batch.cliPath = '/opt/aws-cli/bin/aws'
    }
}

manifest {
    name = 'wsi_he_nuclei_segmentation'
    author = 'Biomate AI'
    description = 'RESEARCH-USE-ONLY WSI H&E nuclei segmentation (OpenSlide + Cellpose)'
    mainScript = 'main.nf'
    nextflowVersion = '>=21.10.0'
    version = '0.1.0'
}
