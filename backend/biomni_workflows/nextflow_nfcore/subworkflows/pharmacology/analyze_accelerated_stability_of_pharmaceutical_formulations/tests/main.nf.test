nextflow_process {
    name "Test Process ANALYZE_ACCELERATED_STABILITY_OF_PHARMACEUTICAL_FORMULATIONS"
    script "../main.nf"
    process "ANALYZE_ACCELERATED_STABILITY_OF_PHARMACEUTICAL_FORMULATIONS"

    test("Should run analyze_accelerated_stability_of_pharmaceutical_formulations with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
