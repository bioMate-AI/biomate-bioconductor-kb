nextflow_process {

    name "Test Process ANALYZE_INTERACTION_MECHANISMS"
    script "../main.nf"
    process "ANALYZE_INTERACTION_MECHANISMS"

    test("Should run analyze_interaction_mechanisms successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
