nextflow_process {
    name "Test Process DOCKING_AUTODOCK_VINA"
    script "../main.nf"
    process "DOCKING_AUTODOCK_VINA"

    test("Should run docking_autodock_vina with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
