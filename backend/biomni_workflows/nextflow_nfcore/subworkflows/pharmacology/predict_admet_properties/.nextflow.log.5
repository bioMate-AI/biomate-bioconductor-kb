      )
      success = True
      error_msg = None
  except Exception as e:
      result = None
      success = False
      error_msg = str(e)
  
  # ── Save main results JSON ───────────────────────────────────────────────────
  output_data = {
      "success": success,
      "function": "predict_admet_properties",
      "domain": "pharmacology",
  }
  if success:
      output_data["result"] = str(result) if not isinstance(result, (dict, list)) else result
  else:
