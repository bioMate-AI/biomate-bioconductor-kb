nextflow_process {
    name "Test Process PREDICT_ADMET_PROPERTIES"
    script "../main.nf"
    process "PREDICT_ADMET_PROPERTIES"

    test("Should run predict_admet_properties with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
