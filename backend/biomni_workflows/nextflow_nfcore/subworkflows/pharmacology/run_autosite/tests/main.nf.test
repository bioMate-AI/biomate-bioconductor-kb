nextflow_process {
    name "Test Process RUN_AUTOSITE"
    script "../main.nf"
    process "RUN_AUTOSITE"

    test("Should run run_autosite with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
