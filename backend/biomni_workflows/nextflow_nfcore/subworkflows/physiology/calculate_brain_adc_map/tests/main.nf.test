nextflow_process {
    name "Test Process CALCULATE_BRAIN_ADC_MAP"
    script "../main.nf"
    process "CALCULATE_BRAIN_ADC_MAP"

    test("Should run calculate_brain_adc_map with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
