nextflow_process {

    name "Test Process MONO_EXP_MODEL"
    script "../main.nf"
    process "MONO_EXP_MODEL"

    test("Should run mono_exp_model successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
