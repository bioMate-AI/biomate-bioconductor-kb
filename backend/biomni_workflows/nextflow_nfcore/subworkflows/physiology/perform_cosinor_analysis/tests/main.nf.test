nextflow_process {

    name "Test Process PERFORM_COSINOR_ANALYSIS"
    script "../main.nf"
    process "PERFORM_COSINOR_ANALYSIS"

    test("Should run perform_cosinor_analysis successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
