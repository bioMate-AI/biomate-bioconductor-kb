nextflow_process {
    name "Test Process QUANTIFY_AMYLOID_BETA_PLAQUES"
    script "../main.nf"
    process "QUANTIFY_AMYLOID_BETA_PLAQUES"

    test("Should run quantify_amyloid_beta_plaques with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
