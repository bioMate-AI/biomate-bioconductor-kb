/*
 * ProFAM-1 Fitness Prediction — Nextflow config
 */

params {
    outdir           = './results'
    publish_dir_mode = 'copy'
}

process {
    container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/ai-tools/profam:latest'

    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 30.min
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = 32.GB
        time   = 4.h
    }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
}

profiles {
    standard {
        process.executor = 'local'
        docker.enabled   = true
    }

    cpu_batch {
        process.executor  = 'awsbatch'
        aws.region        = 'us-west-2'
        aws.batch.cliPath = '/opt/aws-cli/bin/aws'

        process {
            withLabel: 'process_high' {
                queue = 'biomate-hpc-queue'
            }
            withLabel: 'process_low' {
                queue = 'biomate-nextflow-queue'
            }
        }
    }
}

manifest {
    name            = 'profam_fitness_prediction'
    description     = 'Protein variant fitness prediction with ProFAM-1 (ProteinGym SOTA)'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
