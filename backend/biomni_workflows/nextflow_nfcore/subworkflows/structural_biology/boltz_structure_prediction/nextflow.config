/*
 * Boltz-2 Structure Prediction — Nextflow config
 */

params {
    outdir           = './results'
    publish_dir_mode = 'copy'
}

process {
    container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/ai-tools/boltz:latest'

    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 30.min
    }
    withLabel: 'process_gpu' {
        cpus        = 8
        memory      = 32.GB
        time        = 4.h
        accelerator = 1
    }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
}

profiles {
    standard {
        process.executor = 'local'
        docker.enabled   = true
    }

    gpu_batch {
        process.executor = 'awsbatch'
        aws.region       = 'us-west-2'
        aws.batch.cliPath = '/opt/aws-cli/bin/aws'

        process {
            withLabel: 'process_gpu' {
                // Prefer spot GPU (g6/g4dn, SPOT_CAPACITY_OPTIMIZED) for ~70%
                // cost reduction vs on-demand. Retry once on spot reclaim.
                queue            = 'biomate-gpu-spot-queue'
                containerOptions = '--runtime=nvidia'
            }
            withLabel: 'process_low' {
                queue = 'biomate-nextflow-queue'
            }
        }
    }
}

manifest {
    name            = 'boltz_structure_prediction'
    description     = 'Biomolecular structure prediction with Boltz-2'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
