/*
 * Chai-1 Structure Prediction — Nextflow config
 */

params {
    outdir           = './results'
    publish_dir_mode = 'copy'
}

process {
    container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/ai-tools/chai1:latest'

    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 30.min
    }
    withLabel: 'process_gpu' {
        cpus        = 8
        memory      = 48.GB
        time        = 6.h
        accelerator = 1
    }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
}

profiles {
    standard {
        process.executor = 'local'
        docker.enabled   = true
    }

    gpu_batch {
        process.executor  = 'awsbatch'
        aws.region        = 'us-west-2'
        aws.batch.cliPath = '/opt/aws-cli/bin/aws'

        process {
            withLabel: 'process_gpu' {
                queue            = 'galaxy-cloud-queue-gpu'
                containerOptions = '--runtime=nvidia'
            }
            withLabel: 'process_low' {
                queue = 'biomate-nextflow-queue'
            }
        }
    }
}

manifest {
    name            = 'chai1_structure_prediction'
    description     = 'Multi-modal biomolecular structure prediction with Chai-1'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
