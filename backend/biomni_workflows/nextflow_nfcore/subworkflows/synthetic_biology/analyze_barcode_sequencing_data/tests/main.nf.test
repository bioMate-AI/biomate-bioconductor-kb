nextflow_process {
    name "Test Process ANALYZE_BARCODE_SEQUENCING_DATA"
    script "../main.nf"
    process "ANALYZE_BARCODE_SEQUENCING_DATA"

    test("Should run analyze_barcode_sequencing_data with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
