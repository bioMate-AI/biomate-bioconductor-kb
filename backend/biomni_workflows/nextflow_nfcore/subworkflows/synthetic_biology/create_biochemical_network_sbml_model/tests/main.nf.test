nextflow_process {
    name "Test Process CREATE_BIOCHEMICAL_NETWORK_SBML_MODEL"
    script "../main.nf"
    process "CREATE_BIOCHEMICAL_NETWORK_SBML_MODEL"

    test("Should run create_biochemical_network_sbml_model with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
