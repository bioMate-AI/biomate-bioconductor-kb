nextflow_process {

    name "Test Process GENE_CIRCUIT_ODES"
    script "../main.nf"
    process "GENE_CIRCUIT_ODES"

    test("Should run gene_circuit_odes successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
