nextflow_process {

    name "Test Process IDENTIFY_FAS_FUNCTIONAL_DOMAINS"
    script "../main.nf"
    process "IDENTIFY_FAS_FUNCTIONAL_DOMAINS"

    test("Should run identify_fas_functional_domains successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
