nextflow_process {
    name "Test Process COMPARE_PROTEIN_STRUCTURES"
    script "../main.nf"
    process "COMPARE_PROTEIN_STRUCTURES"

    test("Should run compare_protein_structures with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
