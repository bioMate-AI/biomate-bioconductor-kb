nextflow_process {

    name "Test Process HILL_FUNCTION"
    script "../main.nf"
    process "HILL_FUNCTION"

    test("Should run hill_function successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
