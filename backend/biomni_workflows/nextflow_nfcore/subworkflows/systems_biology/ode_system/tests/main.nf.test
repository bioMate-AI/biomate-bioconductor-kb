nextflow_process {

    name "Test Process ODE_SYSTEM"
    script "../main.nf"
    process "ODE_SYSTEM"

    test("Should run ode_system successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
