nextflow_process {

    name "Test Process RAS_ODE_SYSTEM"
    script "../main.nf"
    process "RAS_ODE_SYSTEM"

    test("Should run ras_ode_system successfully") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.results
        }

    }

}
