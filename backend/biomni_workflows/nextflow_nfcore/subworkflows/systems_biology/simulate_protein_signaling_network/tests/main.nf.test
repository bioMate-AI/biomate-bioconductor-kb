nextflow_process {
    name "Test Process SIMULATE_PROTEIN_SIGNALING_NETWORK"
    script "../main.nf"
    process "SIMULATE_PROTEIN_SIGNALING_NETWORK"

    test("Should run simulate_protein_signaling_network with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
