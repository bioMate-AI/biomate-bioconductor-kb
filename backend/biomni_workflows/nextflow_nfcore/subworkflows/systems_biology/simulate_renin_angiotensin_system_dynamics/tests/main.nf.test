nextflow_process {
    name "Test Process SIMULATE_RENIN_ANGIOTENSIN_SYSTEM_DYNAMICS"
    script "../main.nf"
    process "SIMULATE_RENIN_ANGIOTENSIN_SYSTEM_DYNAMICS"

    test("Should run simulate_renin_angiotensin_system_dynamics with default parameters") {
        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }
        then {
            assert process.success
        }
    }
}
