/*
 * virtual_cell/cpa_synergy_gpu — Nextflow configuration
 */

params {
    outdir           = './results'
    publish_dir_mode = 'copy'
    use_aws          = false
}

process {
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_gpu' {
        cpus        = 8
        memory      = 32.GB
        time        = 4.h
        accelerator = 1
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    gpu_batch {
        params.use_aws      = true
        docker.enabled      = true
        singularity.enabled = false

        process {
            executor  = 'awsbatch'
            container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/virtual-cell-gpu:1.0'

            withLabel: 'process_gpu' {
                queue       = 'galaxy-cloud-queue-gpu'
                accelerator = 1
            }
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
    }

    aws {
        params.use_aws      = true
        process.executor    = 'awsbatch'
        docker.enabled      = true
        singularity.enabled = false

        process {
            queue     = 'galaxy-cloud-queue-gpu'
            container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/virtual-cell-gpu:1.0'
            withLabel: 'process_gpu' { accelerator = 1 }
        }
        aws {
            region        = 'us-west-2'
            batch.cliPath = '/opt/aws-cli/bin/aws'
        }
    }
}
