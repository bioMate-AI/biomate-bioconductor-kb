galaxy:
  admin_users: admin@galaxy.org
  ai_llm_api_key: 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
  ai_llm_model: claude-sonnet-4-5
  ai_llm_provider: anthropic
  check_migrate_tools: false
  database_connection: sqlite:///./database/universe.sqlite?isolation_level=IMMEDIATE
  enable_ai_assistant: true
  # Enable Interactive Tools (Jupyter, RStudio, CellxGene)
  # upstream_proxy=true: nginx/Caddy handles routing, no separate gx-it-proxy needed
  interactivetools_enable: true
  interactivetools_upstream_proxy: true
  file_path: database/files
  master_api_key: f17c618a6d8a9b0c397d6cc847a7f658
  new_file_path: database/tmp
  preload_tool_panel: false
  tool_config_file: config/tool_conf.xml.sample,config/shed_tool_conf.xml,config/interactivetools_conf.xml
  tool_dependency_dir: database/dependencies
gravity:
  galaxy_user: galaxy
  gunicorn:
    bind: 0.0.0.0:8080
    max_requests: 1000
    max_requests_jitter: 50
    # workers=4 + preload=true (option (a) from the 2026-06-09 rollback
    # writeup). With preload the master process loads ~600 tools + the
    # SQLite DB once at boot; workers fork via copy-on-write so they
    # don't race on integrated_tool_panel.xml or initialize the DB
    # in parallel.
    #
    # Why this change now: 2026-06-17 after-run audit confirmed
    # single-worker is the root cause of multiple residual UX blockers
    # (Outputs tab empty, Phase B/C/D no running-state, Methods 502,
    # /api/nextflow/execute → 504). See docs/sge-audit-2026-06-16/
    # FINAL_STATE.md. The audit also showed backend/config/galaxy.yml
    # (the non-docker variant) already documents `workers: 4` as
    # correct for any host with ≥8GB RAM — dev's t3-class instance
    # qualifies.
    #
    # If workers fail to bind port 8080 after a sync (the original
    # symptom that motivated rollback), revert to workers=1 and pursue
    # option (b) SQLite → Postgres or option (c) move
    # /api/nextflow/execute to Celery.
    preload: true
    timeout: 300
    worker_class: sync
    workers: 4
  process_manager: supervisor
  # The new image installs deps directly to system Python (/usr/local/lib/...)
  # so we point Gravity's virtualenv at /usr/local. This makes Gravity exec
  # /usr/local/bin/gunicorn and /usr/local/bin/celery instead of /app/.venv/bin/*
  # which doesn't exist in the new image.
  virtualenv: /usr/local
