# BioMate Interactive Tools - ARM64 Version
# Comprehensive all-in-one container with ALL interactive tools
#
# Uses rocker/rstudio as base (has ARM64 support)

FROM rocker/rstudio:4.3

LABEL maintainer="BioMate Team"
LABEL version="2.0"
LABEL architecture="arm64"
LABEL description="All-in-One Interactive Tools for BioMate (ARM64)"

# ============================================
# System dependencies
# ============================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python
    python3 python3-pip python3-venv python3-dev \
    # Build tools
    build-essential cmake pkg-config \
    # HDF5/data formats
    libhdf5-dev \
    # Network/SSL
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    # Graphics
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libcairo2-dev \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    # Bioinformatics CLI
    samtools \
    bcftools \
    bedtools \
    tabix \
    # For pybedtools compilation
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    # Web server
    nginx \
    supervisor \
    # Node.js for JupyterLab and EtherCalc
    nodejs \
    npm \
    # Java for OpenRefine
    default-jre-headless \
    # Git for cloning tools
    git \
    wget \
    unzip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================
# Python environment with Jupyter
# ============================================
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Core Python packages
RUN pip3 install --no-cache-dir \
    jupyterlab \
    notebook \
    ipykernel \
    pandas \
    numpy \
    scipy \
    matplotlib \
    seaborn \
    plotly \
    bokeh \
    ipywidgets

# Bioinformatics Python
RUN pip3 install --no-cache-dir \
    scanpy \
    anndata \
    pysam \
    biopython \
    bioblend \
    h5py \
    pyBigWig

# pybedtools separately (may fail on some ARM, optional)
RUN pip3 install --no-cache-dir pybedtools || echo "pybedtools skipped on ARM"

# CellxGene
RUN pip3 install --no-cache-dir cellxgene

# HiGlass (Hi-C visualization)
RUN pip3 install --no-cache-dir \
    higlass-python \
    clodius \
    cooler || echo "HiGlass packages - some may fail on ARM"

# Additional viz
RUN pip3 install --no-cache-dir \
    gseapy \
    adjustText \
    networkx \
    scikit-learn

# ============================================
# R packages (Bioconductor + visualization)
# ============================================
RUN R -e "install.packages('BiocManager', repos='https://cloud.r-project.org/')"

# Bioconductor core
RUN R -e "BiocManager::install(c('DESeq2', 'edgeR', 'limma'), ask=FALSE, update=FALSE)"

# Bioconductor visualization
RUN R -e "BiocManager::install(c('clusterProfiler', 'enrichplot', 'ComplexHeatmap'), ask=FALSE, update=FALSE)"

# iSEE - Interactive SummarizedExperiment Explorer
RUN R -e "BiocManager::install('iSEE', ask=FALSE, update=FALSE)"

# Single-cell R packages
RUN R -e "BiocManager::install(c('SingleCellExperiment', 'scater', 'scran'), ask=FALSE, update=FALSE)" || echo "Some single-cell packages may fail"

# CRAN packages
RUN R -e "install.packages(c('ggplot2', 'pheatmap', 'ggrepel', 'viridis', 'RColorBrewer', 'tidyverse', 'data.table', 'DT', 'shiny', 'shinydashboard', 'plotly', 'colourpicker', 'rintrojs'), repos='https://cloud.r-project.org/')"

# Pavian (metagenomics)
RUN R -e "install.packages('remotes', repos='https://cloud.r-project.org/')" && \
    R -e "remotes::install_github('fbreitwieser/pavian')"

# ============================================
# OpenRefine (Data cleaning tool)
# ============================================
ARG OPENREFINE_VERSION=3.7.9
RUN mkdir -p /opt/openrefine && \
    wget -q https://github.com/OpenRefine/OpenRefine/releases/download/${OPENREFINE_VERSION}/openrefine-linux-${OPENREFINE_VERSION}.tar.gz -O /tmp/openrefine.tar.gz && \
    tar -xzf /tmp/openrefine.tar.gz -C /opt/openrefine --strip-components=1 && \
    rm /tmp/openrefine.tar.gz

# ============================================
# EtherCalc (Collaborative spreadsheet)
# ============================================
RUN npm install -g ethercalc || echo "EtherCalc installation optional"

# ============================================
# Configuration
# ============================================
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY nginx.conf /etc/nginx/sites-available/default
COPY jupyter_config.py /root/.jupyter/jupyter_notebook_config.py
COPY startup.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/startup.sh

# Create directories
RUN mkdir -p /import /export /var/log/supervisor /var/www/html/hub /data/openrefine

# RStudio config (disable auth)
RUN echo "auth-none=1" >> /etc/rstudio/rserver.conf && \
    echo "www-address=127.0.0.1" >> /etc/rstudio/rserver.conf

# ============================================
# Ports
# ============================================
# 80    - nginx (main entry)
# 8888  - JupyterLab
# 8787  - RStudio
# 5005  - CellxGene
# 3838  - Pavian/Shiny
# 3333  - OpenRefine
# 8000  - EtherCalc
# 8989  - HiGlass
# 7777  - iSEE
EXPOSE 80 8888 8787 5005 3838 3333 8000 8989 7777

ENV GALAXY_URL="" \
    HISTORY_ID=""

WORKDIR /home/rstudio

CMD ["/usr/local/bin/startup.sh"]
