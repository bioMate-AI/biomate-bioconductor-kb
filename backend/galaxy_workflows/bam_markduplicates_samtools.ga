{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "BAM_MARKDUPLICATES_SAMTOOLS",
  "annotation": "BAM_MARKDUPLICATES_SAMTOOLS: Collate, fixmate, sort and markdup using Samtools. This workflow processes BAM files through a series of samtools operations: collate by query name, fix mate pair information, sort by coordinate, and mark duplicate reads.",
  "steps": {
    "0": {
      "annotation": "Input BAM file channel",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_bam",
          "description": "BAM file with metadata"
        }
      ],
      "name": "Input BAM",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input FASTA reference file channel",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_fasta",
          "description": "FASTA reference file with metadata"
        }
      ],
      "name": "Input FASTA",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "SAMTOOLS_COLLATE: Collate BAM file by query name",
      "id": 2,
      "input_connections": {
        "bam_input": {
          "id": 0,
          "output_name": "output"
        },
        "fasta_input": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "SAMTOOLS_COLLATE",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/samtools_depad/Repository_Actions_Depad_SAM/BAM_file",
      "tool_version": "0.0.5",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "3": {
      "annotation": "SAMTOOLS_FIXMATE: Fix mate pair information",
      "id": 3,
      "input_connections": {
        "bam_input": {
          "id": 2,
          "output_name": "bam"
        }
      },
      "name": "SAMTOOLS_FIXMATE",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/samtools_depad/Repository_Actions_Depad_SAM/BAM_file",
      "tool_version": "0.0.5",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "4": {
      "annotation": "SAMTOOLS_SORT: Sort BAM file by coordinate",
      "id": 4,
      "input_connections": {
        "bam_input": {
          "id": 3,
          "output_name": "bam"
        },
        "fasta_input": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "SAMTOOLS_SORT",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/samtools_depad/Repository_Actions_Depad_SAM/BAM_file",
      "tool_version": "0.0.5",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "5": {
      "annotation": "SAMTOOLS_MARKDUP: Mark duplicate reads",
      "id": 5,
      "input_connections": {
        "bam_input": {
          "id": 4,
          "output_name": "bam"
        },
        "fasta_input": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "SAMTOOLS_MARKDUP",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/samtools_depad/Repository_Actions_Depad_SAM/BAM_file",
      "tool_version": "0.0.5",
      "type": "tool",
      "position": {
        "left": 890,
        "top": 10
      }
    },
    "6": {
      "annotation": "Output BAM file with duplicates marked",
      "id": 6,
      "input_connections": {
        "bam": {
          "id": 5,
          "output_name": "bam"
        }
      },
      "name": "Output BAM",
      "type": "data_output",
      "position": {
        "left": 1110,
        "top": 10
      }
    }
  }
}