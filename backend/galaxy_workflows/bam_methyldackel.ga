{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "BAM_METHYLDACKEL",
  "annotation": "Converted from nf-core subworkflow: Extract per-base methylation metrics and methylation bias from BAM files using MethylDackel",
