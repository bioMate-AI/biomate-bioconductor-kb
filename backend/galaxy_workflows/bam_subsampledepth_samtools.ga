      "tool_version": "0.0.5",
      "type": "tool",
      "annotation": "Compute depth statistics from BAM file",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "3": {
      "id": 3,
      "input_connections": {
        "input": {
          "id": 2,
          "output_name": "output"
        }
      },
      "name": "GAWK",
      "tool_id": "nfcore_gawk",
      "type": "tool",
      "annotation": "Extract mean depth from samtools depth output",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "4": {
      "id": 4,
      "input_connections": {
        "input_bam": {
          "id": 0,
          "output_name": "output"
        },
        "reference_fasta": {
          "id": 1,
          "output_name": "output"
        },
        "mean_depth": {
          "id": 3,
          "output_name": "output"
        }
      },
      "name": "SAMTOOLS_VIEW",
