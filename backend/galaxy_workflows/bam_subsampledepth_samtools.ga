      "tool_version": "0.0.5",
      "type": "tool",
      "annotation": "Downsample BAM file based on computed subsample fraction (target_depth / mean_depth)",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "5": {
      "annotation": "Output subsampled BAM file with index",
