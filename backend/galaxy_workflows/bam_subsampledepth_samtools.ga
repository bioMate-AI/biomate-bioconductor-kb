{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "BAM_SUBSAMPLEDEPTH_SAMTOOLS",
  "annotation": "Converted from nf-core subworkflow: Subsample BAM files based on depth using samtools",
  "steps": {
    "0": {
      "annotation": "Input BAM files with index and target depth",
      "id": 0,
      "input_connections": {},
      "inputs": [
