      "name": "Input BAM/BAI/Depth",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input reference FASTA file",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "fasta",
          "description": "Reference FASTA file"
        }
      ],
      "name": "Input FASTA",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "id": 2,
      "input_connections": {
        "input_bam": {
          "id": 0,
          "output_name": "output"
        }
      },
