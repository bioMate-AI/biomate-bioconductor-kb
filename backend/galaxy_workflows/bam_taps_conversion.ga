{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "BAM_TAPS_CONVERSION",
  "annotation": "TAPS methylation conversion subworkflow - Uses Rastair to assess C->T conversion as a readout for methylation in a genome-wide basis",
