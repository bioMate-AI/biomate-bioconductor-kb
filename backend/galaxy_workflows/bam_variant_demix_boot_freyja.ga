      "input_connections": {},
      "inputs": [
        {
          "name": "val_db_name"
        }
      ],
      "name": "Input parameter: Database name",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 730
      }
    },
    "7": {
      "annotation": "Freyja: Variants - Call variants from BAM file",
      "id": 7,
      "input_connections": {
        "bam": {
          "id": 0,
          "output_name": "output"
        },
