{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "BAM_VARIANT_DEMIX_BOOT_FREYJA",
  "annotation": "Converted from nf-core subworkflow: BAM_VARIANT_DEMIX_BOOT_FREYJA. Performs variant calling, database update (conditional), demixing, and optional bootstrapping for SARS-CoV-2 lineage abundance estimation using Freyja.",
  "steps": {
    "0": {
      "annotation": "Input BAM files with metadata",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_bam"
        }
      ],
      "name": "Input dataset: BAM files",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input reference FASTA sequence",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_fasta"
        }
      ],
      "name": "Input dataset: Reference FASTA",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Input barcodes file (optional)",
      "id": 2,
      "input_connections": {},
