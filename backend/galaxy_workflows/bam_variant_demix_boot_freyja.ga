        }
      ],
      "name": "Input parameter: Skip boot",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "Number of bootstrap repeats",
      "id": 5,
      "input_connections": {},
      "inputs": [
        {
          "name": "val_repeats"
        }
      ],
      "name": "Input parameter: Repeats",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 610
