{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "DIFFERENTIAL_FUNCTIONAL_ENRICHMENT",
  "annotation": "This workflow performs differential functional enrichment analysis using multiple methods: gprofiler2 for gene ontology enrichment, GSEA for gene set enrichment analysis, DECOUPLER for pathway activity inference, and GREA for proportionality-based enrichment. Input data is routed to appropriate methods based on the specified method parameter.",
  "steps": {
    "0": {
      "annotation": "Input data for functional analysis containing input file, genesets, background, and method specification",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_input"
        }
      ],
      "name": "Input: ch_input",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Contrast information for differential analysis",
      "id": 1,
      "input_connections": {},
      "inputs": [
