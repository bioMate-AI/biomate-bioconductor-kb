      }
    },
    "11": {
      "annotation": "FCS-GX contamination report output",
      "id": 11,
      "input_connections": {
        "input": {
          "id": 5,
          "output_name": "fcsgx_report"
        }
      },
      "name": "Output: FCS-GX Report",
      "type": "data_output",
      "position": {
        "left": 890,
        "top": 610
      }
    },
    "12": {
