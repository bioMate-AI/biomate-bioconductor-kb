{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "FASTA_CLEAN_FCS",
  "annotation": "Converted from nf-core subworkflow FASTA_CLEAN_FCS. Performs FASTA cleaning using FCS adaptor trimming followed by FCS-GX contamination screening.",
  "steps": {
    "0": {
      "annotation": "Input FASTA sequences with metadata",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_fasta",
          "description": "FASTA file with metadata containing taxid"
        }
      ],
      "name": "Input FASTA",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input FCS database for contamination screening",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "database",
          "description": "FCS-GX database"
        }
      ],
      "name": "Input Database",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Input ramdisk path for FCS-GX processing",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "ramdisk_path",
          "description": "Path to ramdisk for temporary storage"
        }
      ],
      "name": "Input Ramdisk Path",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "FCS Adaptor: Trim adapter sequences from FASTA input",
      "id": 3,
      "input_connections": {
        "fasta": {
          "id": 0,
          "output_name": "output"
        }
      },
      "name": "FCS_FCSADAPTOR",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/nf-core/fcs/fcsadaptor/main",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "4": {
      "annotation": "Join original FASTA with cleaned assembly output. Uses cleaned assembly if available, otherwise uses original input.",
      "id": 4,
      "input_connections": {
        "original_fasta": {
          "id": 0,
          "output_name": "output"
        },
        "cleaned_assembly": {
          "id": 3,
          "output_name": "cleaned_assembly"
        }
      },
      "name": "Join FASTA with Cleaned Assembly",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/galaxy-iuc/join/join1",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "5": {
      "annotation": "FCS-GX: Screen cleaned assembly for contamination using FCS-GX database",
      "id": 5,
      "input_connections": {
        "fasta": {
          "id": 4,
          "output_name": "output"
        },
        "database": {
          "id": 1,
          "output_name": "output"
        },
        "ramdisk_path": {
          "id": 2,
          "output_name": "output"
        }
      },
      "name": "FCSGX_RUNGX",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/nf-core/fcsgx/rungx/main",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "6": {
      "annotation": "FCS Adaptor cleaned assembly output",
      "id": 6,
      "input_connections": {
        "input": {
          "id": 4,
          "output_name": "output"
        }
      },
      "name": "Output: FCS Adaptor Cleaned Assembly",
      "type": "data_output",
      "position": {
        "left": 890,
        "top": 10
      }
    },
    "7": {
      "annotation": "FCS Adaptor report output",
      "id": 7,
      "input_connections": {
