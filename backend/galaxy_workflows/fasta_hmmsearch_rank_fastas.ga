{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "FASTA_HMMSEARCH_RANK_FASTAS",
  "annotation": "Converted from nf-core subworkflow: HMMSEARCH on FASTA sequences, rank results, and extract top-ranked sequences",
  "steps": {
    "0": {
      "annotation": "Input HMM profiles channel",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_hmms",
          "description": "HMM profile files with metadata"
        }
      ],
      "name": "Input HMM Profiles",
