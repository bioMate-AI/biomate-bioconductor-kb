{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "FASTA_INDEX_BISMARK_BWAMETH",
  "annotation": "Converted from nf-core subworkflow for FASTA indexing and preparation for Bismark or BWA-meth alignment",
  "steps": {
    "0": {
      "annotation": "Input FASTA file (may be gzipped)",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "fasta"
        }
      ],
      "name": "Input FASTA",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input FASTA index (optional)",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "fasta_index"
        }
      ],
      "name": "Input FASTA Index",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Input Bismark index (optional, gzipped or uncompressed)",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "bismark_index"
        }
      ],
      "name": "Input Bismark Index",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Input BWA-meth index (optional, gzipped or uncompressed)",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "bwameth_index"
        }
      ],
      "name": "Input BWA-meth Index",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Aligner selection: bismark, bismark_hisat, or bwameth",
      "id": 4,
      "input_connections": {},
      "inputs": [
        {
          "name": "aligner",
          "description": "Aligner type"
        }
      ],
      "name": "Input Aligner",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "Whether to run picard collecthsmetrics",
      "id": 5,
      "input_connections": {},
      "inputs": [
        {
          "name": "collecthsmetrics",
          "description": "Boolean flag"
        }
      ],
      "name": "Input CollectHSMetrics Flag",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 610
      }
    },
    "6": {
      "annotation": "Generate mem2 index for BWA-meth if no index provided",
      "id": 6,
      "input_connections": {},
      "inputs": [
        {
          "name": "use_mem2",
          "description": "Boolean flag"
        }
      ],
      "name": "Input Use Mem2 Flag",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 730
      }
    },
    "7": {
      "annotation": "Decompress FASTA if gzipped",
      "id": 7,
      "input_connections": {
        "infile": {
          "id": 0,
          "output_name": "output"
        }
      },
      "name": "gunzip",
      "tool_id": "nfcore_gunzip",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "8": {
      "annotation": "Generate Bismark genome index from FASTA (if no index provided and aligner is bismark)",
      "id": 8,
      "input_connections": {
        "fasta": {
          "id": 7,
          "output_name": "outfile"
        }
      },
      "name": "Bismark Genome Preparation",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/jobucher/bismark2bedgraph/Repository_Actions_Bismark_to_BedGraph",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "9": {
      "annotation": "Extract Bismark index if provided as tar/tar.gz archive",
      "id": 9,
      "input_connections": {
        "infile": {
          "id": 2,
          "output_name": "output"
        }
      },
      "name": "untar Bismark Index",
      "tool_id": "nfcore_untar",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 130
      }
    },
    "10": {
      "annotation": "Generate BWA-meth index from FASTA (if no index provided and aligner is bwameth)",
      "id": 10,
      "input_connections": {
        "fasta": {
          "id": 7,
          "output_name": "outfile"
        },
        "use_mem2": {
          "id": 6,
          "output_name": "output"
        }
      },
      "name": "BWA-meth Index",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/bwameth/Repository_Actions_bwameth",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 250
      }
    },
    "11": {
      "annotation": "Extract BWA-meth index if provided as tar/tar.gz archive",
      "id": 11,
      "input_connections": {
        "infile": {
          "id": 3,
          "output_name": "output"
        }
      },
      "name": "untar BWA-meth Index",
      "tool_id": "nfcore_untar",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 370
      }
    },
    "12": {
      "annotation": "Generate FASTA index with samtools faidx (if needed for bwameth or collecthsmetrics and no index provided)",
      "id": 12,
      "input_connections": {
        "fasta": {
          "id": 7,
          "output_name": "outfile"
        }
      },
      "name": "Samtools FAI Index",
