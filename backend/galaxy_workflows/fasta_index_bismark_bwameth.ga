      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "13": {
      "annotation": "Output decompressed FASTA",
      "id": 13,
      "input_connections": {
        "input": {
          "id": 7,
          "output_name": "outfile"
        }
      },
      "name": "Output FASTA",
      "type": "data_output",
      "position": {
        "left": 890,
        "top": 10
      }
    },
    "14": {
      "annotation": "Output FASTA index (from samtools faidx or input)",
      "id": 14,
      "input_connections": {
        "input": {
