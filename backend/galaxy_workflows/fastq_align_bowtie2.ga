{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "FASTQ_ALIGN_BOWTIE2",
  "annotation": "Converted from nf-core subworkflow: Alignment with Bowtie2 followed by BAM sorting, indexing and statistics",
  "steps": {
    "0": {
      "annotation": "Input FASTQ reads",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_reads"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_collection_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input Bowtie2 index",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_index"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Input reference FASTA",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_fasta"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Save unaligned reads parameter",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "save_unaligned"
        }
      ],
      "name": "Input parameter",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Sort BAM parameter",
      "id": 4,
      "input_connections": {},
      "inputs": [
        {
          "name": "sort_bam"
        }
      ],
      "name": "Input parameter",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "id": 5,
      "input_connections": {
        "reads": {
          "id": 0,
          "output_name": "output"
        },
        "index": {
          "id": 1,
          "output_name": "output"
        },
        "fasta": {
          "id": 2,
          "output_name": "output"
        },
        "save_unaligned": {
          "id": 3,
          "output_name": "output"
        },
        "sort_bam": {
          "id": 4,
          "output_name": "output"
        }
      },
      "name": "Bowtie2",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/devteam/bowtie2/Repository_Actions_Bowtie2",
      "tool_version": "2.5.4+galaxy0",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 130
      },
      "annotation": "Map reads with Bowtie2"
    },
    "6": {
      "id": 6,
      "input_connections": {
        "bam": {
          "id": 5,
          "output_name": "bam"
        },
        "fasta": {
          "id": 2,
          "output_name": "output"
        }
      },
      "name": "BAM coverage statistics",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/coverage_stats/Repository_Actions_BAM_coverage_statistics",
      "tool_version": "0.1.0",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 130
      },
      "annotation": "Sort, index BAM file and run samtools stats, flagstat and idxstats"
    }
  },
  "outputs": {
    "bam_orig": {
      "id": 5,
      "output_name": "bam",
      "annotation": "Original BAM from Bowtie2 alignment"
    },
    "log_out": {
      "id": 5,
      "output_name": "log",
      "annotation": "Bowtie2 alignment log"
    },
    "fastq": {
      "id": 5,
      "output_name": "fastq",
      "annotation": "Unaligned FASTQ reads (if save_unaligned enabled)"
    },
    "bam": {
      "id": 6,
      "output_name": "bam",
      "annotation": "Sorted and indexed BAM file"
    },
    "bai": {
      "id": 6,
      "output_name": "bai",
      "annotation": "BAM index file"
    },
    "csi": {
      "id": 6,
      "output_name": "csi",
      "annotation": "CSI index file"
    },
    "stats": {
      "id": 6,
      "output_name": "stats",
      "annotation": "Samtools stats output"
    },
    "flagstat": {
      "id": 6,
      "output_name": "flagstat",
      "annotation": "Samtools flagstat output"
    },
    "idxstats": {
      "id": 6,
      "output_name": "idxstats",
      "annotation": "Samtools idxstats output"
    }
  }
}