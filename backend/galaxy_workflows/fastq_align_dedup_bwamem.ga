{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "FASTQ_ALIGN_DEDUP_BWAMEM",
  "annotation": "Workflow structure: FASTQ_ALIGN_BWA (always runs) -> conditional deduplication branch (PICARD_ADDORREPLACEREADGROUPS -> PICARD_MARKDUPLICATES -> SAMTOOLS_INDEX) if skip_deduplication=false -> collect outputs. Outputs: BAM, BAI, flagstat, stats, idxstats, picard_metrics (if dedup), versions.",
  "steps": {
    "0": {
      "annotation": "Input FASTQ reads",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_reads"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input reference FASTA",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_fasta"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Input FASTA index",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_fasta_index"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Input BWA-MEM index",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_bwamem_index"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Skip deduplication flag",
      "id": 4,
      "input_connections": {},
      "inputs": [
        {
          "name": "skip_deduplication"
        }
      ],
      "name": "Input parameter",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "Use GPU flag",
      "id": 5,
      "input_connections": {},
      "inputs": [
        {
          "name": "use_gpu"
        }
      ],
      "name": "Input parameter",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 610
      }
    },
    "6": {
      "id": 6,
      "input_connections": {
        "reads": {
          "id": 0,
          "output_name": "output"
        },
        "bwamem_index": {
          "id": 3,
          "output_name": "output"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "FASTQ_ALIGN_BWA",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/lijing/bubio/Repository_Actions_interleave_fastqs",
      "type": "tool",
      "annotation": "Align FASTQ reads with BWA-MEM, sort BAM output",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "7": {
      "id": 7,
      "input_connections": {
        "bam": {
          "id": 6,
          "output_name": "bam"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        },
        "fasta_index": {
          "id": 2,
          "output_name": "output"
        }
      },
      "name": "PICARD_ADDORREPLACEREADGROUPS",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/avowinkel/picard/Repository_Actions_BedToIntervalList",
      "type": "tool",
      "annotation": "Add or replace read group information (conditional: only if skip_deduplication is false)",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "8": {
      "id": 8,
      "input_connections": {
        "bam": {
          "id": 7,
          "output_name": "bam"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        },
        "fasta_index": {
          "id": 2,
          "output_name": "output"
        }
      },
      "name": "PICARD_MARKDUPLICATES",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/avowinkel/picard/Repository_Actions_BedToIntervalList",
      "type": "tool",
      "annotation": "Mark and remove duplicate reads (conditional: only if skip_deduplication is false)",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "9": {
      "id": 9,
      "input_connections": {
        "bam": {
          "id": 8,
          "output_name": "bam"
        }
      },
      "name": "SAMTOOLS_INDEX",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/samtools_depad/Repository_Actions_Depad_SAM/BAM_file",
      "type": "tool",
      "annotation": "Index deduplicated BAM file (conditional: only if skip_deduplication is false)",
      "position": {
        "left": 890,
        "top": 10
      }
    },
    "10": {
      "id": 10,
      "input_connections": {
        "picard_metrics": {
          "id": 8,
          "output_name": "metrics"
        },
        "flagstat": {
          "id": 6,
          "output_name": "flagstat"
        },
        "stats": {
          "id": 6,
          "output_name": "stats"
        },
        "idxstats": {
          "id": 6,
          "output_name": "idxstats"
        }
      },
      "name": "Collect MultiQC inputs",
      "type": "data_collection_input",
      "annotation": "Aggregate all QC metrics for MultiQC",
      "position": {
        "left": 1110,
        "top": 10
      }
    }
  }
}