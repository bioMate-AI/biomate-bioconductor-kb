{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "FASTQ_ALIGN_DNA",
  "annotation": "Align fastq files to a reference genome using selectable aligner (bowtie2, bwamem, bwamem2, dragmap, snap, or strobealign). Converted from nf-core subworkflow.",
  "steps": {
    "0": {
      "annotation": "Input fastq reads",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_reads"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Aligner index files",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_aligner_index"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Reference fasta file",
      "id": 2,
      "input_connections": {},
