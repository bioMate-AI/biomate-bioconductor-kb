      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "Bowtie2 alignment - alternative path when aligner == 'bowtie2'",
      "id": 5,
      "input_connections": {
        "reads": {
          "id": 0,
          "output_name": "output"
        },
        "index": {
          "id": 1,
          "output_name": "output"
        },
        "fasta": {
          "id": 2,
          "output_name": "output"
        },
        "sort": {
          "id": 4,
          "output_name": "output"
        }
      },
      "name": "Bowtie2",
