      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Combine reads and index channels with metadata preparation. Creates key_read_ref combining read and index IDs, and preserves id_index for reference tracking",
