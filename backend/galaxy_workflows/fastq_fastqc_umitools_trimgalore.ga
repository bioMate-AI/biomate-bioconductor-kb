{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "FASTQ_FASTQC_UMITOOLS_TRIMGALORE",
  "annotation": "This workflow performs quality control, UMI extraction, and adapter trimming on FASTQ reads. It includes conditional steps for FastQC analysis, UMI processing, and TrimGalore trimming based on input parameters. The workflow filters final reads based on minimum read count thresholds.",
  "steps": {
    "0": {
      "annotation": "Input FASTQ reads",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "reads",
          "description": "Input FASTQ reads"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Skip FastQC parameter",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "skip_fastqc",
          "description": "Skip FastQC analysis"
        }
      ],
      "name": "Input parameter",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "With UMI parameter",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "with_umi",
          "description": "Enable UMI processing"
        }
      ],
      "name": "Input parameter",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Skip UMI extraction parameter",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "skip_umi_extract",
          "description": "Skip UMI extraction"
        }
      ],
      "name": "Input parameter",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Skip trimming parameter",
      "id": 4,
      "input_connections": {},
      "inputs": [
        {
          "name": "skip_trimming",
          "description": "Skip adapter trimming"
        }
      ],
      "name": "Input parameter",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "UMI discard read parameter",
      "id": 5,
      "input_connections": {},
      "inputs": [
        {
          "name": "umi_discard_read",
          "description": "Discard R1/R2 after UMI extraction (0, 1, or 2)"
        }
      ],
      "name": "Input parameter",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 610
      }
    },
    "6": {
      "annotation": "Minimum trimmed reads parameter",
      "id": 6,
      "input_connections": {},
      "inputs": [
        {
          "name": "min_trimmed_reads",
          "description": "Minimum number of reads after trimming"
        }
      ],
      "name": "Input parameter",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 730
      }
    },
    "7": {
      "annotation": "FastQC quality control - conditional on skip_fastqc parameter",
      "id": 7,
      "input_connections": {
        "input_file": {
          "id": 0,
          "output_name": "output"
        }
      },
      "name": "FastQC",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/devteam/fastqc/Repository_Actions_FastQC",
      "tool_version": "0.74+galaxy1",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "8": {
      "annotation": "UMI extraction - conditional on with_umi and skip_umi_extract parameters",
      "id": 8,
      "input_connections": {
        "reads": {
          "id": 0,
          "output_name": "output"
        }
      },
      "name": "UMI-tools extract",
      "tool_id": "umitools_extract",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 130
      }
    },
    "9": {
      "annotation": "Trim Galore adapter trimming - conditional on skip_trimming parameter",
      "id": 9,
      "input_connections": {
        "reads": {
          "id": 8,
          "output_name": "reads"
        }
      },
      "name": "Trim Galore!",
      "tool_id": "nfcore_trimgalore",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 130
      }
    },
    "10": {
      "annotation": "Filter reads by minimum count threshold",
      "id": 10,
      "input_connections": {
        "input": {
          "id": 9,
          "output_name": "reads"
        }
      },
      "name": "Filter by read count",
      "tool_id": "Filter1",
      "type": "tool",
      "position": {
        "left": 890,
        "top": 130
      }
    }
  }
}