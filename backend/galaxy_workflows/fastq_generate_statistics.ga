      "position": {
        "left": 670,
        "top": 10
      }
    },
    "4": {
      "annotation": "SEQKIT_STATS - Sequence statistics using seqkit (conditional: skip_seqkit_stats)",
      "id": 4,
      "input_connections": {
        "input_file": {
          "id": 0,
          "output_name": "output"
        }
      },
