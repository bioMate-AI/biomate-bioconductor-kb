        {
          "name": "skip_seqkit_replace",
          "description": "Skip seqkit replace step"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Input: skip_seqkit_rmdup boolean flag",
      "id": 4,
      "input_connections": {},
      "inputs": [
        {
          "name": "skip_seqkit_rmdup",
          "description": "Skip seqkit rmdup step"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "Conditional: FASTQ_SANITISE_SEQKIT - Sanitize paired-end FASTQ files (executed if skip_seqkit_sana_pair is false)",
      "id": 5,
      "input_connections": {
        "fastq_input": {
          "id": 0,
          "output_name": "output"
        }
      },
      "name": "interleave fastqs",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/lijing/bubio/Repository_Actions_interleave_fastqs",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "6": {
      "annotation": "Conditional: SEQKIT_SEQ - Convert sequence format (executed if skip_seqkit_seq is false). Input comes from FASTQ_SANITISE_SEQKIT output or original reads",
      "id": 6,
      "input_connections": {
        "fastq_input": {
          "id": 5,
          "output_name": "output"
        }
      },
      "name": "Qcat",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/alyssa/seqkit_seq/Repository_Actions_Qcat",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "7": {
      "annotation": "Conditional: SEQKIT_REPLACE - Replace sequence identifiers (executed if skip_seqkit_replace is false). Input comes from SEQKIT_SEQ output",
      "id": 7,
      "input_connections": {
        "fastq_input": {
          "id": 6,
          "output_name": "output"
        }
      },
      "name": "Qcat",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/alyssa/seqkit_seq/Repository_Actions_Qcat",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "8": {
      "annotation": "Conditional: SEQKIT_RMDUP - Remove duplicate sequences (executed if skip_seqkit_rmdup is false). Input comes from SEQKIT_REPLACE output",
      "id": 8,
      "input_connections": {
        "fastq_input": {
          "id": 7,
          "output_name": "output"
        }
      },
      "name": "Qcat",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/alyssa/seqkit_seq/Repository_Actions_Qcat",
      "type": "tool",
      "position": {
        "left": 890,
        "top": 10
      }
    },
