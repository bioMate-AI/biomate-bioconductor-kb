{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "FASTQ_SANITISE_SEQKIT",
  "annotation": "Converted from nf-core subworkflow: Sanitizes FASTQ files using seqkit sana and pair tools. Handles both single-end and paired-end reads with proper metadata management.",
  "steps": {
    "0": {
      "annotation": "Input FASTQ reads with metadata",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_reads",
          "description": "Channel containing metadata and FASTQ files"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Sanitize FASTQ sequences using seqkit sana. Processes single-end reads as-is and splits paired-end reads into separate R1/R2 streams with strandness metadata.",
      "id": 1,
      "input_connections": {
        "reads": {
          "id": 0,
          "output_name": "output"
        }
      },
      "name": "SEQKIT_SANA",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/alyssa/seqkit_seq/Repository_Actions_Qcat",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "2": {
      "annotation": "Branch sanitized reads: single-end reads bypass pairing, paired-end reads proceed to SEQKIT_PAIR for validation and pairing.",
      "id": 2,
      "input_connections": {
        "reads": {
          "id": 1,
          "output_name": "reads"
        }
      },
      "name": "Branch single/paired",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "3": {
      "annotation": "Validate and repair paired-end reads using seqkit pair. Ensures R1 and R2 files are properly paired and outputs unpaired reads separately.",
      "id": 3,
      "input_connections": {
        "reads": {
          "id": 2,
          "output_name": "paired_end"
        }
      },
      "name": "SEQKIT_PAIR",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/alyssa/seqkit_seq/Repository_Actions_Qcat",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "4": {
      "annotation": "Merge outputs: single-end reads from branch, paired-end reads from SEQKIT_PAIR, and unpaired reads from SEQKIT_PAIR.",
      "id": 4,
      "input_connections": {
        "single_end": {
          "id": 2,
          "output_name": "single_end"
        },
        "paired_end": {
          "id": 3,
          "output_name": "reads"
        },
        "unpaired": {
          "id": 3,
          "output_name": "unpaired_reads"
        }
      },
      "name": "Merge sanitized reads",
      "type": "tool",
      "position": {
        "left": 890,
        "top": 10
      }
    },
    "5": {
      "annotation": "Collect version information from SEQKIT_SANA and SEQKIT_PAIR tools.",
      "id": 5,
      "input_connections": {
        "versions_sana": {
          "id": 1,
          "output_name": "versions"
        },
        "versions_pair": {
          "id": 3,
          "output_name": "versions"
        }
      },
      "name": "Collect versions",
      "type": "tool",
      "position": {
        "left": 1110,
        "top": 10
      }
    }
  },
  "outputs": {
    "reads": {
      "id": 4,
      "output_name": "output",
      "description": "Sanitized FASTQ reads (single-end, paired-end, and unpaired)"
    },
    "versions": {
      "id": 5,
      "output_name": "versions",
      "description": "Version information from seqkit tools"
    }
  }
}