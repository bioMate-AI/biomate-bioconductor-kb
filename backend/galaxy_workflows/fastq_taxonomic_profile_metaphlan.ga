{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "FASTQ_TAXONOMIC_PROFILE_METAPHLAN",
  "annotation": "This workflow performs taxonomic profiling of metagenomic FASTQ data using MetaPhlAn. It: (1) builds the MetaPhlAn database, (2) profiles each FASTQ sample against the database, and (3) merges individual profiles into a single taxonomic abundance table.",
  "steps": {
    "0": {
      "annotation": "Input FASTQ files for taxonomic profiling",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_fastq",
          "description": "Input FASTQ files"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Build MetaPhlAn database for taxonomic profiling",
      "id": 1,
      "input_connections": {},
      "inputs": [],
      "name": "MetaPhlAn makedb",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/metaphlan/Repository_Actions_MetaPhlAn",
      "tool_version": "4.1.1+galaxy4",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "2": {
      "annotation": "Profile metagenomic composition using MetaPhlAn with FASTQ input and database",
      "id": 2,
      "input_connections": {
        "input_file": {
          "id": 0,
          "output_name": "output"
        },
        "metaphlan_db": {
          "id": 1,
          "output_name": "db"
        }
      },
      "inputs": [],
      "name": "MetaPhlAn metaphlan",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/metaphlan/Repository_Actions_MetaPhlAn",
      "tool_version": "4.1.1+galaxy4",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "3": {
      "annotation": "Merge individual MetaPhlAn taxonomic profiles into a single table",
      "id": 3,
      "input_connections": {
        "profile_files": {
          "id": 2,
          "output_name": "profile"
        }
      },
      "inputs": [],
      "name": "MetaPhlAn merge tables",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/metaphlan/Repository_Actions_MetaPhlAn",
      "tool_version": "4.1.1+galaxy4",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "4": {
      "annotation": "Output: Merged taxonomic profiles",
      "id": 4,
      "input_connections": {
        "input": {
          "id": 3,
          "output_name": "txt"
        }
      },
      "inputs": [],
      "name": "Output merged taxa",
      "type": "data_output",
      "position": {
        "left": 890,
        "top": 10
      }
    }
  },
  "steps_version": 1
}