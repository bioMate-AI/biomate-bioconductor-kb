{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "PIPELINE_INITIALISATION",
  "annotation": "Pipeline initialization workflow that: 1) Prints version info and dumps parameters to JSON, 2) Validates parameters against schema and displays help text with nf-core branding, 3) Checks pipeline configuration and CLI arguments, 4) Performs custom validation on genome, FASTA, GTF/GFF, and MACS3 parameters",
  "steps": {
    "0": {
      "annotation": "Pipeline version flag",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "version"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Display help text flag",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "help"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Validate parameters against schema",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "validate_params"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Disable colored log output",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "monochrome_logs"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Nextflow CLI arguments",
      "id": 4,
      "input_connections": {},
      "inputs": [
        {
          "name": "nextflow_cli_args"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "Output directory path",
      "id": 5,
      "input_connections": {},
      "inputs": [
        {
          "name": "outdir"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 610
      }
    },
    "6": {
      "annotation": "UTILS_NEXTFLOW_PIPELINE: Print version and dump pipeline parameters to JSON file",
      "id": 6,
      "input_connections": {
        "version": {
          "id": 0,
          "output_name": "output"
        },
        "outdir": {
          "id": 5,
          "output_name": "output"
        }
      },
      "name": "UTILS_NEXTFLOW_PIPELINE",
      "tool_id": "utils_nextflow_pipeline",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "7": {
      "annotation": "UTILS_NFVALIDATION_PLUGIN: Validate parameters and generate parameter summary. Displays help text with nf-core logo and workflow citation",
      "id": 7,
      "input_connections": {
        "help": {
          "id": 1,
          "output_name": "output"
        },
        "validate_params": {
          "id": 2,
          "output_name": "output"
        },
        "monochrome_logs": {
          "id": 3,
          "output_name": "output"
        }
      },
      "name": "UTILS_NFVALIDATION_PLUGIN",
      "tool_id": "utils_nfvalidation_plugin",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 130
      }
    },
    "8": {
      "annotation": "UTILS_NFCORE_PIPELINE: Check config provided to the pipeline and validate nextflow CLI arguments",
      "id": 8,
      "input_connections": {
        "nextflow_cli_args": {
          "id": 4,
          "output_name": "output"
        }
      },
      "name": "UTILS_NFCORE_PIPELINE",
      "tool_id": "utils_nfcore_pipeline",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 490
      }
    },
    "9": {
      "annotation": "Custom validation for pipeline parameters: Validates genome existence, checks for required FASTA file, validates GTF/GFF annotation files, and verifies MACS3 genome size parameters",
      "id": 9,
      "input_connections": {
        "validation_output": {
          "id": 8,
          "output_name": "output"
        }
      },
      "name": "validateInputParameters",
      "tool_id": "validate_input_parameters",
      "type": "tool",
      "position": {
        "left": 890,
        "top": 490
      }
    }
  }
}