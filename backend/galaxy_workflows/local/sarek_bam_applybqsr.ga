      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Input intervals for scatter-gather strategy",
      "id": 4,
      "input_connections": {},
      "inputs": [
        {
          "name": "intervals"
        }
      ],
      "name": "Input Intervals",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "Apply BQSR recalibration to CRAM files using GATK4",
      "id": 5,
      "input_connections": {
        "cram": {
          "id": 0,
          "output_name": "output"
        },
        "dict": {
          "id": 1,
          "output_name": "output"
        },
        "fasta": {
          "id": 2,
          "output_name": "output"
        },
        "fasta_fai": {
          "id": 3,
          "output_name": "output"
        },
        "intervals": {
          "id": 4,
          "output_name": "output"
        }
      },
      "name": "GATK4 ApplyBQSR",
      "tool_id": "artbio_gatk4_gatk4_MergeMutectStats_4.1.7.0+galaxy3",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 250
      }
    },
    "6": {
      "annotation": "Merge and index BAM files from multiple intervals (conditional - only if save_output_as_bam is true)",
      "id": 6,
      "input_connections": {
        "bam": {
          "id": 5,
          "output_name": "bam"
        }
      },
      "name": "BAM Merge Index Samtools",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/coverage_stats/Repository_Actions_BAM_coverage_statistics",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 130
      }
    },
    "7": {
      "annotation": "Merge and index CRAM files from multiple intervals",
      "id": 7,
      "input_connections": {
        "cram": {
          "id": 5,
          "output_name": "cram"
        },
        "fasta": {
          "id": 2,
          "output_name": "output"
        },
        "fasta_fai": {
          "id": 3,
          "output_name": "output"
        }
      },
      "name": "CRAM Merge Index Samtools",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/cramino/Repository_Actions_Cramino",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 370
      }
    },
    "8": {
      "annotation": "Output recalibrated BAM files with indices",
      "id": 8,
      "input_connections": {
