{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "BAM_APPLYBQSR",
  "annotation": "Converted from nf-core subworkflow - Apply BQSR recalibration to BAM/CRAM files with optional merging for scattered intervals",
  "steps": {
    "0": {
      "annotation": "Input CRAM file with index and recalibration table",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "cram"
        }
      ],
      "name": "Input CRAM",
      "type": "data_input",
