        "top": 10
      }
    },
    "1": {
      "annotation": "Input reference dictionary",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "dict"
        }
      ],
      "name": "Input Dictionary",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Input reference FASTA",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "fasta"
        }
      ],
      "name": "Input FASTA",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
