{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "BAM_CONVERT_SAMTOOLS",
  "annotation": "Workflow for converting BAM/CRAM files to FASTQ format. Separates reads into mapped and unmapped categories, merges unmapped reads, converts both to FASTQ, and concatenates the results.",
  "steps": {
    "0": {
      "annotation": "Input BAM/CRAM alignment file with metadata",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "input"
        }
      ],
      "name": "Input alignment",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Reference FASTA file (optional, required for CRAM format)",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "fasta"
        }
      ],
      "name": "Input reference FASTA",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Reference FASTA index file",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "fasta_fai"
        }
      ],
      "name": "Input FASTA index",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Boolean flag for interleaved FASTQ output",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "interleaved"
        }
      ],
      "name": "Interleaved parameter",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Extract mapped reads where both pairs are mapped",
      "id": 4,
      "input_connections": {
        "input": {
          "id": 0,
          "output_name": "output"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "SAMTOOLS_VIEW_MAP_MAP",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/samtools_depad/Repository_Actions_Depad_SAM/BAM_file",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "5": {
      "annotation": "Extract unmapped reads where both pairs are unmapped",
      "id": 5,
      "input_connections": {
        "input": {
          "id": 0,
          "output_name": "output"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "SAMTOOLS_VIEW_UNMAP_UNMAP",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/samtools_depad/Repository_Actions_Depad_SAM/BAM_file",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 130
      }
    },
    "6": {
      "annotation": "Extract reads where first pair is unmapped, second is mapped",
      "id": 6,
      "input_connections": {
        "input": {
          "id": 0,
          "output_name": "output"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "SAMTOOLS_VIEW_UNMAP_MAP",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/samtools_depad/Repository_Actions_Depad_SAM/BAM_file",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 250
      }
    },
    "7": {
      "annotation": "Extract reads where first pair is mapped, second is unmapped",
      "id": 7,
      "input_connections": {
        "input": {
          "id": 0,
          "output_name": "output"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "SAMTOOLS_VIEW_MAP_UNMAP",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/samtools_depad/Repository_Actions_Depad_SAM/BAM_file",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 370
      }
    },
    "8": {
      "annotation": "Merge all unmapped BAM files (both pairs unmapped, first unmapped, second unmapped)",
      "id": 8,
      "input_connections": {
        "bam_unmap_unmap": {
          "id": 5,
          "output_name": "output"
        },
        "bam_unmap_map": {
          "id": 6,
          "output_name": "output"
        },
        "bam_map_unmap": {
          "id": 7,
          "output_name": "output"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        },
        "fasta_fai": {
          "id": 2,
          "output_name": "output"
        }
      },
      "name": "SAMTOOLS_MERGE_UNMAP",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/samtools_depad/Repository_Actions_Depad_SAM/BAM_file",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 190
      }
    },
    "9": {
      "annotation": "Collate and convert merged unmapped BAM to FASTQ",
      "id": 9,
      "input_connections": {
        "bam": {
          "id": 8,
          "output_name": "output"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        },
        "interleaved": {
          "id": 3,
          "output_name": "output"
        }
      },
      "name": "COLLATE_FASTQ_UNMAP",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/jjohnson/qiime/Repository_Actions_collate_alpha",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 190
      }
    },
    "10": {
      "annotation": "Collate and convert mapped BAM to FASTQ",
      "id": 10,
      "input_connections": {
        "bam": {
          "id": 4,
          "output_name": "output"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        },
        "interleaved": {
          "id": 3,
          "output_name": "output"
        }
      },
      "name": "COLLATE_FASTQ_MAP",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/jjohnson/qiime/Repository_Actions_collate_alpha",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "11": {
      "annotation": "Concatenate mapped and unmapped FASTQ files (R1 and R2 pairs)",
      "id": 11,
      "input_connections": {
        "fastq_mapped_r1": {
          "id": 10,
          "output_name": "fastq_r1"
        },
        "fastq_mapped_r2": {
          "id": 10,
          "output_name": "fastq_r2"
        },
        "fastq_unmapped_r1": {
          "id": 9,
          "output_name": "fastq_r1"
        },
        "fastq_unmapped_r2": {
          "id": 9,
          "output_name": "fastq_r2"
        }
      },
      "name": "CAT_FASTQ",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/trinity_ctat/ctat_concatenate/Repository_Actions_ctat_concatenate",
      "type": "tool",
      "position": {
        "left": 890,
        "top": 100
      }
    },
    "12": {
      "annotation": "Output final concatenated FASTQ reads",
      "id": 12,
      "input_connections": {
        "reads": {
          "id": 11,
          "output_name": "reads"
        }
      },
      "name": "Output reads",
      "type": "data_output",
      "position": {
        "left": 1110,
        "top": 100
      }
    }
  },
  "tags": [
    "BAM",
    "CRAM",
    "FASTQ",
    "conversion",
    "samtools"
  ]
}