          "output_name": "output"
        },
        "resource_tbi": {
          "id": 9,
          "output_name": "output"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        },
        "fai": {
          "id": 2,
          "output_name": "output"
        }
      },
      "name": "SENTIEON_VARCAL_SNP",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/nf-core/sentieon_varcal/sentieon_varcal",
      "type": "tool",
      "position": {
        "left": 890,
        "top": 250
      }
    },
    "16": {
      "annotation": "Conditional: Only run if variant_caller != sentieon_dnascope",
      "id": 16,
      "input_connections": {
        "vcf_input": {
          "id": 13,
          "output_name": "vcf"
        },
        "recal": {
          "id": 15,
          "output_name": "recal"
        },
        "idx": {
          "id": 15,
          "output_name": "idx"
        },
