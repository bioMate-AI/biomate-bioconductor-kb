      "name": "SENTIEON_APPLYVARCAL_SNP",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/nf-core/sentieon_applyvarcal/sentieon_applyvarcal",
      "type": "tool",
      "position": {
        "left": 1110,
        "top": 250
      }
    },
    "17": {
