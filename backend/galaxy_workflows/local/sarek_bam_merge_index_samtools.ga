{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "BAM_MERGE_INDEX_SAMTOOLS",
  "annotation": "Converted from nf-core subworkflow: Merge and index BAM files using samtools. Handles both single and multiple BAM files per sample.",
  "steps": {
    "0": {
      "annotation": "Input BAM files channel with metadata",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "bam",
          "description": "BAM files to merge and index"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Alternative path 1: Single BAM files bypass merge step",
      "id": 1,
      "input_connections": {
        "input": {
          "id": 0,
          "output_name": "output"
        }
      },
      "name": "Conditional branching",
      "type": "tool",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/devteam/merge/Repository_Actions_Merge",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "2": {
      "annotation": "Executed only when multiple BAM files exist for a sample",
      "id": 2,
      "input_connections": {
        "bam_input": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "SAMTOOLS_MERGE",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/devteam/merge/Repository_Actions_Merge",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "3": {
      "annotation": "Combine both single and merged BAM files for indexing",
      "id": 3,
      "input_connections": {
        "merged_bam": {
          "id": 2,
          "output_name": "output"
        },
        "single_bam": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "Merge channels",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "4": {
      "annotation": "Index BAM files using samtools index",
      "id": 4,
      "input_connections": {
        "bam_input": {
          "id": 3,
          "output_name": "output"
        }
      },
      "name": "SAMTOOLS_INDEX",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/metasbt_index/Repository_Actions_index",
      "type": "tool",
      "position": {
        "left": 890,
        "top": 10
      }
    },
    "5": {
      "annotation": "Final output: BAM files paired with their index files",
      "id": 5,
      "input_connections": {
        "bam": {
          "id": 3,
          "output_name": "output"
        },
        "bai": {
          "id": 4,
          "output_name": "output"
        }
      },
      "name": "Join BAM and BAI",
      "type": "tool",
      "position": {
        "left": 1110,
        "top": 10
      }
    }
  },
  "outputs": {
    "bam_bai": {
      "id": 5,
      "output_name": "output",
      "annotation": "Merged and indexed BAM files with corresponding BAI index files"
    }
  }
}