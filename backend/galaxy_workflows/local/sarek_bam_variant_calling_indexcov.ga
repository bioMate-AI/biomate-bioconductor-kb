{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "BAM_VARIANT_CALLING_INDEXCOV",
  "annotation": "Converted from nf-core subworkflow: BAM_VARIANT_CALLING_INDEXCOV. Performs indexcov calling on BAM/CRAM files with reindexing and goleft indexcov analysis.",
  "steps": {
    "0": {
      "annotation": "Input CRAM/BAM file with index",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "cram",
          "description": "CRAM or BAM file with index"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input reference FASTA file",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "fasta",
          "description": "Reference FASTA sequence"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Input FASTA index file",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "fasta_fai",
          "description": "FASTA index file"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Reindex BAM/CRAM file to generate cleaner index without duplicates or supplementary alignments",
      "id": 3,
      "input_connections": {
        "input_bam": {
          "id": 0,
          "output_name": "output"
        },
        "reference_fasta": {
          "id": 1,
          "output_name": "output"
        },
        "reference_fasta_index": {
          "id": 2,
          "output_name": "output"
        }
      },
      "name": "Samtools Reindex BAM",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/peterjc/samtools_depad/Repository_Actions_Depad_SAM/BAM_file",
      "tool_version": "0.0.5",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 130
      }
    },
    "4": {
      "annotation": "Run goleft indexcov to analyze coverage and identify potential copy number variations",
      "id": 4,
      "input_connections": {
        "bam_files": {
          "id": 3,
          "output_name": "output"
        },
        "fasta_index": {
          "id": 2,
          "output_name": "output"
