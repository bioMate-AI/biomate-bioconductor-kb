    },
    "10": {
      "id": 10,
      "input_connections": {
        "input_vcf": {
          "id": 8,
          "output_name": "output"
        }
      },
      "name": "Merge",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/devteam/merge/Repository_Actions_Merge",
      "tool_version": "1.0.0",
      "type": "tool",
      "annotation": "MERGE_STRELKA_GENOME: Merge multiple genome VCF files from interval-based parallelization",
      "position": {
        "left": 670,
        "top": 130
      }
    },
    "11": {
      "id": 11,
      "input_connections": {
        "merged_vcf": {
          "id": 9,
          "output_name": "output"
        },
        "no_interval_vcf": {
          "id": 7,
          "output_name": "output"
        }
      },
      "name": "Combine VCF Results",
      "tool_id": "cat1",
      "type": "tool",
      "annotation": "Mix merged VCF (from intervals) with no_intervals VCF branch. Add variantcaller='strelka' to metadata",
      "position": {
        "left": 890,
        "top": 70
      }
    }
  }
}