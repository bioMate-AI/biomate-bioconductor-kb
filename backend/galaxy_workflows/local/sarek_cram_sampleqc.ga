{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "CRAM_SAMPLEQC",
  "annotation": "Converted from nf-core subworkflow for CRAM sample quality control",
  "steps": {
    "0": {
      "annotation": "Input CRAM file with index",
