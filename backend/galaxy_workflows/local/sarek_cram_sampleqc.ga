        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input NGSCheckmate BED file",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "ngscheckmate_bed"
        }
      ],
      "name": "Input dataset - NGSCheckmate BED",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Input reference FASTA file",
      "id": 2,
      "input_connections": {},
