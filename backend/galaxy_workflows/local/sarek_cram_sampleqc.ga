      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Skip base recalibration flag (boolean)",
      "id": 4,
      "input_connections": {},
      "inputs": [
        {
          "name": "skip_baserecalibration"
        }
      ],
      "name": "Input parameter - Skip BaseRecalibration",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "Conditional: CRAM QC with Mosdepth and Samtools - only executed if skip_baserecalibration is false",
      "id": 5,
      "input_connections": {
        "cram": {
          "id": 0,
          "output_name": "output"
        },
        "fasta": {
          "id": 2,
          "output_name": "output"
        },
