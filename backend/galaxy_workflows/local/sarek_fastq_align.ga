{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "FASTQ_ALIGN",
  "annotation": "Converted from nf-core subworkflow - FASTQ alignment with multiple aligner options (BWA-MEM, BWA-MEM2, DRAGMAP, or Sentieon-BWAMEM)",
