      "tool_version": "1.3.0+galaxy1",
      "type": "tool",
      "annotation": "Group reads by UMI information to identify reads from same original molecule",
      "position": {
        "left": 1110,
        "top": 10
      }
    },
    "9": {
      "id": 9,
      "input_connections": {
        "bam": {
          "id": 8,
          "output_name": "bam"
        }
      },
      "name": "fgbio CallMolecularConsensusReads",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/jjohnson/fgbio_callmolecularconsensusreads/Repository_Actions_fgbio_CallMolecularConsensusReads",
      "tool_version": "1.3.0+galaxy1",
      "type": "tool",
      "annotation": "Call consensus sequences from grouped UMI reads with min_reads=1 and min_baseq=10",
      "position": {
        "left": 1330,
        "top": 10
      }
    },
    "10": {
      "annotation": "Output: UMI-tagged unmapped BAM from FASTQTOBAM",
      "id": 10,
      "input_connections": {
