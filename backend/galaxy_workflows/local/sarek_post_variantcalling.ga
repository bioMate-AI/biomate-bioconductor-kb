          "id": 2,
          "output_name": "output"
        },
        "germline_vcfs": {
          "id": 0,
          "output_name": "output"
        },
        "varlociraptor_chunk_size": {
          "id": 5,
          "output_name": "output"
        }
      },
      "name": "Convert Affymetrix",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/greg/affy2vcf2/Repository_Actions_Convert_Affymetrix",
