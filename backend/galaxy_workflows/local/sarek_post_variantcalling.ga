        },
        "fai": {
          "id": 4,
          "output_name": "output"
        },
        "tumor_only_vcfs": {
          "id": 1,
          "output_name": "output"
        },
        "varlociraptor_chunk_size": {
          "id": 5,
          "output_name": "output"
