{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "PREPARE_INTERVALS",
  "annotation": "PREPARE_INTERVALS subworkflow: Generates and prepares genomic intervals for parallel scatter/gather processing. Handles three scenarios: (1) no_intervals flag - creates empty interval files, (2) no intervals provided - generates from FASTA, (3) intervals provided - uses provided file (converts from .interval_list if needed). All intervals are split for parallel processing and indexed with tabix.",
  "steps": {
    "0": {
      "annotation": "FASTA index file (.fai)",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "fasta_fai"
        }
      ],
      "name": "Input: fasta_fai",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Optional intervals file (.bed or .interval_list)",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "intervals"
        }
      ],
      "name": "Input: intervals",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Flag to skip interval generation",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "no_intervals"
        }
      ],
      "name": "Input: no_intervals",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Nucleotides per second for interval splitting",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "nucleotides_per_second"
        }
      ],
      "name": "Input: nucleotides_per_second",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Step parameter (annotate, controlfreec, etc.)",
      "id": 4,
      "input_connections": {},
      "inputs": [
        {
          "name": "step"
        }
      ],
      "name": "Input: step",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "Alternative path: Generate intervals from FASTA when no intervals provided",
      "id": 5,
      "input_connections": {
        "infile": {
          "id": 0,
          "output_name": "output"
        }
      },
