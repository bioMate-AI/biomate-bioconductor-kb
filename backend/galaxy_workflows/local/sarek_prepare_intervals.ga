      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "6": {
      "annotation": "Path 1: When intervals generated from FASTA",
      "id": 6,
      "input_connections": {
        "intervals": {
          "id": 5,
          "output_name": "output"
        }
      },
      "name": "CREATE_INTERVALS_BED",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/bgruening/ctb_frankenstein_ligand/Repository_Actions_Create_Frankenstein_ligand",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "7": {
      "annotation": "Path 2: When intervals file provided",
      "id": 7,
      "input_connections": {
        "intervals": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "CREATE_INTERVALS_BED (from file)",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/bgruening/ctb_frankenstein_ligand/Repository_Actions_Create_Frankenstein_ligand",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 130
      }
    },
    "8": {
