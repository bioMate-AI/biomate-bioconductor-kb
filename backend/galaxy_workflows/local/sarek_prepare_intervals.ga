      "tool_id": "artbio_gatk4_gatk4_MergeMutectStats_4.1.7.0+galaxy3",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 130
      }
    },
    "9": {
      "annotation": "Compress and index each split interval bed file",
