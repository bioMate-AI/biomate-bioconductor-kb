{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "PIPELINE_INITIALISATION",
  "annotation": "nf-core/sarek pipeline initialization subworkflow - validates parameters, processes samplesheet, and prepares pipeline execution",
  "steps": {
    "0": {
      "annotation": "Pipeline version flag",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "version"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Parameter validation flag",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "validate_params"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Nextflow CLI arguments",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "nextflow_cli_args"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Output directory path",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "outdir"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Input samplesheet CSV file",
      "id": 4,
      "input_connections": {},
      "inputs": [
        {
          "name": "input"
        }
      ],
      "name": "Input dataset",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "UTILS_NEXTFLOW_PIPELINE: Print version and dump pipeline parameters to JSON file",
      "id": 5,
      "input_connections": {
        "version": {
          "id": 0,
          "output_name": "output"
        },
        "outdir": {
          "id": 3,
          "output_name": "output"
        }
      },
      "name": "Flexynesis utils",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/bgruening/flexynesis_utils/Repository_Actions_Flexynesis_utils",
      "tool_version": "0.2.20+galaxy3",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "6": {
      "annotation": "UTILS_NFSCHEMA_PLUGIN: Validate parameters and generate parameter summary",
      "id": 6,
      "input_connections": {
        "validate_params": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "Flexynesis utils",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/bgruening/flexynesis_utils/Repository_Actions_Flexynesis_utils",
      "tool_version": "0.2.20+galaxy3",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 130
      }
    },
    "7": {
      "annotation": "UTILS_NFCORE_PIPELINE: Check config provided to the pipeline",
      "id": 7,
      "input_connections": {
        "nextflow_cli_args": {
          "id": 2,
          "output_name": "output"
        }
      },
      "name": "Flexynesis utils",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/bgruening/flexynesis_utils/Repository_Actions_Flexynesis_utils",
      "tool_version": "0.2.20+galaxy3",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 250
      }
    },
    "8": {
      "annotation": "SAMPLESHEET_TO_CHANNEL: Convert samplesheet to channel and validate samples. Processes input samplesheet with comprehensive parameter configuration for alignment, variant calling, and annotation tools.",
      "id": 8,
      "input_connections": {
        "input_samplesheet": {
          "id": 4,
          "output_name": "output"
        },
        "outdir": {
          "id": 3,
          "output_name": "output"
        }
      },
      "name": "Flexynesis utils",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/bgruening/flexynesis_utils/Repository_Actions_Flexynesis_utils",
      "tool_version": "0.2.20+galaxy3",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 250
      }
    }
  },
  "outputs": {
    "samplesheet": {
      "annotation": "Processed samplesheet channel output containing validated sample information",
      "id": 8,
      "output_name": "input_sample",
      "type": "data"
    }
  }
}