        {
          "name": "vep_species"
        }
      ],
      "name": "Input VEP Species",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 730
      }
    },
    "7": {
      "annotation": "VEP cache version",
      "id": 7,
      "input_connections": {},
      "inputs": [
        {
          "name": "vep_cache_version"
        }
      ],
      "name": "Input VEP Cache Version",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 850
      }
    },
    "8": {
      "annotation": "VEP cache",
      "id": 8,
      "input_connections": {},
      "inputs": [
        {
          "name": "vep_cache"
        }
      ],
      "name": "Input VEP Cache",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 970
      }
    },
    "9": {
