        {
          "name": "snpeff_cache"
        }
      ],
      "name": "Input snpEff Cache",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "VEP genome",
      "id": 5,
      "input_connections": {},
      "inputs": [
        {
          "name": "vep_genome"
        }
      ],
      "name": "Input VEP Genome",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 610
      }
    },
    "6": {
