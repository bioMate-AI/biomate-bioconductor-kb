          "name": "bcftools_columns"
        }
      ],
      "name": "Input bcftools Columns",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 1450
      }
    },
    "13": {
      "annotation": "bcftools header lines",
      "id": 13,
      "input_connections": {},
      "inputs": [
        {
          "name": "bcftools_header_lines"
        }
      ],
      "name": "Input bcftools Header Lines",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 1570
      }
    },
    "14": {
      "annotation": "Conditional: bcftools annotate (if 'bcfann' in tools)",
      "id": 14,
      "input_connections": {
        "vcf": {
          "id": 0,
          "output_name": "output"
        },
        "annotations": {
          "id": 10,
          "output_name": "output"
        },
        "annotations_index": {
          "id": 11,
          "output_name": "output"
        },
        "columns": {
          "id": 12,
          "output_name": "output"
        },
        "header_lines": {
          "id": 13,
          "output_name": "output"
        }
      },
      "name": "bcftools view",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/gregory-minevich/bcftools_view/Repository_Actions_bcftools_view",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "15": {
      "annotation": "Conditional: snpEff annotation (if 'snpeff' or 'merge' in tools)",
      "id": 15,
      "input_connections": {
        "vcf": {
          "id": 0,
          "output_name": "output"
        },
        "snpeff_db": {
          "id": 3,
          "output_name": "output"
        },
        "snpeff_cache": {
          "id": 4,
          "output_name": "output"
        }
      },
      "name": "Convert Affymetrix (snpEff)",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/greg/affy2vcf2/Repository_Actions_Convert_Affymetrix",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 130
      }
    },
    "16": {
      "annotation": "Conditional: VEP merge annotation (if 'merge' in tools)",
      "id": 16,
      "input_connections": {
        "vcf": {
          "id": 15,
          "output_name": "output"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        },
        "vep_genome": {
          "id": 5,
          "output_name": "output"
        },
        "vep_species": {
          "id": 6,
          "output_name": "output"
        },
        "vep_cache_version": {
          "id": 7,
          "output_name": "output"
        },
        "vep_cache": {
          "id": 8,
          "output_name": "output"
        },
        "vep_extra_files": {
          "id": 9,
          "output_name": "output"
        }
      },
      "name": "Convert Affymetrix (VEP Merge)",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/greg/affy2vcf2/Repository_Actions_Convert_Affymetrix",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 130
      }
    },
    "17": {
      "annotation": "Conditional: Ensembl VEP annotation (if 'vep' in tools)",
      "id": 17,
      "input_connections": {
        "vcf": {
          "id": 0,
          "output_name": "output"
        },
        "fasta": {
          "id": 1,
          "output_name": "output"
        },
        "vep_genome": {
          "id": 5,
          "output_name": "output"
        },
        "vep_species": {
          "id": 6,
          "output_name": "output"
        },
        "vep_cache_version": {
          "id": 7,
          "output_name": "output"
        },
        "vep_cache": {
          "id": 8,
          "output_name": "output"
        },
        "vep_extra_files": {
          "id": 9,
          "output_name": "output"
        }
      },
      "name": "Convert Affymetrix (Ensembl VEP)",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/greg/affy2vcf2/Repository_Actions_Convert_Affymetrix",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 250
      }
    }
  },
  "annotation_notes": "This workflow implements conditional branching based on the 'tools' parameter:\n- If 'bcfann' is specified: bcftools annotate is applied\n- If 'snpeff' or 'merge' is specified: snpEff annotation is applied\n- If 'merge' is specified: VEP merge is applied after snpEff\n- If 'vep' is specified: Ensembl VEP annotation is applied\nOutputs include annotated VCF files, reports, and version information."
}