{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "VCF_ANNOTATE_ALL",
  "annotation": "VCF annotation workflow with conditional tool selection (bcftools, snpEff, VEP, or merge)",
  "steps": {
    "0": {
      "annotation": "Input VCF file",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "vcf"
        }
      ],
      "name": "Input VCF",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input reference FASTA",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "fasta"
        }
      ],
      "name": "Input FASTA",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Annotation tools to apply (bcfann, snpeff, merge, vep)",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "tools"
        }
      ],
      "name": "Input Tools Parameter",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "snpEff database",
      "id": 3,
      "input_connections": {},
