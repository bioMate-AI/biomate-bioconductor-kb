      ],
      "name": "Input VEP Extra Files",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 1090
      }
    },
    "10": {
      "annotation": "bcftools annotation files",
      "id": 10,
      "input_connections": {},
      "inputs": [
        {
          "name": "bcftools_annotations"
        }
      ],
      "name": "Input bcftools Annotations",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 1210
      }
    },
    "11": {
      "annotation": "bcftools annotation index",
      "id": 11,
      "input_connections": {},
      "inputs": [
        {
          "name": "bcftools_annotations_index"
        }
      ],
      "name": "Input bcftools Annotations Index",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 1330
      }
    },
    "12": {
      "annotation": "bcftools columns",
      "id": 12,
      "input_connections": {},
      "inputs": [
