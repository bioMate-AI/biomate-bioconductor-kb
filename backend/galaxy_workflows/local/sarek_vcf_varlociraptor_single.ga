        {
          "name": "ch_vcf"
        }
      ],
      "name": "Input VCF",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "Number of chunks for VCF splitting",
      "id": 5,
