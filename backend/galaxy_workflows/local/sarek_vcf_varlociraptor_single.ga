          "name": "ch_cram"
        }
      ],
      "name": "Input CRAM",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input reference FASTA",
      "id": 1,
      "input_connections": {},
