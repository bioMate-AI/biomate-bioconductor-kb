{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "VCF_VARLOCIRAPTOR_SINGLE",
  "annotation": "VCF_VARLOCIRAPTOR_SINGLE: Variant calling workflow using Varlociraptor for single samples. Processes CRAM files with reference genome, estimates alignment properties, splits input VCF into chunks, preprocesses with Varlociraptor, calls variants, and merges results.",
