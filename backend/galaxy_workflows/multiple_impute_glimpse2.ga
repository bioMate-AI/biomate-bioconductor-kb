{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "MULTIPLE_IMPUTE_GLIMPSE2",
  "annotation": "Converted from nf-core subworkflow for GLIMPSE2 imputation with multiple phases",
  "steps": {
    "0": {
      "annotation": "Input VCF file with metadata",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_input"
        }
      ],
      "name": "Input dataset collection",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Reference panel VCF with index and region",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_ref"
        }
      ],
      "name": "Reference panel input",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Genetic map file",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_map"
        }
      ],
      "name": "Genetic map input",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Reference FASTA file with index",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_fasta"
        }
      ],
      "name": "FASTA reference input",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Chunking model parameter",
      "id": 4,
      "input_connections": {},
      "inputs": [
        {
          "name": "chunk_model"
        }
      ],
      "name": "Chunk model parameter",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 490
      }
    },
    "5": {
      "annotation": "GLIMPSE2 chunk reference panel into regions",
      "id": 5,
      "input_connections": {
        "vcf": {
          "id": 1,
          "output_name": "vcf"
        },
        "map": {
          "id": 2,
          "output_name": "map"
        },
        "chunk_model": {
          "id": 4,
          "output_name": "chunk_model"
        }
      },
      "name": "GLIMPSE2_CHUNK",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/glimpse2_chunk/glimpse2_chunk",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "6": {
      "annotation": "Split reference panel into bin files based on chunks",
      "id": 6,
      "input_connections": {
        "vcf": {
          "id": 1,
          "output_name": "vcf"
        },
        "vcf_index": {
          "id": 1,
          "output_name": "csi"
        },
        "chunk_file": {
          "id": 5,
          "output_name": "chunk_chr"
        },
        "map": {
          "id": 2,
          "output_name": "map"
        }
      },
      "name": "GLIMPSE2_SPLITREFERENCE",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/glimpse2_splitreference/glimpse2_splitreference",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "7": {
      "annotation": "Phase input files using split reference bins",
      "id": 7,
      "input_connections": {
        "input_vcf": {
          "id": 0,
          "output_name": "vcf"
        },
        "input_vcf_index": {
          "id": 0,
          "output_name": "csi"
        },
        "input_infos": {
          "id": 0,
          "output_name": "infos"
        },
        "ref_bin": {
          "id": 6,
          "output_name": "bin_ref"
        },
        "fasta": {
          "id": 3,
          "output_name": "fasta"
        },
        "fasta_index": {
          "id": 3,
          "output_name": "index"
        }
      },
      "name": "GLIMPSE2_PHASE",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/glimpse2_phase/glimpse2_phase",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "8": {
      "annotation": "Index phased variants with bcftools",
      "id": 8,
      "input_connections": {
        "vcf": {
          "id": 7,
          "output_name": "phased_variants"
        }
      },
      "name": "INDEX_PHASE",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/bcftools_index/bcftools_index",
      "type": "tool",
      "position": {
        "left": 890,
        "top": 10
      }
    },
    "9": {
      "annotation": "Ligate all phased files into single merged VCF",
      "id": 9,
      "input_connections": {
        "vcf": {
          "id": 7,
          "output_name": "phased_variants"
        },
        "vcf_index": {
          "id": 8,
          "output_name": "csi"
        }
      },
      "name": "GLIMPSE2_LIGATE",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/glimpse2_ligate/glimpse2_ligate",
      "type": "tool",
      "position": {
        "left": 1110,
        "top": 10
      }
    },
    "10": {
      "annotation": "Index merged variants with bcftools",
      "id": 10,
      "input_connections": {
        "vcf": {
          "id": 9,
          "output_name": "merged_variants"
        }
      },
      "name": "INDEX_LIGATE",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/bcftools_index/bcftools_index",
      "type": "tool",
      "position": {
        "left": 1330,
        "top": 10
      }
    },
    "11": {
      "annotation": "Output chunk chromosome file",
      "id": 11,
      "input_connections": {
        "input": {
          "id": 5,
          "output_name": "chunk_chr"
        }
      },
      "name": "Output chunk_chr",
      "type": "data_output",
      "position": {
        "left": 1550,
        "top": 10
      }
    },
    "12": {
