{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "TIFF_SEGMENTATION_VPT",
  "annotation": "Perform segmentation of MERSCOPE TIFF images using the vizgen-postprocessing tool. Converted from nf-core subworkflow.",
  "steps": {
    "0": {
      "annotation": "Input channel containing metadata, image directory, and micron to mosaic pixel transform CSV",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_input",
          "description": "[ meta, image_dir, micron_to_mosaic_pixel_transform.csv ]"
        }
      ],
      "name": "Input: ch_input",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input channel containing algorithm configuration JSON",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_algorithm_json",
          "description": "[ algorithm.json ]"
        }
      ],
      "name": "Input: ch_algorithm_json",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Input channel containing image regex pattern",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_images_regex",
          "description": "[ val(regex) ]"
        }
      ],
      "name": "Input: ch_images_regex",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Input channel containing custom weights for segmentation model",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_custom_weights",
          "description": "[ custom_weights ]"
        }
      ],
      "name": "Input: ch_custom_weights",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Generate segmentation parameters file from input metadata and algorithm configuration",
      "id": 4,
      "input_connections": {
        "ch_input": {
          "id": 0,
          "output_name": "output"
        },
        "ch_algorithm_json": {
          "id": 1,
          "output_name": "output"
        },
        "ch_images_regex": {
          "id": 2,
          "output_name": "output"
        }
      },
      "name": "VIZGENPOSTPROCESSING_PREPARESEGMENTATION",
      "tool_id": "vizgenpostprocessing_preparesegmentation",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "5": {
      "annotation": "Extract number of tiles from segmentation parameters and create tile index sequence",
      "id": 5,
      "input_connections": {
        "segmentation_files": {
          "id": 4,
          "output_name": "segmentation_files"
        }
      },
      "name": "Generate Tile Indices",
      "tool_id": "expression_tools",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "6": {
      "annotation": "Prepare segmentation files channel by joining prepared segmentation parameters with input metadata",
      "id": 6,
      "input_connections": {
        "segmentation_files": {
          "id": 4,
          "output_name": "segmentation_files"
        },
        "ch_input": {
          "id": 0,
          "output_name": "output"
        }
      },
      "name": "Prepare Segmentation Files Channel",
      "tool_id": "expression_tools",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 130
      }
    },
    "7": {
      "annotation": "Run VPT segmentation on each tile independently",
      "id": 7,
      "input_connections": {
        "ch_segmentation_files": {
          "id": 6,
          "output_name": "output"
        },
        "ch_tiles": {
          "id": 5,
          "output_name": "output"
        },
        "ch_algorithm_json": {
          "id": 1,
          "output_name": "output"
        },
        "ch_custom_weights": {
          "id": 3,
          "output_name": "output"
        }
      },
      "name": "VIZGENPOSTPROCESSING_RUNSEGMENTATIONONTILE",
      "tool_id": "vizgenpostprocessing_runsegmentationontile",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "8": {
      "annotation": "Collect all segmented tiles from parallel processing",
      "id": 8,
      "input_connections": {
        "segmented_tiles": {
          "id": 7,
          "output_name": "segmented_tile"
        }
      },
      "name": "Collect Segmented Tiles",
      "tool_id": "expression_tools",
      "type": "tool",
      "position": {
        "left": 890,
        "top": 10
      }
    },
    "9": {
      "annotation": "Compile segmentation results from all tiles into final micron and mosaic space segmentations",
      "id": 9,
      "input_connections": {
        "ch_segmentation_files": {
          "id": 6,
          "output_name": "output"
        },
        "ch_algorithm_json": {
          "id": 1,
          "output_name": "output"
        },
        "ch_segmented_tiles": {
          "id": 8,
          "output_name": "output"
        }
      },
      "name": "VIZGENPOSTPROCESSING_COMPILETILESEGMENTATION",
      "tool_id": "vizgenpostprocessing_compiletilesegmentation",
      "type": "tool",
      "position": {
        "left": 1110,
        "top": 10
      }
    },
    "10": {
      "annotation": "Output: Micron space segmentation in parquet format",
      "id": 10,
      "input_connections": {
        "micron_space_segmentation": {
          "id": 9,
          "output_name": "micron_space"
        }
      },
      "name": "Output: micron_space_segmentation",
      "type": "data_output",
      "position": {
        "left": 1330,
        "top": 10
      }
    },
    "11": {
      "annotation": "Output: Mosaic space segmentation in parquet format",
      "id": 11,
      "input_connections": {
        "mosaic_space_segmentation": {
          "id": 9,
          "output_name": "mosaic_space"
        }
      },
      "name": "Output: mosaic_space_segmentation",
      "type": "data_output",
      "position": {
        "left": 1330,
        "top": 130
      }
    },
    "12": {
      "annotation": "Output: Version information from all tools",
      "id": 12,
      "input_connections": {
        "versions": {
          "id": 9,
          "output_name": "versions"
        }
      },
      "name": "Output: versions",
      "type": "data_output",
      "position": {
        "left": 1330,
        "top": 250
      }
    }
  }
}