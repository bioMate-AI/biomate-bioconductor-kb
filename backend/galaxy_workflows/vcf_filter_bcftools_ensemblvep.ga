{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "VCF_FILTER_BCFTOOLS_ENSEMBLVEP",
  "annotation": "Converted from nf-core subworkflow - VCF filtering with optional bcftools and/or Ensembl VEP filter_vep",
  "steps": {
    "0": {
      "annotation": "Input VCF file",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_vcf",
          "description": "VCF file to filter"
        }
      ],
      "name": "Input VCF",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input VEP feature file for filtering",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_filter_vep_feature_file",
          "description": "Feature file for VEP filtering"
        }
      ],
      "name": "Input VEP Feature File",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Input parameter: should bcftools view be run",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "filter_with_bcftools",
          "description": "Boolean flag to enable bcftools filtering"
        }
      ],
      "name": "Input filter_with_bcftools",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Input parameter: should filter_vep be run",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "filter_with_filter_vep",
          "description": "Boolean flag to enable VEP filtering"
        }
      ],
      "name": "Input filter_with_filter_vep",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "BCFTOOLS_VIEW - Filter VCF with bcftools (conditional step, runs if filter_with_bcftools is true)",
      "id": 4,
      "input_connections": {
        "input_file": {
          "id": 0,
          "output_name": "output"
        }
      },
      "name": "bcftools view",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/gregory-minevich/bcftools_view/Repository_Actions_bcftools_view",
      "tool_version": "0.0.1",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "5": {
      "annotation": "ENSEMBLVEP_FILTERVEP - Filter VCF with Ensembl VEP filter_vep (conditional step, runs if filter_with_filter_vep is true). Takes output from bcftools if it ran, otherwise takes original VCF.",
      "id": 5,
      "input_connections": {
        "vcf_input": {
          "id": 4,
          "output_name": "vcf"
        },
        "feature_file": {
          "id": 1,
          "output_name": "output"
        }
      },
      "name": "ensemblvep filtervep",
      "tool_id": "ensemblvep_filtervep",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "6": {
      "annotation": "TABIX_BGZIPTABIX - Index the filtered VCF output from filter_vep",
      "id": 6,
      "input_connections": {
        "input_file": {
          "id": 5,
          "output_name": "output"
        }
      },
      "name": "tabix",
      "tool_id": "nilesh_tabix_tabix_0.0.1",
      "tool_version": "0.0.1",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "7": {
      "annotation": "Output VCF file - either from bcftools, filter_vep+tabix, or original input depending on filter flags",
      "id": 7,
      "input_connections": {
        "vcf": {
          "id": 6,
          "output_name": "gz_vcf"
        }
      },
      "name": "Output VCF",
      "type": "data_output",
      "position": {
        "left": 890,
        "top": 10
      }
    },
    "8": {
      "annotation": "Output TBI index file - from tabix indexing of filter_vep output",
      "id": 8,
      "input_connections": {
        "tbi": {
          "id": 6,
          "output_name": "tbi"
        }
      },
      "name": "Output TBI",
      "type": "data_output",
      "position": {
        "left": 890,
        "top": 130
      }
    }
  }
}