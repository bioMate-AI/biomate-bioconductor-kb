{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "VCF_GATHER_BCFTOOLS",
  "annotation": "Converted from nf-core subworkflow - Gathers and processes VCF files using bcftools with optional sorting",
  "steps": {
    "0": {
      "annotation": "Input VCF files with metadata and index",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_vcfs",
          "description": "Channel containing [meta, vcf, tbi]"
        }
      ],
      "name": "Input VCF files",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Input scatter output with bed and gather count",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_scatter_output",
          "description": "Channel containing [meta, bed, gather_count]"
        }
      ],
      "name": "Input scatter output",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Input parameter for common meta field name",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "val_common_meta",
          "description": "Meta field name to become new id"
        }
      ],
      "name": "Input common meta",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Input parameter for sort flag",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "val_sort",
          "description": "Boolean flag for sorting output"
        }
      ],
      "name": "Input sort flag",
      "type": "parameter_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Concatenate multiple VCF files",
      "id": 4,
      "input_connections": {
        "vcf_input": {
          "id": 0,
          "output_name": "output"
        },
        "tbi_input": {
          "id": 0,
          "output_name": "output"
        }
      },
      "name": "BCFTOOLS_CONCAT",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/gregory-minevich/bcftools_view/Repository_Actions_bcftools_view",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 70
      }
    },
    "5": {
      "annotation": "Sort VCF file (conditional - only if val_sort is true)",
      "id": 5,
      "input_connections": {
        "vcf_input": {
          "id": 4,
          "output_name": "vcf"
        }
      },
      "name": "BCFTOOLS_SORT",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/gregory-minevich/bcftools_view/Repository_Actions_bcftools_view",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "6": {
      "annotation": "Index sorted VCF file with tabix",
      "id": 6,
      "input_connections": {
        "vcf_input": {
          "id": 5,
          "output_name": "vcf"
        }
      },
      "name": "TABIX_TABIX (sorted path)",
      "tool_id": "nilesh_tabix_tabix_0.0.1",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "7": {
      "annotation": "Index concatenated VCF file with tabix (when sort is false)",
      "id": 7,
      "input_connections": {
        "vcf_input": {
          "id": 4,
          "output_name": "vcf"
        }
      },
      "name": "TABIX_TABIX (unsorted path)",
      "tool_id": "nilesh_tabix_tabix_0.0.1",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 130
      }
    },
    "8": {
      "annotation": "Output VCF file (from sorted or unsorted path based on val_sort)",
      "id": 8,
      "input_connections": {
        "vcf_sorted": {
          "id": 5,
          "output_name": "vcf"
        },
        "vcf_unsorted": {
          "id": 4,
          "output_name": "vcf"
        }
      },
      "name": "Output VCF",
      "type": "data_output",
      "position": {
        "left": 890,
        "top": 70
      }
    },
    "9": {
      "annotation": "Output TBI index file (from sorted or unsorted path based on val_sort)",
      "id": 9,
      "input_connections": {
        "tbi_sorted": {
          "id": 6,
          "output_name": "tbi"
        },
        "tbi_unsorted": {
          "id": 7,
          "output_name": "tbi"
        }
      },
      "name": "Output TBI",
      "type": "data_output",
      "position": {
        "left": 890,
        "top": 190
      }
    }
  }
}