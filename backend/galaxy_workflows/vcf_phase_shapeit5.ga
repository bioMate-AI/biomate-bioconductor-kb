{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "VCF_PHASE_SHAPEIT5",
  "annotation": "Converted from nf-core subworkflow for VCF phasing using SHAPEIT5",
  "steps": {
    "0": {
      "annotation": "Input VCF file with metadata, index, pedigree and region information",
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_vcf",
          "description": "VCF file with CSI index and pedigree"
        }
      ],
      "name": "Input VCF",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 10
      }
    },
    "1": {
      "annotation": "Optional reference VCF file with index",
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_ref",
          "description": "Reference VCF file (optional)"
        }
      ],
      "name": "Input Reference VCF",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 130
      }
    },
    "2": {
      "annotation": "Optional scaffold VCF file with index",
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_scaffold",
          "description": "Scaffold VCF file (optional)"
        }
      ],
      "name": "Input Scaffold VCF",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 250
      }
    },
    "3": {
      "annotation": "Optional genetic map file",
      "id": 3,
      "input_connections": {},
      "inputs": [
        {
          "name": "ch_map",
          "description": "Genetic map file (optional)"
        }
      ],
      "name": "Input Genetic Map",
      "type": "data_input",
      "position": {
        "left": 10,
        "top": 370
      }
    },
    "4": {
      "annotation": "Create BED format windows from VCF regions for chunking",
      "id": 4,
      "input_connections": {
        "input_bed": {
          "id": 0,
          "output_name": "output"
        }
      },
      "name": "BEDTOOLS_MAKEWINDOWS",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/aaronquinlan/bedtools/Repository_Actions_Intersect_BAM_alignments_with_intervals_in_another_files",
      "type": "tool",
      "position": {
        "left": 230,
        "top": 10
      }
    },
    "5": {
      "annotation": "Phase common variants using SHAPEIT5 for each chunk",
      "id": 5,
      "input_connections": {
        "vcf": {
          "id": 0,
          "output_name": "output"
        },
        "reference": {
          "id": 1,
          "output_name": "output"
        },
        "scaffold": {
          "id": 2,
          "output_name": "output"
        },
        "map": {
          "id": 3,
          "output_name": "output"
        },
        "regions": {
          "id": 4,
          "output_name": "output"
        }
      },
      "name": "SHAPEIT5_PHASECOMMON",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/shapeit/shapeit5/shapeit5_phasecommon",
      "type": "tool",
      "position": {
        "left": 450,
        "top": 10
      }
    },
    "6": {
      "annotation": "Index phased VCF output from SHAPEIT5_PHASECOMMON",
      "id": 6,
      "input_connections": {
        "vcf": {
          "id": 5,
          "output_name": "phased_variant"
        }
      },
      "name": "VCF_INDEX1",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/greg/affy2vcf2/Repository_Actions_Convert_Affymetrix",
      "type": "tool",
      "position": {
        "left": 670,
        "top": 10
      }
    },
    "7": {
      "annotation": "Ligate phased VCF chunks back together",
      "id": 7,
      "input_connections": {
        "vcf": {
          "id": 5,
          "output_name": "phased_variant"
        },
        "vcf_index": {
          "id": 6,
          "output_name": "csi"
        }
      },
      "name": "SHAPEIT5_LIGATE",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/shapeit/shapeit5/shapeit5_ligate",
      "type": "tool",
      "position": {
        "left": 890,
        "top": 10
      }
    },
    "8": {
      "annotation": "Index final merged phased VCF",
      "id": 8,
      "input_connections": {
        "vcf": {
          "id": 7,
          "output_name": "merged_variants"
        }
      },
      "name": "VCF_INDEX2",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/greg/affy2vcf2/Repository_Actions_Convert_Affymetrix",
      "type": "tool",
      "position": {
        "left": 1110,
        "top": 10
      }
    },
    "9": {
      "annotation": "Output BED file with windows",
      "id": 9,
      "input_connections": {
        "input": {
          "id": 4,
          "output_name": "output"
        }
      },
      "name": "Output BED",
      "type": "data_output",
      "position": {
        "left": 1330,
        "top": 10
      }
    },
    "10": {
      "annotation": "Output phased VCF variants",
      "id": 10,
      "input_connections": {
        "input": {
          "id": 7,
          "output_name": "merged_variants"
        }
      },
      "name": "Output Phased Variants",
      "type": "data_output",
      "position": {
        "left": 1330,
        "top": 130
      }
    },
    "11": {
      "annotation": "Output VCF index file",
      "id": 11,
      "input_connections": {
        "input": {
          "id": 8,
          "output_name": "csi"
        }
      },
      "name": "Output Variants Index",
      "type": "data_output",
      "position": {
        "left": 1330,
        "top": 250
      }
    }
  }
}