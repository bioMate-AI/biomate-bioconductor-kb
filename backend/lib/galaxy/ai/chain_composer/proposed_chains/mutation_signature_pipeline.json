    "extract mutation signatures with musicatk",
    "kataegis hypermutation detection after sarek",
    "signature deconvolution and hypermutation clustering"
  ],
  "tags": ["mutation_signatures", "kataegis", "musicatk", "katdetectr", "consensus_candidates"]
