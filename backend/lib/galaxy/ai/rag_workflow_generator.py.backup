"""
RAG-based Galaxy Workflow Generator

Uses real workflow data from crawler to generate workflows based on similar patterns
and user requirements. Provides more accurate and practical workflow recommendations.
"""

import json
import numpy as np
import logging
from typing import Dict, List, Any, Optional, Tuple
from datetime import datetime
from collections import defaultdict
import pickle
import os

from .types import (
    UserRequest, WorkflowTemplate, WorkflowStep, 
    Task, Tool, ToolRecommendation
)
from .config import AIConfig
from .llm_client import LLMClient

log = logging.getLogger(__name__)


class WorkflowEmbedding:
    """Workflow embedding for similarity search."""
    
    def __init__(self, workflow_id: str, name: str, description: str, 
                 tags: List[str], steps: List[Dict], embedding: np.ndarray):
        self.workflow_id = workflow_id
        self.name = name
        self.description = description
        self.tags = tags
        self.steps = steps
        self.embedding = embedding
        self.step_count = len(steps) if steps else 0


class CrawledWorkflowData:
    """Manages crawled workflow data."""
    
    def __init__(self, crawler_data_path: str):
        self.crawler_data_path = crawler_data_path
        self.workflows = []
        self.workflow_index = {}
        self.category_index = defaultdict(list)
        
    def load_crawler_data(self):
        """Load workflow data from crawler JSON files."""
        try:
            # Load from the crawler data directory
            data_files = []
            if os.path.isdir(self.crawler_data_path):
                for file in os.listdir(self.crawler_data_path):
                    if file.endswith('.json'):
                        data_files.append(os.path.join(self.crawler_data_path, file))
            elif os.path.isfile(self.crawler_data_path):
                data_files = [self.crawler_data_path]
            
            for data_file in data_files:
                log.info(f"Loading workflow data from {data_file}")
                with open(data_file, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    
                    # Handle different data formats - fix for crawler data format
                    if 'workflows' in data:
                        workflows = data['workflows']
                    elif isinstance(data, list):
                        workflows = data
                    else:
                        # Handle single workflow file with metadata format
                        if 'metadata' in data:
                            # Transform crawler format to expected format
                            workflow = {
                                'id': data.get('workflow_id', ''),
                                'name': data['metadata'].get('name', ''),
                                'annotations': data['metadata'].get('annotations', []),
                                'tags': data['metadata'].get('tags', []),
                                'number_of_steps': data['metadata'].get('number_of_steps', 0),
                                'owner': data['metadata'].get('owner', ''),
                                'steps': data.get('workflow_json', {}).get('steps', {})
                            }
                            workflows = [workflow]
                        else:
                            workflows = [data]
                    
                    self.workflows.extend(workflows)
            
            log.info(f"Loaded {len(self.workflows)} workflows from crawler data")
            self._build_indexes()
            
        except Exception as e:
            log.error(f"Error loading crawler data: {e}")
            self.workflows = []
    
    def _build_indexes(self):
        """Build search indexes for workflows."""
        for workflow in self.workflows:
            workflow_id = workflow.get('id', '')
            self.workflow_index[workflow_id] = workflow
            
            # Index by categories/tags
            tags = workflow.get('tags', [])
            if isinstance(tags, str):
                tags = [tags]
            
            for tag in tags:
                if tag:
                    self.category_index[tag.lower()].append(workflow_id)
            
            # Auto-categorize based on name and description
            categories = self._auto_categorize(workflow)
            for category in categories:
                self.category_index[category].append(workflow_id)
    
    def _auto_categorize(self, workflow: Dict) -> List[str]:
        """Auto-categorize workflow based on content."""
        name = workflow.get('name', '').lower()
        description = ' '.join(workflow.get('annotations', [])).lower()
        text = f"{name} {description}"
        
        categories = []
        
        # Genomics categories
        if any(term in text for term in ['genome', 'genomic', 'assembly', 'dna']):
            categories.append('genomics')
        if any(term in text for term in ['rna', 'transcript', 'expression']):
            categories.append('rna-seq')
        if any(term in text for term in ['variant', 'snp', 'mutation', 'calling']):
            categories.append('variant-analysis')
        if any(term in text for term in ['bacterial', 'bacteria']):
            categories.append('bacterial-genomics')
        if any(term in text for term in ['quality', 'qc', 'fastqc']):
            categories.append('quality-control')
        if any(term in text for term in ['assembly', 'assemble']):
            categories.append('assembly')
        if any(term in text for term in ['align', 'mapping', 'map']):
            categories.append('alignment')
        
        return categories
    
    def search_workflows(self, query: str, category: str = None, 
                        min_steps: int = 0, max_steps: int = 1000) -> List[Dict]:
        """Search workflows by query and filters."""
        results = []
        query_lower = query.lower()
        
        for workflow in self.workflows:
            score = 0
            
            # Basic filtering
            step_count = workflow.get('number_of_steps', 0)
            if step_count < min_steps or step_count > max_steps:
                continue
            
            # Category filtering
            if category:
                workflow_categories = []
                tags = workflow.get('tags', [])
                if isinstance(tags, str):
                    tags = [tags]
                workflow_categories.extend([t.lower() for t in tags])
                workflow_categories.extend(self._auto_categorize(workflow))
                
                if category.lower() not in workflow_categories:
                    continue
            
            # Text matching
            name = workflow.get('name', '').lower()
            annotations = ' '.join(workflow.get('annotations', [])).lower()
            
            if query_lower in name:
                score += 20
            if query_lower in annotations:
                score += 15
            
            # Partial matches in name
            query_words = query_lower.split()
            for word in query_words:
                if word in name:
                    score += 5
                if word in annotations:
                    score += 3
            
            if score > 0:
                workflow_copy = workflow.copy()
                workflow_copy['relevance_score'] = score
                results.append(workflow_copy)
        
        # Sort by relevance
        results.sort(key=lambda x: x.get('relevance_score', 0), reverse=True)
        return results


class RAGWorkflowGenerator:
    """RAG-based workflow generator using crawled workflow data."""
    
    def __init__(self, config: AIConfig, crawler_data_path: str, galaxy_app=None):
        self.config = config
        self.galaxy_app = galaxy_app
        self.llm_client = LLMClient(config)
        
        # Initialize workflow data
        self.workflow_data = CrawledWorkflowData(crawler_data_path)
        self.workflow_data.load_crawler_data()
        
        # Embeddings storage
        self.embeddings = {}
        self.embeddings_cache_file = "workflow_embeddings.pkl"
        
        self._load_or_create_embeddings()
    
    def _load_or_create_embeddings(self):
        """Load existing embeddings or create new ones."""
        try:
            if os.path.exists(self.embeddings_cache_file):
                with open(self.embeddings_cache_file, 'rb') as f:
                    self.embeddings = pickle.load(f)
                log.info(f"Loaded {len(self.embeddings)} workflow embeddings from cache")
            else:
                self._create_embeddings()
        except Exception as e:
            log.warning(f"Error loading embeddings, creating new ones: {e}")
            self._create_embeddings()
    
    def _create_embeddings(self):
        """Create embeddings for all workflows."""
        log.info("Creating workflow embeddings...")
        
        for workflow in self.workflow_data.workflows:
            try:
                # Create text representation of workflow
                text = self._workflow_to_text(workflow)
                
                # Simple embedding using text length and keywords for now
                # In production, you'd use a proper embedding model
                embedding = self._simple_text_embedding(text)
                
                workflow_id = workflow.get('id', '')
                self.embeddings[workflow_id] = WorkflowEmbedding(
                    workflow_id=workflow_id,
                    name=workflow.get('name', ''),
                    description=' '.join(workflow.get('annotations', [])),
                    tags=workflow.get('tags', []),
                    steps=workflow.get('steps', []),
                    embedding=embedding
                )
            except Exception as e:
                log.warning(f"Error creating embedding for workflow {workflow.get('id', 'unknown')}: {e}")
        
        # Save embeddings cache
        try:
            with open(self.embeddings_cache_file, 'wb') as f:
                pickle.dump(self.embeddings, f)
            log.info(f"Saved {len(self.embeddings)} workflow embeddings to cache")
        except Exception as e:
            log.warning(f"Error saving embeddings cache: {e}")
    
    def _workflow_to_text(self, workflow: Dict) -> str:
        """Convert workflow to text representation."""
        parts = []
        
        # Basic info
        parts.append(workflow.get('name', ''))
        parts.extend(workflow.get('annotations', []))
        parts.extend([str(tag) for tag in workflow.get('tags', [])])
        
        # Step information (if available)
        steps = workflow.get('steps', [])
        if isinstance(steps, dict):
            for step in steps.values():
                if isinstance(step, dict):
                    parts.append(step.get('tool_id', ''))
                    parts.append(step.get('annotation', ''))
        elif isinstance(steps, list):
            for step in steps:
                if isinstance(step, dict):
                    parts.append(step.get('tool_id', ''))
                    parts.append(step.get('annotation', ''))
        
        return ' '.join(filter(None, parts))
    
    def _simple_text_embedding(self, text: str) -> np.ndarray:
        """Create a simple text embedding (placeholder for real embedding model)."""
        # This is a very simple embedding - in production you'd use
        # sentence transformers, OpenAI embeddings, etc.
        
        # Convert to lowercase and split
        words = text.lower().split()
        
        # Create feature vector based on presence of key terms
        features = {
            'genomics': any(w in words for w in ['genome', 'genomic', 'dna', 'gene']),
            'rna_seq': any(w in words for w in ['rna', 'transcript', 'expression', 'rnaseq']),
            'assembly': any(w in words for w in ['assembly', 'assemble', 'contig']),
            'variant': any(w in words for w in ['variant', 'snp', 'mutation', 'calling']),
            'quality': any(w in words for w in ['quality', 'qc', 'fastqc', 'trim']),
            'alignment': any(w in words for w in ['align', 'mapping', 'bwa', 'hisat', 'star']),
            'bacterial': any(w in words for w in ['bacterial', 'bacteria', 'prokaryote']),
            'analysis': any(w in words for w in ['analysis', 'pipeline', 'workflow']),
        }
        
        # Create embedding vector
        embedding = np.array([
            len(words),  # Text length
            len(set(words)),  # Unique words
            *[1.0 if v else 0.0 for v in features.values()]  # Feature presence
        ], dtype=np.float32)
        
        # Normalize
        if np.linalg.norm(embedding) > 0:
            embedding = embedding / np.linalg.norm(embedding)
        
        return embedding
    
    def find_similar_workflows(self, user_request: UserRequest, top_k: int = 5) -> List[Tuple[Dict, float]]:
        """Find workflows similar to user request."""
        # Create query embedding
        query_text = f"{user_request.request_text} {' '.join(user_request.context.get('tags', []))}"
        query_embedding = self._simple_text_embedding(query_text)
        
        # Calculate similarities
        similarities = []
        for workflow_id, workflow_emb in self.embeddings.items():
            similarity = np.dot(query_embedding, workflow_emb.embedding)
            similarities.append((workflow_id, similarity))
        
        # Sort and get top results
        similarities.sort(key=lambda x: x[1], reverse=True)
        
        results = []
        for workflow_id, similarity in similarities[:top_k]:
            workflow = self.workflow_data.workflow_index.get(workflow_id)
            if workflow:
                results.append((workflow, similarity))
        
        return results
    
    def generate_workflow_from_similar(self, user_request: UserRequest, 
                                     similar_workflows: List[Tuple[Dict, float]]) -> Optional[WorkflowTemplate]:
        """Generate workflow based on similar existing workflows."""
        if not similar_workflows:
            return None
        
        try:
            # Use the most similar workflow as template
            best_workflow, similarity = similar_workflows[0]
            
            # Create workflow template
            workflow_template = self._adapt_workflow_to_request(best_workflow, user_request, similarity)
            
            return workflow_template
            
        except Exception as e:
            log.error(f"Error generating workflow from similar workflows: {e}")
            return None
    
    def _adapt_workflow_to_request(self, template_workflow: Dict, 
                                 user_request: UserRequest, similarity: float) -> WorkflowTemplate:
        """Adapt a template workflow to user request."""
        
        # Extract workflow information
        workflow_id = template_workflow.get('id', '')
        template_name = template_workflow.get('name', '')
        template_annotations = template_workflow.get('annotations', [])
        template_tags = template_workflow.get('tags', [])
        
        # Generate adapted name and description
        adapted_name = self._generate_adapted_name(template_name, user_request)
        adapted_description = self._generate_adapted_description(
            template_annotations, user_request, similarity
        )
        
        # Convert steps (if available in detailed format)
        steps = self._convert_workflow_steps(template_workflow.get('steps', []))
        
        # Create workflow template
        workflow_template = WorkflowTemplate(
            name=adapted_name,
            description=adapted_description,
            steps=steps,
            inputs=self._infer_workflow_inputs(steps),
            outputs=self._infer_workflow_outputs(steps),
            tags=['rag-generated', 'adapted'] + (template_tags if isinstance(template_tags, list) else []),
            created_at=datetime.now()
        )
        
        return workflow_template
    
    def _generate_adapted_name(self, template_name: str, user_request: UserRequest) -> str:
        """Generate adapted workflow name."""
        try:
            prompt = f"""
            Based on this template workflow name: "{template_name}"
            And user request: "{user_request.request_text}"
            
            Generate a new, descriptive workflow name that:
            1. Reflects the user's specific request
            2. Maintains the analytical approach of the template
            3. Is 3-8 words long
            4. Uses standard bioinformatics terminology
            
            Respond with just the workflow name, no quotes.
            """
            
            adapted_name = self.llm_client.generate(prompt).strip().strip('"\'')
            return adapted_name if adapted_name else f"Adapted {template_name}"
            
        except Exception as e:
            log.warning(f"Error generating adapted name: {e}")
            return f"Adapted {template_name}"
    
    def _generate_adapted_description(self, template_annotations: List[str], 
                                    user_request: UserRequest, similarity: float) -> str:
        """Generate adapted workflow description."""
        template_desc = ' '.join(template_annotations) if template_annotations else "No description"
        
        description = f"""
        Workflow adapted from existing Galaxy workflow (similarity: {similarity:.2f})
        
        User Request: "{user_request.request_text}"
        
        Template Description: {template_desc}
        
        This workflow has been automatically adapted based on similar existing workflows
        in the Galaxy community. Generated using RAG-based workflow generation.
        """
        
        return description.strip()
    
    def _convert_workflow_steps(self, steps: Any) -> List[WorkflowStep]:
        """Convert workflow steps to WorkflowStep objects."""
        workflow_steps = []
        
        if isinstance(steps, dict):
            # Steps as dictionary (Galaxy format)
            for step_id, step_data in steps.items():
                if isinstance(step_data, dict):
                    workflow_step = self._create_workflow_step(step_id, step_data)
                    if workflow_step:
                        workflow_steps.append(workflow_step)
        elif isinstance(steps, list):
            # Steps as list
            for i, step_data in enumerate(steps):
                if isinstance(step_data, dict):
                    workflow_step = self._create_workflow_step(str(i), step_data)
                    if workflow_step:
                        workflow_steps.append(workflow_step)
        
        return workflow_steps
    
    def _create_workflow_step(self, step_id: str, step_data: Dict) -> Optional[WorkflowStep]:
        """Create a WorkflowStep from step data."""
        try:
            # Skip input steps and steps without valid tool_id
            step_type = step_data.get('type', '')
            tool_id = step_data.get('tool_id')
            
            # Filter out input steps, data collection steps, and steps without tools
            if (step_type in ['data_input', 'data_collection_input', 'parameter_input'] or 
                tool_id is None or 
                tool_id == ''):
                return None
            
            # Get annotation with fallback to step label or name
            annotation = (step_data.get('annotation', '') or 
                         step_data.get('label', '') or 
                         step_data.get('name', '') or 
                         f'Step {step_id}: {tool_id}')
            
            return WorkflowStep(
                step_id=step_id,
                tool_id=tool_id,
                tool_version=step_data.get('tool_version', 'latest'),
                input_connections=step_data.get('input_connections', {}),
                parameters=step_data.get('tool_state', {}),
                annotation=annotation,
                position=step_data.get('position', {'left': 200, 'top': 200})
            )
        except Exception as e:
            log.warning(f"Error creating workflow step {step_id}: {e}")
            return None
    
    def _infer_workflow_inputs(self, steps: List[WorkflowStep]) -> List[Dict[str, Any]]:
        """Infer workflow inputs from steps."""
        # Simple inference - in practice you'd analyze the workflow more carefully
        return [{
            'label': 'Input Dataset',
            'name': 'input_data',
            'type': 'data',
            'optional': False,
            'description': 'Primary input dataset for the workflow'
        }]
    
    def _infer_workflow_outputs(self, steps: List[WorkflowStep]) -> List[Dict[str, Any]]:
        """Infer workflow outputs from steps."""
        # Simple inference - in practice you'd analyze the final steps
        return [{
            'label': 'Analysis Result',
            'name': 'output_result',
            'type': 'data',
            'description': 'Final analysis output'
        }]
    
    def get_workflow_recommendations(self, user_request: UserRequest, limit: int = 5) -> List[Dict[str, Any]]:
        """Get workflow recommendations based on similarity search."""
        similar_workflows = self.find_similar_workflows(user_request, top_k=limit)
        
        recommendations = []
        for workflow, similarity in similar_workflows:
            # Extract tool list from workflow steps
            tools = []
            steps_data = workflow.get('steps', {})
            if isinstance(steps_data, dict):
                for step_key, step_data in steps_data.items():
                    if isinstance(step_data, dict):
                        step_type = step_data.get('type', '')
                        tool_id = step_data.get('tool_id')
                        
                        # Skip input steps and get actual tools
                        if (step_type not in ['data_input', 'data_collection_input', 'parameter_input'] and 
                            tool_id and tool_id != ''):
                            
                            # Extract tool name from tool_id
                            tool_name = tool_id
                            if '/' in tool_id:
                                tool_name = tool_id.split('/')[-1]
                            if tool_name not in tools:
                                tools.append(tool_name)
            
            # Get meaningful workflow steps description
            workflow_steps = self._convert_workflow_steps(steps_data)
            step_descriptions = []
            for step in workflow_steps:
                if step.annotation and step.annotation.strip():
                    step_descriptions.append(step.annotation.strip())
                elif step.tool_id:
                    step_descriptions.append(f"Run {step.tool_id}")
            
            recommendations.append({
                'workflow_id': workflow.get('id', ''),
                'name': workflow.get('name', ''),
                'description': ' '.join(workflow.get('annotations', [])),
                'tags': workflow.get('tags', []),
                'step_count': workflow.get('number_of_steps', 0),
                'actual_tool_steps': len(workflow_steps),  # Number of actual tool steps
                'tools': tools,  # List of tools used
                'steps': len(workflow_steps),  # For compatibility
                'step_descriptions': step_descriptions,  # Descriptions of each step
                'similarity_score': float(similarity),  # Convert numpy.float32 to Python float
                'owner': workflow.get('owner', ''),
                'confidence': float(similarity),  # Convert numpy.float32 to Python float
                'reason': f"Similar workflow found with {similarity:.2f} similarity score"
            })
        
        return recommendations
    
    def generate_workflow(self, user_request: UserRequest) -> Dict[str, Any]:
        """Main method to generate workflow using RAG approach."""
        try:
            # Find similar workflows
            similar_workflows = self.find_similar_workflows(user_request, top_k=3)
            
            if not similar_workflows:
                return {
                    'success': False,
                    'error': 'No similar workflows found',
                    'confidence': 0.0
                }
            
            # Generate workflow from most similar
            workflow_template = self.generate_workflow_from_similar(user_request, similar_workflows)
            
            if not workflow_template:
                return {
                    'success': False,
                    'error': 'Failed to generate workflow from templates',
                    'confidence': 0.0
                }
            
            # Calculate confidence based on similarity
            best_similarity = similar_workflows[0][1] if similar_workflows else 0.0
            
            return {
                'success': True,
                'workflow': {
                    'name': workflow_template.name,
                    'description': workflow_template.description,
                    'steps': [self._step_to_dict(step) for step in workflow_template.steps],
                    'inputs': workflow_template.inputs,
                    'outputs': workflow_template.outputs,
                    'tags': workflow_template.tags
                },
                'confidence': float(best_similarity),  # Convert numpy.float32 to Python float
                'similar_workflows_count': len(similar_workflows),
                'generation_method': 'rag_template_adaptation'
            }
            
        except Exception as e:
            log.error(f"Error in RAG workflow generation: {e}")
            return {
                'success': False,
                'error': str(e),
                'confidence': 0.0
            }
    
    def _step_to_dict(self, step: WorkflowStep) -> Dict[str, Any]:
        """Convert WorkflowStep to dictionary."""
        return {
            'id': step.step_id,
            'tool_id': step.tool_id,
            'tool_version': step.tool_version,
            'annotation': step.annotation,
            'input_connections': step.input_connections,
            'parameters': step.parameters,
            'position': step.position
        }
    
    def get_stats(self) -> Dict[str, Any]:
        """Get statistics about the RAG system."""
        return {
            'total_workflows': len(self.workflow_data.workflows),
            'indexed_workflows': len(self.embeddings),
            'categories': list(self.workflow_data.category_index.keys()),
            'avg_steps': np.mean([w.get('number_of_steps', 0) for w in self.workflow_data.workflows]) if self.workflow_data.workflows else 0
        }