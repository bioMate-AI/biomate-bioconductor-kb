# Galaxy Cloud Executor - Global Job Configuration (YAML)
# =========================================================
#
# 这是 Galaxy Cloud Executor 的全局作业配置文件模板（YAML 格式）。
#
# 使用方法：
# 1. 复制此文件到你的 Galaxy 配置目录：
#    cp config/job_conf.yml.sample $GALAXY_ROOT/config/job_conf.yml
#
# 2. 根据你的云环境修改配置
#
# 3. 重启 Galaxy
#
# 配置说明见: JOB_CONFIG_GUIDE.md

# ==========================================
# Runners（作业运行器）
# ==========================================
runners:
  # 本地执行器
  local:
    load: galaxy.jobs.runners.local:LocalJobRunner
    workers: 4

  # Galaxy Cloud 执行器
  galaxy_cloud:
    load: galaxy_cloud.galaxy_workflow.galaxy_job_runner:GalaxyCloudJobRunner
    workers: 8
    params:
      # 云配置文件路径
      cloud_config_file: config/aws_cloud_config.yaml

      # 默认云提供商
      default_provider: aws

      # 最大并行作业数
      max_parallel_jobs: 10

      # 作业超时（秒）
      job_timeout: 3600

      # 作业监控间隔（秒）
      monitor_interval: 30

  # Kubernetes 执行器（可选）
  k8s:
    load: galaxy.jobs.runners.kubernetes:KubernetesJobRunner
    params:
      k8s_config_path: ~/.kube/config
      k8s_namespace: galaxy-jobs

# ==========================================
# Execution（执行环境）
# ==========================================
execution:
  # 默认目标
  default: local

  # 环境变量
  environments:
    default:
      AWS_DEFAULT_REGION: us-east-1
      GALAXY_CLOUD_ENABLED: "true"
      TMPDIR: /tmp

# ==========================================
# Destinations（作业目标）
# ==========================================
destinations:
  # 本地执行
  local:
    runner: local

  # ==========================================
  # AWS Cloud Destinations
  # ==========================================

  # AWS: 默认配置
  aws_default:
    runner: galaxy_cloud
    params:
      provider: aws
      cpus: 1
      memory_mb: 2048
      disk_gb: 20

  # AWS: 小型作业（< 1 GB RAM）
  aws_small:
    runner: galaxy_cloud
    params:
      provider: aws
      cpus: 1
      memory_mb: 1024
      disk_gb: 10
      spot_allocation: spot  # 使用 Spot 实例节省成本

  # AWS: 中型作业（1-4 GB RAM）
  aws_medium:
    runner: galaxy_cloud
    params:
      provider: aws
      cpus: 2
      memory_mb: 4096
      disk_gb: 50
      spot_allocation: spot

  # AWS: 大型作业（4-16 GB RAM）
  aws_large:
    runner: galaxy_cloud
    params:
      provider: aws
      cpus: 4
      memory_mb: 16384
      disk_gb: 100
      spot_allocation: onDemand  # 大型作业使用按需实例

  # AWS: 超大型作业（> 16 GB RAM）
  aws_xlarge:
    runner: galaxy_cloud
    params:
      provider: aws
      cpus: 8
      memory_mb: 32768
      disk_gb: 200
      spot_allocation: onDemand

  # AWS: GPU 作业
  aws_gpu:
    runner: galaxy_cloud
    params:
      provider: aws
      cpus: 4
      memory_mb: 16384
      disk_gb: 100
      gpu: 1
      spot_allocation: spot

  # ==========================================
  # Kubernetes Destinations（可选）
  # ==========================================

  # Kubernetes: 默认配置
  k8s_default:
    runner: k8s
    params:
      docker_enabled: true
      requests_cpu: 1
      requests_memory: 2Gi
      limits_cpu: 2
      limits_memory: 4Gi

  # Kubernetes: 大型作业
  k8s_large:
    runner: k8s
    params:
      docker_enabled: true
      requests_cpu: 4
      requests_memory: 16Gi
      limits_cpu: 8
      limits_memory: 32Gi

# ==========================================
# Tools（工具到目标的映射）
# ==========================================
tools:
  # ==========================================
  # 生物信息学工具 → AWS Cloud
  # ==========================================

  # FastQC（质量控制）→ 小型
  - id: toolshed.g2.bx.psu.edu/repos/devteam/fastqc/fastqc
    destination: aws_small

  # Trimmomatic（序列修剪）→ 中型
  - id: toolshed.g2.bx.psu.edu/repos/pjbriggs/trimmomatic/trimmomatic
    destination: aws_medium

  # BWA（序列比对）→ 大型
  - id: toolshed.g2.bx.psu.edu/repos/devteam/bwa/bwa_mem
    destination: aws_large

  - id: toolshed.g2.bx.psu.edu/repos/devteam/bwa/bwa
    destination: aws_large

  # Bowtie2（序列比对）→ 大型
  - id: toolshed.g2.bx.psu.edu/repos/devteam/bowtie2/bowtie2
    destination: aws_large

  # GATK（变异检测）→ 超大型
  - id: toolshed.g2.bx.psu.edu/repos/devteam/gatk4/gatk4
    destination: aws_xlarge

  # SAMtools（SAM/BAM 处理）→ 中型
  - id: toolshed.g2.bx.psu.edu/repos/devteam/samtools/samtools
    destination: aws_medium

  # DeepVariant（深度学习变异检测）→ GPU
  - id: deepvariant
    destination: aws_gpu

  # ==========================================
  # 按工具类型路由（正则表达式匹配）
  # ==========================================

  # 所有比对工具 → 大型
  - id: ".*aligner.*"
    destination: aws_large
    runner_type: regex

  # 所有装配工具 → 超大型
  - id: ".*assembl.*"
    destination: aws_xlarge
    runner_type: regex

  # 所有变异检测工具 → 超大型
  - id: ".*variant.*"
    destination: aws_xlarge
    runner_type: regex

# ==========================================
# Limits（资源限制）
# ==========================================
limits:
  # 全局并发限制
  - type: registered_user_concurrent_jobs
    value: 10

  - type: anonymous_user_concurrent_jobs
    value: 1

  # 按目标的用户并发限制
  - type: destination_user_concurrent_jobs
    id: aws_default
    value: 5

  - type: destination_user_concurrent_jobs
    id: aws_large
    value: 2

  - type: destination_user_concurrent_jobs
    id: aws_xlarge
    value: 1

  # 总并发作业数限制
  - type: concurrent_jobs
    id: local
    value: 4

  - type: concurrent_jobs
    id: aws_default
    value: 20

  - type: concurrent_jobs
    id: aws_large
    value: 10

  - type: concurrent_jobs
    id: aws_xlarge
    value: 5

# ==========================================
# Resources（动态资源分配）
# ==========================================
resources:
  default: default_resource

  groups:
    # 默认资源组
    default_resource:
      - aws_default

    # 小型任务资源组
    small:
      - aws_small
      - local

    # 中型任务资源组
    medium:
      - aws_medium
      - aws_default

    # 大型任务资源组
    large:
      - aws_large
      - aws_medium

    # 超大型任务资源组
    xlarge:
      - aws_xlarge
      - aws_large

    # GPU 资源组
    gpu:
      - aws_gpu

# ==========================================
# Scheduling（作业调度策略）
# ==========================================
scheduling:
  # 启用动态作业调度
  dynamic_destination: true

  # 调度策略
  strategy: fair_share

  # 作业优先级
  priority:
    # 高优先级用户
    high_priority_users:
      - admin@galaxy.org

    # 工具优先级
    tool_priority:
      fastqc: 10
      bwa: 20
      gatk4: 30

# ==========================================
# Monitoring（监控配置）
# ==========================================
monitoring:
  # 启用作业监控
  enabled: true

  # 监控间隔（秒）
  interval: 30

  # 超时设置
  timeout:
    default: 3600  # 1 小时
    long_running: 86400  # 24 小时

  # 重试设置
  retry:
    max_attempts: 3
    backoff_multiplier: 2
    initial_delay: 60

# ==========================================
# Handlers（作业处理器）
# ==========================================
handlers:
  # 主处理器
  main:
    - id: main_0
    - id: main_1

  # 云作业处理器
  cloud:
    - id: cloud_0
    - id: cloud_1
    - id: cloud_2

  # 处理器分配
  assign:
    # 本地作业 → 主处理器
    - destination: local
      handler: main

    # 云作业 → 云处理器
    - destination: aws_*
      handler: cloud

# ==========================================
# 高级配置
# ==========================================
advanced:
  # 启用作业缓存
  enable_job_cache: true

  # 作业元数据
  metadata:
    collect_metrics: true
    store_logs: true

  # 清理策略
  cleanup:
    # 完成后清理临时文件
    on_completion: true

    # 保留时间（小时）
    retention_hours: 24

  # 故障处理
  failure_handling:
    # 自动重试
    auto_retry: true

    # 降级策略（失败后使用备用目标）
    fallback_destinations:
      aws_large: aws_medium
      aws_xlarge: aws_large
