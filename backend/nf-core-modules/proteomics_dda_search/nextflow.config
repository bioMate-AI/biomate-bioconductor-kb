// proteomics_dda_search — search params surfaced as ext.args (identical for every run
// = fair-comparison / reproducibility). Tune per project via -params-file or --<param>.

params {
    enzyme                  = 'Trypsin'
    missed_cleavages        = 2
    precursor_tolerance_ppm = 10
    fragment_tolerance_da   = 0.02
    fixed_mods              = 'Carbamidomethyl (C)'
    variable_mods           = 'Oxidation (M)'
}

process {
    // CPU-bound search — process_high maps to a CPU Batch queue (NOT GPU) in the
    // BioMate executor (nextflow_executor.py _generate_executor_config withLabel).
    withName: '.*OPENMSTHIRDPARTY_COMETADAPTER' {
        ext.args = { [
            "-precursor_mass_tolerance ${params.precursor_tolerance_ppm}",
            "-precursor_error_units ppm",
            "-fragment_mass_tolerance ${params.fragment_tolerance_da}",
            "-fragment_error_units Da",
            "-enzyme '${params.enzyme}'",
            "-missed_cleavages ${params.missed_cleavages}",
            "-fixed_modifications '${params.fixed_mods}'",
            "-variable_modifications '${params.variable_mods}'",
        ].join(' ') }
    }
    withName: '.*OPENMS_DECOYDATABASE' {
        // append reversed decoys to the target DB (target+decoy in one FASTA)
        ext.args = '-decoy_string DECOY_ -decoy_string_position prefix -enzyme Trypsin'
    }
    withName: '.*OPENMS_PEPTIDEINDEXER' {
        ext.args = "-decoy_string DECOY_ -decoy_string_position prefix -enzyme:name '${params.enzyme}'"
    }
}
