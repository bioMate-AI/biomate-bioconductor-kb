// Biomate AI Tools - Nextflow Configuration
// ECR Repository: 399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate/ai-tools/

params {
    // Model paths (mount these volumes)
    models_dir = '/models'
    profam_model = "${params.models_dir}/profam"
    state_model = "${params.models_dir}/state"

    // API keys (set via environment)
    gemini_api_key = System.getenv('GEMINI_API_KEY') ?: ''
}

// Container registry
docker {
    enabled = true
    registry = '399683337364.dkr.ecr.us-west-2.amazonaws.com'
}

// Process labels for resource allocation
process {
    withLabel: 'process_low' {
        cpus = 2
        memory = '4.GB'
        time = '1.h'
    }
    withLabel: 'process_medium' {
        cpus = 4
        memory = '16.GB'
        time = '4.h'
    }
    withLabel: 'process_gpu' {
        cpus = 8
        memory = '32.GB'
        time = '24.h'
        containerOptions = '--gpus all'
    }
    withLabel: 'process_gpu_medium' {
        cpus   = 8
        memory = '32.GB'
        time   = '12.h'
        containerOptions = '--gpus all'
    }
    withLabel: 'process_high_memory' {
        memory = '64.GB'
    }

    // ── Cryo-EM heterogeneity: named process overrides for AWS Batch ──────────
    withName: 'CRYODRGN_TRAIN' {
        // GPU training — route to Batch queue with GPU access
        queue            = 'biomate-nextflow-queue'
        containerOptions = '--gpus all'
        cpus             = 8
        memory           = '32.GB'
        time             = '24.h'
    }
    withName: 'CRYODRGN_ANALYZE' {
        // CPU-bound UMAP + k-means analysis
        queue  = 'biomate-nextflow-queue'
        cpus   = 4
        memory = '16.GB'
        time   = '4.h'
    }
    withName: 'POCKET_SCAN_ENSEMBLE' {
        // fpocket scan of reconstructed density maps
        queue  = 'biomate-nextflow-queue'
        cpus   = 4
        memory = '16.GB'
        time   = '2.h'
    }
    withName: 'HETEROGENEITY_REPORT' {
        // Lightweight report assembly
        queue  = 'biomate-nextflow-queue'
        cpus   = 2
        memory = '4.GB'
        time   = '30.m'
    }
}

// AWS Batch configuration (optional)
profiles {
    aws {
        process.executor = 'awsbatch'
        process.queue    = 'biomate-nextflow-queue'
        aws.region       = 'us-west-2'
        aws.batch.cliPath = '/opt/aws-cli/bin/aws'

        // Route GPU-heavy processes to the GPU queue
        process {
            withName: 'BIOEMU_SAMPLE' {
                queue            = 'biomate-nextflow-queue'
            }
            // cryoDRGN training uses GPU Batch queue
            withName: 'CRYODRGN_TRAIN' {
                queue            = 'biomate-nextflow-queue'
                containerOptions = '--gpus all'
            }
        }
    }

    // Spot GPU profile — uses SPOT_CAPACITY_OPTIMIZED queue (g6/g4dn, 60-70% cheaper).
    // Falls back to on-demand galaxy-cloud-compute-gpu-industrial if spot capacity unavailable.
    spot_gpu {
        process.executor  = 'awsbatch'
        process.queue     = 'biomate-nextflow-queue'   // CPU default
        aws.region        = 'us-west-2'
        aws.batch.cliPath = '/opt/aws-cli/bin/aws'

        process {
            withLabel: 'process_gpu' {
                queue            = 'biomate-gpu-spot-queue'
                containerOptions = '--gpus all'
                accelerator      = 1
            }
            withName: 'BIOEMU_SAMPLE' {
                queue            = 'biomate-gpu-spot-queue'
                containerOptions = '--gpus all'
                accelerator      = 1
                cpus             = 8
                memory           = '32.GB'
                time             = '8.h'
            }
            withName: 'CRYODRGN_TRAIN' {
                queue            = 'biomate-gpu-spot-queue'
                containerOptions = '--gpus all'
                accelerator      = 1
                cpus             = 8
                memory           = '32.GB'
                time             = '12.h'
            }
            withName: 'CRYODRGN_ANALYZE' {
                queue  = 'biomate-nextflow-queue'
                cpus   = 4
                memory = '16.GB'
                time   = '4.h'
            }
            withName: 'POCKET_SCAN_ENSEMBLE' {
                queue  = 'biomate-nextflow-queue'
                cpus   = 4
                memory = '16.GB'
                time   = '2.h'
            }
            withName: 'CONFORMATIONAL_SUMMARY' {
                queue  = 'biomate-nextflow-queue'
                cpus   = 2
                memory = '8.GB'
                time   = '1.h'
            }
            withName: 'POCKET_MINER' {
                queue  = 'biomate-nextflow-queue'
                cpus   = 4
                memory = '16.GB'
                time   = '2.h'
            }
        }
    }

    local {
        process.executor = 'local'
        docker.enabled = true
    }

    test {
        params.test_data = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data'
    }
}

// Manifest
manifest {
    name = 'biomate-ai-tools'
    author = 'Biomate Team'
    description = 'Nextflow modules for cutting-edge bioinformatics AI tools'
    version = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
