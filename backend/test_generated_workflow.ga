{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "Human Serum LC-MS Metabolite Identification Workflow",
  "annotation": "This workflow addresses the complete metabolite identification pipeline from human serum LC-MS data. Step 1 (BEAMSpy) handles the critical initial peak detection and feature extraction from raw LC-MS data. Step 2 (Bih4MaConDa) provides general LC-MS metabolite annotation. Step 3 (BiH4BloodExposome) is specifically designed for blood/serum samples, making it ideal for human serum analysis. Step 4 (BioTransformer) expands identification by predicting biotransformation products. Step 5 (MetaboRank) ranks compounds to prioritize the most relevant metabolites. Step 6 (Pathview) provides biological context through pathway mapping. This workflow maximizes the use of available tools that match the keywords: LC-MS, peak detection, metabolite, annotation, compound identification, and MS analysis.",
  "tags": [
    "lcms",
    "metabolomics",
    "ai-generated"
  ],
  "steps": {
    "0": {
      "id": 0,
      "tool_id": "toolshed.g2.bx.psu.edu/repos/metabolights/beamspy_galaxy/beamspy/1.1.0+galaxy0",
      "tool_version": null,
      "type": "tool",
      "name": "BEAMSpy",
      "tool_state": {},
      "inputs": []
    },
    "1": {
      "id": 1,
