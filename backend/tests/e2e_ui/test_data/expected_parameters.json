{
  "test_01_dia_lcms": {
    "query": "Analyze DIA LC-MS data for protein identification and quantification",
    "workflow_description": "DIA-NN/OpenSWATH workflow for data-independent acquisition mass spectrometry",
    "expected_steps": [
      "DIA-NN Search",
      "Statistical Analysis",
      "Protein Quantification",
      "Quality Control"
    ],
    "expected_parameters": {
      "step_0_diann": {
        "tool_id": "biomate_dm_diann",
        "step_name": "DIA-NN Search",
        "params": {
          "library_type": {
            "value": "spectral",
            "tier": "essential",
            "description": "Type of spectral library to use"
          },
          "organism": {
            "value": "human",
            "tier": "essential",
            "description": "Target organism for protein identification"
          },
          "fdr_threshold": {
            "value": 0.01,
            "tier": "common",
            "description": "False discovery rate threshold"
          },
          "mass_accuracy": {
            "value": 10.0,
            "tier": "common",
            "description": "Mass accuracy in ppm"
          },
          "min_peptide_length": {
            "value": 7,
            "tier": "advanced",
            "description": "Minimum peptide length"
          }
        },
        "min_confidence": 0.75,
        "critical_params": ["library_type", "organism", "fdr_threshold"]
      },
      "step_1_stats": {
        "tool_id": "biomate_dm_stats",
        "step_name": "Statistical Analysis",
        "params": {
          "normalization_method": {
            "value": "median",
            "tier": "essential",
            "description": "Normalization method for quantification"
          },
          "missing_value_imputation": {
            "value": "knn",
            "tier": "common",
            "description": "Method for handling missing values"
          },
          "statistical_test": {
            "value": "t-test",
            "tier": "common",
            "description": "Statistical test for differential analysis"
          }
        },
        "min_confidence": 0.70,
        "critical_params": ["normalization_method"]
      },
      "step_2_quant": {
        "tool_id": "biomate_dm_protein_quant",
        "step_name": "Protein Quantification",
        "params": {
          "quantification_method": {
            "value": "maxlfq",
            "tier": "essential",
            "description": "Protein quantification algorithm"
          },
          "min_peptides": {
            "value": 2,
            "tier": "common",
            "description": "Minimum peptides per protein"
          },
          "use_shared_peptides": {
            "value": false,
            "tier": "advanced",
            "description": "Include shared peptides in quantification"
          }
        },
        "min_confidence": 0.75,
        "critical_params": ["quantification_method", "min_peptides"]
      },
      "step_3_qc": {
        "tool_id": "biomate_dm_qc",
        "step_name": "Quality Control",
        "params": {
          "cv_threshold": {
            "value": 0.20,
            "tier": "common",
            "description": "Coefficient of variation threshold"
          },
          "generate_plots": {
            "value": true,
            "tier": "common",
            "description": "Generate QC visualization plots"
          }
        },
        "min_confidence": 0.60,
        "critical_params": ["cv_threshold"]
      }
    },
    "validation_strategy": {
      "check_step_count": true,
      "check_tool_ids": true,
      "check_critical_params": true,
      "allow_additional_params": true,
      "check_parameter_tiers": true
    }
  },
