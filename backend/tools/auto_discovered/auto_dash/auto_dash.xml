<?xml version='1.0' encoding='utf-8'?>
<tool id="auto_dash" name="dash" version="1.0.0">
  <description>Data Apps &amp; Dashboards for Python. No JavaScript Required.</description>
  <requirements>
    <container type="docker">python:3.9-slim</container>
  </requirements>
  <command detect_errors="exit_code">&lt;![CDATA[
# Setup environment
pip install dash

# Run tool
dash --help || python -m dash --help
]]&gt;</command>
  <inputs>
    <param name="help" type="text" label="Help" help="Parameter for help" />
    <param name="m" type="text" label="M" help="Parameter for m" />
    <param name="help" type="text" label="Help" help="Parameter for help" />
  </inputs>
  <outputs>
    <data name="output" format="txt" label="Output file" />
  </outputs>
