<?xml version="1.0" ?>
<tool id="biomni_run_autosite" name="BioMni: Run Autosite" version="1.0.0" profile="20.01">
  <description>run_autosite</description>
  <requirements>
    <!-- BioMni Python function wrapper -->
    <requirement type="package">matplotlib</requirement>
    <requirement type="package">numpy</requirement>
    <requirement type="package">pandas</requirement>
    <requirement type="package">scipy</requirement>
    <requirement type="package">biomni</requirement>
  </requirements>
  <command detect_errors="exit_code">&lt;![CDATA[
python '$__tool_directory__/wrapper.py' --pdb_file 'pdb_file' --output_dir 'output_dir' --spacing 'spacing'
]]&gt;</command>
  <inputs>
    <param type="data" name="pdb_file" label="Pdb File" help=""/>
    <param type="text" name="output_dir" label="Output Dir" help="" value=""/>
    <param type="text" name="spacing" label="Spacing" help="" value=""/>
  </inputs>
  <outputs>
    <data name="output" format="auto" label="run_autosite output"/>
  </outputs>
  <help>&lt;![CDATA[
**What it does**



**Source**

This tool wraps the BioMni function: `run_autosite`

Module: pharmacology

**BioMni**

BioMni is a Python library for biological data analysis.
For more information: https://github.com/batmen-lab/BioMni

**Requirements**

This tool requires the following conda packages:
matplotlib, numpy, pandas, scipy
]]&gt;</help>
</tool>
