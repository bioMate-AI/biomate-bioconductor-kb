<tool id="nfcore_affy/justrma" name="affy_justrma" version="1.0" profile="21.05">
    <description>Read CEL files into an ExpressionSet and generate a matrix</description>

    <requirements>
        <container type="docker">biocontainers/bioconductor-affy:1.78.0--r43ha9d7317_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        affy/justrma
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**affy_justrma**

Read CEL files into an ExpressionSet and generate a matrix

**nf-core Module Information:**

- Module: affy/justrma
- Container: biocontainers/bioconductor-affy:1.78.0--r43ha9d7317_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

