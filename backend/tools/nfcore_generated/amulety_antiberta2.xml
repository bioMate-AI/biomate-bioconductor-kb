<?xml version='1.0' encoding='UTF-8'?>
<tool id="nfcore_amulety/antiberta2" name="amulety_antiberta2" version="1.0" profile="21.05">
    <description>A module to create antiberta2 embeddings of antibody (BCR) amino acid sequences using amulety.</description>

    <requirements>
        <container type="docker">biocontainers/amulety:1.1</container>
    </requirements>

    <command detect_errors="exit_code">
        amulety/antiberta2
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    </command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File" help="Input data file for processing" />
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads" help="Number of CPU threads to use" />
        <param name="advanced_options" type="text" value="" label="Advanced Options" help="Additional command-line options (advanced users)" />
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*" label="${tool.name} on ${on_string}: Output" />
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt" />
                </assert_contents>
            </output>
        </test>
    </tests>

    <help>
**amulety_antiberta2**

A module to create antiberta2 embeddings of antibody (BCR) amino acid sequences using amulety.

**nf-core Module Information:**

- Module: amulety/antiberta2
- Container: biocontainers/amulety:1.1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    </help>

    <citations>
        <citation type="bibtex">@misc{nfcore_amulety/antiberta2,
            title = {nf-core amulety/antiberta2 module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/amulety/antiberta2},
            year = {2024}
        }}</citation>
    </citations>
</tool>