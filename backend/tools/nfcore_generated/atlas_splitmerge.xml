<tool id="nfcore_atlas/splitmerge" name="atlas_splitmerge" version="1.0" profile="21.05">
    <description>split single end read groups by length and merge paired end reads</description>

    <requirements>
        <container type="docker">biocontainers/atlas:0.9.9--h082e891_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        atlas/splitmerge
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**atlas_splitmerge**

split single end read groups by length and merge paired end reads

**nf-core Module Information:**

- Module: atlas/splitmerge
- Container: biocontainers/atlas:0.9.9--h082e891_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_atlas/splitmerge,
            title = {nf-core atlas/splitmerge module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/atlas/splitmerge},
            year = {2024}
        }}</citation>
    </citations>
</tool>