<tool id="nfcore_bacphlip" name="bacphlip" version="1.0" profile="21.05">
    <description>A bacteriophage lifestyle prediction tool</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-e16bfb0f667f2f3c236b32087aaf8c76a0cd2864:c64689d7d5c51670ff5841ec4af982edbe7aa406-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        bacphlip
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**bacphlip**

A bacteriophage lifestyle prediction tool

**nf-core Module Information:**

- Module: bacphlip
- Container: biocontainers/mulled-v2-e16bfb0f667f2f3c236b32087aaf8c76a0cd2864:c64689d7d5c51670ff5841ec4af982edbe7aa406-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_bacphlip,
            title = {nf-core bacphlip module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/bacphlip},
            year = {2024}
        }}</citation>
    </citations>
</tool>