<tool id="nfcore_bam2fastx/bam2fastq" name="bam2fastx_bam2fastq" version="1.0" profile="21.05">
    <description>Conversion of PacBio BAM files into gzipped fastq files, including splitting of barcoded data</description>

    <requirements>
        <container type="docker">biocontainers/bam2fastx:1.3.1--hf05d43a_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        bam2fastx/bam2fastq
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**bam2fastx_bam2fastq**

Conversion of PacBio BAM files into gzipped fastq files, including splitting of barcoded data

**nf-core Module Information:**

- Module: bam2fastx/bam2fastq
- Container: biocontainers/bam2fastx:1.3.1--hf05d43a_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_bam2fastx/bam2fastq,
            title = {nf-core bam2fastx/bam2fastq module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/bam2fastx/bam2fastq},
            year = {2024}
        }}</citation>
    </citations>
</tool>