<tool id="nfcore_bamutil/trimbam" name="bamutil_trimbam" version="1.0" profile="21.05">
    <description>trims the end of reads in a SAM/BAM file, changing read ends to ‘N’ and quality to ‘!’, or by soft clipping</description>

    <requirements>
        <container type="docker">biocontainers/bamutil:1.0.15--h2e03b76_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        bamutil/trimbam
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**bamutil_trimbam**

trims the end of reads in a SAM/BAM file, changing read ends to ‘N’ and quality to ‘!’, or by soft clipping

**nf-core Module Information:**

- Module: bamutil/trimbam
- Container: biocontainers/bamutil:1.0.15--h2e03b76_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_bamutil/trimbam,
            title = {nf-core bamutil/trimbam module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/bamutil/trimbam},
            year = {2024}
        }}</citation>
    </citations>
</tool>