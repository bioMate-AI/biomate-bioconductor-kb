<tool id="nfcore_bcftools/plugintag2tag" name="bcftools_plugintag2tag" version="1.0" profile="21.05">
    <description>Converts between similar tags, such as GL,PL,GP or QR,QA,QS or localized alleles, eg LPL,LAD.</description>

    <requirements>
        <container type="docker">biocontainers/bcftools/plugintag2tag:latest</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        bcftools/plugintag2tag
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**bcftools_plugintag2tag**

Converts between similar tags, such as GL,PL,GP or QR,QA,QS or localized alleles, eg LPL,LAD.

**nf-core Module Information:**

- Module: bcftools/plugintag2tag
- Container: biocontainers/bcftools/plugintag2tag:latest

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_bcftools/plugintag2tag,
            title = {nf-core bcftools/plugintag2tag module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/bcftools/plugintag2tag},
            year = {2024}
        }}</citation>
    </citations>
</tool>