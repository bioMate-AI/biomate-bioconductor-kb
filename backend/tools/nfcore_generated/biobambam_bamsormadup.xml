<tool id="nfcore_biobambam/bamsormadup" name="biobambam_bamsormadup" version="1.0" profile="21.05">
    <description>Parallel sorting and duplicate marking</description>

    <requirements>
        <container type="docker">biocontainers/biobambam:2.0.183--h9f5acd7_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        biobambam/bamsormadup
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**biobambam_bamsormadup**

Parallel sorting and duplicate marking

**nf-core Module Information:**

- Module: biobambam/bamsormadup
- Container: biocontainers/biobambam:2.0.183--h9f5acd7_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_biobambam/bamsormadup,
            title = {nf-core biobambam/bamsormadup module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/biobambam/bamsormadup},
            year = {2024}
        }}</citation>
    </citations>
</tool>