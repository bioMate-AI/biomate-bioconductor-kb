<?xml version='1.0' encoding='UTF-8'?>
<tool id="nfcore_biscuit/epiread" name="biscuit_epiread" version="1.0" profile="21.05">
    <description>Summarizes read-level methylation (and optionally SNV) information from a
Biscuit BAM file in a standard-compliant BED format.
</description>

    <requirements>
        <container type="docker">biocontainers/biscuit:1.5.0.20240506</container>
    </requirements>

    <command detect_errors="exit_code">
        biscuit/epiread
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    </command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File" help="Input data file for processing" />
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads" help="Number of CPU threads to use" />
        <param name="advanced_options" type="text" value="" label="Advanced Options" help="Additional command-line options (advanced users)" />
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*" label="${tool.name} on ${on_string}: Output" />
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt" />
                </assert_contents>
            </output>
        </test>
    </tests>

    <help>
**biscuit_epiread**

Summarizes read-level methylation (and optionally SNV) information from a
Biscuit BAM file in a standard-compliant BED format.


**nf-core Module Information:**

- Module: biscuit/epiread
- Container: biocontainers/biscuit:1.5.0.20240506

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    </help>

    <citations>
        <citation type="bibtex">@misc{nfcore_biscuit/epiread,
            title = {nf-core biscuit/epiread module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/biscuit/epiread},
            year = {2024}
        }}</citation>
    </citations>
</tool>