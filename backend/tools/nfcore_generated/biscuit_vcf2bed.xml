<tool id="nfcore_biscuit/vcf2bed" name="biscuit_vcf2bed" version="1.0" profile="21.05">
    <description>Summarizes methylation or SNV information from a Biscuit VCF in a
standard-compliant BED file.
</description>

    <requirements>
        <container type="docker">biocontainers/biscuit/vcf2bed:latest</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        biscuit/vcf2bed
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**biscuit_vcf2bed**

Summarizes methylation or SNV information from a Biscuit VCF in a
standard-compliant BED file.


**nf-core Module Information:**

- Module: biscuit/vcf2bed
- Container: biocontainers/biscuit/vcf2bed:latest

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_biscuit/vcf2bed,
            title = {nf-core biscuit/vcf2bed module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/biscuit/vcf2bed},
            year = {2024}
        }}</citation>
    </citations>
</tool>