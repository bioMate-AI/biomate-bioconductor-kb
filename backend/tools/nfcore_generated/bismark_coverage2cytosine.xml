<tool id="nfcore_bismark/coverage2cytosine" name="bismark_coverage2cytosine" version="1.0" profile="21.05">
    <description>Relates methylation calls back to genomic cytosine contexts.</description>

    <requirements>
        <container type="docker">biocontainers/bismark/coverage2cytosine:latest</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        bismark/coverage2cytosine
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**bismark_coverage2cytosine**

Relates methylation calls back to genomic cytosine contexts.

**nf-core Module Information:**

- Module: bismark/coverage2cytosine
- Container: biocontainers/bismark/coverage2cytosine:latest

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_bismark/coverage2cytosine,
            title = {nf-core bismark/coverage2cytosine module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/bismark/coverage2cytosine},
            year = {2024}
        }}</citation>
    </citations>
</tool>