<?xml version='1.0' encoding='UTF-8'?>
<tool id="nfcore_blast/blastp" name="blast_blastp" version="1.0" profile="21.05">
    <description>BLASTP (Basic Local Alignment Search Tool- Protein) compares an amino acid (protein) query sequence against a protein database</description>

    <requirements>
        <container type="docker">biocontainers/blast:2.17.0</container>
    </requirements>

    <command detect_errors="exit_code">
        blast/blastp
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    </command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File" help="Input data file for processing" />
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads" help="Number of CPU threads to use" />
        <param name="advanced_options" type="text" value="" label="Advanced Options" help="Additional command-line options (advanced users)" />
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*" label="${tool.name} on ${on_string}: Output" />
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt" />
                </assert_contents>
            </output>
        </test>
    </tests>

    <help>
**blast_blastp**

BLASTP (Basic Local Alignment Search Tool- Protein) compares an amino acid (protein) query sequence against a protein database

**nf-core Module Information:**

- Module: blast/blastp
- Container: biocontainers/blast:2.17.0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    </help>

    <citations>
        <citation type="bibtex">@misc{nfcore_blast/blastp,
            title = {nf-core blast/blastp module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/blast/blastp},
            year = {2024}
        }}</citation>
    </citations>
</tool>