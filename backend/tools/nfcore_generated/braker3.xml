<tool id="nfcore_braker3" name="braker3" version="1.0" profile="21.05">
    <description>Gene prediction in novel genomes using RNA-seq and protein homology information
</description>

    <requirements>
        <container type="docker">biocontainers/braker3:latest</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        braker3
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**braker3**

Gene prediction in novel genomes using RNA-seq and protein homology information


**nf-core Module Information:**

- Module: braker3
- Container: biocontainers/braker3:latest

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_braker3,
            title = {nf-core braker3 module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/braker3},
            year = {2024}
        }}</citation>
    </citations>
</tool>