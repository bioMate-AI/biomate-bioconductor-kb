<tool id="nfcore_bwameme/mem" name="bwameme_mem" version="1.0" profile="21.05">
    <description>Performs fastq alignment to a fasta reference using BWA-MEME</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-ed29b84fa94419f5a7bf6a841ddbcb964768825b:139b5e403886ad278b9ad139174967441c1c6ff3-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        bwameme/mem
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**bwameme_mem**

Performs fastq alignment to a fasta reference using BWA-MEME

**nf-core Module Information:**

- Module: bwameme/mem
- Container: biocontainers/mulled-v2-ed29b84fa94419f5a7bf6a841ddbcb964768825b:139b5e403886ad278b9ad139174967441c1c6ff3-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_bwameme/mem,
            title = {nf-core bwameme/mem module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/bwameme/mem},
            year = {2024}
        }}</citation>
    </citations>
</tool>