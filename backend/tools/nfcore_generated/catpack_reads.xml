<tool id="nfcore_catpack/reads" name="catpack_reads" version="1.0" profile="21.05">
    <description>Taxonomic classification plus read-based abundance estimation from long DNA sequences and metagenome assembled genomes (e.g. contigs, MAGs / bins).</description>

    <requirements>
        <container type="docker">biocontainers/cat:6.0.1--hdfd78af_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        catpack/reads
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**catpack_reads**

Taxonomic classification plus read-based abundance estimation from long DNA sequences and metagenome assembled genomes (e.g. contigs, MAGs / bins).

**nf-core Module Information:**

- Module: catpack/reads
- Container: biocontainers/cat:6.0.1--hdfd78af_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_catpack/reads,
            title = {nf-core catpack/reads module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/catpack/reads},
            year = {2024}
        }}</citation>
    </citations>
</tool>