<tool id="nfcore_cellrangerarc/mkfastq" name="cellrangerarc_mkfastq" version="1.0" profile="21.05">
    <description>Module to create fastqs needed by the 10x Genomics Cell Ranger Arc tool. Uses the cellranger-arc mkfastq command.</description>

    <requirements>
        <container type="docker">nf-core/cellranger-arc-mkfastq:2.0.2</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        cellrangerarc/mkfastq
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**cellrangerarc_mkfastq**

Module to create fastqs needed by the 10x Genomics Cell Ranger Arc tool. Uses the cellranger-arc mkfastq command.

**nf-core Module Information:**

- Module: cellrangerarc/mkfastq
- Container: nf-core/cellranger-arc-mkfastq:2.0.2

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_cellrangerarc/mkfastq,
            title = {nf-core cellrangerarc/mkfastq module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/cellrangerarc/mkfastq},
            year = {2024}
        }}</citation>
    </citations>
</tool>