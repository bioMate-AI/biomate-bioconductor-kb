<tool id="nfcore_chromap/chromap" name="chromap_chromap" version="1.0" profile="21.05">
    <description>Performs preprocessing and alignment of chromatin fastq files to
fasta reference files using chromap.
</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-1f09f39f20b1c4ee36581dc81cc323c70e661633:6500f0fa0c9536821177168555632d9811670937-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        chromap/chromap
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**chromap_chromap**

Performs preprocessing and alignment of chromatin fastq files to
fasta reference files using chromap.


**nf-core Module Information:**

- Module: chromap/chromap
- Container: biocontainers/mulled-v2-1f09f39f20b1c4ee36581dc81cc323c70e661633:6500f0fa0c9536821177168555632d9811670937-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_chromap/chromap,
            title = {nf-core chromap/chromap module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/chromap/chromap},
            year = {2024}
        }}</citation>
    </citations>
</tool>