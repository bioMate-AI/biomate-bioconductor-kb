<tool id="nfcore_circexplorer2/parse" name="circexplorer2_parse" version="1.0" profile="21.05">
    <description>CIRCexplorer2 parses fusion junction files from multiple aligners to prepare them for CIRCexplorer2 annotate.</description>

    <requirements>
        <container type="docker">biocontainers/circexplorer2:2.3.8--pyh864c0ab_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        circexplorer2/parse
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**circexplorer2_parse**

CIRCexplorer2 parses fusion junction files from multiple aligners to prepare them for CIRCexplorer2 annotate.

**nf-core Module Information:**

- Module: circexplorer2/parse
- Container: biocontainers/circexplorer2:2.3.8--pyh864c0ab_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_circexplorer2/parse,
            title = {nf-core circexplorer2/parse module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/circexplorer2/parse},
            year = {2024}
        }}</citation>
    </citations>
</tool>