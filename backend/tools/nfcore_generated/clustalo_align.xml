<tool id="nfcore_clustalo/align" name="clustalo_align" version="1.0" profile="21.05">
    <description>Align sequences using Clustal Omega</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-4cefc38542f86c17596c29b35a059de10387c6a7:adbe4fbad680f9beb083956d79128039a727e7b3-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        clustalo/align
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**clustalo_align**

Align sequences using Clustal Omega

**nf-core Module Information:**

- Module: clustalo/align
- Container: biocontainers/mulled-v2-4cefc38542f86c17596c29b35a059de10387c6a7:adbe4fbad680f9beb083956d79128039a727e7b3-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_clustalo/align,
            title = {nf-core clustalo/align module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/clustalo/align},
            year = {2024}
        }}</citation>
    </citations>
</tool>