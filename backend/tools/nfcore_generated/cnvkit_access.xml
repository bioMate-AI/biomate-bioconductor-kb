<tool id="nfcore_cnvkit/access" name="cnvkit_access" version="1.0" profile="21.05">
    <description>Calculate the sequence-accessible coordinates in chromosomes from the given reference genome, output as a BED file.</description>

    <requirements>
        <container type="docker">biocontainers/cnvkit:0.9.12--pyhdfd78af_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        cnvkit/access
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**cnvkit_access**

Calculate the sequence-accessible coordinates in chromosomes from the given reference genome, output as a BED file.

**nf-core Module Information:**

- Module: cnvkit/access
- Container: biocontainers/cnvkit:0.9.12--pyhdfd78af_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_cnvkit/access,
            title = {nf-core cnvkit/access module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/cnvkit/access},
            year = {2024}
        }}</citation>
    </citations>
</tool>