<tool id="nfcore_custom/tx2gene" name="custom_tx2gene" version="1.0" profile="21.05">
    <description>Make a transcript/gene mapping from a GTF and cross-reference with transcript quantifications.</description>

    <requirements>
        <container type="docker">biocontainers/python:3.10.4</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        custom/tx2gene
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**custom_tx2gene**

Make a transcript/gene mapping from a GTF and cross-reference with transcript quantifications.

**nf-core Module Information:**

- Module: custom/tx2gene
- Container: biocontainers/python:3.10.4

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_custom/tx2gene,
            title = {nf-core custom/tx2gene module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/custom/tx2gene},
            year = {2024}
        }}</citation>
    </citations>
</tool>