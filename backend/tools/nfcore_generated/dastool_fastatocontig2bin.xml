<tool id="nfcore_dastool/fastatocontig2bin" name="dastool_fastatocontig2bin" version="1.0" profile="21.05">
    <description>Helper script to convert a set of bins in fasta format to tabular scaffolds2bin format</description>

    <requirements>
        <container type="docker">biocontainers/das_tool:1.1.7--r44hdfd78af_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        dastool/fastatocontig2bin
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**dastool_fastatocontig2bin**

Helper script to convert a set of bins in fasta format to tabular scaffolds2bin format

**nf-core Module Information:**

- Module: dastool/fastatocontig2bin
- Container: biocontainers/das_tool:1.1.7--r44hdfd78af_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

