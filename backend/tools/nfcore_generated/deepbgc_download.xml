<tool id="nfcore_deepbgc/download" name="deepbgc_download" version="1.0" profile="21.05">
    <description>Database download module for DeepBGC which detects BGCs in bacterial and fungal genomes using deep learning.</description>

    <requirements>
        <container type="docker">biocontainers/deepbgc:0.1.31--pyhca03a8a_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        deepbgc/download
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**deepbgc_download**

Database download module for DeepBGC which detects BGCs in bacterial and fungal genomes using deep learning.

**nf-core Module Information:**

- Module: deepbgc/download
- Container: biocontainers/deepbgc:0.1.31--pyhca03a8a_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_deepbgc/download,
            title = {nf-core deepbgc/download module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/deepbgc/download},
            year = {2024}
        }}</citation>
    </citations>
</tool>