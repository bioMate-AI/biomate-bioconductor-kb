<tool id="nfcore_deeptools/alignmentsieve" name="deeptools_alignmentSieve" version="1.0" profile="21.05">
    <description>This tool filters alignments in a BAM/CRAM file according the the specified parameters.</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-eb9e7907c7a753917c1e4d7a64384c047429618a:41defd13a6f2ce014549fcc05d0b051f655777f9-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        deeptools/alignmentsieve
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**deeptools_alignmentSieve**

This tool filters alignments in a BAM/CRAM file according the the specified parameters.

**nf-core Module Information:**

- Module: deeptools/alignmentsieve
- Container: biocontainers/mulled-v2-eb9e7907c7a753917c1e4d7a64384c047429618a:41defd13a6f2ce014549fcc05d0b051f655777f9-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_deeptools/alignmentsieve,
            title = {nf-core deeptools/alignmentsieve module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/deeptools/alignmentsieve},
            year = {2024}
        }}</citation>
    </citations>
</tool>