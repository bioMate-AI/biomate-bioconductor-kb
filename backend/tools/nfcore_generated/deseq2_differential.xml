<tool id="nfcore_deseq2/differential" name="deseq2_differential" version="1.0" profile="21.05">
    <description>runs a differential expression analysis with DESeq2</description>

    <requirements>
        <container type="docker">biocontainers/bioconductor-deseq2:1.34.0--r41hc247a5b_3</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        deseq2/differential
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**deseq2_differential**

runs a differential expression analysis with DESeq2

**nf-core Module Information:**

- Module: deseq2/differential
- Container: biocontainers/bioconductor-deseq2:1.34.0--r41hc247a5b_3

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_deseq2/differential,
            title = {nf-core deseq2/differential module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/deseq2/differential},
            year = {2024}
        }}</citation>
    </citations>
</tool>