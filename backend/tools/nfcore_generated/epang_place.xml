<tool id="nfcore_epang/place" name="epang_place" version="1.0" profile="21.05">
    <description>phylogenetic placement of query sequences in a reference tree</description>

    <requirements>
        <container type="docker">biocontainers/epa-ng:0.3.8--h9a82719_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        epang/place
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**epang_place**

phylogenetic placement of query sequences in a reference tree

**nf-core Module Information:**

- Module: epang/place
- Container: biocontainers/epa-ng:0.3.8--h9a82719_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_epang/place,
            title = {nf-core epang/place module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/epang/place},
            year = {2024}
        }}</citation>
    </citations>
</tool>