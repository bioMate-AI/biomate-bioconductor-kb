<tool id="nfcore_fastavalidator" name="fastavalidator" version="1.0" profile="21.05">
    <description>"Python C-extension for a simple validator for fasta files. The module emits the validated file or an
error log upon validation failure."
</description>

    <requirements>
        <container type="docker">biocontainers/py_fasta_validator:0.6--py37h595c7a6_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        fastavalidator
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**fastavalidator**

"Python C-extension for a simple validator for fasta files. The module emits the validated file or an
error log upon validation failure."


**nf-core Module Information:**

- Module: fastavalidator
- Container: biocontainers/py_fasta_validator:0.6--py37h595c7a6_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_fastavalidator,
            title = {nf-core fastavalidator module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/fastavalidator},
            year = {2024}
        }}</citation>
    </citations>
</tool>