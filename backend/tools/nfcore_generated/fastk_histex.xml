<tool id="nfcore_fastk/histex" name="fastk_histex" version="1.0" profile="21.05">
    <description>A fast K-mer counter for high-fidelity shotgun datasets</description>

    <requirements>
        <container type="docker">biocontainers/fastk/histex:latest</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        fastk/histex
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**fastk_histex**

A fast K-mer counter for high-fidelity shotgun datasets

**nf-core Module Information:**

- Module: fastk/histex
- Container: biocontainers/fastk/histex:latest

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_fastk/histex,
            title = {nf-core fastk/histex module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/fastk/histex},
            year = {2024}
        }}</citation>
    </citations>
</tool>