<tool id="nfcore_fastx/collapser" name="fastx_collapser" version="1.0" profile="21.05">
    <description>Collapses identical sequences in a FASTQ/A file into a single sequence (while maintaining reads counts)</description>

    <requirements>
        <container type="docker">biocontainers/fastx_toolkit:0.0.14--hdbdd923_11</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        fastx/collapser
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**fastx_collapser**

Collapses identical sequences in a FASTQ/A file into a single sequence (while maintaining reads counts)

**nf-core Module Information:**

- Module: fastx/collapser
- Container: biocontainers/fastx_toolkit:0.0.14--hdbdd923_11

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_fastx/collapser,
            title = {nf-core fastx/collapser module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/fastx/collapser},
            year = {2024}
        }}</citation>
    </citations>
</tool>