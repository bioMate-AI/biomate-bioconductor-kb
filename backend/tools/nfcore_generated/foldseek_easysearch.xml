<tool id="nfcore_foldseek/easysearch" name="foldseek_easysearch" version="1.0" profile="21.05">
    <description>Search for protein structural hits against a foldseek database of protein structures</description>

    <requirements>
        <container type="docker">biocontainers/foldseek:9.427df8a--pl5321hb365157_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        foldseek/easysearch
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**foldseek_easysearch**

Search for protein structural hits against a foldseek database of protein structures

**nf-core Module Information:**

- Module: foldseek/easysearch
- Container: biocontainers/foldseek:9.427df8a--pl5321hb365157_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_foldseek/easysearch,
            title = {nf-core foldseek/easysearch module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/foldseek/easysearch},
            year = {2024}
        }}</citation>
    </citations>
</tool>