<tool id="nfcore_gatk/unifiedgenotyper" name="gatk_unifiedgenotyper" version="1.0" profile="21.05">
    <description>SNP and Indel variant caller on a per-locus basis</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-5e3fd88c6b8af48bb5982d5721ca5e36da94029b:c496eeb8cc9067e0720d35121dbff7732a7ebdb0-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        gatk/unifiedgenotyper
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**gatk_unifiedgenotyper**

SNP and Indel variant caller on a per-locus basis

**nf-core Module Information:**

- Module: gatk/unifiedgenotyper
- Container: biocontainers/mulled-v2-5e3fd88c6b8af48bb5982d5721ca5e36da94029b:c496eeb8cc9067e0720d35121dbff7732a7ebdb0-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_gatk/unifiedgenotyper,
            title = {nf-core gatk/unifiedgenotyper module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/gatk/unifiedgenotyper},
            year = {2024}
        }}</citation>
    </citations>
</tool>