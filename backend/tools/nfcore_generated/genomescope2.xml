<tool id="nfcore_genomescope2" name="genomescope2" version="1.0" profile="21.05">
    <description>Estimate genome heterozygosity, repeat content, and size from sequencing reads using a kmer-based statistical approach</description>

    <requirements>
        <container type="docker">biocontainers/genomescope2:2.0--py311r42hdfd78af_6</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        genomescope2
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**genomescope2**

Estimate genome heterozygosity, repeat content, and size from sequencing reads using a kmer-based statistical approach

**nf-core Module Information:**

- Module: genomescope2
- Container: biocontainers/genomescope2:2.0--py311r42hdfd78af_6

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_genomescope2,
            title = {nf-core genomescope2 module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/genomescope2},
            year = {2024}
        }}</citation>
    </citations>
</tool>