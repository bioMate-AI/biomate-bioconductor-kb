<tool id="nfcore_glimpse/concordance" name="glimpse_concordance" version="1.0" profile="21.05">
    <description>Compute the r2 correlation between imputed dosages (in MAF bins) and highly-confident genotype calls from the high-coverage dataset.</description>

    <requirements>
        <container type="docker">biocontainers/glimpse-bio:1.1.1--h0303221_3</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        glimpse/concordance
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**glimpse_concordance**

Compute the r2 correlation between imputed dosages (in MAF bins) and highly-confident genotype calls from the high-coverage dataset.

**nf-core Module Information:**

- Module: glimpse/concordance
- Container: biocontainers/glimpse-bio:1.1.1--h0303221_3

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_glimpse/concordance,
            title = {nf-core glimpse/concordance module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/glimpse/concordance},
            year = {2024}
        }}</citation>
    </citations>
</tool>