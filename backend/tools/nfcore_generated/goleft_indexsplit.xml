<tool id="nfcore_goleft/indexsplit" name="goleft_indexsplit" version="1.0" profile="21.05">
    <description>Quickly generate evenly sized (by amount of data) regions across a number of bam/cram files</description>

    <requirements>
        <container type="docker">biocontainers/goleft:0.2.4--h9ee0642_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        goleft/indexsplit
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**goleft_indexsplit**

Quickly generate evenly sized (by amount of data) regions across a number of bam/cram files

**nf-core Module Information:**

- Module: goleft/indexsplit
- Container: biocontainers/goleft:0.2.4--h9ee0642_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_goleft/indexsplit,
            title = {nf-core goleft/indexsplit module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/goleft/indexsplit},
            year = {2024}
        }}</citation>
    </citations>
</tool>