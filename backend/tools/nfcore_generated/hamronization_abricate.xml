<tool id="nfcore_hamronization/abricate" name="hamronization_abricate" version="1.0" profile="21.05">
    <description>Tool to convert and summarize ABRicate outputs using the hAMRonization specification</description>

    <requirements>
        <container type="docker">biocontainers/hamronization:1.1.9--pyhdfd78af_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        hamronization/abricate
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**hamronization_abricate**

Tool to convert and summarize ABRicate outputs using the hAMRonization specification

**nf-core Module Information:**

- Module: hamronization/abricate
- Container: biocontainers/hamronization:1.1.9--pyhdfd78af_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_hamronization/abricate,
            title = {nf-core hamronization/abricate module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/hamronization/abricate},
            year = {2024}
        }}</citation>
    </citations>
</tool>