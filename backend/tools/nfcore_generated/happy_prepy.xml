<tool id="nfcore_happy/prepy" name="happy_prepy" version="1.0" profile="21.05">
    <description>Pre.py is a preprocessing tool made to preprocess VCF files for Hap.py</description>

    <requirements>
        <container type="docker">biocontainers/hap.py:0.3.14--py27h5c5a3ab_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        happy/prepy
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**happy_prepy**

Pre.py is a preprocessing tool made to preprocess VCF files for Hap.py

**nf-core Module Information:**

- Module: happy/prepy
- Container: biocontainers/hap.py:0.3.14--py27h5c5a3ab_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_happy/prepy,
            title = {nf-core happy/prepy module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/happy/prepy},
            year = {2024}
        }}</citation>
    </citations>
</tool>