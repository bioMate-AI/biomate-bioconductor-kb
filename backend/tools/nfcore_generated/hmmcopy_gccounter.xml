<tool id="nfcore_hmmcopy/gccounter" name="hmmcopy_gccounter" version="1.0" profile="21.05">
    <description>gcCounter function from HMMcopy utilities, used to generate GC content in non-overlapping windows from a fasta reference</description>

    <requirements>
        <container type="docker">biocontainers/hmmcopy:0.1.1--h2e03b76_7</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        hmmcopy/gccounter
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**hmmcopy_gccounter**

gcCounter function from HMMcopy utilities, used to generate GC content in non-overlapping windows from a fasta reference

**nf-core Module Information:**

- Module: hmmcopy/gccounter
- Container: biocontainers/hmmcopy:0.1.1--h2e03b76_7

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_hmmcopy/gccounter,
            title = {nf-core hmmcopy/gccounter module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/hmmcopy/gccounter},
            year = {2024}
        }}</citation>
    </citations>
</tool>