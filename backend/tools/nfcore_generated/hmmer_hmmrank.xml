<tool id="nfcore_hmmer/hmmrank" name="hmmer_hmmrank" version="1.0" profile="21.05">
    <description>R script that scores output from multiple runs of hmmer/hmmsearch</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-b2ec1fea5791d428eebb8c8ea7409c350d31dada:a447f6b7a6afde38352b24c30ae9cd6e39df95c4-1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        hmmer/hmmrank
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**hmmer_hmmrank**

R script that scores output from multiple runs of hmmer/hmmsearch

**nf-core Module Information:**

- Module: hmmer/hmmrank
- Container: biocontainers/mulled-v2-b2ec1fea5791d428eebb8c8ea7409c350d31dada:a447f6b7a6afde38352b24c30ae9cd6e39df95c4-1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_hmmer/hmmrank,
            title = {nf-core hmmer/hmmrank module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/hmmer/hmmrank},
            year = {2024}
        }}</citation>
    </citations>
</tool>