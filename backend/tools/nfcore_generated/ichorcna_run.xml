<tool id="nfcore_ichorcna/run" name="ichorcna_run" version="1.0" profile="21.05">
    <description>ichorCNA is an R package for calculating copy number alteration from (low-pass) whole genome sequencing, particularly for use in cell-free DNA</description>

    <requirements>
        <container type="docker">biocontainers/r-ichorcna:0.5.1--r43hdfd78af_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        ichorcna/run
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**ichorcna_run**

ichorCNA is an R package for calculating copy number alteration from (low-pass) whole genome sequencing, particularly for use in cell-free DNA

**nf-core Module Information:**

- Module: ichorcna/run
- Container: biocontainers/r-ichorcna:0.5.1--r43hdfd78af_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_ichorcna/run,
            title = {nf-core ichorcna/run module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/ichorcna/run},
            year = {2024}
        }}</citation>
    </citations>
</tool>