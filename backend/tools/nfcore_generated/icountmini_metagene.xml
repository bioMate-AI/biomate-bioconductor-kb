<tool id="nfcore_icountmini/metagene" name="icountmini_metagene" version="1.0" profile="21.05">
    <description>Plot a metagene of cross-link events/sites around various transcriptomic landmarks.</description>

    <requirements>
        <container type="docker">biocontainers/icount-mini:3.0.1--pyh7cba7a3_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        icountmini/metagene
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**icountmini_metagene**

Plot a metagene of cross-link events/sites around various transcriptomic landmarks.

**nf-core Module Information:**

- Module: icountmini/metagene
- Container: biocontainers/icount-mini:3.0.1--pyh7cba7a3_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

