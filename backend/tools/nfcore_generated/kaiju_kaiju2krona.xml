<tool id="nfcore_kaiju/kaiju2krona" name="kaiju_kaiju2krona" version="1.0" profile="21.05">
    <description>Convert Kaiju's tab-separated output file into a tab-separated text file which can be imported into Krona.</description>

    <requirements>
        <container type="docker">biocontainers/kaiju:1.10.0--h43eeafb_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        kaiju/kaiju2krona
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**kaiju_kaiju2krona**

Convert Kaiju's tab-separated output file into a tab-separated text file which can be imported into Krona.

**nf-core Module Information:**

- Module: kaiju/kaiju2krona
- Container: biocontainers/kaiju:1.10.0--h43eeafb_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

