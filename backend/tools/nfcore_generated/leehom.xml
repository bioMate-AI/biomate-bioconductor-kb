<?xml version="1.0" ?>
<tool id="nfcore_leehom" name="nf-core leehom" version="1.0.0" profile="20.01">
  <description>Bayesian reconstruction of ancient DNA fragments</description>
  <requirements>
    <requirement type="package" version="1.2.15">leehom</requirement>
    <container type="docker">${ workflow.containerEngine == </container>
  </requirements>
  <command detect_errors="exit_code">&lt;![CDATA[
leeHom \\
            ${args} \\
            -t ${task.cpus} \\
            -o ${prefix}.bam \\
            --log ${prefix}.log \\
            ${reads}

        cat &lt;&lt;-END_VERSIONS &gt; versions.yml
        &quot;${task.process}&quot;:
            leehom: ${VERSION}
        END_VERSIONS
]]&gt;</command>
  <inputs>
    <param type="data" name="reads" format="fastq,fastqsanger,fastqsanger.gz" label="Input reads"/>
  </inputs>
  <outputs>
    <data name="bam" format="bam" label="Bam" from_work_dir="${prefix}.bam"/>
    <data name="fq_pass" format="data" label="Fq Pass" from_work_dir="${prefix}.fq.gz"/>
    <data name="fq_fail" format="data" label="Fq Fail" from_work_dir="${prefix}.fail.fq.gz"/>
    <data name="unmerged_r1_fq_pass" format="data" label="Unmerged R1 Fq Pass" from_work_dir="${prefix}_r1.fq.gz"/>
    <data name="unmerged_r1_fq_fail" format="data" label="Unmerged R1 Fq Fail" from_work_dir="${prefix}_r1.fail.fq.gz"/>
    <data name="unmerged_r2_fq_pass" format="data" label="Unmerged R2 Fq Pass" from_work_dir="${prefix}_r2.fq.gz"/>
    <data name="unmerged_r2_fq_fail" format="data" label="Unmerged R2 Fq Fail" from_work_dir="${prefix}_r2.fail.fq.gz"/>
    <data name="log" format="txt" label="Log" from_work_dir="*.log"/>
    <data name="versions" format="yaml" label="Versions" from_work_dir="versions.yml"/>
  </outputs>
  <help>&lt;![CDATA[
**What it does**

Bayesian reconstruction of ancient DNA fragments

**nf-core Module**

This tool is automatically generated from nf-core modules repository.

Module: leehom
Container: ${ workflow.containerEngine == 

**More Information**

For more information about this tool, visit:
https://github.com/nf-core/modules/tree/master/modules/nf-core/leehom
]]&gt;</help>
</tool>
