<tool id="nfcore_macs3/callpeak" name="macs3_callpeak" version="1.0" profile="21.05">
    <description>Peak calling of enriched genomic regions of ChIP-seq and ATAC-seq experiments</description>

    <requirements>
        <container type="docker">biocontainers/macs3:3.0.1--py311h0152c62_3</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        macs3/callpeak
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**macs3_callpeak**

Peak calling of enriched genomic regions of ChIP-seq and ATAC-seq experiments

**nf-core Module Information:**

- Module: macs3/callpeak
- Container: biocontainers/macs3:3.0.1--py311h0152c62_3

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_macs3/callpeak,
            title = {nf-core macs3/callpeak module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/macs3/callpeak},
            year = {2024}
        }}</citation>
    </citations>
</tool>