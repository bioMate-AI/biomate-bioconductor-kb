<tool id="nfcore_mageck/test" name="mageck_test" version="1.0" profile="21.05">
    <description>Mageck test performs a robust ranking aggregation (RRA) to identify positively or negatively selected genes in functional genomics screens.</description>

    <requirements>
        <container type="docker">biocontainers/mageck:0.5.9.5--py39h1f90b4d_3</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        mageck/test
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**mageck_test**

Mageck test performs a robust ranking aggregation (RRA) to identify positively or negatively selected genes in functional genomics screens.

**nf-core Module Information:**

- Module: mageck/test
- Container: biocontainers/mageck:0.5.9.5--py39h1f90b4d_3

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_mageck/test,
            title = {nf-core mageck/test module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/mageck/test},
            year = {2024}
        }}</citation>
    </citations>
</tool>