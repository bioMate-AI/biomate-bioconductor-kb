<tool id="nfcore_magus/align" name="magus_align" version="1.0" profile="21.05">
    <description>Multiple Sequence Alignment using Graph Clustering</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-ae4ea1182e75371808710b6c081bef8b228c4815:10b41722a6b9471a0945fe6baeb9aff444d8eb1d-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        magus/align
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**magus_align**

Multiple Sequence Alignment using Graph Clustering

**nf-core Module Information:**

- Module: magus/align
- Container: biocontainers/mulled-v2-ae4ea1182e75371808710b6c081bef8b228c4815:10b41722a6b9471a0945fe6baeb9aff444d8eb1d-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_magus/align,
            title = {nf-core magus/align module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/magus/align},
            year = {2024}
        }}</citation>
    </citations>
</tool>