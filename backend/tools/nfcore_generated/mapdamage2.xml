<?xml version="1.0" ?>
<tool id="nfcore_mapdamage2" name="nf-core mapdamage2" version="1.0.0" profile="20.01">
  <description>Computational framework for tracking and quantifying DNA damage patterns among ancient DNA sequencing reads generated by Next-Generation Sequencing platforms.</description>
  <requirements>
    <requirement type="package" version="2.2.1">mapdamage2</requirement>
    <container type="docker">${ workflow.containerEngine == </container>
  </requirements>
  <command detect_errors="exit_code">&lt;![CDATA[
mapDamage \\
            $args \\
            -i $bam \\
            -r $fasta

    cat &lt;&lt;-END_VERSIONS &gt; versions.yml
    &quot;${task.process}&quot;:
        mapdamage2: \$(echo \$(mapDamage --version))
    END_VERSIONS
]]&gt;</command>
  <inputs>
    <param type="data" name="bam" format="data" label="Bam"/>
    <param type="data" name="fasta" format="data" label="Fasta"/>
  </inputs>
  <outputs>
    <data name="runtime_log" format="txt" label="Runtime Log" from_work_dir="results_*/Runtime_log.txt"/>
    <data name="fragmisincorporation_plot" format="data" label="Fragmisincorporation Plot" from_work_dir="results_*/Fragmisincorporation_plot.pdf"/>
    <data name="length_plot" format="data" label="Length Plot" from_work_dir="results_*/Length_plot.pdf"/>
    <data name="misincorporation" format="txt" label="Misincorporation" from_work_dir="results_*/misincorporation.txt"/>
    <data name="lgdistribution" format="txt" label="Lgdistribution" from_work_dir="results_*/lgdistribution.txt"/>
    <data name="dnacomp" format="txt" label="Dnacomp" from_work_dir="results_*/dnacomp.txt"/>
    <data name="stats_out_mcmc_hist" format="data" label="Stats Out Mcmc Hist" from_work_dir="results_*/Stats_out_MCMC_hist.pdf"/>
    <data name="stats_out_mcmc_iter" format="data" label="Stats Out Mcmc Iter" from_work_dir="results_*/Stats_out_MCMC_iter.csv"/>
    <data name="stats_out_mcmc_trace" format="data" label="Stats Out Mcmc Trace" from_work_dir="results_*/Stats_out_MCMC_trace.pdf"/>
    <data name="stats_out_mcmc_iter_summ_stat" format="data" label="Stats Out Mcmc Iter Summ Stat" from_work_dir="results_*/Stats_out_MCMC_iter_summ_stat.csv"/>
    <data name="stats_out_mcmc_post_pred" format="data" label="Stats Out Mcmc Post Pred" from_work_dir="results_*/Stats_out_MCMC_post_pred.pdf"/>
    <data name="stats_out_mcmc_correct_prob" format="data" label="Stats Out Mcmc Correct Prob" from_work_dir="results_*/Stats_out_MCMC_correct_prob.csv"/>
    <data name="dnacomp_genome" format="data" label="Dnacomp Genome" from_work_dir="results_*/dnacomp_genome.csv"/>
    <data name="rescaled" format="bam" label="Rescaled" from_work_dir="results_*/*rescaled.bam"/>
    <data name="pctot_freq" format="txt" label="Pctot Freq" from_work_dir="results_*/5pCtoT_freq.txt"/>
    <data name="pgtoa_freq" format="txt" label="Pgtoa Freq" from_work_dir="results_*/3pGtoA_freq.txt"/>
    <data name="fasta" format="data" label="Fasta" from_work_dir="results_*/*.fasta"/>
    <data name="folder" format="data" label="Folder" from_work_dir="*/"/>
    <data name="versions" format="yaml" label="Versions" from_work_dir="versions.yml"/>
  </outputs>
  <help>&lt;![CDATA[
**What it does**

