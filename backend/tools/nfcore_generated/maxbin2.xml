<tool id="nfcore_maxbin2" name="maxbin2" version="1.0" profile="21.05">
    <description>MaxBin is a software that is capable of clustering metagenomic contigs</description>

    <requirements>
        <container type="docker">biocontainers/maxbin2:2.2.7--he1b5a44_2</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        maxbin2
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**maxbin2**

MaxBin is a software that is capable of clustering metagenomic contigs

**nf-core Module Information:**

- Module: maxbin2
- Container: biocontainers/maxbin2:2.2.7--he1b5a44_2

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_maxbin2,
            title = {nf-core maxbin2 module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/maxbin2},
            year = {2024}
        }}</citation>
    </citations>
</tool>