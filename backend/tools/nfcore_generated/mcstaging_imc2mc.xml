<tool id="nfcore_mcstaging/imc2mc" name="mcstaging_imc2mc" version="1.0" profile="21.05">
    <description>Staging module for MCMICRO transforming Imaging Mass Cytometry .txt files to .tif files with OME-XML metadata. Includes optional hot pixel removal.</description>

    <requirements>
        <container type="docker">ghcr.io/schapirolabor/imc2mc:0.0.2</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        mcstaging/imc2mc
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**mcstaging_imc2mc**

Staging module for MCMICRO transforming Imaging Mass Cytometry .txt files to .tif files with OME-XML metadata. Includes optional hot pixel removal.

**nf-core Module Information:**

- Module: mcstaging/imc2mc
- Container: ghcr.io/schapirolabor/imc2mc:0.0.2

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_mcstaging/imc2mc,
            title = {nf-core mcstaging/imc2mc module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/mcstaging/imc2mc},
            year = {2024}
        }}</citation>
    </citations>
</tool>