<tool id="nfcore_mtmalign/align" name="mtmalign_align" version="1.0" profile="21.05">
    <description>Aligns protein structures using mTM-align</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-5bcf71dc66dac33d8e003c5e78043b80f5c7f269:8f0e486d46f7ab38892c1a8f78d2894a549d03b5-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        mtmalign/align
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**mtmalign_align**

Aligns protein structures using mTM-align

**nf-core Module Information:**

- Module: mtmalign/align
- Container: biocontainers/mulled-v2-5bcf71dc66dac33d8e003c5e78043b80f5c7f269:8f0e486d46f7ab38892c1a8f78d2894a549d03b5-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_mtmalign/align,
            title = {nf-core mtmalign/align module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/mtmalign/align},
            year = {2024}
        }}</citation>
    </citations>
</tool>