<tool id="nfcore_muse/call" name="muse_call" version="1.0" profile="21.05">
    <description>pre-filtering and calculating position-specific summary statistics using the Markov substitution model</description>

    <requirements>
        <container type="docker">biocontainers/muse/call:latest</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        muse/call
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**muse_call**

pre-filtering and calculating position-specific summary statistics using the Markov substitution model

**nf-core Module Information:**

- Module: muse/call
- Container: biocontainers/muse/call:latest

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_muse/call,
            title = {nf-core muse/call module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/muse/call},
            year = {2024}
        }}</citation>
    </citations>
</tool>