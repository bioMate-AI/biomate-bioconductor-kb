<tool id="nfcore_nail/search" name="nail_search" version="1.0" profile="21.05">
    <description>nail search is a fast and scalable tool for searching protein sequences against protein databases</description>

    <requirements>
        <container type="docker">biocontainers/nail:0.4.0--h4349ce8_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        nail/search
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**nail_search**

nail search is a fast and scalable tool for searching protein sequences against protein databases

**nf-core Module Information:**

- Module: nail/search
- Container: biocontainers/nail:0.4.0--h4349ce8_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_nail/search,
            title = {nf-core nail/search module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/nail/search},
            year = {2024}
        }}</citation>
    </citations>
</tool>