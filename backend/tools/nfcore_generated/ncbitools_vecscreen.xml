<tool id="nfcore_ncbitools/vecscreen" name="NCBITOOLS_VECSCREEN" version="1.0" profile="21.05">
    <description>NCBI tool for detecting vector contamination in nucleic acid sequences. This tool is older than NCBI's FCS-adaptor, which is for the same purpose</description>

    <requirements>
        <container type="docker">biocontainers/ncbitools/vecscreen:latest</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        ncbitools/vecscreen
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**NCBITOOLS_VECSCREEN**

NCBI tool for detecting vector contamination in nucleic acid sequences. This tool is older than NCBI's FCS-adaptor, which is for the same purpose

**nf-core Module Information:**

- Module: ncbitools/vecscreen
- Container: biocontainers/ncbitools/vecscreen:latest

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_ncbitools/vecscreen,
            title = {nf-core ncbitools/vecscreen module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/ncbitools/vecscreen},
            year = {2024}
        }}</citation>
    </citations>
</tool>