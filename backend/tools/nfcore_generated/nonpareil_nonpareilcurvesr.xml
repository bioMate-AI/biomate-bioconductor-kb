<tool id="nfcore_nonpareil/nonpareilcurvesr" name="nonpareil_nonpareilcurvesr" version="1.0" profile="21.05">
    <description>Generate summary reports with raw data for Nonpareil NPO curves, including MultiQC compatible JSON/TSV files</description>

    <requirements>
        <container type="docker">biocontainers/nonpareil:3.5.5--r43hdcf5f25_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        nonpareil/nonpareilcurvesr
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**nonpareil_nonpareilcurvesr**

Generate summary reports with raw data for Nonpareil NPO curves, including MultiQC compatible JSON/TSV files

**nf-core Module Information:**

- Module: nonpareil/nonpareilcurvesr
- Container: biocontainers/nonpareil:3.5.5--r43hdcf5f25_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_nonpareil/nonpareilcurvesr,
            title = {nf-core nonpareil/nonpareilcurvesr module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/nonpareil/nonpareilcurvesr},
            year = {2024}
        }}</citation>
    </citations>
</tool>