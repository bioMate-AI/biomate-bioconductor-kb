<tool id="nfcore_openmsthirdparty/cometadapter" name="openmsthirdparty_cometadapter" version="1.0" profile="21.05">
    <description>Annotates MS/MS spectra using Comet.</description>

    <requirements>
        <container type="docker">biocontainers/openms-thirdparty:3.4.0--h9ee0642_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        openmsthirdparty/cometadapter
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**openmsthirdparty_cometadapter**

Annotates MS/MS spectra using Comet.

**nf-core Module Information:**

- Module: openmsthirdparty/cometadapter
- Container: biocontainers/openms-thirdparty:3.4.0--h9ee0642_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_openmsthirdparty/cometadapter,
            title = {nf-core openmsthirdparty/cometadapter module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/openmsthirdparty/cometadapter},
            year = {2024}
        }}</citation>
    </citations>
</tool>