        <citation type="bibtex">@misc{nfcore_paftools/sam2paf,
            title = {nf-core paftools/sam2paf module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/paftools/sam2paf},
            year = {2024}
        }}</citation>
    </citations>
</tool>