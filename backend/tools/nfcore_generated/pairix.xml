<tool id="nfcore_pairix" name="pairix" version="1.0" profile="21.05">
    <description>a tool for indexing and querying on a block-compressed text file
containing pairs of genomic coordinates
</description>

    <requirements>
        <container type="docker">biocontainers/pairix:0.3.7--py36h30a8e3e_3</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        pairix
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**pairix**

a tool for indexing and querying on a block-compressed text file
containing pairs of genomic coordinates


**nf-core Module Information:**

- Module: pairix
- Container: biocontainers/pairix:0.3.7--py36h30a8e3e_3

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_pairix,
            title = {nf-core pairix module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/pairix},
            year = {2024}
        }}</citation>
    </citations>
</tool>