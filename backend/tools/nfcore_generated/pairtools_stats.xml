<tool id="nfcore_pairtools/stats" name="pairtools_stats" version="1.0" profile="21.05">
    <description>Calculate pairs statistics</description>

    <requirements>
        <container type="docker">biocontainers/pairtools:1.0.2--py39h2a9f597_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        pairtools/stats
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**pairtools_stats**

Calculate pairs statistics

**nf-core Module Information:**

- Module: pairtools/stats
- Container: biocontainers/pairtools:1.0.2--py39h2a9f597_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_pairtools/stats,
            title = {nf-core pairtools/stats module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/pairtools/stats},
            year = {2024}
        }}</citation>
    </citations>
</tool>