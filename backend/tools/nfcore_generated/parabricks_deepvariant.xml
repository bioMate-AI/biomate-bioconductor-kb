<tool id="nfcore_parabricks/deepvariant" name="parabricks_deepvariant" version="1.0" profile="21.05">
    <description>NVIDIA Clara Parabricks GPU-accelerated germline variant calling, replicating deepvariant.</description>

    <requirements>
        <container type="docker">nvcr.io/nvidia/clara/clara-parabricks:4.5.1-1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        parabricks/deepvariant
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**parabricks_deepvariant**

NVIDIA Clara Parabricks GPU-accelerated germline variant calling, replicating deepvariant.

**nf-core Module Information:**

- Module: parabricks/deepvariant
- Container: nvcr.io/nvidia/clara/clara-parabricks:4.5.1-1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_parabricks/deepvariant,
            title = {nf-core parabricks/deepvariant module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/parabricks/deepvariant},
            year = {2024}
        }}</citation>
    </citations>
</tool>