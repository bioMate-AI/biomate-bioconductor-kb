<tool id="nfcore_pear" name="pear" version="1.0" profile="21.05">
    <description>PEAR is an ultrafast, memory-efficient and highly accurate pair-end read merger.</description>

    <requirements>
        <container type="docker">biocontainers/pear:0.9.6--h67092d7_8</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        pear
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**pear**

PEAR is an ultrafast, memory-efficient and highly accurate pair-end read merger.

**nf-core Module Information:**

- Module: pear
- Container: biocontainers/pear:0.9.6--h67092d7_8

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_pear,
            title = {nf-core pear module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/pear},
            year = {2024}
        }}</citation>
    </citations>
</tool>