<tool id="nfcore_plink/extract" name="plink_extract" version="1.0" profile="21.05">
    <description>Subset plink bfiles with a text file of variant identifiers</description>

    <requirements>
        <container type="docker">biocontainers/plink:1.90b6.21--h779adbc_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        plink/extract
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**plink_extract**

Subset plink bfiles with a text file of variant identifiers

**nf-core Module Information:**

- Module: plink/extract
- Container: biocontainers/plink:1.90b6.21--h779adbc_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_plink/extract,
            title = {nf-core plink/extract module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/plink/extract},
            year = {2024}
        }}</citation>
    </citations>
</tool>