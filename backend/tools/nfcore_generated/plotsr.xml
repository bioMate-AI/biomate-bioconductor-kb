<?xml version="1.0" ?>
<tool id="nfcore_plotsr" name="nf-core plotsr" version="1.0.0" profile="20.01">
  <description>Plotsr generates high-quality visualisation of synteny and structural rearrangements between multiple genomes.</description>
  <requirements>
    <requirement type="package" version="1.1.1">plotsr</requirement>
    <container type="docker">${workflow.containerEngine == </container>
  </requirements>
  <command detect_errors="exit_code">&lt;![CDATA[
plotsr \\
        ${syri_arg} \\
        --genomes ${genomes} \\
        ${bedpe_arg} \\
        ${markers_arg} \\
        ${tracks_arg} \\
        ${chrord_arg} \\
        ${chrname_arg} \\
        ${args} \\
        -o ${prefix}.png

    cat &lt;&lt;-END_VERSIONS &gt; versions.yml
    &quot;${task.process}&quot;:
        plotsr: \$(plotsr --version)
    END_VERSIONS
]]&gt;</command>
  <inputs>
    <param type="data" name="syri" format="data" label="Syri"/>
    <param type="data" name="fastas" format="data" label="Fastas"/>
    <param type="data" name="genomes" format="data" label="Genomes"/>
    <param type="data" name="bedpe" format="data" label="Bedpe"/>
    <param type="data" name="markers" format="data" label="Markers"/>
    <param type="data" name="tracks" format="data" label="Tracks"/>
    <param type="data" name="chrord" format="data" label="Chrord"/>
    <param type="data" name="chrname" format="data" label="Chrname"/>
  </inputs>
  <outputs>
    <data name="png" format="data" label="Png" from_work_dir="*.png"/>
    <data name="versions" format="yaml" label="Versions" from_work_dir="versions.yml"/>
  </outputs>
  <help>&lt;![CDATA[
**What it does**

Plotsr generates high-quality visualisation of synteny and structural rearrangements between multiple genomes.

**nf-core Module**

This tool is automatically generated from nf-core modules repository.

Module: plotsr
Container: ${workflow.containerEngine == 

**More Information**

For more information about this tool, visit:
https://github.com/nf-core/modules/tree/master/modules/nf-core/plotsr
]]&gt;</help>
</tool>
