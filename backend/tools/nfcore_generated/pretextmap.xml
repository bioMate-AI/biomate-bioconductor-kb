<tool id="nfcore_pretextmap" name="pretextmap" version="1.0" profile="21.05">
    <description>converts sam/bam/cram/pairs into genome contact map</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-f3591ce8609c7b3b33e5715333200aa5c163aa61:44321ab4d64f0b6d0c93abbd1406369d1b3da684-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        pretextmap
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**pretextmap**

converts sam/bam/cram/pairs into genome contact map

**nf-core Module Information:**

- Module: pretextmap
- Container: biocontainers/mulled-v2-f3591ce8609c7b3b33e5715333200aa5c163aa61:44321ab4d64f0b6d0c93abbd1406369d1b3da684-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_pretextmap,
            title = {nf-core pretextmap module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/pretextmap},
            year = {2024}
        }}</citation>
    </citations>
</tool>