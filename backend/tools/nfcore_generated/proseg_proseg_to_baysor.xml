<tool id="nfcore_proseg/proseg_to_baysor" name="proseg_to_baysor" version="1.0" profile="21.05">
    <description>Convert proseg outputs to baysor format for import to Xenium explorer</description>

    <requirements>
        <container type="docker">biocontainers/proseg/proseg:latest</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        proseg/proseg
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**proseg_to_baysor**

Convert proseg outputs to baysor format for import to Xenium explorer

**nf-core Module Information:**

- Module: proseg/proseg_to_baysor
- Container: biocontainers/proseg/proseg:latest

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_proseg/proseg_to_baysor,
            title = {nf-core proseg/proseg_to_baysor module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/proseg/proseg/to/baysor},
            year = {2024}
        }}</citation>
    </citations>
</tool>