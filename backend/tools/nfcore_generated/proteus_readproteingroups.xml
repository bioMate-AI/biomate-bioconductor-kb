<tool id="nfcore_proteus/readproteingroups" name="proteus_readproteingroups" version="1.0" profile="21.05">
    <description>reads a maxQuant proteinGroups file with Proteus</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-503e259d7d34ce533ce66c4c8871af4ab409db6d:1e504ef71c83943061a39b6260d826b988bfa56f-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        proteus/readproteingroups
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**proteus_readproteingroups**

reads a maxQuant proteinGroups file with Proteus

**nf-core Module Information:**

- Module: proteus/readproteingroups
- Container: biocontainers/mulled-v2-503e259d7d34ce533ce66c4c8871af4ab409db6d:1e504ef71c83943061a39b6260d826b988bfa56f-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_proteus/readproteingroups,
            title = {nf-core proteus/readproteingroups module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/proteus/readproteingroups},
            year = {2024}
        }}</citation>
    </citations>
</tool>