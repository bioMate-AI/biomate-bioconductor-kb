<?xml version='1.0' encoding='UTF-8'?>
<tool id="nfcore_purecn/intervalfile" name="purecn_intervalfile" version="1.0" profile="21.05">
    <description>Generate on and off-target intervals for PureCN from a list of targets</description>

    <requirements>
        <container type="docker">biocontainers/bioconductor-dnacopy:1.80.0</container>
    </requirements>

    <command detect_errors="exit_code">
        purecn/intervalfile
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    </command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File" help="Input data file for processing" />
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads" help="Number of CPU threads to use" />
        <param name="advanced_options" type="text" value="" label="Advanced Options" help="Additional command-line options (advanced users)" />
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*" label="${tool.name} on ${on_string}: Output" />
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt" />
                </assert_contents>
            </output>
        </test>
    </tests>

    <help>
**purecn_intervalfile**

Generate on and off-target intervals for PureCN from a list of targets

**nf-core Module Information:**

- Module: purecn/intervalfile
- Container: biocontainers/bioconductor-dnacopy:1.80.0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    </help>

    <citations>
        <citation type="bibtex">@misc{nfcore_purecn/intervalfile,
            title = {nf-core purecn/intervalfile module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/purecn/intervalfile},
            year = {2024}
        }}</citation>
    </citations>
</tool>