<tool id="nfcore_quilt/quilt" name="quilt_quilt" version="1.0" profile="21.05">
    <description>QUILT is an R and C++ program for rapid genotype imputation from low-coverage sequence using a large reference panel.</description>

    <requirements>
        <container type="docker">biocontainers/r-quilt:1.0.5--r43h06b5641_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        quilt/quilt
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**quilt_quilt**

QUILT is an R and C++ program for rapid genotype imputation from low-coverage sequence using a large reference panel.

**nf-core Module Information:**

- Module: quilt/quilt
- Container: biocontainers/r-quilt:1.0.5--r43h06b5641_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

