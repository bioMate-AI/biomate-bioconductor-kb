<tool id="nfcore_s4pred/runmodel" name="s4pred_runmodel" version="1.0" profile="21.05">
    <description>Prediction of a protein's secondary structure from its amino acid sequence</description>

    <requirements>
        <container type="docker">biocontainers/s4pred:1.2.1--pyhdfd78af_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        s4pred/runmodel
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**s4pred_runmodel**

Prediction of a protein's secondary structure from its amino acid sequence

**nf-core Module Information:**

- Module: s4pred/runmodel
- Container: biocontainers/s4pred:1.2.1--pyhdfd78af_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_s4pred/runmodel,
            title = {nf-core s4pred/runmodel module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/s4pred/runmodel},
            year = {2024}
        }}</citation>
    </citations>
</tool>