<tool id="nfcore_scanpy/scrublet" name="scanpy_scrublet" version="1.0" profile="21.05">
    <description>Detect doublets in single-cell RNA-seq data using Scrublet via Scanpy</description>

    <requirements>
        <container type="docker">biocontainers/python:3.12.11</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        scanpy/scrublet
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**scanpy_scrublet**

Detect doublets in single-cell RNA-seq data using Scrublet via Scanpy

**nf-core Module Information:**

- Module: scanpy/scrublet
- Container: biocontainers/python:3.12.11

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_scanpy/scrublet,
            title = {nf-core scanpy/scrublet module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/scanpy/scrublet},
            year = {2024}
        }}</citation>
    </citations>
</tool>