<tool id="nfcore_scvitools/solo" name="scvitools_solo" version="1.0" profile="21.05">
    <description>Detect doublets in single-cell RNA-Seq data</description>

    <requirements>
        <container type="docker">biocontainers/scvi-tools:1.3.3</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        scvitools/solo
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**scvitools_solo**

Detect doublets in single-cell RNA-Seq data

**nf-core Module Information:**

- Module: scvitools/solo
- Container: biocontainers/scvi-tools:1.3.3

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_scvitools/solo,
            title = {nf-core scvitools/solo module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/scvitools/solo},
            year = {2024}
        }}</citation>
    </citations>
</tool>