<tool id="nfcore_seacr/callpeak" name="seacr_callpeak" version="1.0" profile="21.05">
    <description>Call peaks using SEACR on sequenced reads in bedgraph format</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-03bfeb32fe80910c231f630d4262b83677c8c0f4:f4bb19b68e66de27e4c64306f951d5ff11919931-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        seacr/callpeak
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**seacr_callpeak**

Call peaks using SEACR on sequenced reads in bedgraph format

**nf-core Module Information:**

- Module: seacr/callpeak
- Container: biocontainers/mulled-v2-03bfeb32fe80910c231f630d4262b83677c8c0f4:f4bb19b68e66de27e4c64306f951d5ff11919931-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_seacr/callpeak,
            title = {nf-core seacr/callpeak module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/seacr/callpeak},
            year = {2024}
        }}</citation>
    </citations>
</tool>