<tool id="nfcore_segemehl/index" name="segemehl_index" version="1.0" profile="21.05">
    <description>Generate genome indices for segemehl align</description>

    <requirements>
        <container type="docker">biocontainers/segemehl:0.3.4--hc2ea5fd_5</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        segemehl/index
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**segemehl_index**

Generate genome indices for segemehl align

**nf-core Module Information:**

- Module: segemehl/index
- Container: biocontainers/segemehl:0.3.4--hc2ea5fd_5

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_segemehl/index,
            title = {nf-core segemehl/index module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/segemehl/index},
            year = {2024}
        }}</citation>
    </citations>
</tool>