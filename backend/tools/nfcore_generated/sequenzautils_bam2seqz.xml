<tool id="nfcore_sequenzautils/bam2seqz" name="sequenzautils_bam2seqz" version="1.0" profile="21.05">
    <description>Sequenza-utils bam2seqz process BAM and Wiggle files to produce a seqz file</description>

    <requirements>
        <container type="docker">biocontainers/sequenza-utils:3.0.0--py38h6ed170a_2</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        sequenzautils/bam2seqz
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**sequenzautils_bam2seqz**

Sequenza-utils bam2seqz process BAM and Wiggle files to produce a seqz file

**nf-core Module Information:**

- Module: sequenzautils/bam2seqz
- Container: biocontainers/sequenza-utils:3.0.0--py38h6ed170a_2

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_sequenzautils/bam2seqz,
            title = {nf-core sequenzautils/bam2seqz module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/sequenzautils/bam2seqz},
            year = {2024}
        }}</citation>
    </citations>
</tool>