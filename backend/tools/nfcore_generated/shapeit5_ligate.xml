<tool id="nfcore_shapeit5/ligate" name="shapeit5_ligate" version="1.0" profile="21.05">
    <description>Ligate multiple phased BCF/VCF files into a single whole chromosome file.
Typically run to ligate multiple chunks of phased common variants.
</description>

    <requirements>
        <container type="docker">biocontainers/shapeit5:5.1.1--hb60d31d_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        shapeit5/ligate
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**shapeit5_ligate**

Ligate multiple phased BCF/VCF files into a single whole chromosome file.
Typically run to ligate multiple chunks of phased common variants.


**nf-core Module Information:**

- Module: shapeit5/ligate
- Container: biocontainers/shapeit5:5.1.1--hb60d31d_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_shapeit5/ligate,
            title = {nf-core shapeit5/ligate module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/shapeit5/ligate},
            year = {2024}
        }}</citation>
    </citations>
</tool>