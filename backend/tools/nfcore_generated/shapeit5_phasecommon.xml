<tool id="nfcore_shapeit5/phasecommon" name="shapeit5_phasecommon" version="1.0" profile="21.05">
    <description>Tool to phase common sites, typically SNP array data, or the first step of WES/WGS data.</description>

    <requirements>
        <container type="docker">biocontainers/shapeit5:5.1.1--hb60d31d_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        shapeit5/phasecommon
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**shapeit5_phasecommon**

Tool to phase common sites, typically SNP array data, or the first step of WES/WGS data.

**nf-core Module Information:**

- Module: shapeit5/phasecommon
- Container: biocontainers/shapeit5:5.1.1--hb60d31d_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_shapeit5/phasecommon,
            title = {nf-core shapeit5/phasecommon module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/shapeit5/phasecommon},
            year = {2024}
        }}</citation>
    </citations>
</tool>