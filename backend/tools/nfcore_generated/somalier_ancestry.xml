<tool id="nfcore_somalier/ancestry" name="somalier_ancestry" version="1.0" profile="21.05">
    <description>Somalier can extract informative sites, evaluate relatedness, and perform quality-control on BAM/CRAM/BCF/VCF/GVCF or from jointly-called VCFs</description>

    <requirements>
        <container type="docker">biocontainers/somalier:0.2.19--h0c29559_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        somalier/ancestry
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**somalier_ancestry**

Somalier can extract informative sites, evaluate relatedness, and perform quality-control on BAM/CRAM/BCF/VCF/GVCF or from jointly-called VCFs

**nf-core Module Information:**

- Module: somalier/ancestry
- Container: biocontainers/somalier:0.2.19--h0c29559_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_somalier/ancestry,
            title = {nf-core somalier/ancestry module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/somalier/ancestry},
            year = {2024}
        }}</citation>
    </citations>
</tool>