<tool id="nfcore_sourmash/index" name="sourmash_index" version="1.0" profile="21.05">
    <description>Create a database of sourmash signatures (a group of FracMinHash sketches) to be used as references.</description>

    <requirements>
        <container type="docker">biocontainers/sourmash:4.9.4--hdfd78af_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        sourmash/index
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**sourmash_index**

Create a database of sourmash signatures (a group of FracMinHash sketches) to be used as references.

**nf-core Module Information:**

- Module: sourmash/index
- Container: biocontainers/sourmash:4.9.4--hdfd78af_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_sourmash/index,
            title = {nf-core sourmash/index module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/sourmash/index},
            year = {2024}
        }}</citation>
    </citations>
</tool>