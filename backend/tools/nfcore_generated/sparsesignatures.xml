<tool id="nfcore_sparsesignatures" name="sparse_signatures" version="1.0" profile="21.05">
    <description>mutational signature deconvolution of cancer cells</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-d410175e2fbd9c47aa685bb5dfb87cfad76d408b:a995bb98b7122825523ffed7ae131cb006e56cbe-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        sparsesignatures
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**sparse_signatures**

mutational signature deconvolution of cancer cells

**nf-core Module Information:**

- Module: sparsesignatures
- Container: biocontainers/mulled-v2-d410175e2fbd9c47aa685bb5dfb87cfad76d408b:a995bb98b7122825523ffed7ae131cb006e56cbe-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_sparsesignatures,
            title = {nf-core sparsesignatures module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/sparsesignatures},
            year = {2024}
        }}</citation>
    </citations>
</tool>