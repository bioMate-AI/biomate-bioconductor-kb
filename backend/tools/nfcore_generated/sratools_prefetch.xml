<tool id="nfcore_sratools/prefetch" name="sratools_prefetch" version="1.0" profile="21.05">
    <description>Download sequencing data from the NCBI Sequence Read Archive (SRA).</description>

    <requirements>
        <container type="docker">biocontainers/sra-tools:3.1.0--h9f5acd7_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        sratools/prefetch
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**sratools_prefetch**

Download sequencing data from the NCBI Sequence Read Archive (SRA).

**nf-core Module Information:**

- Module: sratools/prefetch
- Container: biocontainers/sra-tools:3.1.0--h9f5acd7_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_sratools/prefetch,
            title = {nf-core sratools/prefetch module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/sratools/prefetch},
            year = {2024}
        }}</citation>
    </citations>
</tool>