<?xml version='1.0' encoding='UTF-8'?>
<tool id="nfcore_stare" name="stare" version="1.0" profile="21.05">
    <description>Framework that scores enhancer–gene interactions using the Activity-By-Contact model and derives transcription factor affinities on gene level</description>

    <requirements>
        <container type="docker">biocontainers/stare-abc:1.0.5</container>
    </requirements>

    <command detect_errors="exit_code">
        stare
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    </command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File" help="Input data file for processing" />
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads" help="Number of CPU threads to use" />
        <param name="advanced_options" type="text" value="" label="Advanced Options" help="Additional command-line options (advanced users)" />
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*" label="${tool.name} on ${on_string}: Output" />
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt" />
                </assert_contents>
            </output>
        </test>
    </tests>

    <help>
**stare**

Framework that scores enhancer–gene interactions using the Activity-By-Contact model and derives transcription factor affinities on gene level

**nf-core Module Information:**

- Module: stare
- Container: biocontainers/stare-abc:1.0.5

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    </help>

    <citations>
        <citation type="bibtex">@misc{nfcore_stare,
            title = {nf-core stare module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/stare},
            year = {2024}
        }}</citation>
    </citations>
</tool>