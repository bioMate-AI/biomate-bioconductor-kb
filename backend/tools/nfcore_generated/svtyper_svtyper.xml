<tool id="nfcore_svtyper/svtyper" name="svtyper_svtyper" version="1.0" profile="21.05">
    <description>SVTyper performs breakpoint genotyping of structural variants (SVs) using whole genome sequencing data</description>

    <requirements>
        <container type="docker">biocontainers/svtyper:0.7.0--py27h24bf2e0_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        svtyper/svtyper
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**svtyper_svtyper**

SVTyper performs breakpoint genotyping of structural variants (SVs) using whole genome sequencing data

**nf-core Module Information:**

- Module: svtyper/svtyper
- Container: biocontainers/svtyper:0.7.0--py27h24bf2e0_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_svtyper/svtyper,
            title = {nf-core svtyper/svtyper module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/svtyper/svtyper},
            year = {2024}
        }}</citation>
    </citations>
</tool>