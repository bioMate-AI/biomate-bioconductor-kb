<tool id="nfcore_sylph/profile" name="sylph_profile" version="1.0" profile="21.05">
    <description>Sylph profile command for taxonoming profiling</description>

    <requirements>
        <container type="docker">biocontainers/sylph:0.7.0--h919a2d8_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        sylph/profile
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**sylph_profile**

Sylph profile command for taxonoming profiling

**nf-core Module Information:**

- Module: sylph/profile
- Container: biocontainers/sylph:0.7.0--h919a2d8_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_sylph/profile,
            title = {nf-core sylph/profile module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/sylph/profile},
            year = {2024}
        }}</citation>
    </citations>
</tool>