<tool id="nfcore_taxonkit/list" name="taxonkit_list" version="1.0" profile="21.05">
    <description>Generate taxonomic subtrees based on taxonids</description>

    <requirements>
        <container type="docker">biocontainers/taxonkit:0.20.0--h9ee0642_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        taxonkit/list
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**taxonkit_list**

Generate taxonomic subtrees based on taxonids

**nf-core Module Information:**

- Module: taxonkit/list
- Container: biocontainers/taxonkit:0.20.0--h9ee0642_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_taxonkit/list,
            title = {nf-core taxonkit/list module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/taxonkit/list},
            year = {2024}
        }}</citation>
    </citations>
</tool>