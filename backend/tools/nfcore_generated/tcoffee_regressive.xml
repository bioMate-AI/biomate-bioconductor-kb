<tool id="nfcore_tcoffee/regressive" name="tcoffee_regressive" version="1.0" profile="21.05">
    <description>Aligns sequences using the regressive algorithm as implemented in the T_COFFEE package</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-a76a981c07359a31ff55b9dc13bd3da5ce1909c1:84c8f17f1259b49e2f7783b95b7a89c6f2cb199e-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        tcoffee/regressive
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**tcoffee_regressive**

Aligns sequences using the regressive algorithm as implemented in the T_COFFEE package

**nf-core Module Information:**

- Module: tcoffee/regressive
- Container: biocontainers/mulled-v2-a76a981c07359a31ff55b9dc13bd3da5ce1909c1:84c8f17f1259b49e2f7783b95b7a89c6f2cb199e-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_tcoffee/regressive,
            title = {nf-core tcoffee/regressive module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/tcoffee/regressive},
            year = {2024}
        }}</citation>
    </citations>
</tool>