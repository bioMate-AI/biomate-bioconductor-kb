<tool id="nfcore_tiddit/cov" name="tiddit_cov" version="1.0" profile="21.05">
    <description>Computes the coverage of different regions from the bam file.</description>

    <requirements>
        <container type="docker">biocontainers/tiddit:3.6.1--py38h24c8ff8_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        tiddit/cov
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**tiddit_cov**

Computes the coverage of different regions from the bam file.

**nf-core Module Information:**

- Module: tiddit/cov
- Container: biocontainers/tiddit:3.6.1--py38h24c8ff8_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_tiddit/cov,
            title = {nf-core tiddit/cov module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/tiddit/cov},
            year = {2024}
        }}</citation>
    </citations>
</tool>