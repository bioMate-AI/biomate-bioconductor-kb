        <citation type="bibtex">@misc{nfcore_transdecoder/longorf,
            title = {nf-core transdecoder/longorf module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/transdecoder/longorf},
            year = {2024}
        }}</citation>
    </citations>
</tool>