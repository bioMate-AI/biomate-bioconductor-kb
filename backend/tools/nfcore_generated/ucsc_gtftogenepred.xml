<tool id="nfcore_ucsc/gtftogenepred" name="ucsc_gtftogenepred" version="1.0" profile="21.05">
    <description>compute average score of bigwig over bed file</description>

    <requirements>
        <container type="docker">biocontainers/ucsc-gtftogenepred:447--h954228d_0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        ucsc/gtftogenepred
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**ucsc_gtftogenepred**

compute average score of bigwig over bed file

**nf-core Module Information:**

- Module: ucsc/gtftogenepred
- Container: biocontainers/ucsc-gtftogenepred:447--h954228d_0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

