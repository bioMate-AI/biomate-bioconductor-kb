<tool id="nfcore_ucsc/wigtobigwig" name="ucsc_wigtobigwig" version="1.0" profile="21.05">
    <description>Convert ascii format wig file to binary big wig format</description>

    <requirements>
        <container type="docker">biocontainers/ucsc-wigtobigwig:447--h2a80c09_1</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        ucsc/wigtobigwig
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**ucsc_wigtobigwig**

Convert ascii format wig file to binary big wig format

**nf-core Module Information:**

- Module: ucsc/wigtobigwig
- Container: biocontainers/ucsc-wigtobigwig:447--h2a80c09_1

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_ucsc/wigtobigwig,
            title = {nf-core ucsc/wigtobigwig module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/ucsc/wigtobigwig},
            year = {2024}
        }}</citation>
    </citations>
</tool>