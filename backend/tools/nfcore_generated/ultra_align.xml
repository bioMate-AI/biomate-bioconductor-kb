<tool id="nfcore_ultra/align" name="ultra_align" version="1.0" profile="21.05">
    <description>uLTRA aligner - A wrapper around minimap2 to improve small exon detection - Map reads on genome</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-4b749ef583d6de806ddbf51c2d235ac8c14763c6:c2c0cd48e7ed1cf3f365b421c7389d04e6bfa812-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        ultra/align
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**ultra_align**

uLTRA aligner - A wrapper around minimap2 to improve small exon detection - Map reads on genome

**nf-core Module Information:**

- Module: ultra/align
- Container: biocontainers/mulled-v2-4b749ef583d6de806ddbf51c2d235ac8c14763c6:c2c0cd48e7ed1cf3f365b421c7389d04e6bfa812-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_ultra/align,
            title = {nf-core ultra/align module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/ultra/align},
            year = {2024}
        }}</citation>
    </citations>
</tool>