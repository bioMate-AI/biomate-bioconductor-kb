<?xml version='1.0' encoding='UTF-8'?>
<tool id="nfcore_variancepartition/dream" name="variancepartition_dream" version="1.0" profile="21.05">
    <description>Runs a differential expression analysis with dream() from variancePartition R package</description>

    <requirements>
        <container type="docker">biocontainers/bioconductor-edger:4.0.16</container>
    </requirements>

    <command detect_errors="exit_code">
        variancepartition/dream
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    </command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File" help="Input data file for processing" />
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads" help="Number of CPU threads to use" />
        <param name="advanced_options" type="text" value="" label="Advanced Options" help="Additional command-line options (advanced users)" />
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*" label="${tool.name} on ${on_string}: Output" />
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt" />
                </assert_contents>
            </output>
        </test>
    </tests>

    <help>
**variancepartition_dream**

Runs a differential expression analysis with dream() from variancePartition R package

**nf-core Module Information:**

- Module: variancepartition/dream
- Container: biocontainers/bioconductor-edger:4.0.16

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    </help>

    <citations>
        <citation type="bibtex">@misc{nfcore_variancepartition/dream,
            title = {nf-core variancepartition/dream module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/variancepartition/dream},
            year = {2024}
        }}</citation>
    </citations>
</tool>