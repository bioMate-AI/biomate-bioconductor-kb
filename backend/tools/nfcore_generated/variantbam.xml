<tool id="nfcore_variantbam" name="variantbam" version="1.0" profile="21.05">
    <description>Filtering, downsampling and profiling alignments in BAM/CRAM formats</description>

    <requirements>
        <container type="docker">biocontainers/variantbam:1.4.4a--h7d7f7ad_5</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        variantbam
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**variantbam**

Filtering, downsampling and profiling alignments in BAM/CRAM formats

**nf-core Module Information:**

- Module: variantbam
- Container: biocontainers/variantbam:1.4.4a--h7d7f7ad_5

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_variantbam,
            title = {nf-core variantbam module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/variantbam},
            year = {2024}
        }}</citation>
    </citations>
</tool>