<tool id="nfcore_vcf2zarr/convert" name="vcf2zarr_convert" version="1.0" profile="21.05">
    <description>Convert VCF data to the VCF Zarr specification reliably, in parallel or distributed over a cluster</description>

    <requirements>
        <container type="docker">biocontainers/vcf2zarr/convert:latest</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        vcf2zarr/convert
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**vcf2zarr_convert**

Convert VCF data to the VCF Zarr specification reliably, in parallel or distributed over a cluster

**nf-core Module Information:**

- Module: vcf2zarr/convert
- Container: biocontainers/vcf2zarr/convert:latest

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_vcf2zarr/convert,
            title = {nf-core vcf2zarr/convert module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/vcf2zarr/convert},
            year = {2024}
        }}</citation>
    </citations>
</tool>