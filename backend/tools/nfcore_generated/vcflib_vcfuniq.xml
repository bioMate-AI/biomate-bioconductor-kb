<?xml version='1.0' encoding='UTF-8'?>
<tool id="nfcore_vcflib/vcfuniq" name="vcflib_vcfuniq" version="1.0" profile="21.05">
    <description>List unique genotypes. Like GNU uniq, but for VCF records. Remove records which have the same position, ref, and alt as the previous record.</description>

    <requirements>
        <container type="docker">biocontainers/vcflib:1.0.14</container>
    </requirements>

    <command detect_errors="exit_code">
        vcflib/vcfuniq
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    </command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File" help="Input data file for processing" />
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads" help="Number of CPU threads to use" />
        <param name="advanced_options" type="text" value="" label="Advanced Options" help="Additional command-line options (advanced users)" />
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*" label="${tool.name} on ${on_string}: Output" />
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt" />
                </assert_contents>
            </output>
        </test>
    </tests>

    <help>
**vcflib_vcfuniq**

List unique genotypes. Like GNU uniq, but for VCF records. Remove records which have the same position, ref, and alt as the previous record.

**nf-core Module Information:**

- Module: vcflib/vcfuniq
- Container: biocontainers/vcflib:1.0.14

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    </help>

    <citations>
        <citation type="bibtex">@misc{nfcore_vcflib/vcfuniq,
            title = {nf-core vcflib/vcfuniq module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/vcflib/vcfuniq},
            year = {2024}
        }}</citation>
    </citations>
</tool>