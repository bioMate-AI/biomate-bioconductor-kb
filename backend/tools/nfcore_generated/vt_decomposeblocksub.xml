<tool id="nfcore_vt/decomposeblocksub" name="vt_decomposeblocksub" version="1.0" profile="21.05">
    <description>Decomposes biallelic block substitutions into its constituent SNPs.</description>

    <requirements>
        <container type="docker">biocontainers/vt:2015.11.10--h5ef6573_4</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        vt/decomposeblocksub
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**vt_decomposeblocksub**

Decomposes biallelic block substitutions into its constituent SNPs.

**nf-core Module Information:**

- Module: vt/decomposeblocksub
- Container: biocontainers/vt:2015.11.10--h5ef6573_4

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_vt/decomposeblocksub,
            title = {nf-core vt/decomposeblocksub module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/vt/decomposeblocksub},
            year = {2024}
        }}</citation>
    </citations>
</tool>