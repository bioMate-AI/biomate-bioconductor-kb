<tool id="nfcore_yara/mapper" name="yara_mapper" version="1.0" profile="21.05">
    <description>Align reads to a reference genome using YARA</description>

    <requirements>
        <container type="docker">biocontainers/mulled-v2-f13549097a0d1ca36f9d4f017636fb3609f6c083:de7982183b85634270540ac760c2644f16e0b6d1-0</container>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        yara/mapper
        #if $input
            --input '$input'
        #end if
        --output output
        #if $threads
            --threads \${GALAXY_SLOTS:-$threads}
        #end if
        $advanced_options
    ]]></command>

    <inputs>
        <param name="input" type="data" format="auto" label="Input File"
               help="Input data file for processing"/>
        <param name="threads" type="integer" value="4" min="1" max="32" label="Number of Threads"
               help="Number of CPU threads to use"/>
        <param name="advanced_options" type="text" value="" label="Advanced Options"
               help="Additional command-line options (advanced users)"/>
    </inputs>

    <outputs>
        <data name="output" format="auto" from_work_dir="output*"
              label="${tool.name} on ${on_string}: Output"/>
    </outputs>

    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_size value="0" compare="gt"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
**yara_mapper**

Align reads to a reference genome using YARA

**nf-core Module Information:**

- Module: yara/mapper
- Container: biocontainers/mulled-v2-f13549097a0d1ca36f9d4f017636fb3609f6c083:de7982183b85634270540ac760c2644f16e0b6d1-0

**Usage:**
This tool provides the functionality from the nf-core module within Galaxy workflows.
    ]]></help>

    <citations>
        <citation type="bibtex">@misc{nfcore_yara/mapper,
            title = {nf-core yara/mapper module},
            url = {https://github.com/nf-core/modules/tree/master/modules/nf-core/yara/mapper},
            year = {2024}
        }}</citation>
    </citations>
</tool>