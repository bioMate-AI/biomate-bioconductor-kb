        <mxCell id="phaseA" value="&lt;b&gt;Phase A — Atlas Tissue Check&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;PCSK9 hepatocyte-restricted → LNP-IV delivery viable • &amp;gt;90% on-target tissue, minimal off-target&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#1e3a8a;strokeWidth=2;arcSize=15;" vertex="1" parent="1"><mxGeometry x="100" y="180" width="1000" height="70" as="geometry" /></mxCell>
        <mxCell id="phaseB" value="&lt;b&gt;Phase B — Editor Selection&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;LoF target → CBE (cytosine → thymine, premature stop) over ABE / prime editing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#14532d;strokeWidth=2;arcSize=15;" vertex="1" parent="1"><mxGeometry x="100" y="270" width="1000" height="70" as="geometry" /></mxCell>
        <mxCell id="phaseC" value="&lt;b&gt;Phase C — Guide RNA Design&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;PCSK9 exon 1 W8 codon (CAA → TAA stop) • 20-nt protospacer, NGG PAM, edit window pos 4-8&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#78350f;strokeWidth=2;arcSize=15;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="1000" height="70" as="geometry" /></mxCell>
        <mxCell id="phaseD" value="&lt;b&gt;Phase D — CMC Flag Emission&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Surface VERVE-101 LFT precedent (Nov 2023) → &quot;optimize LNP for lower hepatotoxicity&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#9d174d;fontColor=#831843;strokeWidth=2;arcSize=15;" vertex="1" parent="1"><mxGeometry x="100" y="450" width="1000" height="70" as="geometry" /></mxCell>
        <mxCell id="result" value="&lt;b&gt;Recommendation: VERVE-102 architecture&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CBE + PCSK9 W8 gRNA + LNP-IV + LFT-reformulated • dosed Q4 2024 in real life&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#047857;fontColor=#064e3b;strokeWidth=3;arcSize=20;" vertex="1" parent="1"><mxGeometry x="200" y="560" width="800" height="60" as="geometry" /></mxCell>
