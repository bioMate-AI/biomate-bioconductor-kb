# BioMate 生产运行时环境变量清单 (single source of truth)
# =============================================================================
# 这是「仓库内只放变量名、值在 GitHub Secrets/Variables 外部配置」的落地文件。
#
# 用法:
#   scripts/deploy.sh 按本清单逐行读取变量名,从部署时环境(GitHub Secrets +
#   Variables,经 deploy.yml 注入)取值,安全 upsert 进 EC2 的 /opt/biomate/.env。
#   docker-compose.deploy.yml 再以 `env_file: /opt/biomate/.env` 注入两个容器。
#
# 格式(每行一个变量):
#   NAME              → 可选变量。GitHub 里有值才写入;没值则保留主机现有值,不覆盖。
#   NAME   required   → 必需变量。部署时若取不到非空值,deploy.sh 直接失败(fail-fast)。
#   # ...             → 注释,忽略。
#
# 增删变量 = 改这一处 + 在 GitHub 网页 Settings → Secrets and variables 设值。
# workflow 用 toJSON(secrets/vars) 透传,无需改动。
#
# 主机独有、不经 CI 管理的密钥(EMAIL_PASS / GALAXY_MASTER_API_KEY /
# LAGO_WEBHOOK_SECRET 等)不要列在这里 —— deploy.sh 的 upsert 会保留它们。
# =============================================================================

# ── 核心密钥 (secret) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY        required
JWT_SECRET               required
SESSION_SECRET           required
BILLING_INTERNAL_KEY     required
DATABASE_URL             required
GALAXY_API_KEY           required
AWS_ACCESS_KEY_ID        required
AWS_SECRET_ACCESS_KEY    required
ENCRYPTION_KEY
CSRF_SECRET
GALAXY_JWT_SECRET
OPENAI_API_KEY
GEMINI_API_KEY

# ── 核心非敏感配置 (public → GitHub Variables) ──────────────────────────────
GALAXY_URL               required
AWS_REGION               required
S3_BUCKET_NAME           required
NODE_ENV
APP_URL
CORS_ORIGINS
FORCE_HTTPS
ENABLE_HSTS

# ── 计费 (Lago + Java billing) ───────────────────────────────────────────────
LAGO_API_KEY             required
LAGO_API_URL             required
REDIS_URL                required
JAVA_BILLING_SERVICE_URL
JAVA_BILLING_ENABLED
BILLING_DEV_MODE

# ── Nextflow / AWS Batch ─────────────────────────────────────────────────────
AWS_NF_ACCESS_KEY_ID
AWS_NF_SECRET_ACCESS_KEY
AWS_S3_NEXTFLOW_BUCKET
AWS_S3_BUCKET
AWS_DEFAULT_REGION
AWS_BATCH_QUEUE
GPU_BATCH_QUEUE
NEXTFLOW_USE_AWS
BIOMATE_NF_PROFILE

# ── 内置 Postgres (docker-compose.ec2.yml 路径用) ───────────────────────────
POSTGRES_DB
POSTGRES_USER
POSTGRES_PASSWORD

# ── 应用加密 (secret;app 关键,缺失会导致字段/MFA 解密失败)────────────────
FIELD_ENCRYPTION_SECRET
MFA_ENCRYPTION_SECRET
LAGO_WEBHOOK_SECRET

# ── 邮件 / SMTP (EMAIL_PASS 为 secret,其余为 variable)──────────────────────
EMAIL_HOST
EMAIL_PORT
EMAIL_SECURE
EMAIL_USER
EMAIL_PASS
EMAIL_FROM

# ── 模型 / 行为 / 运维 (public)──────────────────────────────────────────────
BIOMATE_INTENT_MODEL
BIOMATE_RESPONSE_MODEL
BIOMATE_CHAT_VIA_CHAIN
ADMIN_ALERT_EMAIL

# ── CryoEM / CryoSPARC (CRYOSPARC_PASSWORD 为 secret,其余为 variable)────────
CRYOSPARC_AMI_ID
CRYOSPARC_HOST
CRYOSPARC_PORT
CRYOSPARC_EMAIL
CRYOSPARC_PASSWORD
CRYOSPARC_INSTANCE_REGION
CRYOSPARC_INSTANCE_TYPE
CRYOSPARC_MOVIES_S3
CRYOSPARC_PROJECT_DIR
CRYOSPARC_LICENSE
CRYOSPARC_DEFAULT_MOVIE_DIR
CRYOSPARC_SSH_USER
# ⚠️ CRYOSPARC_SSH_KEY 值是工作站本地路径(/home/.../*.pem);推到部署机后该路径不存在,
#    需把密钥文件也放到部署机或改成部署机上的路径,否则 CryoSPARC SSH 仍不可用。
CRYOSPARC_SSH_KEY

# ── 本地独有补充 (2026-06-14:原本只在本地、部署机缺) ────────────────────────
GOOGLE_API_KEY
JWT_EXPIRY
REDIS_PORT
DATABASE_PATH
