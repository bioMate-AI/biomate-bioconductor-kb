{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "Default capabilities for BioMate Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "http:default",
    "notification:default",
    "os:allow-os-type",
    "os:allow-version",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-load",
    "store:allow-save",
    "updater:default"
  ]
}
