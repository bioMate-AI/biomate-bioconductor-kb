{
 "_meta": {
  "artifact": "RENORMALIZED_H4_CORPUS",
  "date": "2026-09-14",
  "training_eligible": false,
  "purpose": "Canonical renormalization of the H4 immunopeptidome corpus onto genuine-HLA-I-ligand space so antibody-IP and mild-acid-elution deposits are cross-comparable. Raw total-peptide counts are NOT comparable across deposits (enrichment method differs). All H4 scoring must be on ligand-filtered space.",
  "method_ref": "RENORMALIZATION_SPEC.md ; A375_B2M_KO_DIAGNOSTIC.md",
  "ligand_filter": "length 8-12 (9mer peak) AND exact-sequence match to the deposit's own HLA-I alleles' mono-allelic ligand reference (combined_monoallelic_hlaI_human.tsv.gz, 201 alleles / 642k peptides). Anchor-heuristic lower bound: NetMHCpan/MHCflurry NOT installed on host.",
  "within_deposit_normalization": "quantile rank of the presentation measure (intensity, else spectral/PSM count) over all peptides in the condition, in [0,1] -> cross-lab absolute scales do not leak.",
  "measures": {
   "ligand_fraction": "n_genuine_ligands / n_raw_distinct_peptides",
   "ligand_fraction_of_8to12": "n_ligands / n_(len8-12) = anchor-hit rate among plausible HLA-I lengths (the shape-robust cross-method comparable measure)",
   "frac_9mer": "HLA-I signature check"
  },
  "s3_renorm_tables": "s3://knowledge-datasets-1759951976/immunology_sc_corpus_broad/acquisitions/immunopeptidome/renormalized_v1/",
  "hla_genotype_note": "Cell-line HLA-I genotypes reconciled from Cellosaurus/TRON/source papers. HAP1 CORRECTED to A*02:01/B*40:01/C*03:04 (expression-validated in HAP1 immunopeptidomics; the earlier A*03:01/B*51:01/C*01:02 was unsupported and depressed HAP1 ligand_fraction 20-fold)."
 },
