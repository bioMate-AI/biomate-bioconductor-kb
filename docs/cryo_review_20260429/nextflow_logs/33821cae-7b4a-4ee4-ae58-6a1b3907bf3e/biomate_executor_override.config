params {
    container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate-nextflow-base:latest'
    outdir = 's3://biomate-nextflow-work/nextflow/outputs/bbb23492-bd5c-415d-b5f5-678921480534/33821cae-7b4a-4ee4-ae58-6a1b3907bf3e'
}
process {
    executor = 'awsbatch'
    queue = 'biomate-nextflow-queue'
    container = '399683337364.dkr.ecr.us-west-2.amazonaws.com/biomate-nextflow-base:latest'
    environment = [
        BIOMATE_USER_ID: 'bbb23492-bd5c-415d-b5f5-678921480534',
        BIOMATE_RUN_ID: '33821cae-7b4a-4ee4-ae58-6a1b3907bf3e',
    ]
}
process {
    withLabel: 'process_gpu' {
        queue = 'galaxy-cloud-queue-gpu'
        accelerator = 1
    }
}
aws {
    region = 'us-west-2'
    client {
        maxConnections = 20
        uploadChunkSize = 104857600
    }
    batch {
        cliPath = '/opt/aws-cli/bin/aws'
    }
}
docker.enabled = true
workDir = 's3://biomate-nextflow-work/nextflow/work/bbb23492-bd5c-415d-b5f5-678921480534/33821cae-7b4a-4ee4-ae58-6a1b3907bf3e'
