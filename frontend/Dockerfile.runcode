# run_code sandbox image = biotools base + CJK fonts + matplotlib defaults + Office/pandoc.
# A thin layer on biomate-biotools:1 (the heavy R/Bioconductor base is not rebuilt).
# Tag: biomate-runcode:3 — built on the dev host by scripts/sync_to_dev.sh when missing
# (bump the tag on any change: the sync only builds a tag that is not there yet).
FROM biomate-biotools:1

RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-cjk fontconfig pandoc \
    && rm -rf /var/lib/apt/lists/* && fc-cache -f

# Office documents (founder 2026-11-12: a requested .docx report failed — the sandbox is offline, so
# `pip install python-docx` inside a run cannot work; ship the libraries in the image).
RUN pip3 install --no-cache-dir --break-system-packages python-docx python-pptx

COPY sandbox/matplotlibrc /etc/matplotlibrc
# Sandboxes run read-only with HOME=/tmp and no network: ship a prebuilt font cache so every
# call does not rebuild it, and point matplotlib at the site config.
ENV MATPLOTLIBRC=/etc/matplotlibrc \
    MPLCONFIGDIR=/opt/mplcache
COPY sandbox/cjk_font_aliases.py /opt/cjk_font_aliases.py
RUN mkdir -p /opt/mplcache \
    && python3 /opt/cjk_font_aliases.py \
    && chmod -R a+rwX /opt/mplcache
