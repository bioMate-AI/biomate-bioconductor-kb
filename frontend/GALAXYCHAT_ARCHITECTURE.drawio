          <mxGeometry x="1070" y="40" width="110" height="60" as="geometry" />
        </mxCell>

        <!-- Services Layer -->
        <mxCell id="services-layer" value="Services Layer" style="swimlane;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="1200" height="260" as="geometry" />
        </mxCell>

        <!-- Chat Service -->
        <mxCell id="chat-service" value="Chat API Service&#xa;(Hybrid Intelligence)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;fontStyle=1" vertex="1" parent="services-layer">
          <mxGeometry x="20" y="40" width="260" height="200" as="geometry" />
        </mxCell>

        <mxCell id="chat-service-detail" value="1. OpenAI Chat&#xa;   • GPT-4 for NLU&#xa;   • Intent detection&#xa;&#xa;2. Galaxy Tool Search&#xa;   • Query tool index&#xa;   • Filter by category&#xa;&#xa;3. BioMNI Dataset RAG&#xa;   • Dataset discovery&#xa;   • Schema matching&#xa;&#xa;4. Workflow Generator&#xa;   • Build Galaxy JSON&#xa;   • Add suggested datasets" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="chat-service">
          <mxGeometry x="10" y="30" width="240" height="160" as="geometry" />
        </mxCell>

        <!-- Galaxy Proxy Service -->
        <mxCell id="galaxy-proxy-service" value="Galaxy API Proxy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;fontStyle=1" vertex="1" parent="services-layer">
          <mxGeometry x="300" y="40" width="260" height="200" as="geometry" />
        </mxCell>

        <mxCell id="galaxy-proxy-detail" value="galaxy-api-proxy.ts&#xa;&#xa;Methods:&#xa;• searchTools(query)&#xa;• installTool(owner, name)&#xa;• invokeWorkflow(wf_json)&#xa;• getInvocationState(id)&#xa;• getJobState(job_id)&#xa;• getJobLogs(job_id)&#xa;• getDatasets()&#xa;&#xa;Handles:&#xa;• Authentication&#xa;• Error retry logic&#xa;• Response parsing" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="galaxy-proxy-service">
          <mxGeometry x="10" y="30" width="240" height="160" as="geometry" />
        </mxCell>

        <!-- Workflow Executor Service -->
        <mxCell id="workflow-exec-service" value="Workflow Executor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;fontStyle=1" vertex="1" parent="services-layer">
          <mxGeometry x="580" y="40" width="260" height="200" as="geometry" />
        </mxCell>

        <mxCell id="workflow-exec-detail" value="workflow-executor.ts&#xa;&#xa;Methods:&#xa;• executeWorkflow(steps)&#xa;• convertToGalaxyFormat()&#xa;• checkAndInstallTools()&#xa;• handleExecutionError()&#xa;&#xa;Process:&#xa;1. Validate workflow&#xa;2. Check tool availability&#xa;3. Install missing tools&#xa;4. Convert to Galaxy JSON&#xa;5. Invoke via proxy&#xa;6. Return invocation_id" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="workflow-exec-service">
          <mxGeometry x="10" y="30" width="240" height="160" as="geometry" />
        </mxCell>

        <!-- State Poller + SSE Service -->
        <mxCell id="state-poller-service" value="State Poller + SSE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=top;fontStyle=1" vertex="1" parent="services-layer">
          <mxGeometry x="860" y="40" width="320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="state-poller-detail" value="galaxy-state-poller.ts + workflow-sse.ts&#xa;&#xa;State Poller:&#xa;• Poll GET /api/invocations/{id} every 3s&#xa;• Extract job states from response&#xa;• Detect state changes&#xa;&#xa;SSE Stream:&#xa;• Open EventSource connection&#xa;• Stream state updates to frontend&#xa;• Format: data: {type, invocation_id, state, steps}&#xa;&#xa;States Tracked:&#xa;• new, queued, running, ok, error, paused&#xa;• Real timestamps (create_time, update_time)&#xa;• NO progress estimation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="state-poller-service">
          <mxGeometry x="10" y="30" width="300" height="160" as="geometry" />
        </mxCell>

        <!-- Integration Layer -->
        <mxCell id="integration-layer" value="Integration Layer" style="swimlane;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="1200" height="220" as="geometry" />
        </mxCell>

        <!-- Galaxy Backend -->
        <mxCell id="galaxy-backend-box" value="Galaxy Backend APIs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;fontStyle=1" vertex="1" parent="integration-layer">
          <mxGeometry x="20" y="40" width="380" height="160" as="geometry" />
        </mxCell>

        <mxCell id="galaxy-backend-detail" value="Production-Ready Components:&#xa;&#xa;• On-Demand Tool Installer&#xa;  - 2,177 tools indexed (SQLite FTS5)&#xa;  - Auto-install from ToolShed&#xa;  - Retry logic, no restart needed&#xa;&#xa;• Workflow API&#xa;  - POST /api/workflows/{id}/invocations&#xa;  - GET /api/invocations/{id}&#xa;&#xa;• Jobs API&#xa;  - GET /api/jobs/{id} (state tracking)&#xa;  - GET /api/jobs/{id}/stdout, /stderr" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="galaxy-backend-box">
          <mxGeometry x="10" y="30" width="360" height="120" as="geometry" />
        </mxCell>

        <!-- BioMNI RAG -->
        <mxCell id="biomni-rag-box" value="BioMNI Dataset RAG" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;fontStyle=1" vertex="1" parent="integration-layer">
          <mxGeometry x="420" y="40" width="360" height="160" as="geometry" />
        </mxCell>

        <mxCell id="biomni-rag-detail" value="biomni_dataset_rag.py&#xa;&#xa;• Dataset Search Engine&#xa;  - 100+ GB data lake indexed&#xa;  - Category-based search&#xa;  - Schema-based query&#xa;  - Format filtering&#xa;&#xa;• Methods:&#xa;  - search_datasets(query, category)&#xa;  - get_datasets_by_schema(fields)&#xa;  - get_compatible_datasets(format)&#xa;&#xa;• Returns: dataset_id, name, description,&#xa;  category, format, size, path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="biomni-rag-box">
          <mxGeometry x="10" y="30" width="340" height="120" as="geometry" />
        </mxCell>

