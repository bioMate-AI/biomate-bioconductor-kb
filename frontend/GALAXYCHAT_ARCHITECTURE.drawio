        <mxCell id="step1-1" value="1. User Input&#xa;&#xa;&quot;I need to analyze RNA-seq data&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step1-2" value="2. Chat API Processes&#xa;&#xa;• OpenAI: Understand intent&#xa;• Intent: RNA-seq analysis" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="260" y="130" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step1-3" value="3. Tool Search&#xa;&#xa;Query Galaxy ToolShed:&#xa;• &quot;RNA-seq alignment&quot;&#xa;• Result: HISAT2, STAR&#xa;• &quot;quantification&quot;&#xa;• Result: featureCounts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="480" y="130" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step1-4" value="4. Dataset Recommendations&#xa;&#xa;Query BioMNI RAG:&#xa;• Category: genomics&#xa;• Query: &quot;human reference&quot;&#xa;• Result: hg38 genome&#xa;• Result: gene annotations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="130" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step1-5" value="5. Generate Workflow&#xa;&#xa;Create workflow JSON:&#xa;• Step 1: FastQC (QC)&#xa;• Step 2: HISAT2 (align)&#xa;• Step 3: featureCounts&#xa;• Step 4: DESeq2&#xa;&#xa;+ Suggested datasets" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="940" y="130" width="200" height="80" as="geometry" />
        </mxCell>

