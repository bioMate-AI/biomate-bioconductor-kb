        <mxCell id="arrow2-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="step2-2" target="step2-3">
          <mxGeometry relative="1" as="geometry" />
