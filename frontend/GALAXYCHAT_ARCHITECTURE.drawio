        <mxCell id="arrow2-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="step2-6" target="step2-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Galaxy Execution Details -->
        <mxCell id="galaxy-exec-title" value="Galaxy Internal Execution (Behind the Scenes)" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="galaxy-step1" value="Job Scheduling&#xa;&#xa;• Galaxy queues jobs&#xa;• State: new → queued" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="galaxy-step2" value="Job Execution&#xa;&#xa;• Tool runs (local/cluster)&#xa;• State: queued → running" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="240" y="480" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="galaxy-step3" value="Output Generation&#xa;&#xa;• Tool creates datasets&#xa;• Stored in Galaxy DB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="480" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="galaxy-step4" value="Job Completion&#xa;&#xa;• State: running → ok/error&#xa;• Logs saved" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="640" y="480" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="galaxy-step5" value="Next Step Trigger&#xa;&#xa;• If job ok: run next step&#xa;• If error: stop workflow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="840" y="480" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Galaxy Execution Arrows -->
        <mxCell id="arrow-gal-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="galaxy-step1" target="galaxy-step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-gal-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="galaxy-step2" target="galaxy-step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-gal-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="galaxy-step3" target="galaxy-step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-gal-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="galaxy-step4" target="galaxy-step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 3: Error Handling -->
        <mxCell id="flow3-title" value="Flow 3: Error Handling &amp; Chat Assistance" style="text;html=1;strokeColor=none;fillColor=#f8cecc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="450" height="30" as="geometry" />
        </mxCell>

        <mxCell id="step3-1" value="1. Job Fails&#xa;&#xa;Galaxy Job State:&#xa;• state: &quot;error&quot;&#xa;• stderr: error message" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step3-2" value="2. Error Detected&#xa;&#xa;State Poller:&#xa;• Detects error state&#xa;• Fetches stderr log" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="260" y="640" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step3-3" value="3. Display Error&#xa;&#xa;Workflow View:&#xa;• Node turns red&#xa;• Show error message&#xa;• &quot;Ask Chat for Help&quot; btn" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="480" y="640" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step3-4" value="4. User Asks Chat&#xa;&#xa;Clicks &quot;Ask for Help&quot;&#xa;&#xa;Sends to chat:&#xa;• tool_id&#xa;• error_message&#xa;• workflow_context" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="640" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step3-5" value="5. Chat Analyzes&#xa;&#xa;• OpenAI interprets error&#xa;• Suggests fixes:&#xa;  &quot;Missing reference&#xa;  genome. Add hg38&quot;&#xa;• Offers to update&#xa;  workflow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="920" y="640" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step3-6" value="6. Auto-Fix (Optional)&#xa;&#xa;If user accepts:&#xa;• Add missing step&#xa;• Update parameters&#xa;• Restart workflow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1140" y="640" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Flow 3 Arrows -->
        <mxCell id="arrow3-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="step3-1" target="step3-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow3-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="step3-2" target="step3-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow3-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="step3-3" target="step3-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow3-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="step3-4" target="step3-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow3-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="step3-5" target="step3-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- State Diagram -->
        <mxCell id="state-title" value="Galaxy Job State Transitions" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1360" height="30" as="geometry" />
        </mxCell>

        <mxCell id="state-new" value="new" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="820" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="state-queued" value="queued" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="820" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="state-running" value="running" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="480" y="820" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="state-ok" value="ok" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="660" y="820" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="state-error" value="error" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="660" y="940" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="state-paused" value="paused" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="480" y="940" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="state-deleted" value="deleted" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="840" y="820" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- State Transitions -->
        <mxCell id="trans-1" value="submitted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="state-new" target="state-queued">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="trans-2" value="resource&#xa;available" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="state-queued" target="state-running">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="trans-3" value="success" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="state-running" target="state-ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="trans-4" value="failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="state-running" target="state-error">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="trans-5" value="user pause" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="state-running" target="state-paused">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="trans-6" value="resume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeWidth=2;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="state-paused" target="state-running">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="trans-7" value="user delete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeWidth=2;strokeColor=#9673a6;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state-ok" target="state-deleted">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- State Notes -->
        <mxCell id="state-note-1" value="✓ No progress estimation&#xa;✓ Only show actual states&#xa;✓ Display elapsed time&#xa;✗ No fake percentages" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1000" y="820" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="state-note-2" value="Example Timeline:&#xa;&#xa;14:23:10 - Job created (new)&#xa;14:23:15 - Queued (queued)&#xa;14:23:20 - Started (running)&#xa;14:26:35 - Completed (ok)&#xa;&#xa;Elapsed: 3m 25s" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="920" width="220" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3. User Interaction Flow" id="user-flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title3" value="User Interaction Flow - Chat &amp; Workflow Semantic Separation" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- Split View -->
        <mxCell id="chat-panel" value="CHAT VIEW (Left Panel)" style="swimlane;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;startSize=40;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="660" height="980" as="geometry" />
        </mxCell>

        <mxCell id="chat-responsibility" value="Responsibility: Conversational Guide &amp; Assistant" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;strokeColor=#82b366;" vertex="1" parent="chat-panel">
          <mxGeometry x="10" y="50" width="640" height="30" as="geometry" />
        </mxCell>

        <!-- Chat Interactions -->
        <mxCell id="chat-int-1" value="1. Natural Language Understanding" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="chat-panel">
          <mxGeometry x="20" y="100" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-1-detail" value="User: &quot;I have RNA-seq data&quot;&#xa;&#xa;AI understands:&#xa;• Data type: RNA-seq&#xa;• Intent: Analysis pipeline&#xa;• Organism: (asks if unclear)&#xa;• Expected: alignment, quantification, DE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="chat-int-1">
          <mxGeometry x="10" y="30" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-2" value="2. Tool Recommendations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="chat-panel">
          <mxGeometry x="340" y="100" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-2-detail" value="AI: &quot;I recommend:&#xa;• FastQC for quality control&#xa;• HISAT2 for alignment (handles&#xa;  splice junctions better than BWA)&#xa;• featureCounts for gene quantification&#xa;• DESeq2 for differential expression&quot;&#xa;&#xa;[Generates workflow in right panel]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="chat-int-2">
          <mxGeometry x="10" y="30" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-3" value="3. Parameter Guidance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="chat-panel">
          <mxGeometry x="20" y="240" width="280" height="140" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-3-detail" value="User clicks parameter button in workflow&#xa;→ Chat receives context&#xa;&#xa;AI: &quot;For the quality offset parameter:&#xa;• Illumina 1.8+: Use Phred+33&#xa;• Older Illumina: Use Phred+64&#xa;• Sanger: Use Phred+33&#xa;&#xa;Your data appears to be Illumina,&#xa;so I've pre-filled Phred+33.&quot;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="chat-int-3">
          <mxGeometry x="10" y="30" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-4" value="4. Dataset Recommendations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="chat-panel">
          <mxGeometry x="340" y="240" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-4-detail" value="AI queries BioMNI Dataset RAG:&#xa;&#xa;AI: &quot;For human RNA-seq, you'll need:&#xa;• Reference genome: hg38 (3.1 GB)&#xa;• Gene annotations: GENCODE v44&#xa;&#xa;I've added these to your workflow.&#xa;Would you like me to suggest&#xa;alternative references?&quot;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="chat-int-4">
          <mxGeometry x="10" y="30" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-5" value="5. Error Interpretation &amp; Debugging" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="chat-panel">
          <mxGeometry x="20" y="400" width="620" height="160" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-5-detail" value="Workflow fails → User clicks &quot;Ask Chat&quot;&#xa;&#xa;AI receives: tool_id + error_message + context&#xa;&#xa;AI: &quot;This error means the reference genome index is missing. Galaxy tried to find:&#xa;  /data/genomes/hg38/hisat2_index/*&#xa;&#xa;But it doesn't exist. Here are your options:&#xa;&#xa;1. [Recommended] I can add a 'Build HISAT2 Index' step before alignment&#xa;2. You can upload a pre-built index&#xa;3. Change to a different aligner that has the index&#xa;&#xa;Would you like me to fix option 1 automatically?&quot;&#xa;&#xa;[User clicks 'Yes'] → Chat updates workflow → Workflow view refreshes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="chat-int-5">
          <mxGeometry x="10" y="30" width="600" height="120" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-6" value="6. Education &amp; Documentation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="chat-panel">
          <mxGeometry x="20" y="580" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-6-detail" value="User: &quot;Why HISAT2 instead of STAR?&quot;&#xa;&#xa;AI: &quot;Both are excellent RNA-seq aligners:&#xa;&#xa;HISAT2:&#xa;• Faster, lower memory (8GB)&#xa;• Graph-based alignment&#xa;• Good for most use cases&#xa;&#xa;STAR:&#xa;• More sensitive for novel junctions&#xa;• Higher memory (32GB)&#xa;• Better for de novo transcripts&#xa;&#xa;For standard RNA-seq, HISAT2 is&#xa;usually sufficient. Want to switch?&quot;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="chat-int-6">
          <mxGeometry x="10" y="30" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-7" value="7. Workflow Suggestions &amp; Optimization" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="chat-panel">
          <mxGeometry x="340" y="580" width="300" height="160" as="geometry" />
        </mxCell>

        <mxCell id="chat-int-7-detail" value="AI analyzes workflow:&#xa;&#xa;AI: &quot;I notice your workflow could be&#xa;optimized:&#xa;&#xa;Current: QC → Align → Quantify → DE&#xa;&#xa;Suggestion: Add 'MultiQC' after QC&#xa;to aggregate quality reports.&#xa;&#xa;This won't slow down execution but&#xa;will give you better visualization.&#xa;&#xa;Add MultiQC step?&quot;&#xa;&#xa;[Kept in chat, NOT shown in workflow]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="chat-int-7">
          <mxGeometry x="10" y="30" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- Chat DON'Ts -->
        <mxCell id="chat-donts" value="What Chat Should NOT Do" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="chat-panel">
          <mxGeometry x="20" y="760" width="620" height="200" as="geometry" />
        </mxCell>

        <mxCell id="chat-donts-detail" value="❌ Display workflow graph&#xa;   → That's workflow view's job&#xa;&#xa;❌ Show execution progress bars&#xa;   → Workflow view tracks progress with Galaxy states&#xa;&#xa;❌ Display detailed parameter forms&#xa;   → Workflow view has parameter dialog&#xa;&#xa;❌ Show Galaxy job logs (stdout/stderr)&#xa;   → Workflow view displays raw logs&#xa;&#xa;❌ Provide workflow execution controls (Play/Pause/Stop)&#xa;   → Workflow view has execution controls&#xa;&#xa;✓ Instead: Chat EXPLAINS, SUGGESTS, GUIDES, INTERPRETS&#xa;✓ Workflow view EXECUTES, CONFIGURES, DISPLAYS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New;" vertex="1" parent="chat-donts">
          <mxGeometry x="10" y="30" width="600" height="160" as="geometry" />
        </mxCell>

        <!-- Workflow Panel -->
        <mxCell id="workflow-panel" value="WORKFLOW VIEW (Right Panel)" style="swimlane;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;startSize=40;" vertex="1" parent="1">
          <mxGeometry x="740" y="80" width="660" height="980" as="geometry" />
        </mxCell>

        <mxCell id="workflow-responsibility" value="Responsibility: Visual Execution Workspace" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;strokeColor=#6c8ebf;" vertex="1" parent="workflow-panel">
          <mxGeometry x="10" y="50" width="640" height="30" as="geometry" />
        </mxCell>

        <!-- Workflow Interactions -->
        <mxCell id="work-int-1" value="1. Workflow Graph Visualization" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="workflow-panel">
          <mxGeometry x="20" y="100" width="620" height="140" as="geometry" />
        </mxCell>

        <mxCell id="work-int-1-detail" value="┌─────────────────────────────────────────────────────────┐&#xa;│  [FastQC] → [HISAT2] → [featureCounts] → [DESeq2]      │&#xa;│     ○          ⟳             ○              ○            │&#xa;│  pending   running       pending        pending          │&#xa;│                                                          │&#xa;│ Node colors:  Gray=pending  Blue=running  Green=ok      │&#xa;│               Red=error     Yellow=paused                 │&#xa;│                                                          │&#xa;│ Hover node → Show dependencies highlighted              │&#xa;│ Click node → Parameter dialog OR execution controls     │&#xa;└─────────────────────────────────────────────────────────┘" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;" vertex="1" parent="work-int-1">
          <mxGeometry x="10" y="30" width="600" height="100" as="geometry" />
        </mxCell>

        <mxCell id="work-int-2" value="2. Parameter Configuration (3-Tier)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="workflow-panel">
          <mxGeometry x="20" y="260" width="620" height="180" as="geometry" />
        </mxCell>

        <mxCell id="work-int-2-detail" value="Click node → Parameter Dialog opens:&#xa;&#xa;┌─────────────────────────────────────┐&#xa;│ Configure: HISAT2 Alignment         │&#xa;│                                     │&#xa;│ ⚙️ Essential Parameters (3)         │&#xa;│   Reference Genome: [hg38     ▼]    │  ← From chat suggestion&#xa;│   Alignment Mode:  [end-to-end ▼]   │  ← Smart default&#xa;│   Strand Specific: [unstranded ▼]   │&#xa;│                                     │&#xa;│ 📊 Common (8 more)    [Expand ▼]    │&#xa;│                                     │&#xa;│ 🔧 Advanced (45 more) [Expand ▼]    │&#xa;│                                     │&#xa;│ 💡 AI Suggestion from chat:          │&#xa;│ &quot;For paired-end RNA-seq, I recommend│&#xa;│  --rna-strandness FR setting&quot;       │&#xa;│                                     │&#xa;│ [Cancel]  [Apply]  [Apply &amp; Run]    │&#xa;└─────────────────────────────────────┘" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;" vertex="1" parent="work-int-2">
          <mxGeometry x="10" y="30" width="600" height="140" as="geometry" />
        </mxCell>

        <mxCell id="work-int-3" value="3. Execution Controls &amp; Progress" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="workflow-panel">
          <mxGeometry x="20" y="460" width="620" height="160" as="geometry" />
        </mxCell>

        <mxCell id="work-int-3-detail" value="Workflow-Level Controls:&#xa;[▶ Run All] [⏸ Pause] [⏹ Stop] [↻ Restart]&#xa;&#xa;Real-Time Progress (from Galaxy states):&#xa;&#xa;Step 1: FastQC                    [✓ Completed]&#xa;  └─ Job job_123 | State: ok | Elapsed: 37s&#xa;     [View Logs] [Download Output: fastqc_report.html]&#xa;&#xa;Step 2: HISAT2                    [⟳ Running]&#xa;  └─ Job job_124 | State: running | Elapsed: 2m 15s&#xa;     [View Live Logs]&#xa;&#xa;Step 3: featureCounts             [○ Queued]&#xa;  └─ Job job_125 | State: queued&#xa;     Waiting for Step 2..." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;" vertex="1" parent="work-int-3">
          <mxGeometry x="10" y="30" width="600" height="120" as="geometry" />
        </mxCell>

        <mxCell id="work-int-4" value="4. Galaxy Log Display" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="workflow-panel">
          <mxGeometry x="20" y="640" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="work-int-4-detail" value="Click [View Logs] →&#xa;&#xa;Shows actual Galaxy stdout/stderr:&#xa;&#xa;[stdout]&#xa;HISAT2 version 2.2.1&#xa;Loading genome index...&#xa;Aligning reads... 45% complete" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;" vertex="1" parent="work-int-4">
          <mxGeometry x="10" y="30" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="work-int-5" value="5. Result Viewing &amp; Download" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="workflow-panel">
          <mxGeometry x="340" y="640" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="work-int-5-detail" value="Click completed step →&#xa;&#xa;Output Datasets:&#xa;• aligned_reads.bam (2.3 GB)&#xa;  [Download] [Preview]&#xa;• alignment_summary.txt&#xa;  [Download] [View]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;" vertex="1" parent="work-int-5">
          <mxGeometry x="10" y="30" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- Workflow DON'Ts -->
        <mxCell id="workflow-donts" value="What Workflow View Should NOT Do" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="workflow-panel">
          <mxGeometry x="20" y="760" width="620" height="200" as="geometry" />
        </mxCell>

        <mxCell id="workflow-donts-detail" value="❌ Explain WHY to use a tool&#xa;   → Chat provides explanations and education&#xa;&#xa;❌ Provide tutorials or best practices&#xa;   → Chat links to documentation&#xa;&#xa;❌ Recommend alternative tools&#xa;   → Chat makes tool recommendations&#xa;&#xa;❌ Interpret error messages&#xa;   → Chat interprets errors and suggests fixes&#xa;   → Workflow just SHOWS raw Galaxy error&#xa;&#xa;❌ Suggest workflow optimizations&#xa;   → Chat analyzes and suggests improvements&#xa;&#xa;✓ Instead: Workflow VISUALIZES, EXECUTES, CONFIGURES&#xa;✓ Chat EXPLAINS, SUGGESTS, GUIDES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New;" vertex="1" parent="workflow-donts">
          <mxGeometry x="10" y="30" width="600" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="4. Backend Architecture" id="backend-arch">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title4" value="Backend Architecture - Node.js/Express + Galaxy Integration" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- Express App -->
