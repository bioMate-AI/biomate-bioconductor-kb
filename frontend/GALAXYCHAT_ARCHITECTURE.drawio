        <mxCell id="arrow2-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="step2-3" target="step2-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow2-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="step2-4" target="step2-5">
          <mxGeometry relative="1" as="geometry" />
