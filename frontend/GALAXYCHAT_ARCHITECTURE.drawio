        <mxCell id="route-tool-search" value="POST /api/galaxy/&#xa;tool-search" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="routes-layer">
