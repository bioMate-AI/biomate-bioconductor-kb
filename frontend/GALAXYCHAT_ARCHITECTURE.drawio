        <mxCell id="step2-1" value="1. User Clicks Run&#xa;&#xa;Workflow View:&#xa;Click &quot;Run Workflow&quot; button" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;" vertex="1" parent="1">
