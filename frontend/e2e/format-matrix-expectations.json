{
  "$comment": "Expected per-format outcomes for e2e/dataset-format-matrix.e2e.ts. Written for the TARGET behaviour of docs/20261112_DATASET_PANEL_AUDIT.md in the backend profiler's own vocabulary (data_perception.py decide(): profile.viewKind, quality 'unassessed', per-kind stats from _VIEW_STATS), and the panel's per-kind views (no Table/Columns/Plot/Edit on non-tables). The harness computes PASS / PARTIAL / FAIL from these checks and writes the counts to e2e/format-matrix-results.json; nobody grades by hand. Change an expectation only for a benchmark-design error (the expected answer is wrong for the format), never to match current behaviour. 2026-11-12 seams: vocabulary aligned to the profiler (sequence→sequences, density→image for MRC (the profiler classes MRC/MRCS as image, drawn by the density viewer), signal→binary for POD5, xlsx→document, BED/narrowPeak→intervals, GTF/GFF3→annotation, VCF→variants, loom→loom); stats per kind follow _VIEW_STATS.",
  "contract": {
    "dataset-object": "[data-testid=dataset-object] carries data-view-kind = profile.viewKind (one of viewKinds)",
    "dataset-preview": "[data-testid=dataset-preview] carries data-preview-kind = the renderer actually shown (one of viewKinds, or 'none' / 'error'), and aria-busy=true while it loads",
    "stats": "each stat card is [data-testid=dataset-stat][data-stat=<code>] (the kind's own measures in the profiler's stat codes — rows, columns, reads, read_length, sequences, bases, variants, samples, regions, features, cells, genes, references, molecules, chains, sheets, entries, records, tables — then size, type)",
    "quality": "[data-testid=data-perception][data-quality] in good | watch | blocked | unassessed; watch/blocked always list >= 1 [data-testid=perception-why-item]",
    "columns": "rowKinds show the paged rows table: header cells th[data-column-name] (falls back to th innerText); compared case-insensitively",
    "toggles": "Table/Columns/Plot/Edit controls are [data-testid=dataset-preview-toggle-<key>] and render only for toggleKinds",
    "loading": "every loading indicator inside dataset-object is [data-testid$=-loading] or [aria-busy=true]",
    "tree": "folder rows [data-testid=folder-<path>] carry aria-expanded",
    "findings": "every rendered QC finding is [data-testid=perception-why-item] (a verdict reason) or [data-testid=perception-finding], both with data-code",
    "previewTestids": "an item's requirePreviewTestids must each appear as a [data-testid] inside the Preview (outside the QC card) — e.g. the server-rendered TIFF plane, the spreadsheet's read-only first-sheet table"
  },
