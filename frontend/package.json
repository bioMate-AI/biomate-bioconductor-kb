{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "admin:set": "tsx scripts/set-admin.ts",
    "admin:invite": "tsx scripts/create-invite-codes.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:isolated": "bash scripts/run-e2e-isolated.sh",
    "e2e:isolated:complete": "bash scripts/run-e2e-isolated.sh e2e/complete-workflow.e2e.ts --project chromium --trace off --retries=0",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:feedback:matrix": "bash scripts/run-feedback-e2e-matrix.sh",
    "e2e:report": "playwright show-report e2e/reports",
    "pm:wire:deps": "bash scripts/check-pm-wire-deps.sh",
    "pm:wire:quick": "bash scripts/run-pm-test-wire.sh quick",
    "pm:wire:full": "bash scripts/run-pm-test-wire.sh full",
    "pm:wire:release": "PM_WIRE_STRICT=1 bash scripts/run-pm-test-wire.sh full"
  },
