# Apply to both frontend and backend. Restart both after changing deployment mode.
BIOMATE_LOCAL_ONLY=1
BIOMATE_LOCAL_LLM_URL=http://127.0.0.1:8000/v1
BIOMATE_LOCAL_LLM_ORIGIN=http://127.0.0.1:8000
BIOMATE_LOCAL_LLM_MODEL=Qwen/Qwen3.8-27B
BIOMATE_LOCAL_LLM_TIMEOUT_MS=120000
# Optional authentication for a server configured with an API key:
# BIOMATE_LOCAL_LLM_KEY=
# No external model API keys are required. Customer deployment must deny external
# inference egress at the network boundary; this file alone is not that boundary.
