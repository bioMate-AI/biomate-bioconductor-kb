        <mxCell id="sec-layer2-items" value="✓ JWT authentication (RS256 signatures)&#xa;✓ RBAC authorization (Admin, User, Researcher, Clinician)&#xa;✓ Session timeout (30 minutes)&#xa;✓ MFA enforcement (TOTP)&#xa;✓ Rate limiting (per user, per IP)&#xa;✓ Input validation (all API endpoints)&#xa;✓ CORS whitelisting&#xa;✓ CSRF protection&#xa;✓ CSP headers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="330" width="380" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="sec-layer3" value="Layer 3: Data Security" style="text;html=1;strokeColor=none;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1320" y="480" width="400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="sec-layer3-items" value="✓ Encryption at rest:&#xa;  • S3: SSE-S3 (default), SSE-KMS (PHI)&#xa;  • RDS: KMS encryption&#xa;  • EBS: KMS encryption&#xa;  • Redis: Encryption enabled&#xa;✓ Encryption in transit:&#xa;  • TLS 1.2+ (all services)&#xa;  • Redis: TLS enabled&#xa;  • RDS: SSL enforced&#xa;✓ Key rotation (KMS: 365 days)&#xa;✓ Presigned URLs (1-hour TTL)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="520" width="380" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="sec-layer4" value="Layer 4: Network Security" style="text;html=1;strokeColor=none;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1320" y="710" width="400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="sec-layer4-items" value="✓ VPC isolation (10.0.0.0/16)&#xa;✓ Private subnets (backend, data layer)&#xa;✓ Public subnets (ALB only)&#xa;✓ Security groups (least privilege)&#xa;  • ALB: 443 from 0.0.0.0/0&#xa;  • Backend: 8080 from ALB only&#xa;  • RDS: 5432 from backend only&#xa;  • Redis: 6379 from backend only&#xa;✓ NACLs (deny list)&#xa;✓ VPC Flow Logs&#xa;✓ NAT gateways (private subnet egress)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="750" width="380" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="sec-layer5" value="Layer 5: Audit &amp; Compliance" style="text;html=1;strokeColor=none;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1320" y="930" width="400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="sec-layer5-items" value="✓ CloudTrail (all API calls)&#xa;✓ Application audit logs:&#xa;  • Authentication events&#xa;  • Authorization failures&#xa;  • Data access (PHI)&#xa;  • Admin actions&#xa;✓ Log retention:&#xa;  • Application: 90 days (CloudWatch)&#xa;  • Audit: 6 years (S3 Glacier)&#xa;  • Access: 1 year (S3)&#xa;✓ CloudWatch alarms:&#xa;  • Failed login >10/hour&#xa;  • Error rate >5%&#xa;  • Unauthorized access&#xa;✓ DataDog APM (performance + errors)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="970" width="380" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="sec-layer6" value="Layer 6: Backup &amp; DR" style="text;html=1;strokeColor=none;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1320" y="1180" width="400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="sec-layer6-items" value="✓ RDS automated backups (7 days)&#xa;✓ Point-in-time recovery&#xa;✓ S3 versioning (all buckets)&#xa;✓ Multi-AZ deployment (RDS, Redis)&#xa;✓ Cross-region backup (S3 replication)&#xa;✓ Backup testing (quarterly)&#xa;✓ RTO: 4 hours&#xa;✓ RPO: 1 hour" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
