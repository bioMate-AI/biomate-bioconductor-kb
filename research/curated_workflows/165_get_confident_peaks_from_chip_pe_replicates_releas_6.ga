{
  "a_galaxy_workflow": "true",
  "annotation": "This workflow takes as input PE BAM from ChIP-seq. It calls peaks on each replicate and intersect them. In parallel, each BAM is subsetted to smallest number of reads. Peaks are called using all subsets combined. Only peaks called using a combination of all subsets which have summits intersecting the intersection of at least x replicates will be kept.",
  "comments": [
    {
      "child_steps": [
        4,
        7,
        10,
        11,
        14,
        15,
        16,
        17,
        18,
        19
      ],
      "color": "none",
      "data": {
        "title": "Downsample input BAM to get the same number of reads"
      },
      "id": 1,
      "position": [
        180.2,
        744.1
      ],
      "size": [
        1889,
        379
      ],
