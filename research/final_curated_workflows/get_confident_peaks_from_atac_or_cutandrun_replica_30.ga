{
  "a_galaxy_workflow": "true",
  "annotation": "This workflow takes as input BAM from ATAC-seq or CUT&amp;RUN. It calls peaks on each replicate and intersect them. In parallel, each BAM is subsetted to smallest number of reads. Peaks are called using all subsets combined. Only peaks called using a combination of all subsets which have summits intersecting the intersection of at least x replicates will be kept.",
  "comments": [
    {
      "child_steps": [
        10,
        14
      ],
      "color": "green",
      "data": {
        "title": "Get the average coverage"
      },
      "id": 1,
      "position": [
        647.1,
        523.9
      ],
      "size": [
        504.5,
        324
      ],
      "type": "frame"
    },
