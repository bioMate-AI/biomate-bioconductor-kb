<template>
    <div class="ai-assistant-panel">
        <!-- Toggle Button -->
        <button 
            class="ai-toggle-btn"
            @click="togglePanel"
            :class="{ 'active': isOpen }"
            title="Galaxy AI Assistant"
        >
            <i class="fa fa-robot"></i>
            <span v-if="hasUnreadMessages" class="notification-badge">{{ unreadCount }}</span>
        </button>

        <!-- Sliding Panel -->
        <transition name="slide">
            <div v-if="isOpen" class="ai-panel">
                <div class="ai-panel-header">
                    <h3>AI Assistant</h3>
                    <button class="close-btn" @click="togglePanel">
                        <i class="fa fa-times"></i>
                    </button>
                </div>

                <div class="ai-panel-content">
                    <!-- Quick Actions -->
                    <div class="quick-actions">
                        <h4>Quick Start</h4>
                        <div class="action-buttons">
                            <button 
                                class="action-btn"
                                @click="suggestQuickAction('rna-seq')"
                            >
                                <i class="fa fa-dna"></i>
                                RNA-seq Analysis
                            </button>
                            <button 
                                class="action-btn"
                                @click="suggestQuickAction('variant-calling')"
                            >
                                <i class="fa fa-search"></i>
                                Variant Calling
                            </button>
                            <button 
                                class="action-btn"
                                @click="suggestQuickAction('assembly')"
                            >
                                <i class="fa fa-puzzle-piece"></i>
                                Genome Assembly
                            </button>
                            <button 
                                class="action-btn"
                                @click="suggestQuickAction('quality-control')"
                            >
                                <i class="fa fa-check-circle"></i>
                                Quality Control
                            </button>
                        </div>
                    </div>

                    <!-- Chat Interface -->
                    <div class="chat-section">
                        <h4>Ask AI Assistant</h4>
                        
                        <!-- Messages -->
                        <div class="chat-messages" ref="chatContainer">
                            <div v-if="messages.length === 0" class="welcome-message">
                                <div class="welcome-icon">
                                    <i class="fa fa-robot"></i>
                                </div>
                                <p>Hello! I'm your Galaxy AI Assistant. I can help you:</p>
                                <ul>
                                    <li>Design bioinformatics workflows</li>
                                    <li>Recommend appropriate tools</li>
                                    <li>Explain analysis steps</li>
                                    <li>Optimize your pipelines</li>
                                </ul>
                                <p>Just describe what you want to analyze!</p>
                            </div>

                            <div 
                                v-for="message in messages" 
                                :key="message.id"
                                class="message"
                                :class="message.type"
                            >
                                <div class="message-content">
                                    <div class="message-text">{{ message.text }}</div>
                                    <div v-if="message.actions" class="message-actions">
                                        <button 
                                            v-for="action in message.actions"
                                            :key="action.id"
                                            class="action-btn-sm"
                                            @click="performAction(action)"
                                        >
                                            {{ action.label }}
                                        </button>
                                    </div>
                                </div>
                                <div class="message-time">
                                    {{ formatTime(message.timestamp) }}
                                </div>
                            </div>
                        </div>

                        <!-- Workflow Recommendations Section -->
                        <div v-if="workflowRecommendations.length > 0" class="recommendations-section">
                            <!-- Quick Recommendations -->
                            <div class="quick-recommendations">
                                <h4 @click="toggleRecommendations" class="recommendations-header">
                                    <i class="fa fa-bolt"></i> 
                                    Quick Recommendations ({{ workflowRecommendations.length }})
                                    <i class="fa toggle-icon" :class="showRecommendations ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
                                </h4>
                                <div v-show="showRecommendations" class="recommendation-cards-container">
                                    <div class="recommendation-cards">
                                        <div 
                                            v-for="rec in workflowRecommendations" 
                                            :key="rec.workflow_id"
                                            class="recommendation-card"
                                        >
                                        <div class="card-header">
                                            <h5>{{ rec.name }}</h5>
                                            <span class="confidence-badge">{{ formatConfidence(rec.confidence) }}%</span>
                                        </div>
                                        <div class="card-content">
                                            <p class="description">{{ formatDescription(rec.description) }}</p>
                                            <div class="card-meta">
                                                <span class="steps-info">
                                                    <i class="fa fa-list"></i> {{ rec.steps }} steps
                                                </span>
                                                <span class="tools-info" v-if="rec.tools && rec.tools.length > 0">
                                                    <i class="fa fa-tools"></i> {{ rec.tools.slice(0, 2).join(', ') }}
                                                    <span v-if="rec.tools.length > 2">+{{ rec.tools.length - 2 }} more</span>
                                                </span>
                                            </div>
                                            <div class="card-tags" v-if="rec.tags && rec.tags.length > 0">
                                                <span 
                                                    v-for="tag in rec.tags.slice(0, 3)" 
                                                    :key="tag"
                                                    class="tag"
                                                >{{ tag }}</span>
                                            </div>
                                        </div>
                                        <div class="card-actions">
                                            <button class="action-btn-sm primary" @click="selectWorkflow(rec)">
                                                <i class="fa fa-check"></i> Select
                                            </button>
                                            <button class="action-btn-sm" @click="previewWorkflow(rec)">
                                                <i class="fa fa-eye"></i> Preview
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <!-- Enhanced Workflow Button -->
                                    <div class="enhanced-workflow-section">
                                        <button 
                                            @click="getEnhancedWorkflow"
                                            :disabled="isEnhancing"
                                            class="enhanced-workflow-btn"
                                            :class="{ 'loading': isEnhancing }"
                                        >
                                            <i v-if="isEnhancing" class="fa fa-spinner fa-spin"></i>
                                            <i v-else class="fa fa-magic"></i>
                                            {{ isEnhancing ? 'Generating Enhanced Workflow...' : 'Get AI-Generated Enhanced Workflow' }}
                                        </button>
                                        <div class="enhanced-hint">
                                            Get a custom AI-generated workflow tailored specifically for your needs (2-5s)
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Enhanced Workflow Results -->
                            <div v-if="enhancedWorkflow" class="enhanced-workflow">
                                <h4>
                                    <i class="fa fa-star"></i> 
                                    AI-Enhanced Workflow
                                </h4>
                                <div class="enhanced-card">
                                    <div class="enhanced-header">
                                        <h5>{{ enhancedWorkflow.name }}</h5>
                                        <span class="method-badge">{{ enhancedWorkflow.method }}</span>
                                        <span class="confidence-badge enhanced">{{ formatConfidence(enhancedWorkflow.confidence) }}%</span>
                                    </div>
                                    <div class="enhanced-content">
                                        <p class="description">{{ enhancedWorkflow.description }}</p>
                                        
                                        <div class="workflow-steps" v-if="enhancedWorkflow.steps && enhancedWorkflow.steps.length > 0">
                                            <h6><i class="fa fa-list-ol"></i> Workflow Steps:</h6>
                                            <ol>
                                                <li v-for="step in enhancedWorkflow.steps.slice(0, 5)" :key="step.id">
                                                    <strong>{{ step.annotation || step.tool_id }}</strong>
                                                </li>
                                                <li v-if="enhancedWorkflow.steps.length > 5">
                                                    ...and {{ enhancedWorkflow.steps.length - 5 }} more steps
                                                </li>
                                            </ol>
                                        </div>
                                        
                                        <div class="enhanced-meta">
                                            <div class="meta-item">
                                                <i class="fa fa-clock"></i> 
                                                Response Time: {{ enhancedWorkflow.response_time }}
                                            </div>
                                            <div class="meta-item" v-if="enhancedWorkflow.similar_workflows_count">
                                                <i class="fa fa-database"></i> 
                                                Based on {{ enhancedWorkflow.similar_workflows_count }} similar workflows
                                            </div>
                                        </div>
                                        
                                        <div class="enhanced-tags" v-if="enhancedWorkflow.tags && enhancedWorkflow.tags.length > 0">
                                            <span 
                                                v-for="tag in enhancedWorkflow.tags.slice(0, 5)" 
                                                :key="tag"
                                                class="tag enhanced"
                                            >{{ tag }}</span>
                                        </div>
                                    </div>
                                    <div class="enhanced-actions">
                                        <button class="action-btn primary" @click="createEnhancedWorkflow">
                                            <i class="fa fa-plus"></i> Create This Workflow
                                        </button>
                                        <button class="action-btn" @click="exportEnhancedWorkflow">
                                            <i class="fa fa-download"></i> Export
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Input -->
                        <div class="chat-input-section">
                            <div class="input-wrapper">
                                <input
                                    v-model="currentInput"
                                    type="text"
                                    placeholder="Describe your analysis needs..."
                                    @keyup.enter="sendMessage"
                                    :disabled="isProcessing"
                                    class="chat-input"
                                />
                                <button 
                                    @click="sendMessage"
                                    :disabled="!currentInput.trim() || isProcessing"
                                    class="send-btn"
                                >
                                    <i v-if="isProcessing" class="fa fa-spinner fa-spin"></i>
                                    <i v-else class="fa fa-paper-plane"></i>
                                </button>
                            </div>
                            <div class="input-hint">
                                Try: "Analyze differential gene expression from RNA-seq data"
                            </div>
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="ai-status-footer">
                        <div class="status-indicator" :class="{ 'connected': isConnected }">
                            <span class="status-dot"></span>
                            {{ isConnected ? 'AI Assistant Ready' : 'Connecting...' }}
                        </div>
                        <button 
                            class="expand-btn"
                            @click="openFullInterface"
                            title="Open full AI Assistant interface"
                        >
                            <i class="fa fa-expand"></i>
                        </button>
                    </div>
                </div>
            </div>
        </transition>
    </div>
</template>

<script>
import { ref, computed, onMounted, nextTick } from 'vue'
import { getAppRoot } from 'onload/loadConfig'
import axios from 'axios'

export default {
    name: 'AIAssistantPanel',
    setup() {
        const isOpen = ref(false)
        const isConnected = ref(false)
        const isProcessing = ref(false)
        const messages = ref([])
        const currentInput = ref('')
        const chatContainer = ref(null)
        const unreadCount = ref(0)
        
        // New RAG recommendations data
        const workflowRecommendations = ref([])
        const enhancedWorkflow = ref(null)
        const isEnhancing = ref(false)
        const lastUserQuery = ref('')
        const showRecommendations = ref(false) // Collapsed by default to save space

        const hasUnreadMessages = computed(() => unreadCount.value > 0)

        // Utility methods for template formatting
        const formatConfidence = (confidence) => {
            return Math.round((confidence || 0) * 100)
        }

        const formatDescription = (description, maxLength = 100) => {
            if (!description) return ''
            if (description.length <= maxLength) return description
            return description.substring(0, maxLength) + '...'
        }

        // Check AI status
        const checkStatus = async () => {
            try {
                const response = await axios.get(`${getAppRoot()}api/ai_assistant/status`)
                isConnected.value = response.data.ready
            } catch (error) {
                console.error('AI Assistant status check failed:', error)
                isConnected.value = false
            }
        }

        // Toggle panel visibility
        const togglePanel = () => {
            isOpen.value = !isOpen.value
            if (isOpen.value) {
                unreadCount.value = 0
            }
        }

        // Send message to AI
        const sendMessage = async () => {
            if (!currentInput.value.trim() || isProcessing.value) return

            const userMessage = {
                id: Date.now(),
                type: 'user',
                text: currentInput.value,
                timestamp: new Date()
            }

            messages.value.push(userMessage)
            
            const requestText = currentInput.value
            currentInput.value = ''
            isProcessing.value = true
            
            // Store the query for enhanced workflow generation
            lastUserQuery.value = requestText
            
            // Clear previous recommendations
            workflowRecommendations.value = []
            enhancedWorkflow.value = null

            try {
                // First, try to get quick RAG recommendations (don't fail if this fails)
                try {
                    const ragResponse = await axios.post(
                        `${getAppRoot()}api/ai_assistant/enhanced_workflow_recommendations?level=quick`,
                        {
                            request_text: requestText,
                            context: {}
                        }
                    )

                    // Process RAG recommendations
                    if (ragResponse.data.status === 'success' && ragResponse.data.recommendations) {
                        workflowRecommendations.value = ragResponse.data.recommendations
                        // Auto-expand when new recommendations arrive
                        if (ragResponse.data.recommendations.length > 0) {
                            showRecommendations.value = true
                        }
                    }
                } catch (ragError) {
                    console.warn('RAG recommendations failed, continuing with standard flow:', ragError)
                }

                // Also call the original process_request for full AI analysis
                const response = await axios.post(
                    `${getAppRoot()}api/ai_assistant/process_request`,
                    {
                        request_text: requestText,
                        context: {},
                        available_datasets: [],
                        preferred_tools: null,
                        constraints: {}
                    }
                )

                const aiResponse = response.data
                let responseText = 'I understand your request. '

                // Mention RAG recommendations if available
                if (workflowRecommendations.value.length > 0) {
                    responseText += `I found ${workflowRecommendations.value.length} similar workflows from our database that match your needs. `
                }

                if (aiResponse.decomposed_tasks.length > 0) {
                    responseText += `I've identified ${aiResponse.decomposed_tasks.length} key steps for your analysis. `
                }

                if (aiResponse.tool_recommendations.length > 0) {
                    responseText += `I recommend ${aiResponse.tool_recommendations.length} tools that would be suitable. `
                }

                if (aiResponse.workflow_template) {
                    responseText += `I found workflow options for you. `
                }

                if (workflowRecommendations.value.length > 0) {
                    responseText += `You can select from the recommended workflows below or click "Get AI-Generated Enhanced Workflow" for a custom solution.`
                } else if (aiResponse.workflow_template) {
                    responseText += `Let me show you the available choices.`
                }

                // Create action buttons based on response
                const actions = []
                
                if (aiResponse.workflow_template) {
                    actions.push({
                        id: 'show_workflow_options',
                        label: 'View Workflow Options',
                        data: aiResponse.workflow_template
                    })
                }

                if (aiResponse.tool_recommendations.length > 0) {
                    actions.push({
                        id: 'view_tools',
                        label: 'View Tools',
                        data: aiResponse.tool_recommendations
                    })
                }

                actions.push({
                    id: 'view_details',
                    label: 'View Details',
                    data: aiResponse
                })

                const aiMessage = {
                    id: Date.now() + 1,
                    type: 'ai',
                    text: responseText,
                    actions: actions,
                    timestamp: new Date(),
                    fullResponse: aiResponse
                }

                messages.value.push(aiMessage)

                // Update unread count if panel is closed
                if (!isOpen.value) {
                    unreadCount.value++
                }

            } catch (error) {
                console.error('AI request failed:', error)
                
                const errorMessage = {
                    id: Date.now() + 1,
                    type: 'ai',
                    text: 'Sorry, I encountered an error. Please try again or contact support.',
                    timestamp: new Date()
                }

                messages.value.push(errorMessage)
            } finally {
                isProcessing.value = false
                await nextTick()
                scrollToBottom()
            }
        }

        // Suggest quick action
        const suggestQuickAction = (actionType) => {
            const suggestions = {
                'rna-seq': 'I want to perform differential gene expression analysis on RNA-seq data',
                'variant-calling': 'I need to call variants from whole genome sequencing data',
                'assembly': 'I want to assemble a genome from long-read sequencing data',
                'quality-control': 'I need to assess the quality of my sequencing reads'
            }

            currentInput.value = suggestions[actionType] || ''
        }

        // Perform action from AI response
        const performAction = async (action) => {
            switch (action.id) {
                case 'show_workflow_options':
                    showWorkflowOptions(action.data)
                    break
                case 'create_workflow':
                    await createWorkflow(action.data)
                    break
                case 'view_tools':
                    showToolRecommendations(action.data)
                    break
                case 'view_details':
                    openFullInterface(action.data)
                    break
                case 'open_editor':
                case 'open_workflow_editor':
                    // Open workflow editor
                    const editorUrl = action.url || (action.data && action.data.url)
                    if (editorUrl) {
                        window.open(getAppRoot() + (editorUrl.startsWith('/') ? editorUrl.substring(1) : editorUrl), '_blank')
                    }
                    break
                case 'view_workflows':
                    // Navigate to workflows list  
                    const workflowsUrl = action.url || (action.data && action.data.url) || '/workflows/list'
                    window.open(getAppRoot() + (workflowsUrl.startsWith('/') ? workflowsUrl.substring(1) : workflowsUrl), '_blank')
                    break
                case 'login':
                    // Navigate to login page
                    window.location.href = getAppRoot() + action.data.url.substring(1)
                    break
            }
        }

        // Create workflow
        const createWorkflow = async (workflowData) => {
            try {
                const response = await axios.post(
                    `${getAppRoot()}api/ai_assistant/create_workflow`,
                    {
                        request_text: `Create workflow: ${workflowData.name}`,
                        context: { workflow_template: workflowData }
                    }
                )

                const result = response.data
                let messageText = ''
                let actions = []

                if (result.status === 'success') {
                    messageText = `✅ ${result.message} You can find it in Workflow menu → My Workflows.`
                    actions = [
                        {
                            id: 'open_workflow_editor',
                            label: 'Open Workflow Editor',
                            data: { url: result.workflow_url }
                        },
                        {
                            id: 'view_workflows',
                            label: 'View My Workflows',
                            data: { url: '/workflows/list' }
                        }
                    ]
                } else if (result.status === 'partial_success') {
                    messageText = `⚠️ ${result.message}\n\nError details: ${result.error}`
                } else {
                    messageText = `❌ ${result.message || result.note}`
                    if (result.error) {
                        messageText += `\n\nError: ${result.error}`
                    }
                }

                const resultMessage = {
                    id: Date.now(),
                    type: 'ai',
                    text: messageText,
                    actions: actions,
                    timestamp: new Date()
                }

                messages.value.push(resultMessage)
                await nextTick()
                scrollToBottom()

            } catch (error) {
                console.error('Workflow creation failed:', error)
                
                let errorText = 'Sorry, I couldn\'t create the workflow.'
                let actions = []
                
                if (error.response && error.response.data) {
                    if (error.response.status === 401) {
                        errorText = '🔐 You need to be logged in to create workflows. Please log in to Galaxy first.'
                        actions = [
                            {
                                id: 'login',
                                label: 'Go to Login',
                                data: { url: '/login' }
                            }
                        ]
                    } else if (error.response.data.detail) {
                        errorText += `\n\nError: ${error.response.data.detail}`
                    } else if (error.response.data.error) {
                        errorText += `\n\nError: ${error.response.data.error}`
                    }
                }
                
                const errorMessage = {
                    id: Date.now(),
                    type: 'ai',
                    text: errorText,
                    actions: actions,
                    timestamp: new Date()
                }

                messages.value.push(errorMessage)
            }
        }

        // Show workflow options
        const showWorkflowOptions = async (workflowData) => {
            try {
                // Get workflow recommendations from API
                const response = await axios.post(
                    `${getAppRoot()}api/ai_assistant/get_workflow_recommendations`,
                    {
                        request_text: `Get workflow options for: ${workflowData.name || 'analysis'}`,
                        context: { workflow_template: workflowData }
                    }
                )

                const recommendations = response.data.recommendations || []
                
                let optionsText = `I found ${recommendations.length} workflow options for you:\n\n`
                
                const actions = []
                
                recommendations.forEach((rec, index) => {
                    optionsText += `${index + 1}. **${rec.name}** (${rec.type})\n`
                    optionsText += `   - ${rec.description}\n`
                    optionsText += `   - Confidence: ${(rec.confidence * 100).toFixed(0)}%\n`
                    optionsText += `   - Status: ${rec.validation_status}\n\n`
                    
                    actions.push({
                        id: 'create_workflow',
                        label: `Use ${rec.name}`,
                        data: { 
                            ...workflowData, 
                            template_id: rec.template_id,
                            workflow_type: rec.type 
                        }
                    })
                })

                const optionsMessage = {
                    id: Date.now(),
                    type: 'ai',
                    text: optionsText,
                    actions: actions,
                    timestamp: new Date()
                }

                messages.value.push(optionsMessage)
                await nextTick()
                scrollToBottom()

            } catch (error) {
                console.error('Failed to get workflow options:', error)
                
                // Fallback to simple workflow creation
                const fallbackMessage = {
                    id: Date.now(),
                    type: 'ai',
                    text: 'I can create a basic workflow for you. Would you like to proceed?',
                    actions: [{
                        id: 'create_workflow',
                        label: 'Create Basic Workflow',
                        data: workflowData
                    }],
                    timestamp: new Date()
                }

                messages.value.push(fallbackMessage)
            }
        }

        // Show tool recommendations
        const showToolRecommendations = (tools) => {
            const toolNames = tools.map(t => t.tool_name).join(', ')
            
            const toolMessage = {
                id: Date.now(),
                type: 'ai',
                text: `Here are the recommended tools: ${toolNames}. Click "View Details" to see more information about each tool.`,
                actions: [{
                    id: 'view_details',
                    label: 'View Details',
                    data: { tool_recommendations: tools }
                }],
                timestamp: new Date()
            }

            messages.value.push(toolMessage)
        }

        // Open full AI interface
        const openFullInterface = (data = null) => {
            // This would open the full AIAssistant component
            // In a real implementation, this might be a route navigation or modal
            console.log('Opening full AI interface with data:', data)
            
            // For now, just show a message
            const message = {
                id: Date.now(),
                type: 'ai',
                text: 'Opening full AI Assistant interface... (This would navigate to the complete interface)',
                timestamp: new Date()
            }

            messages.value.push(message)
        }

        // Scroll chat to bottom
        const scrollToBottom = () => {
            if (chatContainer.value) {
                chatContainer.value.scrollTop = chatContainer.value.scrollHeight
            }
        }

        // Format time
        const formatTime = (timestamp) => {
            return new Intl.DateTimeFormat('en-US', {
                hour: '2-digit',
                minute: '2-digit'
            }).format(timestamp)
        }

        // Initialize
        onMounted(() => {
            checkStatus()
        })

        // Add missing methods for new RAG functionality
        const getEnhancedWorkflow = async () => {
            if (!lastUserQuery.value || isEnhancing.value) return
            
            isEnhancing.value = true
            try {
                const response = await axios.post(
                    `${getAppRoot()}api/ai_assistant/enhanced_workflow_recommendations?level=enhanced`,
                    {
                        request_text: lastUserQuery.value,
                        context: {}
                    }
                )
                
                if (response.data.status === 'success' && response.data.workflow) {
                    enhancedWorkflow.value = response.data.workflow
                    enhancedWorkflow.value.method = response.data.method
                    enhancedWorkflow.value.response_time = response.data.response_time
                    enhancedWorkflow.value.confidence = response.data.confidence
                    enhancedWorkflow.value.similar_workflows_count = response.data.similar_workflows_count
                }
            } catch (error) {
                console.error('Enhanced workflow generation failed:', error)
            } finally {
                isEnhancing.value = false
            }
        }

        const selectWorkflow = (workflow) => {
            console.log('Selected workflow:', workflow)
            // You can implement workflow selection logic here
        }

        const previewWorkflow = (workflow) => {
            console.log('Preview workflow:', workflow)
            // You can implement workflow preview logic here
        }

        const createEnhancedWorkflow = () => {
            console.log('Create enhanced workflow:', enhancedWorkflow.value)
            // You can implement workflow creation logic here
        }

        const exportEnhancedWorkflow = () => {
            console.log('Export enhanced workflow:', enhancedWorkflow.value)
            // You can implement workflow export logic here
        }

        const toggleRecommendations = () => {
            showRecommendations.value = !showRecommendations.value
        }

        return {
            isOpen,
            isConnected,
            isProcessing,
            messages,
            currentInput,
            chatContainer,
            unreadCount,
            hasUnreadMessages,
            togglePanel,
            sendMessage,
            suggestQuickAction,
            performAction,
            createWorkflow,
            showWorkflowOptions,
            showToolRecommendations,
            openFullInterface,
            formatTime,
            // New RAG-related properties and methods
            workflowRecommendations,
            enhancedWorkflow,
            isEnhancing,
            lastUserQuery,
            showRecommendations,
            getEnhancedWorkflow,
            selectWorkflow,
            previewWorkflow,
            createEnhancedWorkflow,
            exportEnhancedWorkflow,
            toggleRecommendations,
            // Utility methods
            formatConfidence,
            formatDescription
        }
    }
}
