#!/bin/bash
#
# AWS Batch Fetch-and-Run Script for Galaxy
#
# This script downloads input files from S3, executes a Galaxy tool command,
# and uploads output files back to S3.
#
# Environment Variables:
#   JOB_SCRIPT_S3_URL - S3 URL of the job script to execute
#   S3_BUCKET - S3 bucket name
#   JOB_ID - Unique job identifier
#   AWS_REGION - AWS region (optional, defaults to us-west-2)

set -e  # Exit on error
set -o pipefail

# Configuration
AWS_REGION=${AWS_REGION:-us-west-2}
S3_BUCKET=${S3_BUCKET:-galaxy-cloud-data}
JOB_ID=${JOB_ID:-unknown}
JOB_SCRIPT_S3_URL=${JOB_SCRIPT_S3_URL}
TOOL_CONTAINER_IMAGE=${TOOL_CONTAINER_IMAGE}  # Optional: run in tool container via Docker-in-Docker

# Directories (Fix 13: Docker-in-Docker volume mounting)
# Use /host-tmp if available (bind mount from host /tmp)
# This allows Docker-in-Docker to share files with tool containers
if [ -d "/host-tmp" ]; then
    BASE_TMP="/host-tmp"
    USE_HOST_PATHS=true
    echo "Using host-shared /tmp via /host-tmp for Docker-in-Docker compatibility"
else
    BASE_TMP="/tmp"
    USE_HOST_PATHS=false
    echo "Using container-local /tmp (Docker-in-Docker may have volume issues)"
fi

WORK_DIR="${BASE_TMP}/galaxy_job_${JOB_ID}"
INPUT_DIR="${WORK_DIR}/inputs"
OUTPUT_DIR="${WORK_DIR}/outputs"
SCRIPT_FILE="${WORK_DIR}/job_script.sh"

echo "========================================="
echo "Galaxy Fetch-and-Run Starting"
echo "========================================="
echo "Job ID: ${JOB_ID}"
echo "S3 Bucket: ${S3_BUCKET}"
echo "AWS Region: ${AWS_REGION}"
echo "Script URL: ${JOB_SCRIPT_S3_URL}"
echo "Tool Container: ${TOOL_CONTAINER_IMAGE:-none (direct execution)}"
echo "========================================="

# Debug: Check AWS credentials
echo ""
echo "Checking AWS credentials..."
if [ -n "${AWS_CONTAINER_CREDENTIALS_RELATIVE_URI}" ]; then
    echo "[OK] Using ECS task role credentials"
    echo "  Credentials URI: ${AWS_CONTAINER_CREDENTIALS_RELATIVE_URI}"
else
    echo "[WARN] No ECS task role credentials found"
fi

# Verify AWS identity
echo "AWS Identity:"
aws sts get-caller-identity --region "${AWS_REGION}" || {
    echo "ERROR: Cannot get AWS identity - IAM role may not be configured correctly"
    exit 1
}
echo ""

# Create work directories
mkdir -p "${INPUT_DIR}" "${OUTPUT_DIR}"

# Step 1: Download the job script from S3
if [ -z "${JOB_SCRIPT_S3_URL}" ]; then
    echo "ERROR: JOB_SCRIPT_S3_URL is not set"
    exit 1
fi

echo "[1/4] Downloading job script from S3..."
aws s3 cp "${JOB_SCRIPT_S3_URL}" "${SCRIPT_FILE}" --region "${AWS_REGION}"
chmod +x "${SCRIPT_FILE}"
echo "[OK] Job script downloaded successfully"

# Step 2: Download input files from S3
echo "[2/4] Downloading input files from S3..."
INPUT_S3_PREFIX="s3://${S3_BUCKET}/jobs/${JOB_ID}/inputs/"
echo "  Source: ${INPUT_S3_PREFIX}"
echo "  Destination: ${INPUT_DIR}/"

# Check if inputs exist
if aws s3 ls "${INPUT_S3_PREFIX}" --region "${AWS_REGION}" > /dev/null 2>&1; then
    aws s3 sync "${INPUT_S3_PREFIX}" "${INPUT_DIR}/" --region "${AWS_REGION}" --quiet
    echo "[OK] Downloaded $(find ${INPUT_DIR} -type f | wc -l) input file(s)"
else
    echo "[WARN] No input files found at ${INPUT_S3_PREFIX}"
fi

# Step 2.5: Download working directory files (e.g., expression scripts)
WORKING_S3_PREFIX="s3://${S3_BUCKET}/jobs/${JOB_ID}/working/"
if aws s3 ls "${WORKING_S3_PREFIX}" --region "${AWS_REGION}" > /dev/null 2>&1; then
    echo "[2.5/4] Downloading working directory files..."
    aws s3 sync "${WORKING_S3_PREFIX}" "${WORK_DIR}/" --region "${AWS_REGION}" --quiet
    echo "[OK] Downloaded working files to ${WORK_DIR}/"
fi

# Step 3: Execute the job script
echo "[3/4] Executing job script..."
echo "========================================="

# Export directories for the script to use
export GALAXY_INPUT_DIR="${INPUT_DIR}"
export GALAXY_OUTPUT_DIR="${OUTPUT_DIR}"
export GALAXY_WORK_DIR="${WORK_DIR}"

# Check if Docker-in-Docker mode is enabled
if [ -n "${TOOL_CONTAINER_IMAGE}" ]; then
    echo "Running in Docker-in-Docker mode with image: ${TOOL_CONTAINER_IMAGE}"

    # DEBUG: Check what files exist before Docker run
    echo "Debug: Files in INPUT_DIR before Docker run:"
    ls -la "${INPUT_DIR}" 2>&1 || echo "Cannot list INPUT_DIR"
    echo "Debug: INPUT_DIR path: ${INPUT_DIR}"
    echo "Debug: Number of files: $(find ${INPUT_DIR} -type f 2>/dev/null | wc -l)"

    # Check if Docker is available
    if ! command -v docker &> /dev/null; then
        echo "ERROR: Docker not found, but TOOL_CONTAINER_IMAGE is set"
        echo "Please ensure Docker is installed in the fetch-and-run container"
        exit 1
    fi

    # Pull the tool container image
    echo "Pulling tool container image..."
    docker pull "${TOOL_CONTAINER_IMAGE}" || {
        echo "[WARN] Failed to pull image, trying to use cached version..."
    }

    # Docker-in-Docker 嵌套挂载问题：
    # 工具容器看不到 fetch-and-run 容器内部文件系统的文件
    # 解决方案：通过 stdin 传递脚本内容

    echo "Debug: WORK_DIR=${WORK_DIR}"
    echo "Debug: SCRIPT_FILE=${SCRIPT_FILE}"
    echo "Debug: Checking if script exists in fetch-and-run container:"
    ls -lh "${SCRIPT_FILE}"

    # Run the script inside the tool container
    # Fix 13: Use host paths for Docker volume mounting
    if [ "${USE_HOST_PATHS}" = "true" ]; then
        # Use host /tmp paths (宿主机视角)
        DOCKER_INPUT_DIR="/tmp/galaxy_job_${JOB_ID}/inputs"
        DOCKER_OUTPUT_DIR="/tmp/galaxy_job_${JOB_ID}/outputs"
        echo "Docker mount paths (host perspective):"
    else
        # Fall back to container paths (may not work in Docker-in-Docker)
        DOCKER_INPUT_DIR="${INPUT_DIR}"
        DOCKER_OUTPUT_DIR="${OUTPUT_DIR}"
        echo "Docker mount paths (container perspective - may have issues):"
    fi

    echo "  Input:  ${DOCKER_INPUT_DIR} -> /galaxy_inputs"
    echo "  Output: ${DOCKER_OUTPUT_DIR} -> /galaxy_outputs"
    echo "  Script: passed via stdin"

    # 通过管道将脚本内容传递给容器
    # Fix 13: 使用宿主机路径进行卷挂载
    docker run --rm -i \
        -v "${DOCKER_INPUT_DIR}:/galaxy_inputs:ro" \
        -v "${DOCKER_OUTPUT_DIR}:/galaxy_outputs:rw" \
        -e GALAXY_INPUT_DIR="/galaxy_inputs" \
        -e GALAXY_OUTPUT_DIR="/galaxy_outputs" \
        -e GALAXY_WORK_DIR="/tmp/work" \
        -w /tmp/work \
        "${TOOL_CONTAINER_IMAGE}" \
        bash < "${SCRIPT_FILE}"
    EXIT_CODE=$?
else
    echo "Running in direct execution mode (no container isolation)"

    # Run the script directly
    cd "${WORK_DIR}"
    bash "${SCRIPT_FILE}"
    EXIT_CODE=$?
fi

echo "========================================="
if [ $EXIT_CODE -eq 0 ]; then
    echo "[OK] Job script completed successfully"
else
    echo "[ERROR] Job script failed with exit code ${EXIT_CODE}"
    exit $EXIT_CODE
fi

# Step 4: Upload output files to S3
echo "[4/4] Uploading output files to S3..."
OUTPUT_S3_PREFIX="s3://${S3_BUCKET}/jobs/${JOB_ID}/outputs/"
echo "  Source: ${OUTPUT_DIR}/"
echo "  Destination: ${OUTPUT_S3_PREFIX}"

# Check if there are any outputs
if [ -n "$(find ${OUTPUT_DIR} -type f)" ]; then
    aws s3 sync "${OUTPUT_DIR}/" "${OUTPUT_S3_PREFIX}" --region "${AWS_REGION}" --quiet
    echo "[OK] Uploaded $(find ${OUTPUT_DIR} -type f | wc -l) output file(s)"
else
    echo "[WARN] No output files found in ${OUTPUT_DIR}"
fi

# Cleanup
echo "Cleaning up work directory..."
rm -rf "${WORK_DIR}"

echo "========================================="
echo "Galaxy Fetch-and-Run Completed Successfully"
echo "========================================="
exit 0
