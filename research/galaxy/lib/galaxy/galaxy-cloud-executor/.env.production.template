# Galaxy Cloud Executor - 生产环境变量模板
# 复制为 .env.production 并填入实际值

# ========================================
# AWS 认证配置
# ========================================

# 方案A: 直接使用IAM用户密钥 (简单)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=xxx...
AWS_DEFAULT_REGION=us-west-2

# 方案B: AssumeRole (推荐，更安全)
# AWS_ACCESS_KEY_ID=AKIA...  # 基础用户密钥
# AWS_SECRET_ACCESS_KEY=xxx...
# AWS_DEFAULT_REGION=us-west-2
# GALAXY_SERVICE_ROLE_ARN=arn:aws:iam::399683337364:role/GalaxyCloudServiceRole
# GALAXY_SERVICE_EXTERNAL_ID=galaxy-service-unique-id

# ========================================
# 服务配置
# ========================================

# Galaxy特定配置
GALAXY_AWS_ENABLED=true
GALAXY_AWS_BATCH_QUEUE=galaxy-cloud-queue
GALAXY_AWS_S3_BUCKET=galaxy-cloud-data-1760241377

# 服务配置
GALAXY_DEFAULT_CLOUD_PROVIDER=aws
GALAXY_LOG_LEVEL=info
GALAXY_ENABLE_METRICS=true

# ========================================
# 安全配置
# ========================================

# API密钥 (如果使用)
# GALAXY_API_KEY=your-secure-api-key

# 数据库连接 (如果使用)
# DATABASE_URL=postgresql://user:pass@host:port/db

# Redis连接 (如果使用缓存)
# REDIS_URL=redis://host:port/db

# ========================================
# 部署配置
# ========================================

# 服务端口
PORT=8080

# 环境标识
ENVIRONMENT=production

# 日志配置
LOG_FORMAT=json
LOG_LEVEL=info

# 监控配置
ENABLE_METRICS=true
METRICS_PORT=8080

# ========================================
# 注意事项
# ========================================
# 1. 永远不要将此文件提交到版本控制
# 2. 定期轮换AWS密钥
# 3. 使用最小权限原则
# 4. 考虑使用容器secrets或密钥管理服务