; em.mdp — steepest-descent minimization of the solvated, ionized metal-complete complex.
integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 50000
nstlist         = 10
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.2
rvdw            = 1.2
vdw-modifier    = Potential-shift
pbc             = xyz
